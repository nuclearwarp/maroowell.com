async function fetchKaptSigunguComplexes(env, legalDongCodes) {
  const sigunguCodes = [...new Set(
    (legalDongCodes || [])
      .map((row) => String(row?.legalDongCode || "").replace(/\D/g, "").slice(0, 5))
      .filter((value) => value.length === 5)
  )];

  const rows = [];

  for (const sigunguCode of sigunguCodes) {
    let selectedParameter = "sigunguCode";
    let firstPage = null;

    try {
      firstPage = await fetchKaptSigunguPageWithParam(
        env,
        sigunguCode,
        1,
        selectedParameter
      );
    } catch (firstError) {
      selectedParameter = "sigunguCd";
      firstPage = await fetchKaptSigunguPageWithParam(
        env,
        sigunguCode,
        1,
        selectedParameter
      );
    }

    // 일부 이관 환경은 잘못된 파라미터를 오류 대신 빈 목록으로 반환한다.
    if (!firstPage.items.length && selectedParameter === "sigunguCode") {
      try {
        const alternate = await fetchKaptSigunguPageWithParam(
          env,
          sigunguCode,
          1,
          "sigunguCd"
        );
        if (alternate.items.length) {
          firstPage = alternate;
          selectedParameter = "sigunguCd";
        }
      } catch {}
    }

    rows.push(...firstPage.items);
    const total = firstPage.totalCount;

    for (
      let pageNo = 2;
      pageNo <= KAPT_SIGUNGU_MAX_PAGES &&
      (pageNo - 1) * KAPT_PAGE_SIZE < total;
      pageNo++
    ) {
      const page = await fetchKaptSigunguPageWithParam(
        env,
        sigunguCode,
        pageNo,
        selectedParameter
      );
      rows.push(...page.items);
      if (page.items.length < KAPT_PAGE_SIZE) break;
    }
  }

  const deduped = [];
  const seen = new Set();
  for (const row of rows) {
    const key = kaptComplexKey(row);
    if (!key || seen.has(key)) continue;
    seen.add(key);
    deduped.push(row);
  }
  return deduped;
}

function compactBuildingMatchText(value) {
  return cleanBuildingText(value)
    .toLowerCase()
    .replace(/아파트|오피스텔|주상복합|연립주택|연립|빌라/g, "")
    .replace(/[^0-9a-z가-힣]/g, "");
}

function kaptFallbackMatchesTitleRows(complex, titleRows) {
  const complexName = compactBuildingMatchText(kaptNameOf(complex));
  const complexAddress = normalizedBuildingAddress(
    kaptAddressOf(complex).preferredAddress
  );
  const complexNumbers = complexAddress.match(/\d+(?:-\d+)?/g) || [];

  for (const row of titleRows || []) {
    const classification = buildingHousingClassification(row);
    if (!classification.apartment) continue;

    const titleName = compactBuildingMatchText(
      row?.bldNm ?? row?.bld_nm ?? ""
    );
    if (
      complexName &&
      titleName &&
      Math.min(complexName.length, titleName.length) >= 2 &&
      (complexName.includes(titleName) || titleName.includes(complexName))
    ) {
      return true;
    }

    const titleAddress = normalizedBuildingAddress(
      buildingRecordAddresses(row).preferredAddress
    );
    const titleNumbers = titleAddress.match(/\d+(?:-\d+)?/g) || [];
    if (
      complexAddress &&
      titleAddress &&
      complexNumbers.some((value) => titleNumbers.includes(value)) &&
      buildingAddressSimilarity(complexAddress, titleAddress)
    ) {
      return true;
    }
  }

  return false;
}

async function fetchKaptComplexesWithFallback(
  env,
  legalDongCodes,
  titleRows
) {
  // 이 함수는 법정동 목록이 이미 0건으로 확인된 뒤에만 호출된다.
  // 같은 법정동 API를 다시 부르지 않고 시군구 목록으로 바로 보정한다.
  const sigunguRows = await fetchKaptSigunguComplexes(env, legalDongCodes);
  const filtered = sigunguRows.filter((row) =>
    kaptFallbackMatchesTitleRows(row, titleRows)
  );

  return {
    rows: filtered,
    mode: "sigungu_title_match",
    fallbackCount: sigunguRows.length,
  };
}

function firstObjectFromPublicData(data, label) {
  const parts = publicDataResponseParts(data, label);
  if (parts.items.length) return parts.items[0];

  const response = data?.response ?? data?.Response ?? data ?? {};
  const body = parts.body || {};
  const candidates = [
    body?.item,
    body?.Item,
    body?.result,
    body?.Result,
    body?.data,
    body?.Data,
    response?.item,
    response?.Item,
    response?.result,
    response?.Result,
    data?.item,
    data?.Item,
  ];

  for (const candidate of candidates) {
    if (
      candidate &&
      typeof candidate === "object" &&
      !Array.isArray(candidate) &&
      Object.keys(candidate).length
    ) {
      return candidate;
    }
  }

  // K-APT JSON은 body 없이 최상위 객체 자체가 Item일 수 있다.
  const metadataKeys = new Set([
    "resultCode", "resultMsg", "header", "body", "response",
    "totalCount", "pageNo", "numOfRows"
  ]);
  const ownDataKeys = Object.keys(response || {}).filter(
    (key) => !metadataKeys.has(key)
  );
  if (ownDataKeys.length) return response;

  return {};
}

function kaptRawHouseholdCount(info) {
  const aliases = [
    "kaptdaCnt", "kaptDaCnt", "kapt_da_cnt", "kaptdacnt",
    "householdCount", "household_count", "hhldCnt", "hhld_cnt",
    "hoCnt", "ho_cnt"
  ];

  for (const source of [info?.basic, info?.detail, info?.list]) {
    const value = firstFiniteBuildingValue(
      ...aliases.map((key) => publicDataField(source, key))
    );
    if (value != null && value > 0) return Math.trunc(value);
  }

  return 0;
}

async function fetchKaptEndpointPair(env, kaptCode, basicUrl, detailUrl, version) {
  const [basicResult, detailResult] = await Promise.allSettled([
    fetchPublicDataJson(
      basicUrl,
      { kaptCode },
      env,
      `K-APT ${version} basic info`
    ),
    fetchPublicDataJson(
      detailUrl,
      { kaptCode },
      env,
      `K-APT ${version} detail info`
    ),
  ]);

  const basic = basicResult.status === "fulfilled"
    ? firstObjectFromPublicData(basicResult.value, `K-APT ${version} basic info`)
    : {};
  const detail = detailResult.status === "fulfilled"
    ? firstObjectFromPublicData(detailResult.value, `K-APT ${version} detail info`)
    : {};

  return {
    version,
    basic,
    detail,
    basicError: basicResult.status === "rejected"
      ? String(basicResult.reason || "failed")
      : null,
    detailError: detailResult.status === "rejected"
      ? String(detailResult.reason || "failed")
      : null,
    basicKeys: Object.keys(basic || {}).slice(0, 80),
    detailKeys: Object.keys(detail || {}).slice(0, 80),
  };
}

async function fetchKaptComplexInfo(env, complex) {
  const kaptCode = kaptCodeOf(complex);
  if (!kaptCode) {
    return {
      list: complex,
      basic: {},
      detail: {},
      diagnostics: {
        kaptCode: null,
        error: "missing_kapt_code",
        attempts: [],
      },
    };
  }

  const attempts = [];

  const v4 = await fetchKaptEndpointPair(
    env,
    kaptCode,
    KAPT_BASIC_INFO_URL,
    KAPT_DETAIL_INFO_URL,
    "V4"
  );
  attempts.push(v4);

  let selected = {
    list: complex,
    basic: v4.basic,
    detail: v4.detail,
  };

  // V4가 빈 객체 또는 0세대를 반환하면 V3로 한 번 더 확인한다.
  if (kaptRawHouseholdCount(selected) <= 0) {
    const v3 = await fetchKaptEndpointPair(
      env,
      kaptCode,
      KAPT_BASIC_INFO_V3_URL,
      KAPT_DETAIL_INFO_V3_URL,
      "V3"
    );
    attempts.push(v3);

    const v3Info = {
      list: complex,
      basic: v3.basic,
      detail: v3.detail,
    };

    if (
      kaptRawHouseholdCount(v3Info) > kaptRawHouseholdCount(selected) ||
      Object.keys(selected.basic || {}).length === 0
    ) {
      selected = v3Info;
    }
  }

  return {
    ...selected,
    diagnostics: {
      kaptCode,
      listName: kaptNameOf(complex) || null,
      listAddress: kaptAddressOf(complex).preferredAddress || null,
      householdCount: kaptRawHouseholdCount(selected),
      attempts: attempts.map((attempt) => ({
        version: attempt.version,
        basicError: attempt.basicError,
        detailError: attempt.detailError,
        basicKeys: attempt.basicKeys,
        detailKeys: attempt.detailKeys,
      })),
    },
  };
}

async function mapBuildingWithConcurrency(items, concurrency, mapper) {
  const results = new Array(items.length);
  let cursor = 0;

  async function worker() {
    while (true) {
      const index = cursor++;
      if (index >= items.length) return;
      results[index] = await mapper(items[index], index);
    }
  }

  const count = Math.min(
    Math.max(1, Math.trunc(concurrency) || 1),
    Math.max(1, items.length)
  );

  await Promise.all(Array.from({ length: count }, worker));
  return results;
}

function firstFiniteBuildingValue(...values) {
  for (const value of values) {
    const n = finiteBuildingNumber(value);
    if (n != null) return n;
  }
  return null;
}

function kaptInfoValue(info, ...keys) {
  for (const source of [info?.basic, info?.detail, info?.list]) {
    const value = publicDataField(source, ...keys);
    if (value !== null && value !== undefined && value !== "") {
      return value;
    }
  }
  return null;
}

function normalizedKaptInfo(info, location) {
  const directHouseholds = firstFiniteBuildingValue(
    kaptInfoValue(
      info,
      "kaptdaCnt",
      "kaptDaCnt",
      "kapt_da_cnt",
      "kaptdacnt",
      "householdCount",
      "household_count",
      "hhldCnt",
      "hhld_cnt",
      "hoCnt",
      "ho_cnt"
    )
  );

  const areaBandHouseholds = [
    ["kaptMparea_60", "kaptMparea60", "kapt_mparea_60"],
    ["kaptMparea_85", "kaptMparea85", "kapt_mparea_85"],
    ["kaptMparea_135", "kaptMparea135", "kapt_mparea_135"],
    ["kaptMparea_136", "kaptMparea136", "kapt_mparea_136"],
  ].reduce((sum, aliases) => {
    const value = firstFiniteBuildingValue(
      ...aliases.map((key) => kaptInfoValue(info, key))
    );
    return sum + Math.max(0, Math.trunc(value || 0));
  }, 0);

  const households = Math.max(
    0,
    Math.trunc(
      directHouseholds != null && directHouseholds > 0
        ? directHouseholds
        : areaBandHouseholds
    )
  );

  const buildingCount = Math.max(
    1,
    Math.trunc(firstFiniteBuildingValue(
      kaptInfoValue(
        info,
        "kaptDongCnt",
        "kapt_dong_cnt",
        "dongCnt",
        "dong_count"
      )
    ) || 1)
  );

  const rawElevatorCount = firstFiniteBuildingValue(
    kaptInfoValue(
      info,
      "kaptdEcnt",
      "kaptDEcnt",
      "kaptEcnt",
      "kapt_elevator_cnt",
      "elevatorCnt",
      "elevator_count",
      "elvtCnt",
      "elvt_count"
    )
  );
  const elevatorKnown = rawElevatorCount != null;
  const elevatorCount = Math.max(0, Math.trunc(rawElevatorCount || 0));

  const maxFloorCount = Math.max(
    0,
    Math.trunc(firstFiniteBuildingValue(
      kaptInfoValue(
        info,
        "kaptTopFloor",
        "kapt_top_floor",
        "maxFloorCnt",
        "max_floor_count",
        "topFloor",
        "top_floor"
      )
    ) || 0)
  );

  const addresses = kaptAddressOf(info?.basic || info?.list || {});
  const listAddresses = kaptAddressOf(info?.list || {});
  const code = kaptCodeOf(info?.basic || {}) || kaptCodeOf(info?.list || {});
  const name = kaptNameOf(info?.basic || {}) || kaptNameOf(info?.list || {});

  return {
    key: code ? `kapt:${code}` : kaptComplexKey(info?.list || info?.basic || {}),
    kaptCode: code,
    name,
    address: addresses.preferredAddress || listAddresses.preferredAddress,
    households,
    householdsSource: directHouseholds != null && directHouseholds > 0
      ? "KAPT_TOTAL"
      : areaBandHouseholds > 0
        ? "KAPT_AREA_BANDS"
        : "KAPT_EMPTY",
    buildingCount,
    elevatorCount,
    elevatorKnown,
    maxFloorCount,
    location,
    diagnostics: info?.diagnostics || null,
  };
}

function isRelevantBuildingHubRecord(row) {
  if (!row || typeof row !== "object") return false;
  if (isAncillaryBuildingRecord(row)) return false;

  const classification = buildingHousingClassification(row);
  const hoCount = nonNegativeBuildingInteger(row?.hoCnt ?? row?.ho_cnt);
  const floors = buildingGroundFloorCount(row);
  const purpose = classification.purpose.replace(/\s+/g, "");

  if (/주차장|기계실|전기실|변전실|저수조|경비실|관리사무소만/.test(purpose)) {
    return false;
  }

  return (
    classification.residential ||
    classification.commercial ||
    hoCount > 0 ||
    floors > 0
  );
}

function distanceMetersBetweenPoints(a, b) {
  if (!a || !b) return Infinity;
  const lat1 = Number(a.lat) * Math.PI / 180;
  const lat2 = Number(b.lat) * Math.PI / 180;
  const deltaLat = lat2 - lat1;
  const deltaLng = (Number(b.lng) - Number(a.lng)) * Math.PI / 180;
  const sinLat = Math.sin(deltaLat / 2);
  const sinLng = Math.sin(deltaLng / 2);
  const h = sinLat * sinLat + Math.cos(lat1) * Math.cos(lat2) * sinLng * sinLng;
  return 6371008.8 * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(Math.max(0, 1 - h)));
}

function isNearKaptComplex(location, kaptComplexes) {
  return kaptComplexes.some((complex) =>
    distanceMetersBetweenPoints(location, complex.location) <=
      BUILDING_STATS_KAPT_MATCH_RADIUS_METERS
  );
}


function buildingParcelDescriptor(row) {
  const digits = (value, length) => {
    const raw = String(value ?? "").replace(/\D/g, "");
    return raw ? raw.padStart(length, "0").slice(-length) : "";
  };

  const sigunguCd = digits(row?.sigunguCd ?? row?.sigungu_cd, 5);
  const bjdongCd = digits(row?.bjdongCd ?? row?.bjdong_cd, 5);
  const platGbCd = String(row?.platGbCd ?? row?.plat_gb_cd ?? "0").replace(/\D/g, "") || "0";
  const bun = digits(row?.bun, 4);
  const ji = digits(row?.ji, 4);

  if (!sigunguCd || !bjdongCd || !bun) return null;

  return {
    key: [sigunguCd, bjdongCd, platGbCd, bun, ji || "0000"].join("|"),
    sigunguCd,
    bjdongCd,
    platGbCd,
    bun,
    ji: ji || "0000",
  };
}


function canonicalBuildingParcelKeyFromParts({
  legalDongCode,
  sigunguCd,
  bjdongCd,
  platGbCd,
  parcelMainNo,
  parcelSubNo,
} = {}) {
  const digits = (value, length) => {
    const raw = String(value ?? "").replace(/\D/g, "");
    return raw ? raw.padStart(length, "0").slice(-length) : "";
  };

  const legal = String(legalDongCode ?? "").replace(/\D/g, "");
  const sigungu = digits(sigunguCd || (legal.length >= 10 ? legal.slice(0, 5) : ""), 5);
  const bjdong = digits(bjdongCd || (legal.length >= 10 ? legal.slice(5, 10) : ""), 5);
  const plat = String(platGbCd ?? "0").replace(/\D/g, "") === "1" ? "1" : "0";
  const bun = digits(parcelMainNo, 4);
  const ji = digits(parcelSubNo, 4) || "0000";

  if (!sigungu || !bjdong || !bun || Number(bun) <= 0) return "";
  return [sigungu, bjdong, plat, bun, ji].join("|");
}

function normalizeVerifiedScopeParcels(input, geometry, scopeZipcode) {
  const map = new Map();
  const diagnostics = {
    received: 0,
    accepted: 0,
    invalid: 0,
    outsidePolygon: 0,
    postcodeMismatch: 0,
    duplicate: 0,
  };

  const rows = Array.isArray(input) ? input : [];
  const normalizedZipcode = normalizeTerrainZipcode(scopeZipcode);

  for (const item of rows) {
    diagnostics.received += 1;
    if (!item || typeof item !== "object") {
      diagnostics.invalid += 1;
      continue;
    }

    const location = normalizeBuildingLocationPoint(item);
    if (!location) {
      diagnostics.invalid += 1;
      continue;
    }

    const inside = pointInBuildingGeometry(location.lng, location.lat, geometry);
    if (!inside) {
      diagnostics.outsidePolygon += 1;
      continue;
    }

    const zonecode = normalizeTerrainZipcode(
      item.zonecode ?? item.zoneCode ?? item.zone_no ?? item.zoneNo ??
      item.postcode ?? item.postalCode
    );
    const zoneVerified = item.zoneVerified === true || item.zone_verified === true;
    const interiorVerified = item.interiorVerified === true || item.interior_verified === true;

    // 우편번호가 명시된 경우에는 현재 분석 우편번호와 반드시 같아야 한다.
    // 우편번호가 비어 있는 역지오코딩 결과는 폴리곤 경계에서 충분히 안쪽인 표본만 허용한다.
    if (
      normalizedZipcode &&
      ((zonecode && zonecode !== normalizedZipcode) || (!zonecode && !interiorVerified))
    ) {
      diagnostics.postcodeMismatch += 1;
      continue;
    }

    const key = canonicalBuildingParcelKeyFromParts({
      legalDongCode:
        item.legalDongCode ?? item.legal_dong_code ?? item.bCode ?? item.b_code,
      sigunguCd: item.sigunguCd ?? item.sigungu_cd,
      bjdongCd: item.bjdongCd ?? item.bjdong_cd,
      platGbCd: item.platGbCd ?? item.plat_gb_cd,
      parcelMainNo:
        item.parcelMainNo ?? item.parcel_main_no ?? item.mainAddressNo ?? item.main_address_no,
      parcelSubNo:
        item.parcelSubNo ?? item.parcel_sub_no ?? item.subAddressNo ?? item.sub_address_no,
    });

    if (!key) {
      diagnostics.invalid += 1;
      continue;
    }

    const hitCount = Math.max(1, Math.trunc(Number(item.hitCount ?? item.hit_count) || 1));
    const previous = map.get(key);
    if (previous) {
      diagnostics.duplicate += 1;
      previous.hitCount += hitCount;
      previous.zoneVerified = previous.zoneVerified || zoneVerified;
      previous.interiorVerified = previous.interiorVerified || interiorVerified;
      continue;
    }

    map.set(key, {
      key,
      location: {
        ...location,
        zonecode: zonecode || null,
        identityVerified: true,
        addressVerified: true,
        matchType: "POLYGON_REVERSE_PARCEL",
      },
      hitCount,
      zoneVerified,
      interiorVerified,
      matchedAddress: cleanBuildingText(
        item.matchedAddress ?? item.matched_address ?? item.address
      ) || null,
    });
    diagnostics.accepted += 1;
  }

  return { map, diagnostics };
}

