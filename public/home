<style>
:root{
  --bg:#f3f6f8;--card:#fff;--line:#dce5e8;--line2:#cbd5e1;--text:#172b36;--muted:#60727c;
  --navy:#17364a;--day:#f59e0b;--night:#7c3aed;--blue:#2563eb;--fresh:#16a34a;
  --return:#4169a1;--olive:#71823f;--red:#c52824;--shadow:0 10px 28px rgba(23,54,74,.08)
}
*{box-sizing:border-box}
html,body{
  margin:0;min-height:100%;background:var(--bg);color:var(--text);
  font-family:ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI","Apple SD Gothic Neo","Noto Sans KR",Roboto,Arial,sans-serif;
  font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased
}
body{
  font-weight:400;letter-spacing:-.012em;
  background:
    radial-gradient(circle at 8% 0%,rgba(245,158,11,.055),transparent 26%),
    radial-gradient(circle at 92% 0%,rgba(124,58,237,.055),transparent 26%),
    var(--bg)
}
button,input{font:inherit}
.wrap{width:min(1540px,100%);margin:auto;padding:10px 14px 40px}
.card{background:rgba(255,255,255,.99);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);padding:14px;margin-bottom:12px}
.topbar{display:flex;align-items:center;gap:8px;padding:7px 10px;position:sticky;top:5px;z-index:20}
.brandLogo{width:34px;height:34px;border:0;border-radius:10px;background:#fff;padding:0;display:grid;place-items:center;cursor:pointer}
.brandLogo img{width:31px;height:31px;object-fit:contain}
.brandTitle{font-size:20px;font-weight:650;line-height:1;margin:0;letter-spacing:-.02em}
.grow{flex:1}
.pill{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:38px;padding:0 12px;border-radius:11px;border:1px solid var(--line2);background:#fff;color:#475569;font-size:10.5px;font-weight:600;line-height:1;white-space:nowrap}
.pill:before{content:"";width:6px;height:6px;border-radius:50%;background:#94a3b8}
.pill.ok{border-color:#86efac;color:#166534}.pill.ok:before{background:#22c55e}
.pill.err{border-color:#fecaca;color:#991b1b}.pill.err:before{background:#ef4444}
.btn{height:38px;min-height:38px;padding:0 14px;border-radius:11px;border:1px solid var(--line2);background:#fff;color:#334155;font-weight:600;font-size:11.5px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;line-height:1;transition:.15s}
.btn:active{transform:translateY(1px)}
.btn.primary{background:var(--navy);border-color:var(--navy);color:#fff}
.btn.danger{border-color:#ef4444;color:#dc2626}
.btn.collectorOk{min-width:116px;border:1.5px solid #22c55e;color:#15803d;background:#fff}
.btn.collectorPaused{min-width:116px;border:1.5px solid #fb923c;color:#c2410c;background:#fff7ed}
.btn.collectorError{min-width:116px;border:1.5px solid #ef4444;color:#dc2626;background:#fff}
.btn.collectorOk:disabled,.btn.collectorPaused:disabled,.btn.collectorError:disabled{opacity:1;cursor:default}
.controls{display:grid;grid-template-columns:minmax(240px,1.15fr) minmax(220px,.9fr) minmax(330px,1.25fr) auto;gap:9px;align-items:end}
.field{display:flex;flex-direction:column;gap:5px}
.field label,.caption,.status,.campMeta,.routeLabel,.timeMeta,.selectionHint{font-size:10.5px;color:var(--muted);font-weight:500}
.liveMode{height:46px;display:flex;align-items:center;padding:0 13px;border:1px solid var(--line2);border-radius:11px;background:#f8fafc;color:#17364a;font-size:12px;font-weight:600}
.waveToggle{height:46px;display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line2);border-radius:11px;overflow:hidden;background:#f8fafc}
.waveBtn{border:0;background:transparent;color:#64748b;font-size:13px;font-weight:600;cursor:pointer}
.waveBtn.all.active{background:var(--navy);color:#fff}.waveBtn.day.active{background:var(--day);color:#fff}.waveBtn.night.active{background:var(--night);color:#fff}
.autoRow{height:46px;display:flex;align-items:center;gap:4px;overflow-x:auto}
.autoBtn{height:34px;min-width:44px;padding:0 8px;border-radius:999px;border:1px solid var(--line2);background:#fff;color:#64748b;font-size:10.5px;font-weight:600;cursor:pointer}
.autoBtn.active{background:#e9f0f3;border-color:#94a7b2;color:#17364a}
.actions .btn{height:46px;min-width:76px}
.status{margin-top:9px;min-height:18px;font-size:11.5px}.status.err{color:#b42318}.status strong{color:#334155}
.sectionHead{display:flex;align-items:center;gap:8px;margin-bottom:10px}.sectionHead h2{font-size:17px;margin:0;font-weight:650;letter-spacing:-.03em}
.headActions{margin-left:auto;display:flex;gap:6px}
.copyBtn{height:32px;padding:0 11px;border-radius:9px;border:1px solid #67e8f9;background:#ecfeff;color:#0e7490;font-size:10.5px;font-weight:600;cursor:pointer}
.copyBtn:hover{background:#cffafe}.copyBtn.copied{background:#dcfce7;border-color:#86efac;color:#166534}
.summaryGrid{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:7px}
.summaryBox{border:1px solid var(--line);border-radius:13px;padding:10px 11px;background:#fff;min-width:0}
.summaryBox .label{font-size:9.8px;color:#687a84;font-weight:600}
.summaryBox .value{margin-top:4px;font-size:20px;font-weight:650;line-height:1.05;letter-spacing:-.035em}
.summaryBox .sub{margin-top:6px;font-size:10.5px;line-height:1.35;color:#647680;font-weight:500}
.summaryBox.delivery .value{color:var(--blue);font-size:17px}
.summaryBox.freshDelivery .value{color:var(--fresh);font-size:17px}
.summaryBox.return .value{color:var(--return);font-size:15px}.summaryBox.fresh .value{color:var(--olive);font-size:15px}.summaryBox.bad .value{color:var(--red)}
.stackRate{display:grid;gap:2px;line-height:1.18}.stackRate div{white-space:nowrap}
.campGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.driverGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.campCard,.driverCard{border:1px solid var(--line);border-radius:14px;background:#fff;padding:11px 12px}
.campCard{cursor:pointer;transition:.08s}.campCard:hover{border-color:#aebcc4}
.campCard.selected{border:2px solid var(--navy);box-shadow:0 0 0 3px rgba(23,54,74,.08)}
.campCard.selected:after{content:"선택됨";display:inline-flex;margin-top:8px;padding:3px 7px;border-radius:999px;background:#17364a;color:#fff;font-size:9px;font-weight:600}
.campTop,.driverTop{display:flex;align-items:flex-start;gap:8px}
.campName,.driverName{font-size:15px;font-weight:650}
.campMeta,.routeLabel{margin-top:4px;line-height:1.45;word-break:break-all}
.campOps{margin-top:6px;display:flex;gap:8px;flex-wrap:wrap;font-size:10px;font-weight:600}
.campOps .absent{color:#b42318}.campOps .done{color:#15803d}.campOps .ok{color:#64748b}
.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin-top:9px}
.driverCard .metrics{grid-template-columns:repeat(2,minmax(0,1fr))}
.metricPanel{border-radius:10px;background:#f4f7f8;padding:9px;min-width:0}
.metricPanel.delivery{background:#eff6ff}.metricPanel.freshDelivery{background:#ecfdf5}.metricPanel.return{background:#eef3fa}.metricPanel.fresh{background:#f4f6ec}
.metricPanel .k{font-size:12px;color:#334155;font-weight:800}
.metricPanel .rate{margin-top:3px;font-size:12.5px;font-weight:650;line-height:1.25}
.metricPanel .detail{margin-top:5px;font-size:11.5px;line-height:1.48;color:#52666f;font-weight:600;white-space:normal}
.metricPanel .detailGrid{display:grid;grid-template-columns:56px minmax(0,1fr);column-gap:10px;row-gap:2px;align-items:baseline}
.metricPanel .detailGrid .detailValue{font-variant-numeric:tabular-nums;font-weight:700}
.metricPanel.delivery .rate{color:var(--blue)}.metricPanel.freshDelivery .rate{color:var(--fresh)}.metricPanel.return .rate{color:var(--return)}.metricPanel.fresh .rate{color:var(--olive)}
.metricPanel .dual{display:grid;gap:2px;margin-top:3px;font-size:11.5px;font-weight:650}.metricPanel .dual span{display:block;white-space:nowrap}.metricPanel .dual b{font-size:12.5px}
.driverCamp{display:inline-flex;margin-right:7px;padding:2px 0;background:transparent;color:#17364a;font-size:16px;font-weight:800;vertical-align:0}
.waveBadge{display:inline-flex;margin-right:5px;padding:3px 7px;border-radius:999px;font-size:9px;font-weight:600;vertical-align:2px}
.waveBadge.day{background:#fff6df;color:#9a5b00}.waveBadge.night{background:#f2ecff;color:#6d28d9}
.driverScore{margin-left:auto;text-align:right}.driverScore b{display:block;font-size:13px;color:var(--blue);font-weight:650}.driverScore small{color:#73848e;font-size:9.5px;font-weight:500}
.driverTop{position:relative;padding-bottom:25px}.timeMeta{position:absolute;left:0;right:0;bottom:0;margin-top:7px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:12px;font-size:10px;width:100%}.timeMeta span:first-child{text-align:left}.timeMeta span:last-child{text-align:right}
.missLine{margin-top:7px;padding:7px 9px;border-radius:9px;background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;font-size:10.5px;font-weight:700}
.missLine.red{background:#fff0ef;color:#b42318;border-color:#fecaca}
.routeChips{margin-top:6px;display:flex;gap:5px;flex-wrap:wrap}
.routeChip{display:inline-flex;align-items:center;min-height:24px;padding:3px 8px;border-radius:999px;background:#f1f5f9;border:1px solid #dbe4ea;color:#435667;font-size:11px;font-weight:700;line-height:1}.routeChip.ownExtra{background:#fff7ed;border-color:#fdba74;color:#c2410c}.routeChip.externalExtra{background:#fff1f2;border-color:#fca5a5;color:#b91c1c}
.flagLine{margin-top:7px;display:flex;gap:5px;flex-wrap:wrap}.flag{padding:4px 7px;border-radius:999px;font-size:9px;font-weight:650}.flag.freshMiss{background:#ecfdf5;color:#15803d;border:1px solid #86efac}.flag.dawnMiss{background:#f5f3ff;color:#6d28d9;border:1px solid #c4b5fd}
.driverCard.mismatch{border:2px solid var(--day)}.driverCard.external{border:2px solid var(--red)}
.warn{margin-top:7px;padding:7px 8px;border-radius:9px;background:#fff7e7;color:#9c5b08;font-size:9.5px;line-height:1.45;white-space:pre-line;font-weight:600}
.warn.red{background:#fff0ef;color:#b42318}
.empty{padding:24px 14px;text-align:center;border:1px dashed #cad5da;border-radius:13px;background:#fafcfd;color:#7a8a93;font-size:11.5px}
.loading{opacity:.58;pointer-events:none}.hidden{display:none!important}.selectionHint{margin-left:auto;font-size:9.5px}
.copying{outline:2px solid rgba(23,54,74,.2);outline-offset:4px}.captureMeta{margin:0 0 10px;padding:7px 10px;border-radius:9px;background:#f4f7f8;color:#52666f;font-size:11px;font-weight:600;line-height:1.35}
@media(max-width:1320px){.summaryGrid{grid-template-columns:repeat(5,1fr)}.campCard .metrics{grid-template-columns:repeat(2,1fr)}}
@media(max-width:1120px){.driverGrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:980px){.controls{grid-template-columns:1fr 1fr}.actions{grid-column:1/-1}.summaryGrid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:760px){.wrap{padding:7px}.topbar{top:2px}.pill.user{display:none}.controls{grid-template-columns:1fr}.actions{grid-column:auto}.actions .btn{width:100%}.summaryGrid{grid-template-columns:repeat(2,1fr)}.campGrid,.driverGrid{grid-template-columns:1fr}.metrics,.driverCard .metrics{grid-template-columns:1fr}.card{padding:11px;border-radius:15px}.selectionHint{display:none}}

/* ===== realtime readability + progress bars v13 ===== */
:root{--blue:#38bdf8;--fresh:#22c55e;--return:#6366f1;--olive:#84cc16}
.field label,.caption,.status,.campMeta,.routeLabel,.timeMeta,.selectionHint{font-size:12px}
.pill,.autoBtn,.copyBtn,.summaryBox .sub,.btn{font-size:12px}
.summaryBox .label{font-size:12px}.summaryBox .value{font-size:22px}
.summaryBox.delivery .value,.summaryBox.freshDelivery .value{font-size:20px}
.summaryBox.return .value,.summaryBox.fresh .value{font-size:18px}
.campName,.driverName{font-size:16px}.campOps{font-size:12px}
.metricPanel{padding:10px 11px;border:1px solid rgba(148,163,184,.16)}
.metricPanel.delivery{background:#f0f9ff}.metricPanel.freshDelivery{background:#f0fdf4}.metricPanel.return{background:#eef2ff}.metricPanel.fresh{background:#f7fee7}
 .metricPanel .k{font-size:13.5px;font-weight:800}.metricPanel.delivery .k{color:#0369a1}.metricPanel.freshDelivery .k{color:#15803d}.metricPanel.return .k{color:#4338ca}.metricPanel.fresh .k{color:#4d7c0f}.metricPanel .rate{font-size:16px;font-weight:700}
.metricPanel .detail{font-size:12.5px;line-height:1.5}.metricPanel .dual{font-size:12px}.metricPanel .dual b{font-size:13.5px}
.driverCamp{font-size:16px;font-weight:800}.waveBadge{font-size:11px}.driverScore{min-width:102px}.driverScore b{font-size:16px}.driverScore small{font-size:11px}
.timeMeta{font-size:12px;font-weight:600;color:#5b6f7a}.routeLabel{font-size:12.5px;color:#475569;font-weight:600}.routeChip{font-size:12px}.missLine{font-size:12px}.flag{font-size:11px}.warn{font-size:11.5px}
.metricBar,.scoreBar{height:7px;margin-top:7px;border-radius:999px;background:#e2e8f0;overflow:hidden}
.metricBar i,.scoreBar i{display:block;height:100%;border-radius:inherit;transition:width .18s ease}
.metricBar.delivery i,.scoreBar i{background:var(--blue)}.metricBar.freshDelivery i{background:var(--fresh)}.metricBar.return i{background:var(--return)}.metricBar.fresh i{background:var(--olive)}
.scoreBar{width:100%;height:6px}
/* ===== realtime readability + progress bars v13 end ===== */

