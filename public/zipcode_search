  ].join("|");
}

async function fetchBuildingHubParcelPages(
  env,
  url,
  label,
  parcel,
  options = {}
) {
  const attempts = [];
  let lastError = null;

  const maxVariants = Math.max(
    1,
    Math.trunc(Number(options.maxVariants) || BUILDING_UNIT_QUERY_VARIANT_LIMIT)
  );
  const maxAttempts = Math.max(
    1,
    Math.trunc(Number(options.maxAttempts) || BUILDING_UNIT_DETAIL_MAX_ATTEMPTS)
  );

  for (const variant of buildingParcelQueryVariants(parcel).slice(0, maxVariants)) {
    const rows = [];
    let totalCount = null;
    let variantError = null;

    try {
      for (
        let pageNo = 1;
        pageNo <= BUILDING_UNIT_MAX_PAGES_PER_PARCEL;
        pageNo++
      ) {
        const data = await fetchPublicDataJson(
          url,
          {
            ...variant.params,
            numOfRows: BUILDING_UNIT_PAGE_SIZE,
            pageNo,
          },
          env,
          label,
          BUILDING_UNIT_TIMEOUT_MS,
          maxAttempts
        );

        const page = publicDataResponseParts(data, label);
        if (totalCount == null) totalCount = page.totalCount;
        rows.push(...page.items);

        if (
          page.items.length === 0 ||
          page.items.length < BUILDING_UNIT_PAGE_SIZE ||
          pageNo * BUILDING_UNIT_PAGE_SIZE >= totalCount
        ) break;
      }
    } catch (error) {
      lastError = error;
      variantError = String(error?.message || error || "failed");
    }

    attempts.push({
      name: variant.name,
      params: variant.params,
      rowCount: rows.length,
      totalCount,
      error: variantError,
    });

    if (rows.length) {
      const deduped = [];
      const seen = new Set();
      rows.forEach((row, index) => {
        const key = buildingUnitRowStableKey(row, index);
        if (seen.has(key)) return;
        seen.add(key);
        deduped.push(row);
      });

      return {
        rows: deduped,
        queryVariant: variant.name,
        attempts,
        error: null,
      };
    }
  }

  return {
    rows: [],
    queryVariant: null,
    attempts,
    error: lastError ? String(lastError?.message || lastError) : null,
  };
}

async function fetchMatchedBuildingUnitData(
  env,
  matchedBuildingRows,
  matchedKapt = []
) {
  const parcels = new Map();

  for (const match of matchedBuildingRows || []) {
    const parcel = buildingParcelDescriptor(match?.row);
    if (!parcel) continue;
    if (!parcels.has(parcel.key)) {
      parcels.set(parcel.key, { parcel, titleMatches: [] });
    }
    parcels.get(parcel.key).titleMatches.push(match);
  }

  const parcelGroups = [...parcels.values()];
  const warnings = [];
  let complete = true;

  const resultByKey = new Map();
  const detailCandidates = [];

  const emptySource = (reason) => ({
    rows: [],
    queryVariant: null,
    attempts: [],
    error: null,
    skippedReason: reason || null,
  });

  for (const group of parcelGroups) {
    const titleRowsWithUnits = titleParcelFallback(group.titleMatches);
    const coveredByKaptList = (matchedKapt || []).some((match) => {
      const complex = {
        address: kaptAddressOf(match?.list || {}).preferredAddress,
        location: match?.location || null,
      };
      return kaptMatchesTitleParcel(complex, group.titleMatches);
    });

    if (titleRowsWithUnits.length > 0 || coveredByKaptList) {
      const reason = coveredByKaptList
        ? "kapt_or_title_available"
        : "title_count_available";
      resultByKey.set(group.parcel.key, {
        parcel: group.parcel,
        titleMatches: group.titleMatches,
        areaRows: [],
        exposRows: [],
        recapRows: [],
        housePriceRows: [],
        queryDiagnostics: {
          optimized: true,
          skippedReason: reason,
          area: emptySource(reason),
          expos: emptySource(reason),
          recap: emptySource(reason),
          housePrice: emptySource(reason),
        },
      });
      continue;
    }

    detailCandidates.push(group);
  }

  const selectedCandidates = detailCandidates.slice(
    0,
    BUILDING_STATS_MAX_DETAIL_PARCELS_PER_REQUEST
  );
  const deferredCandidates = detailCandidates.slice(
    BUILDING_STATS_MAX_DETAIL_PARCELS_PER_REQUEST
  );

  if (deferredCandidates.length) {
    complete = false;
    warnings.push(
      `SUBREQUEST_BUDGET: 상세조회 ${selectedCandidates.length}필지만 처리하고 ` +
      `${deferredCandidates.length}필지는 표제부 fallback으로 남겼습니다.`
    );

    for (const group of deferredCandidates) {
      const reason = "deferred_by_subrequest_budget";
      resultByKey.set(group.parcel.key, {
        parcel: group.parcel,
        titleMatches: group.titleMatches,
        areaRows: [],
        exposRows: [],
        recapRows: [],
        housePriceRows: [],
        queryDiagnostics: {
          optimized: true,
          skippedReason: reason,
          area: emptySource(reason),
          expos: emptySource(reason),
          recap: emptySource(reason),
          housePrice: emptySource(reason),
        },
      });
    }
  }

  const selectedResults = await mapBuildingWithConcurrency(
    selectedCandidates,
    BUILDING_UNIT_FETCH_CONCURRENCY,
    async ({ parcel, titleMatches }) => {
      const fetchOne = async (url, label) => {
        try {
          return await fetchBuildingHubParcelPages(
            env,
            url,
            label,
            parcel,
            {
              maxVariants: BUILDING_UNIT_QUERY_VARIANT_LIMIT,
              maxAttempts: BUILDING_UNIT_DETAIL_MAX_ATTEMPTS,
            }
          );
        } catch (error) {
          complete = false;
          warnings.push(
            `${parcel.key} ${label}: ${String(error?.message || error || "failed")}`
          );
          return {
            rows: [],
            queryVariant: null,
            attempts: [],
            error: String(error?.message || error || "failed"),
          };
        }
      };

      // 가장 호 단위 정확도가 높은 전유공용면적을 먼저 조회한다.
      const area = await fetchOne(
        BUILDING_HUB_EXPOS_AREA_URL,
        "Building HUB exclusive/common-area"
      );

      const areaHasUnits = (area.rows || []).some((row) =>
        !isCommonAreaUnitRecord(row) &&
        isExclusiveAreaUnitRecord(row) &&
        !!unitHoName(row)
      );

      let expos = emptySource("area_units_available");
      if (!areaHasUnits) {
        expos = await fetchOne(
          BUILDING_HUB_EXPOS_URL,
          "Building HUB exclusive-unit"
        );
      }

      const exposHasUnits = (expos.rows || []).some((row) =>
        !isCommonAreaUnitRecord(row) && !!unitHoName(row)
      );

      let recap = emptySource("exclusive_units_available");
      if (!areaHasUnits && !exposHasUnits) {
        recap = await fetchOne(
          BUILDING_HUB_RECAP_TITLE_URL,
          "Building HUB recap-title"
        );
      }

      const recapHasUnits = !!bestRecapFallback(recap.rows || []);
      let housePrice = emptySource("earlier_source_available");
      if (!areaHasUnits && !exposHasUnits && !recapHasUnits) {
        housePrice = await fetchOne(
          BUILDING_HUB_HOUSE_PRICE_URL,
          "Building HUB house-price"
        );
      }

      return {
        parcel,
        titleMatches,
        areaRows: area.rows || [],
        exposRows: expos.rows || [],
        recapRows: recap.rows || [],
        housePriceRows: housePrice.rows || [],
        queryDiagnostics: {
          optimized: true,
          area,
          expos,
          recap,
          housePrice,
        },
      };
    }
  );

  for (const result of selectedResults) {
    resultByKey.set(result.parcel.key, result);
  }

  return {
    complete,
    warnings,
    parcels: parcelGroups.map((group) =>
      resultByKey.get(group.parcel.key) || {
        parcel: group.parcel,
        titleMatches: group.titleMatches,
        areaRows: [],
        exposRows: [],
        recapRows: [],
        housePriceRows: [],
        queryDiagnostics: {
          optimized: true,
          skippedReason: "no_result",
        },
      }
    ),
  };
}

function titleRowIndexes(matchedBuildingRows) {
  const byManagementKey = new Map();
  const byParcelKey = new Map();

  for (const match of matchedBuildingRows || []) {
    const row = match.row;
    const mgmKey = cleanBuildingText(row?.mgmBldrgstPk ?? row?.mgm_bldrgst_pk);
    if (mgmKey) byManagementKey.set(mgmKey, match);

    const parcel = buildingParcelDescriptor(row);
    if (parcel) {
      if (!byParcelKey.has(parcel.key)) byParcelKey.set(parcel.key, []);
      byParcelKey.get(parcel.key).push(match);
    }
  }

  return { byManagementKey, byParcelKey };
}

function findParentTitleMatch(unitRow, parcel, indexes) {
  const parentKey = unitParentManagementKey(unitRow);
  if (parentKey && indexes.byManagementKey.has(parentKey)) {
    return indexes.byManagementKey.get(parentKey);
  }

  const candidates = indexes.byParcelKey.get(parcel.key) || [];
  const unitDong = unitDongName(unitRow).replace(/\s+/g, "");
  if (unitDong) {
    const exact = candidates.find((match) =>
      cleanBuildingText(match.row?.dongNm ?? match.row?.dong_nm)
        .replace(/\s+/g, "") === unitDong
    );
    if (exact) return exact;
  }

  return candidates[0] || null;
}

function addUnitToElevatorTotals(totals, unitType, elevatorCategory, units) {
  const count = Math.max(0, Math.trunc(Number(units) || 0));
  if (!count) return;

  if (elevatorCategory === "confirmed") {
    totals.confirmedElevatorUnitCount += count;
    if (unitType === "residential") totals.residentialElevatorUnitCount += count;
    if (unitType === "commercial") totals.commercialElevatorUnitCount += count;
    return;
  }

  if (elevatorCategory === "inferred") {
    totals.inferredElevatorUnitCount += count;
    if (unitType === "residential") totals.residentialElevatorUnitCount += count;
    if (unitType === "commercial") totals.commercialElevatorUnitCount += count;
    return;
  }

  if (elevatorCategory === "none") {
    totals.noElevatorUnitCount += count;
    if (unitType === "residential") totals.residentialNoElevatorUnitCount += count;
    if (unitType === "commercial") totals.commercialNoElevatorUnitCount += count;
    return;
  }

  totals.unknownElevatorUnitCount += count;
  if (unitType === "residential") totals.residentialUnknownElevatorUnitCount += count;
  if (unitType === "commercial") totals.commercialUnknownElevatorUnitCount += count;
}

function buildingLocalMeters(lng, lat, refLng, refLat) {
  const latRad = Number(refLat) * Math.PI / 180;
  return {
    x: (Number(lng) - Number(refLng)) * 111320 * Math.cos(latRad),
    y: (Number(lat) - Number(refLat)) * 110540,
  };
}

function buildingPointToSegmentDistanceMeters(
  pointLng,
  pointLat,
  aLng,
  aLat,
  bLng,
  bLat
) {
  const a = buildingLocalMeters(aLng, aLat, pointLng, pointLat);
  const b = buildingLocalMeters(bLng, bLat, pointLng, pointLat);
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const lengthSquared = dx * dx + dy * dy;

  if (!Number.isFinite(lengthSquared) || lengthSquared <= 1e-12) {
    return Math.hypot(a.x, a.y);
  }

  const t = Math.max(
    0,
    Math.min(1, -(a.x * dx + a.y * dy) / lengthSquared)
  );

  return Math.hypot(a.x + t * dx, a.y + t * dy);
}

function buildingDistanceToRingMeters(lng, lat, ring) {
  if (!Array.isArray(ring) || ring.length < 2) return Infinity;

  let minDistance = Infinity;

  for (let index = 0; index < ring.length; index++) {
    const current = ring[index];
    const next = ring[(index + 1) % ring.length];

    if (
      !Array.isArray(current) ||
      current.length < 2 ||
      !Array.isArray(next) ||
      next.length < 2
    ) {
      continue;
    }

    const distance = buildingPointToSegmentDistanceMeters(
      lng,
      lat,
      Number(current[0]),
      Number(current[1]),
      Number(next[0]),
      Number(next[1])
    );

    if (Number.isFinite(distance) && distance < minDistance) {
      minDistance = distance;
    }
  }

  return minDistance;
}

function buildingDistanceToGeometryMeters(lng, lat, geometry) {
  if (!geometry || typeof geometry !== "object") return Infinity;

  if (pointInBuildingGeometry(lng, lat, geometry)) return 0;

  let minDistance = Infinity;
  const polygons = geometry.type === "Polygon"
    ? [geometry.coordinates]
    : geometry.type === "MultiPolygon"
      ? geometry.coordinates
      : [];

  for (const polygon of polygons || []) {
    for (const ring of polygon || []) {
      const distance = buildingDistanceToRingMeters(lng, lat, ring);
      if (Number.isFinite(distance) && distance < minDistance) {
        minDistance = distance;
      }
    }
  }

  return minDistance;
}

function buildingLocationScopeDecision(location, geometry, scopeZipcode) {
  if (!location) {
    return {
      matched: false,
      reason: "missing_location",
      distanceMeters: null,
    };
  }

  const lng = Number(location.lng);
  const lat = Number(location.lat);

  if (!Number.isFinite(lng) || !Number.isFinite(lat)) {
    return {
      matched: false,
      reason: "invalid_location",
      distanceMeters: null,
    };
  }

  const inside = pointInBuildingGeometry(lng, lat, geometry);
  if (inside) {
    return {
      matched: true,
      reason: "inside_polygon",
      distanceMeters: 0,
    };
  }

  const distanceMeters = buildingDistanceToGeometryMeters(
    lng,
    lat,
    geometry
  );

  const normalizedScopeZipcode = normalizeTerrainZipcode(scopeZipcode);
  const normalizedLocationZipcode = normalizeTerrainZipcode(
    location.zonecode ??
    location.zoneCode ??
    location.zone_no ??
    location.zoneNo ??
    location.postcode ??
    location.postalCode
  );

  if (normalizedScopeZipcode) {
    if (
      normalizedLocationZipcode &&
      normalizedLocationZipcode !== normalizedScopeZipcode
    ) {
      return {
        matched: false,
        reason: "zipcode_mismatch",
        distanceMeters,
      };
    }

    if (
      normalizedLocationZipcode === normalizedScopeZipcode &&
      distanceMeters <= BUILDING_STATS_ZIPCODE_EDGE_TOLERANCE_METERS
    ) {
      return {
        matched: true,
        reason: "zipcode_edge_tolerance",
        distanceMeters,
      };
    }

    if (
      !normalizedLocationZipcode &&
      distanceMeters <= BUILDING_STATS_NO_ZIP_EDGE_TOLERANCE_METERS
    ) {
      return {
        matched: true,
        reason: "no_zip_edge_tolerance",
        distanceMeters,
      };
    }

    return {
      matched: false,
      reason: normalizedLocationZipcode
        ? "same_zip_too_far"
        : "no_zip_outside",
      distanceMeters,
    };
  }

  if (distanceMeters <= BUILDING_STATS_ROUTE_EDGE_TOLERANCE_METERS) {
    return {
      matched: true,
      reason: "route_edge_tolerance",
      distanceMeters,
    };
  }

  return {
    matched: false,
    reason: "outside_polygon",
    distanceMeters,
  };
}

function buildingLocationMatchesScope(location, geometry, scopeZipcode) {
  return buildingLocationScopeDecision(
    location,
    geometry,
    scopeZipcode
  ).matched;
}

function normalizeBuildingComplexName(value) {
  return cleanBuildingText(value)
    .toLowerCase()
    .replace(/\([^)]*\)/g, "")
    .replace(/아파트|공동주택|주상복합|연립주택|단지/g, "")
    .replace(/[^0-9a-z가-힣]/g, "");
}

function kaptTitleMatchScore(complex, titleMatch) {
  const row = titleMatch?.row || {};
  const complexName = normalizeBuildingComplexName(kaptNameOf(complex));
  const buildingName = normalizeBuildingComplexName(
    publicDataField(row, "bldNm", "bld_nm")
  );
  const complexAddress = kaptAddressOf(complex).preferredAddress;
  const titleAddress = buildingRecordAddresses(row).preferredAddress;

  let score = 0;
  if (complexName && buildingName) {
    if (complexName === buildingName) score += 100;
    else if (
      complexName.length >= 3 &&
      buildingName.length >= 3 &&
      (complexName.includes(buildingName) || buildingName.includes(complexName))
    ) score += 70;
  }
  if (buildingAddressSimilarity(complexAddress, titleAddress)) score += 60;
  return score;
}

function findKaptMatchedTitle(complex, matchedBuildingRows) {
  let best = null;
  let bestScore = 0;

  for (const match of matchedBuildingRows || []) {
    const classification = buildingHousingClassification(match?.row || {});
    if (!classification.apartment) continue;
    const score = kaptTitleMatchScore(complex, match);
    if (score > bestScore) {
      bestScore = score;
      best = match;
    }
  }

  return bestScore >= 60 ? best : null;
}

function aggregateCombinedBuildingStats({
  buildingRecords,
  kaptComplexes,
  geometry,
  locationIndex,
  walkupMinGroundFloors,
  scopeZipcode = null,
  verifiedScopeParcels = null,
}) {
  const relevantRecords = buildingRecords.filter(isRelevantBuildingHubRecord);
  const parcelGroups = buildBuildingParcelGroupsV11(relevantRecords);
  const matchedBuildingRows = [];
  const missingBuildingRows = [];
  const matchedKapt = [];
  const missingKapt = [];

  const scopeMatchDiagnostics = {
    insidePolygon: 0,
    verifiedParcelPostcode: 0,
    verifiedAddressEdge: 0,
    verifiedRouteEdge: 0,
    verifiedScopeParcel: 0,
    matchedTitleFallback: 0,
    verifiedOutsideScope: 0,
    unverifiedLocation: 0,
    outsidePolygon: 0,
    missingLocation: 0,
    invalidLocation: 0,
    matchedParcels: 0,
    candidateParcels: parcelGroups.length,
    candidateKapt: kaptComplexes.length,
    matchedKapt: 0,
  };

  const addDecision = (decision) => {
    const mapping = {
      inside_polygon: "insidePolygon",
      verified_parcel_postcode: "verifiedParcelPostcode",
      verified_address_edge: "verifiedAddressEdge",
      verified_route_edge: "verifiedRouteEdge",
      verified_scope_parcel: "verifiedScopeParcel",
      matched_title_fallback: "matchedTitleFallback",
      verified_outside_scope: "verifiedOutsideScope",
      unverified_location: "unverifiedLocation",
      outside_polygon: "outsidePolygon",
      missing_location: "missingLocation",
      invalid_location: "invalidLocation",
    };
    const key = mapping[decision?.reason];
    if (key) scopeMatchDiagnostics[key] += 1;
  };

  const scopeParcelMap = verifiedScopeParcels?.map instanceof Map
    ? verifiedScopeParcels.map
    : new Map();

  for (const group of parcelGroups) {
    const target = buildingParcelGeocodingTargetV13(group);
    const verifiedScopeParcel = scopeParcelMap.get(group.key) || null;
    let location = verifiedScopeParcel?.location || null;
    let decision = null;

    if (verifiedScopeParcel && location) {
      decision = {
        matched: true,
        reason: "verified_scope_parcel",
        distanceMeters: 0,
        hitCount: verifiedScopeParcel.hitCount,
      };
    } else {
      location = findBuildingStatsTargetLocation(target, locationIndex);
      if (!location) {
        missingBuildingRows.push(...group.rows);
        addDecision({ reason: "missing_location" });
        continue;
      }
      decision = buildingParcelScopeDecisionV13(
        location,
        geometry,
        scopeZipcode
      );
    }

    addDecision(decision);
    if (!decision.matched) continue;

    scopeMatchDiagnostics.matchedParcels += 1;
    for (const row of group.rows) {
      matchedBuildingRows.push({
        row,
        location,
        parcelKey: group.key,
        scopeMatchReason: decision.reason,
        scopeDistanceMeters: decision.distanceMeters,
      });
    }
  }

  // K-APT 대표점이 없거나 경계 밖에 찍혀도, 이미 폴리곤 내부로 검증된
  // 건축물대장 아파트와 단지명/주소가 일치하면 그 표제부 위치를 사용한다.
  for (const complex of kaptComplexes) {
    const target = kaptGeocodingTarget(complex);
    const titleMatch = findKaptMatchedTitle(complex, matchedBuildingRows);
    let location = titleMatch?.location || findBuildingStatsTargetLocation(target, locationIndex);
    let decision = titleMatch?.location
      ? {
          matched: true,
          reason: "matched_title_fallback",
          distanceMeters: 0,
          titleKey: buildingRecordKey(titleMatch.row),
        }
      : location
        ? buildingParcelScopeDecisionV13(location, geometry, scopeZipcode)
        : { matched: false, reason: "missing_location", distanceMeters: null };

    if (!decision.matched && !titleMatch) {
      const fallbackTitleMatch = findKaptMatchedTitle(complex, matchedBuildingRows);
      if (fallbackTitleMatch?.location) {
        location = fallbackTitleMatch.location;
        decision = {
          matched: true,
          reason: "matched_title_fallback",
          distanceMeters: 0,
          titleKey: buildingRecordKey(fallbackTitleMatch.row),
        };
      }
    }

    addDecision(decision);
    if (!decision.matched || !location) {
      missingKapt.push(complex);
      continue;
    }

    scopeMatchDiagnostics.matchedKapt += 1;
    matchedKapt.push({
      list: complex,
      location,
      scopeMatchReason: decision.reason,
      scopeDistanceMeters: decision.distanceMeters,
    });
  }

  const coverageTargets = dedupeBuildingStatsGeocodingTargets([
    ...parcelGroups.map(buildingParcelGeocodingTargetV13),
    ...kaptComplexes.map(kaptGeocodingTarget),
  ]);

  const missingGeocodingTargets = [];
  let geocodedBuildingCount = 0;
  for (const target of coverageTargets) {
    const location = findBuildingStatsTargetLocation(target, locationIndex);
    if (location) geocodedBuildingCount += 1;
    else missingGeocodingTargets.push(target);
  }

  const hasVerifiedScopeParcels = scopeParcelMap.size > 0;
  const matchedScopeParcelCount = parcelGroups.reduce(
    (count, group) => count + (scopeParcelMap.has(group.key) ? 1 : 0),
    0
  );
  const sourceRecordCount = hasVerifiedScopeParcels
    ? scopeParcelMap.size
    : coverageTargets.length;
  const effectiveGeocodedBuildingCount = hasVerifiedScopeParcels
    ? scopeParcelMap.size
    : geocodedBuildingCount;
  const unlocatedBuildingCount = hasVerifiedScopeParcels
    ? 0
    : Math.max(0, sourceRecordCount - effectiveGeocodedBuildingCount);
  const coveragePercent = sourceRecordCount > 0
    ? effectiveGeocodedBuildingCount / sourceRecordCount * 100
    : 100;

  return {
    relevantRecords,
    parcelGroups,
    matchedBuildingRows,
    matchedKapt,
    missingBuildingRows,
    missingKapt,
    missingGeocodingTargets,
    sourceRecordCount,
    rawSourceRecordCount: relevantRecords.length + kaptComplexes.length,
    geocodedBuildingCount: effectiveGeocodedBuildingCount,
    unlocatedBuildingCount,
    coveragePercent,
    walkupMinGroundFloors,
    scopeMatchDiagnostics: {
      ...scopeMatchDiagnostics,
      discoveredScopeParcels: scopeParcelMap.size,
      matchedScopeParcelCount,
      scopeParcelDiagnostics: verifiedScopeParcels?.diagnostics || null,
    },
  };
}

function parcelTitleMatches(parcel, indexes) {
  return indexes.byParcelKey.get(parcel.key) || [];
}

function bestRecapFallback(recapRows) {
  let best = null;
  for (const row of recapRows || []) {
    const classification = buildingHousingClassification(row);
    const units = buildingTitleUnitFallback(row, classification);
    if (!best || units > best.units) {
      best = { row, classification, units };
    }
  }
  return best && best.units > 0 ? best : null;
}

function titleParcelFallback(matches) {
  const rows = [];
  const seen = new Set();

  for (const match of matches || []) {
    const row = match?.row;
    if (!row) continue;
    const key = buildingRecordKey(row);
    if (!key || seen.has(key) || isAncillaryBuildingRecord(row)) continue;
    seen.add(key);

    const classification = buildingHousingClassification(row);
    const units = buildingTitleUnitFallback(row, classification);
    if (units > 0) rows.push({ row, classification, units, match });
  }

  if (!rows.length) return [];

  // 총세대수가 동별 표제부마다 반복된 공동주택은 최대값 한 번만 사용한다.
  const apartmentRows = rows.filter((item) => item.classification.apartment);
  if (apartmentRows.length > 1) {
    const values = apartmentRows.map((item) => item.units);
    const max = Math.max(...values);
    const min = Math.min(...values);
    if (max === min || max >= values.reduce((sum, value) => sum + value, 0) * 0.8) {
      const selected = apartmentRows.find((item) => item.units === max);
      return [selected, ...rows.filter((item) => !item.classification.apartment)];
    }
  }

  return rows;
}

function buildingAddressSimilarity(a, b) {
  const left = normalizedBuildingAddress(a);
  const right = normalizedBuildingAddress(b);
  if (!left || !right) return false;
  if (left === right) return true;

  const leftNumbers = left.match(/\d+(?:-\d+)?/g) || [];
  const rightNumbers = right.match(/\d+(?:-\d+)?/g) || [];
  return leftNumbers.some((value) => rightNumbers.includes(value));
}

function kaptMatchesTitleParcel(complex, matches) {
  const kaptAddress = cleanBuildingText(complex?.address);
  const kaptLocation = complex?.location;

  for (const match of matches || []) {
    const titleAddress = buildingRecordAddresses(match?.row || {}).preferredAddress;
    if (buildingAddressSimilarity(kaptAddress, titleAddress)) return true;
    if (
      kaptLocation && match?.location &&
      distanceMetersBetweenPoints(kaptLocation, match.location) <= 100
    ) return true;
  }

  return false;
}

function unitCandidateQuality(row) {
  let score = 0;
  if (unitHoName(row)) score += 4;
  if (unitDongName(row)) score += 2;
  if (unitUseText(row)) score += 4;
  const division = cleanBuildingText(
    row?.exposPubuseGbCdNm ?? row?.expos_pubuse_gb_cd_nm
  );
  if (/전유/.test(division)) score += 3;
  return score;
}

async function finalizeCombinedBuildingStats(env, prepared) {
  const orderedKaptMatches = [...(prepared.matchedKapt || [])].sort((a, b) => {
    const left = Number(a?.scopeDistanceMeters);
    const right = Number(b?.scopeDistanceMeters);
    const aDistance = Number.isFinite(left) ? left : Number.MAX_SAFE_INTEGER;
    const bDistance = Number.isFinite(right) ? right : Number.MAX_SAFE_INTEGER;
    return aDistance - bDistance;
  });
  const selectedKaptMatches = orderedKaptMatches.slice(
    0,
    KAPT_MAX_INFO_COMPLEXES_PER_REQUEST
  );
  const deferredKaptMatches = orderedKaptMatches.slice(
    KAPT_MAX_INFO_COMPLEXES_PER_REQUEST
  );

  const kaptInfoRows = await mapBuildingWithConcurrency(
    selectedKaptMatches,
    KAPT_INFO_CONCURRENCY,
    async (match) => {
      const info = await fetchKaptComplexInfo(env, match.list);
      if (!info) return null;
      return normalizedKaptInfo(info, match.location);
    }
  );

  const normalizedKapt = [];
  const kaptInfoFailures = deferredKaptMatches.map((match) => ({
    kaptCode: kaptCodeOf(match?.list) || null,
    name: kaptNameOf(match?.list) || null,
    diagnostics: {
      error: "deferred_by_subrequest_budget",
    },
  }));
  const seenKaptComplexes = new Set();
  for (const row of kaptInfoRows) {
    if (!row || Number(row.households) <= 0) {
      kaptInfoFailures.push({
        kaptCode: row?.kaptCode || row?.diagnostics?.kaptCode || null,
        name: row?.name || row?.diagnostics?.listName || null,
        diagnostics: row?.diagnostics || null,
      });
      continue;
    }
    const key = cleanBuildingText(row.kaptCode || row.key || row.address);
    if (!key || seenKaptComplexes.has(key)) continue;
    seenKaptComplexes.add(key);
    normalizedKapt.push(row);
  }

  const unitSource = await fetchMatchedBuildingUnitData(
    env,
    prepared.matchedBuildingRows,
    prepared.matchedKapt
  );
  const indexes = titleRowIndexes(prepared.matchedBuildingRows);

  const totals = {
    residentialUnitCount: 0,
    commercialUnitCount: 0,
    unclassifiedUnitCount: 0,
    deliveryUnitCount: 0,
    confirmedElevatorUnitCount: 0,
    inferredElevatorUnitCount: 0,
    noElevatorUnitCount: 0,
    unknownElevatorUnitCount: 0,
    residentialElevatorUnitCount: 0,
    residentialNoElevatorUnitCount: 0,
    residentialUnknownElevatorUnitCount: 0,
    commercialElevatorUnitCount: 0,
    commercialNoElevatorUnitCount: 0,
    commercialUnknownElevatorUnitCount: 0,
    passengerElevatorCount: 0,
    emergencyElevatorCount: 0,
    walkupBuildingCount: 0,
    walkupHouseholdCount: 0,
  };

  const residentialBuildings = new Set();
  const commercialBuildings = new Set();
  const mixedUseBuildings = new Set();
  const countedUnits = new Set();
  const contributorTotals = new Map();
  let commonAreaRecordCount = 0;
  let recapFallbackUnits = 0;
  let titleFallbackUnits = 0;
  let exclusiveUnits = 0;

  const unitDiagnostics = {
    matchedParcels: unitSource.parcels.length,
    areaRows: 0,
    exposRows: 0,
    recapRows: 0,
    housePriceRows: 0,
    candidateUnits: 0,
    parentlessCandidates: 0,
    parcelsWithExclusiveUnits: 0,
    parcelsWithRecapFallback: 0,
    parcelsWithHousePriceFallback: 0,
    parcelsWithTitleFallback: 0,
    kaptComplexes: normalizedKapt.length,
  };

  const registerContributor = (key, payload) => {
    const normalizedKey = cleanBuildingText(key);
    const units = Math.max(0, Math.trunc(Number(payload?.units) || 0));
    if (!normalizedKey || !units) return;

    const previous = contributorTotals.get(normalizedKey) || {
      key: normalizedKey,
      name: payload?.name || null,
      address: payload?.address || null,
      source: payload?.source || null,
      residential: 0,
      commercial: 0,
      unclassified: 0,
      total: 0,
    };

    const type = payload?.unitType;
    if (type === "residential") previous.residential += units;
    else if (type === "commercial") previous.commercial += units;
    else previous.unclassified += units;
    previous.total += units;
    contributorTotals.set(normalizedKey, previous);
  };

  const addCount = (unitType, units, buildingKey, elevator, contributor) => {
    const count = Math.max(0, Math.trunc(Number(units) || 0));
    if (!count) return;

    if (unitType === "residential") {
      totals.residentialUnitCount += count;
      residentialBuildings.add(buildingKey);
    } else if (unitType === "commercial") {
      totals.commercialUnitCount += count;
      commercialBuildings.add(buildingKey);
    } else {
      totals.unclassifiedUnitCount += count;
    }

    addUnitToElevatorTotals(totals, unitType, elevator.category, count);
    registerContributor(buildingKey, { ...contributor, units: count, unitType });

    if (
      elevator.category === "none" &&
      elevator.floors >= prepared.walkupMinGroundFloors
    ) {
      totals.walkupHouseholdCount += count;
      totals.walkupBuildingCount += 1;
    }
  };

  // K-APT에서 총세대수가 정상 확인된 단지만 먼저 집계한다.
  const kaptCoveredParcels = new Set();
  for (const complex of normalizedKapt) {
    const matchedParcelKeys = [];
    for (const parcelResult of unitSource.parcels) {
      const matches = parcelTitleMatches(parcelResult.parcel, indexes);
      if (kaptMatchesTitleParcel(complex, matches)) {
        matchedParcelKeys.push(parcelResult.parcel.key);
      }
    }

    for (const key of matchedParcelKeys) kaptCoveredParcels.add(key);

    const category = complex.elevatorKnown
      ? (complex.elevatorCount > 0 ? "confirmed" : "none")
      : complex.maxFloorCount >= BUILDING_INFER_ELEVATOR_MIN_FLOORS
        ? "inferred"
        : "unknown";

    const key = complex.key || `kapt:${complex.kaptCode}`;
    addCount(
      "residential",
      complex.households,
      key,
      {
        category,
        floors: complex.maxFloorCount,
        passenger: complex.elevatorCount,
        emergency: 0,
      },
      {
        source: "K_APT",
        name: complex.name || null,
        address: complex.address || null,
      }
    );
    totals.passengerElevatorCount += complex.elevatorCount;
  }

  for (const parcelResult of unitSource.parcels) {
    const parcelMatches = parcelTitleMatches(parcelResult.parcel, indexes);
    const parcelKey = parcelResult.parcel.key;
    const coveredByKapt = kaptCoveredParcels.has(parcelKey);

    unitDiagnostics.areaRows += (parcelResult.areaRows || []).length;
    unitDiagnostics.exposRows += (parcelResult.exposRows || []).length;
    unitDiagnostics.recapRows += (parcelResult.recapRows || []).length;
    unitDiagnostics.housePriceRows += (parcelResult.housePriceRows || []).length;

    const candidateMap = new Map();
    const mergeCandidate = (row, source) => {
      if (!row) return;
      if (isCommonAreaUnitRecord(row)) {
        commonAreaRecordCount += 1;
        return;
      }
      if (source === "area" && !isExclusiveAreaUnitRecord(row)) return;
      // 전유공용면적은 호명칭이 있어야 여러 면적행을 한 배송호로 합칠 수 있다.
      if (source === "area" && !unitHoName(row)) return;

      const key = unitRecordKey(row, parcelKey);
      if (!key) return;
      const previous = candidateMap.get(key);
      if (!previous || unitCandidateQuality(row) > unitCandidateQuality(previous.row)) {
        candidateMap.set(key, { key, row, source });
      }
    };

    for (const row of parcelResult.areaRows || []) mergeCandidate(row, "area");
    for (const row of parcelResult.exposRows || []) mergeCandidate(row, "expos");

    const unitCandidates = [...candidateMap.values()];
    unitDiagnostics.candidateUnits += unitCandidates.length;
    let countedOnParcel = 0;

    for (const candidate of unitCandidates) {
      if (!candidate.key || countedUnits.has(candidate.key)) continue;
      countedUnits.add(candidate.key);

      const parentMatch = findParentTitleMatch(
        candidate.row,
        parcelResult.parcel,
        indexes
      );
      const representativeMatch = parentMatch || parcelMatches[0] || null;
      if (!parentMatch) unitDiagnostics.parentlessCandidates += 1;

      const parentRow = representativeMatch?.row || null;
      const parentClassification = parentRow
        ? buildingHousingClassification(parentRow)
        : buildingHousingClassification(candidate.row);
      const unitType = classifyDeliveryUnit(candidate.row, parentClassification);

      if (coveredByKapt && unitType === "residential" && parentClassification.apartment) {
        continue;
      }

      const parentKey = parentRow
        ? (buildingRecordKey(parentRow) || parcelKey)
        : `${parcelKey}|${unitDongName(candidate.row) || "UNIT"}`;
      const elevator = parentRow
        ? buildingElevatorAvailability(parentRow, parentClassification)
        : { category: "unknown", floors: 0, passenger: 0, emergency: 0 };

      addCount(unitType, 1, parentKey, elevator, {
        source: candidate.source === "area"
          ? "BUILDING_HUB_EXCLUSIVE_AREA_UNIT"
          : "BUILDING_HUB_EXCLUSIVE_UNIT",
        name: cleanBuildingText(
          parentRow?.bldNm ?? parentRow?.bld_nm ??
          candidate.row?.bldNm ?? candidate.row?.bld_nm
        ) || null,
        address: parentRow
          ? buildingRecordAddresses(parentRow).preferredAddress || null
          : buildingRecordAddresses(candidate.row).preferredAddress || null,
      });
      countedOnParcel += 1;
      exclusiveUnits += 1;
    }

    if (countedOnParcel > 0) {
      unitDiagnostics.parcelsWithExclusiveUnits += 1;
      for (const match of parcelMatches) {
        const classification = buildingHousingClassification(match.row);
        const elevator = buildingElevatorAvailability(match.row, classification);
        totals.passengerElevatorCount += elevator.passenger;
        totals.emergencyElevatorCount += elevator.emergency;
      }
      continue;
    }


    // 일부 구축 집합건축물은 전유부 API가 비어도 주택가격 대장에는
    // 전유부 관리 PK가 남아 있다. 전유부/전유공용면적이 0건일 때만 사용한다.
    const housePriceUnitKeys = new Set();
    for (const row of parcelResult.housePriceRows || []) {
      const registerKind = cleanBuildingText(
        publicDataField(row, "regstrKindCdNm", "regstr_kind_cd_nm")
      );
      const ho = unitHoName(row);
      const pk = cleanBuildingText(
        publicDataField(row, "mgmBldrgstPk", "mgm_bldrgst_pk")
      );
      if (!pk) continue;
      if (!ho && !/전유/.test(registerKind)) continue;
      housePriceUnitKeys.add(pk);
    }

    if (housePriceUnitKeys.size > 0) {
      const representative = parcelMatches[0] || null;
      const parentRow = representative?.row || null;
      const classification = parentRow
        ? buildingHousingClassification(parentRow)
        : { residential: true, commercial: false, apartment: false };
      const unitType = classification.residential
        ? "residential"
        : classification.commercial
          ? "commercial"
          : "unclassified";
      const elevator = parentRow
        ? buildingElevatorAvailability(parentRow, classification)
        : { category: "unknown", floors: 0, passenger: 0, emergency: 0 };
      const units = housePriceUnitKeys.size;

      addCount(unitType, units, `house-price:${parcelKey}`, elevator, {
        source: "BUILDING_HUB_HOUSE_PRICE_UNIT",
        name: cleanBuildingText(parentRow?.bldNm ?? parentRow?.bld_nm) || null,
        address: parentRow
          ? buildingRecordAddresses(parentRow).preferredAddress || null
          : null,
      });
      unitDiagnostics.parcelsWithHousePriceFallback += 1;
      totals.passengerElevatorCount += elevator.passenger || 0;
      totals.emergencyElevatorCount += elevator.emergency || 0;
      continue;
    }

    const recap = bestRecapFallback(parcelResult.recapRows);
    if (recap && !(coveredByKapt && recap.classification.apartment)) {
      const titleForElevator = parcelMatches.find((match) => {
        const classification = buildingHousingClassification(match.row);
        return classification.housingType === recap.classification.housingType;
      }) || parcelMatches[0];
      const elevator = titleForElevator
        ? buildingElevatorAvailability(titleForElevator.row, recap.classification)
        : { category: "unknown", floors: 0, passenger: 0, emergency: 0 };
      const unitType = recap.classification.residential
        ? "residential"
        : recap.classification.commercial
          ? "commercial"
          : "unclassified";

      addCount(unitType, recap.units, `recap:${parcelKey}`, elevator, {
        source: "BUILDING_HUB_RECAP_TITLE",
        name: cleanBuildingText(recap.row?.bldNm ?? recap.row?.bld_nm) || null,
        address: buildingRecordAddresses(recap.row).preferredAddress || null,
      });
      recapFallbackUnits += recap.units;
      unitDiagnostics.parcelsWithRecapFallback += 1;
      totals.passengerElevatorCount += elevator.passenger || 0;
      totals.emergencyElevatorCount += elevator.emergency || 0;
      continue;
    }

    let parcelTitleUnits = 0;
    for (const fallback of titleParcelFallback(parcelMatches)) {
      if (coveredByKapt && fallback.classification.apartment) continue;
      const unitType = fallback.classification.residential
        ? "residential"
        : fallback.classification.commercial
          ? "commercial"
          : "unclassified";
      const key = buildingRecordKey(fallback.row) || parcelKey;
      const elevator = buildingElevatorAvailability(
        fallback.row,
        fallback.classification
      );

      addCount(unitType, fallback.units, key, elevator, {
        source: "BUILDING_HUB_TITLE_FALLBACK",
        name: cleanBuildingText(fallback.row?.bldNm ?? fallback.row?.bld_nm) || null,
        address: buildingRecordAddresses(fallback.row).preferredAddress || null,
      });
      parcelTitleUnits += fallback.units;
      titleFallbackUnits += fallback.units;
      totals.passengerElevatorCount += elevator.passenger;
      totals.emergencyElevatorCount += elevator.emergency;
    }
    if (parcelTitleUnits > 0) unitDiagnostics.parcelsWithTitleFallback += 1;
  }

  for (const key of residentialBuildings) {
    if (commercialBuildings.has(key)) mixedUseBuildings.add(key);
  }

  totals.deliveryUnitCount =
    totals.residentialUnitCount +
    totals.commercialUnitCount +
    totals.unclassifiedUnitCount;

  const topContributors = [...contributorTotals.values()]
    .sort((a, b) => b.total - a.total)
    .slice(0, 100);
  const kaptHouseholds = normalizedKapt.reduce((sum, row) => sum + row.households, 0);

  return {
    householdCount: totals.residentialUnitCount,
    apartmentHouseholdCount: kaptHouseholds,
    nonApartmentHouseholdCount: Math.max(0, totals.residentialUnitCount - kaptHouseholds),
    unknownHouseholdCount: 0,
    residentialUnitCount: totals.residentialUnitCount,
    commercialUnitCount: totals.commercialUnitCount,
    unclassifiedUnitCount: totals.unclassifiedUnitCount,
    deliveryUnitCount: totals.deliveryUnitCount,
    residentialBuildingUnitCount: residentialBuildings.size,
    commercialBuildingUnitCount: commercialBuildings.size,
    mixedUseBuildingCount: mixedUseBuildings.size,
    exclusiveUnitRecordCount: countedUnits.size,
    commonAreaRecordCount,
    confirmedElevatorUnitCount: totals.confirmedElevatorUnitCount,
    inferredElevatorUnitCount: totals.inferredElevatorUnitCount,
    noElevatorUnitCount: totals.noElevatorUnitCount,
    unknownElevatorUnitCount: totals.unknownElevatorUnitCount,
    residentialElevatorUnitCount: totals.residentialElevatorUnitCount,
    residentialNoElevatorUnitCount: totals.residentialNoElevatorUnitCount,
    residentialUnknownElevatorUnitCount: totals.residentialUnknownElevatorUnitCount,
    commercialElevatorUnitCount: totals.commercialElevatorUnitCount,
    commercialNoElevatorUnitCount: totals.commercialNoElevatorUnitCount,
    commercialUnknownElevatorUnitCount: totals.commercialUnknownElevatorUnitCount,
    sourceRecordCount: prepared.sourceRecordCount,
    matchedBuildingCount: prepared.matchedBuildingRows.length + normalizedKapt.length,
    residentialBuildingCount: residentialBuildings.size,
    geocodedBuildingCount: prepared.geocodedBuildingCount,
    unlocatedBuildingCount: prepared.unlocatedBuildingCount,
    coveragePercent: prepared.coveragePercent,
    elevatorBuildingCount: residentialBuildings.size + commercialBuildings.size,
    noElevatorBuildingCount: totals.walkupBuildingCount,
    unknownElevatorBuildingCount: 0,
    elevatorHouseholdCount:
      totals.confirmedElevatorUnitCount + totals.inferredElevatorUnitCount,
    noElevatorHouseholdCount: totals.noElevatorUnitCount,
    unknownElevatorHouseholdCount: totals.unknownElevatorUnitCount,
    passengerElevatorCount: totals.passengerElevatorCount,
    emergencyElevatorCount: totals.emergencyElevatorCount,
    walkupBuildingCount: totals.walkupBuildingCount,
    walkupHouseholdCount: totals.walkupHouseholdCount,
    unitSourceComplete: unitSource.complete && kaptInfoFailures.length === 0,
    unitSourceWarnings: [
      ...unitSource.warnings,
      ...kaptInfoFailures.map((row) =>
        `K_APT_INFO_EMPTY: ${row.kaptCode || row.name || "unknown"}`
      ),
    ],
    breakdown: {
      algorithm: {
        version: BUILDING_STATS_SOURCE_VERSION,
        parcelIdentityRequired: true,
        polygonInsideWins: true,
        scope: prepared.scopeMatchDiagnostics,
      },
      deliveryUnits: {
        residential: totals.residentialUnitCount,
        commercial: totals.commercialUnitCount,
        unclassified: totals.unclassifiedUnitCount,
        total: totals.deliveryUnitCount,
        exclusiveUnitRows: exclusiveUnits,
        recapFallbackUnits,
        titleFallbackUnits,
      },
      kapt: {
        requestedComplexCount: prepared.matchedKapt.length,
        complexCount: normalizedKapt.length,
        failedComplexCount: kaptInfoFailures.length,
        householdCount: kaptHouseholds,
        failures: kaptInfoFailures,
        complexes: normalizedKapt.map((row) => ({
          kaptCode: row.kaptCode || null,
          name: row.name || null,
          address: row.address || null,
          households: row.households || 0,
          householdsSource: row.householdsSource || null,
          elevatorCount: row.elevatorCount || 0,
          diagnostics: row.diagnostics || null,
        })),
      },
      source: {
        matchedParcels: unitSource.parcels.length,
        unitSourceComplete: unitSource.complete,
        warnings: unitSource.warnings,
        unitDiagnostics,
        parcelQueries: unitSource.parcels.map((parcelResult) => ({
          parcelKey: parcelResult.parcel?.key || null,
          areaRows: (parcelResult.areaRows || []).length,
          exposRows: (parcelResult.exposRows || []).length,
          recapRows: (parcelResult.recapRows || []).length,
          housePriceRows: (parcelResult.housePriceRows || []).length,
          queries: parcelResult.queryDiagnostics || null,
        })),
      },
      topContributors,
    },
  };
}



function titleFallbackIdentity(row, index = 0) {
  const managementKey = cleanBuildingText(
    row?.mgmBldrgstPk ?? row?.mgm_bldrgst_pk
  );
  if (managementKey) return `mgm:${managementKey}`;

  const parcel = buildingParcelDescriptor(row);
  const dong = normalizeDeliveryUnitName(row?.dongNm ?? row?.dong_nm ?? "");
  const name = normalizeDeliveryUnitName(row?.bldNm ?? row?.bld_nm ?? "");
  return [
    parcel?.key || "NO_PARCEL",
    dong || name || `ROW_${index}`,
  ].join("|");
}

function titleFallbackParcelKey(row, index = 0) {
  const parcel = buildingParcelDescriptor(row);
  return parcel?.key || `record:${titleFallbackIdentity(row, index)}`;
}

function titleFallbackUnitType(classification) {
  if (classification?.residential) return "residential";
  if (classification?.commercial) return "commercial";
  return "unclassified";
}

function buildTitleBaselineFallbackAggregate(prepared) {
  const matches = Array.isArray(prepared?.matchedBuildingRows)
    ? prepared.matchedBuildingRows
    : [];

  const parcelGroups = new Map();
  matches.forEach((match, index) => {
    const row = match?.row;
    if (!row || isAncillaryBuildingRecord(row)) return;
    const key = titleFallbackParcelKey(row, index);
    if (!parcelGroups.has(key)) parcelGroups.set(key, []);
    parcelGroups.get(key).push({ match, row, index });
  });

  const totals = {
    residentialUnitCount: 0,
    commercialUnitCount: 0,
    unclassifiedUnitCount: 0,
    confirmedElevatorUnitCount: 0,
    inferredElevatorUnitCount: 0,
    noElevatorUnitCount: 0,
    unknownElevatorUnitCount: 0,
    residentialElevatorUnitCount: 0,
    residentialNoElevatorUnitCount: 0,
    residentialUnknownElevatorUnitCount: 0,
    commercialElevatorUnitCount: 0,
    commercialNoElevatorUnitCount: 0,
    commercialUnknownElevatorUnitCount: 0,
    passengerElevatorCount: 0,
    emergencyElevatorCount: 0,
    walkupBuildingCount: 0,
    walkupHouseholdCount: 0,
  };

  const residentialBuildings = new Set();
  const commercialBuildings = new Set();
  const mixedUseBuildings = new Set();
  const countedBuildings = new Set();
  const contributors = [];

  const add = (unitType, units, row, buildingKey, source) => {
    const count = Math.max(0, Math.trunc(Number(units) || 0));
    if (!count) return;

    const classification = buildingHousingClassification(row);
    const elevator = buildingElevatorAvailability(row, classification);

    if (unitType === "residential") {
      totals.residentialUnitCount += count;
      residentialBuildings.add(buildingKey);
    } else if (unitType === "commercial") {
      totals.commercialUnitCount += count;
      commercialBuildings.add(buildingKey);
    } else {
      totals.unclassifiedUnitCount += count;
    }

    addUnitToElevatorTotals(totals, unitType, elevator.category, count);

    if (
      elevator.category === "none" &&
      elevator.floors >= Number(prepared?.walkupMinGroundFloors || 3)
    ) {
      totals.walkupBuildingCount += 1;
      totals.walkupHouseholdCount += count;
    }

    if (!countedBuildings.has(buildingKey)) {
      countedBuildings.add(buildingKey);
      totals.passengerElevatorCount += elevator.passenger || 0;
      totals.emergencyElevatorCount += elevator.emergency || 0;
    }

    contributors.push({
      key: buildingKey,
      name: cleanBuildingText(row?.bldNm ?? row?.bld_nm) || null,
      address: buildingRecordAddresses(row).preferredAddress || null,
      source,
      unitType,
      units: count,
      rawCounts: {
        hhldCnt: nonNegativeBuildingInteger(row?.hhldCnt ?? row?.hhld_cnt),
        fmlyCnt: nonNegativeBuildingInteger(row?.fmlyCnt ?? row?.fmly_cnt),
        hoCnt: nonNegativeBuildingInteger(row?.hoCnt ?? row?.ho_cnt),
        floors: buildingGroundFloorCount(row),
      },
    });
  };

  for (const [parcelKey, items] of parcelGroups) {
    const unique = [];
    const seen = new Set();

    for (const item of items) {
      const identity = titleFallbackIdentity(item.row, item.index);
      if (seen.has(identity)) continue;
      seen.add(identity);
      unique.push({ ...item, identity });
    }

    const apartmentRows = [];
    const otherRows = [];

    for (const item of unique) {
      const classification = buildingHousingClassification(item.row);
      const units = buildingTitleUnitFallback(item.row, classification);
      const record = { ...item, classification, units };
      if (classification.apartment) apartmentRows.push(record);
      else otherRows.push(record);
    }

    if (apartmentRows.length) {
      const positive = apartmentRows.filter((item) => item.units > 0);
      if (positive.length) {
        const values = positive.map((item) => item.units);
        const maxValue = Math.max(...values);
        const sumValue = values.reduce((sum, value) => sum + value, 0);
        const valueFrequency = new Map();
        values.forEach((value) => valueFrequency.set(value, (valueFrequency.get(value) || 0) + 1));
        const repeatedTotal = [...valueFrequency.values()].some((count) => count > 1);

        // 아파트 총세대수가 동별 표제부마다 반복되는 경우는 최대값 한 번만 사용한다.
        // 동별 세대수가 실제로 서로 다르고 총합형으로 보이면 합산한다.
        if (repeatedTotal || maxValue >= sumValue * 0.6) {
          const selected = positive.find((item) => item.units === maxValue) || positive[0];
          add("residential", maxValue, selected.row, `${parcelKey}|APARTMENT_TOTAL`, "TITLE_BASELINE_MAX");
        } else {
          for (const item of positive) {
            add("residential", item.units, item.row, item.identity, "TITLE_BASELINE_SUM");
          }
        }
      }
    }

    for (const item of otherRows) {
      if (item.units <= 0) continue;
      add(
        titleFallbackUnitType(item.classification),
        item.units,
        item.row,
        item.identity,
        "TITLE_BASELINE"
      );
    }
  }

  for (const key of residentialBuildings) {
    if (commercialBuildings.has(key)) mixedUseBuildings.add(key);
  }

  const deliveryUnitCount =
    totals.residentialUnitCount +
    totals.commercialUnitCount +
    totals.unclassifiedUnitCount;

  return {
    householdCount: totals.residentialUnitCount,
    apartmentHouseholdCount: totals.residentialUnitCount,
    nonApartmentHouseholdCount: 0,
    unknownHouseholdCount: 0,
    residentialUnitCount: totals.residentialUnitCount,
    commercialUnitCount: totals.commercialUnitCount,
    unclassifiedUnitCount: totals.unclassifiedUnitCount,
    deliveryUnitCount,
    residentialBuildingUnitCount: residentialBuildings.size,
    commercialBuildingUnitCount: commercialBuildings.size,
    mixedUseBuildingCount: mixedUseBuildings.size,
    exclusiveUnitRecordCount: 0,
    commonAreaRecordCount: 0,
    confirmedElevatorUnitCount: totals.confirmedElevatorUnitCount,
    inferredElevatorUnitCount: totals.inferredElevatorUnitCount,
    noElevatorUnitCount: totals.noElevatorUnitCount,
    unknownElevatorUnitCount: totals.unknownElevatorUnitCount,
    residentialElevatorUnitCount: totals.residentialElevatorUnitCount,
    residentialNoElevatorUnitCount: totals.residentialNoElevatorUnitCount,
    residentialUnknownElevatorUnitCount: totals.residentialUnknownElevatorUnitCount,
    commercialElevatorUnitCount: totals.commercialElevatorUnitCount,
    commercialNoElevatorUnitCount: totals.commercialNoElevatorUnitCount,
    commercialUnknownElevatorUnitCount: totals.commercialUnknownElevatorUnitCount,
    sourceRecordCount: Number(prepared?.sourceRecordCount || matches.length),
    matchedBuildingCount: matches.length,
    residentialBuildingCount: residentialBuildings.size,
    geocodedBuildingCount: Number(prepared?.geocodedBuildingCount || 0),
    unlocatedBuildingCount: Number(prepared?.unlocatedBuildingCount || 0),
    coveragePercent: Number(prepared?.coveragePercent || 0),
    elevatorBuildingCount: residentialBuildings.size + commercialBuildings.size,
    noElevatorBuildingCount: totals.walkupBuildingCount,
    unknownElevatorBuildingCount: 0,
    elevatorHouseholdCount:
      totals.confirmedElevatorUnitCount + totals.inferredElevatorUnitCount,
    noElevatorHouseholdCount: totals.noElevatorUnitCount,
    unknownElevatorHouseholdCount: totals.unknownElevatorUnitCount,
    passengerElevatorCount: totals.passengerElevatorCount,
    emergencyElevatorCount: totals.emergencyElevatorCount,
    walkupBuildingCount: totals.walkupBuildingCount,
    walkupHouseholdCount: totals.walkupHouseholdCount,
    unitSourceComplete: false,
    unitSourceWarnings: ["TITLE_BASELINE_FALLBACK_APPLIED"],
    breakdown: {
      titleBaselineFallback: {
        parcelCount: parcelGroups.size,
        matchedTitleRowCount: matches.length,
        contributorCount: contributors.length,
        contributors: contributors
          .sort((a, b) => b.units - a.units)
          .slice(0, 100),
      },
    },
  };
}

function nextBuildingStatsExpiry() {
  const date = new Date();
  date.setUTCFullYear(
    date.getUTCFullYear() + BUILDING_STATS_CACHE_YEARS
  );
  return date.toISOString();
}

