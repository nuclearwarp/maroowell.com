async function api(path,body,retry=true){
 const {data,error:e}=await supa.auth.getSession();if(e||!data?.session?.access_token)throw new Error('LOGIN_REQUIRED');
 const r=await fetch(API+path,{method:body===undefined?'GET':'POST',headers:{Authorization:`Bearer ${data.session.access_token}`,...(body===undefined?{}:{'Content-Type':'application/json'})},body:body===undefined?undefined:JSON.stringify(body),cache:'no-store',signal:AbortSignal.timeout(60000)});
 if(r.status===401&&retry){const {error:refreshError}=await supa.auth.refreshSession();if(!refreshError)return api(path,body,false);}
 const j=await r.json().catch(()=>null);if(!r.ok)throw new Error(j?.error||`HTTP ${r.status}`);return j;
}
