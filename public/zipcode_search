async function handleBuildingStatsRequest(request, env) {
  await verifySupabaseUserByJwt(request, env);

  const body = await readJsonBody(request);
  const scope = normalizeBuildingStatsScope(body);
  const normalized = normalizeTerrainGeometry(
    body?.geometry || body?.polygon || body?.geojson
  );
  const geometryHash = await terrainGeometryHash(normalized);
  const polygonAreaM2 = calculateTerrainPolygonAreaM2(normalized.geometry);

  if (polygonAreaM2 == null) {
    throw httpError(400, "Failed to calculate polygon area");
  }

  const forceRefresh = body?.forceRefresh === true || body?.force_refresh === true;
  const cachedRow = await fetchBuildingStatsCache(env, scope.scopeType, scope.scopeKey);

  if (isBuildingStatsCacheFresh(cachedRow, geometryHash, forceRefresh)) {
    const legacyCache =
      String(cachedRow?.source_version || "") !== BUILDING_STATS_SOURCE_VERSION;

    return jsonResp({
      ok: true,
      cached: true,
      stale: false,
      legacyCache,
      needsRefresh: legacyCache,
      requiresGeocoding: false,
      scopeType: scope.scopeType,
      scopeKey: scope.scopeKey,
      geometryHash,
      buildingStats: buildingStatsRowToResponse(cachedRow),
    });
  }

  try {
    const rawScopeParcels = body?.scopeParcels ?? body?.scope_parcels ?? [];
    const verifiedScopeParcels = normalizeVerifiedScopeParcels(
      rawScopeParcels,
      normalized.geometry,
      scope.zipcode
    );

    // 폴리곤 내부 역지오코딩에서 직접 확인한 법정동코드를 최우선으로 사용한다.
    // 기존 샘플링 후보가 인접 법정동을 포함해도 실제 필지 법정동은 절대 잘리지 않는다.
    const requestedLegalDongCodes = normalizeLegalDongCodes(body);
    const scopeLegalDongCodes = [...verifiedScopeParcels.map.keys()]
      .map((key) => {
        const [sigunguCd, bjdongCd] = String(key).split("|");
        const legalDongCode = `${sigunguCd || ""}${bjdongCd || ""}`;
        return /^\d{10}$/.test(legalDongCode)
          ? {
              legalDongCode,
              sigunguCd,
              bjdongCd,
              likelyLegalDong: true,
              source: "SCOPE_PARCEL",
            }
          : null;
      })
      .filter(Boolean);

    const legalDongCodeMap = new Map();
    for (const row of [...scopeLegalDongCodes, ...requestedLegalDongCodes]) {
      if (!row?.legalDongCode || legalDongCodeMap.has(row.legalDongCode)) continue;
      legalDongCodeMap.set(row.legalDongCode, row);
      if (legalDongCodeMap.size >= BUILDING_HUB_MAX_LEGAL_DONG_CODES) break;
    }
    const legalDongCodes = [...legalDongCodeMap.values()];

    if (!legalDongCodes.length) {
      throw httpError(400, "legalDongCodes or verified scope parcels are required for uncached building statistics");
    }

    // 우편번호 분석은 법정동 전체를 주소검색해 잘라내지 않는다.
    // 프론트가 폴리곤 내부 표본을 역지오코딩해 실제 필지목록을 먼저 보내도록 한다.
    if (scope.zipcode && verifiedScopeParcels.map.size === 0) {
      return jsonResp({
        ok: true,
        cached: false,
        stale: false,
        requiresScopeDiscovery: true,
        requiresGeocoding: false,
        scopeType: scope.scopeType,
        scopeKey: scope.scopeKey,
        geometryHash,
        polygonAreaM2,
        legalDongCodes: legalDongCodes.map((row) => row.legalDongCode),
        message: "폴리곤 내부 필지 역지오코딩이 필요합니다.",
      });
    }

    // 한 공공데이터 서비스의 지연이 전체 요청을 500으로 끝내지 않도록 독립 처리한다.
    // 두 원천 중 하나라도 성공하면 임시 분석은 계속하되, 둘 다 성공한 경우에만 1년 캐시한다.
    const buildingHubQueryDiagnostics = [];
    const [buildingSourceResult, kaptSourceResult] = await Promise.allSettled([
      fetchBuildingHubRecords(env, legalDongCodes, buildingHubQueryDiagnostics),
      fetchKaptComplexes(env, legalDongCodes),
    ]);

    const buildingSourceOk = buildingSourceResult.status === "fulfilled";
    const kaptSourceOk = kaptSourceResult.status === "fulfilled";

    if (!buildingSourceOk && !kaptSourceOk) {
      const error = httpError(
        Number(buildingSourceResult.reason?.status || kaptSourceResult.reason?.status || 502),
        `Building data sources failed: BUILDING_HUB=${String(buildingSourceResult.reason?.message || buildingSourceResult.reason || "unknown")}; K_APT=${String(kaptSourceResult.reason?.message || kaptSourceResult.reason || "unknown")}`
      );
      error.diagnostics = {
        legalDongCodes,
        buildingHubQueries: buildingHubQueryDiagnostics,
        buildingHubError: buildingSourceResult.reason?.publicDataGateway || null,
        kaptError: kaptSourceResult.reason?.publicDataGateway || null,
      };
      throw error;
    }

    const allBuildingRecords = buildingSourceOk ? buildingSourceResult.value : [];
    let kaptComplexes = kaptSourceOk ? kaptSourceResult.value : [];
    const sourceWarnings = [];

    if (!buildingSourceOk) {
      sourceWarnings.push(`BUILDING_HUB: ${String(buildingSourceResult.reason || "unavailable")}`);
    }
    if (!kaptSourceOk) {
      sourceWarnings.push(`K_APT: ${String(kaptSourceResult.reason || "unavailable")}`);
    }

    if (allBuildingRecords.length === 0 && kaptComplexes.length === 0) {
      return jsonResp({
        ok: false,
        code: "PUBLIC_DATA_ZERO_ROWS_FOR_LEGAL_DONG",
        error: "공공데이터 원천 조회가 0건입니다. 폴리곤 매칭 전 단계에서 법정동 코드 또는 공공데이터 API가 응답하지 않았습니다.",
        scopeType: scope.scopeType,
        scopeKey: scope.scopeKey,
        geometryHash,
        diagnostics: {
          legalDongCodes,
          buildingHubQueries: buildingHubQueryDiagnostics,
          sourceWarnings,
        },
      }, 424);
    }

    // 법정동 목록이 0건이면 같은 시군구 목록에서 건축물대장 아파트명/지번과
    // 일치하는 단지만 좁혀서 다시 찾는다. 전체 시군구 결과를 그대로 넣지 않는다.
    if (buildingSourceOk && kaptSourceOk && kaptComplexes.length === 0) {
      try {
        const fallback = await fetchKaptComplexesWithFallback(
          env,
          legalDongCodes,
          allBuildingRecords
        );
        kaptComplexes = fallback.rows;
        sourceWarnings.push(
          `K_APT_LIST_FALLBACK: ${fallback.mode} / candidates ${fallback.fallbackCount} / matched ${fallback.rows.length}`
        );
      } catch (fallbackError) {
        sourceWarnings.push(
          `K_APT_LIST_FALLBACK_FAILED: ${String(fallbackError?.message || fallbackError)}`
        );
      }
    }

    const buildingRecords = allBuildingRecords.filter(isRelevantBuildingHubRecord);
    const parcelGroups = buildBuildingParcelGroupsV11(buildingRecords);
    const locationInput = body?.buildingLocations ?? body?.building_locations ?? null;
    const locationIndex = buildBuildingLocationIndex(locationInput);

    const allTargets = dedupeBuildingStatsGeocodingTargets([
      ...parcelGroups.map(buildingParcelGeocodingTargetV13),
      ...kaptComplexes.map(kaptGeocodingTarget),
    ]);

    if (allTargets.length > BUILDING_STATS_MAX_GEOCODING_TARGETS) {
      throw httpError(
        413,
        `Geocoding targets exceed ${BUILDING_STATS_MAX_GEOCODING_TARGETS}; narrow legalDongCodes`
      );
    }

    if (locationIndex.size === 0) {
      return jsonResp({
        ok: true,
        cached: false,
        stale: false,
        requiresGeocoding: true,
        scopeType: scope.scopeType,
        scopeKey: scope.scopeKey,
        geometryHash,
        polygonAreaM2,
        sourceRecordCount: allTargets.length,
        legalDongCodes: legalDongCodes.map((row) => row.legalDongCode),
        geocodingTargets: allTargets,
      });
    }

    const walkupMinGroundFloors = Math.max(
      1,
      Math.min(
        100,
        Math.trunc(Number(
          body?.walkupMinGroundFloors ??
          body?.walkup_min_ground_floors ??
          3
        ) || 3)
      )
    );

    const prepared = aggregateCombinedBuildingStats({
      buildingRecords,
      kaptComplexes,
      geometry: normalized.geometry,
      locationIndex,
      walkupMinGroundFloors,
      scopeZipcode: scope.zipcode,
      verifiedScopeParcels,
    });

    if (verifiedScopeParcels.map.size > 0) {
      sourceWarnings.push(
        `SCOPE_PARCEL_DISCOVERY: received ${verifiedScopeParcels.diagnostics.received} / accepted ${verifiedScopeParcels.diagnostics.accepted} / matched building parcels ${prepared.scopeMatchDiagnostics.matchedScopeParcelCount}`
      );
    }

    const requestedCoverage = Number(
      body?.minCoveragePercent ??
      body?.min_coverage_percent ??
      BUILDING_STATS_DEFAULT_MIN_COVERAGE_PERCENT
    );
    const minCoveragePercent = Number.isFinite(requestedCoverage)
      ? Math.max(0, Math.min(100, requestedCoverage))
      : BUILDING_STATS_DEFAULT_MIN_COVERAGE_PERCENT;

    const allowPartial = (
      body?.allowPartial === true ||
      body?.allow_partial === true
    );

    if (
      prepared.coveragePercent < minCoveragePercent &&
      !allowPartial
    ) {
      const remaining = prepared.missingGeocodingTargets
        .slice(0, BUILDING_STATS_MAX_GEOCODING_TARGETS);

      return jsonResp({
        ok: true,
        cached: false,
        stale: false,
        requiresGeocoding: true,
        partial: true,
        scopeType: scope.scopeType,
        scopeKey: scope.scopeKey,
        geometryHash,
        polygonAreaM2,
        sourceRecordCount: prepared.sourceRecordCount,
        geocodedBuildingCount: prepared.geocodedBuildingCount,
        unlocatedBuildingCount: prepared.unlocatedBuildingCount,
        coveragePercent: Math.round(prepared.coveragePercent * 100) / 100,
        requiredCoveragePercent: minCoveragePercent,
        geocodingTargets: remaining,
      });
    }

    let aggregate = await finalizeCombinedBuildingStats(env, prepared);
    let titleBaselineFallbackApplied = false;

    if (Number(aggregate?.deliveryUnitCount || 0) <= 0) {
      const titleBaseline = buildTitleBaselineFallbackAggregate(prepared);
      if (Number(titleBaseline.deliveryUnitCount || 0) > 0) {
        aggregate = {
          ...aggregate,
          ...titleBaseline,
          unitSourceComplete: false,
          unitSourceWarnings: [
            ...(Array.isArray(aggregate?.unitSourceWarnings)
              ? aggregate.unitSourceWarnings
              : []),
            ...(Array.isArray(titleBaseline.unitSourceWarnings)
              ? titleBaseline.unitSourceWarnings
              : []),
          ],
          breakdown: {
            ...(aggregate?.breakdown || {}),
            ...(titleBaseline.breakdown || {}),
          },
        };
        titleBaselineFallbackApplied = true;
      }
    }

    if (Array.isArray(aggregate.unitSourceWarnings)) {
      sourceWarnings.push(...aggregate.unitSourceWarnings);
    }
    if (titleBaselineFallbackApplied) {
      sourceWarnings.push("BUILDING_UNITS: 전유부/총괄표제부 결과가 0이어서 표제부 세대·가구·호수 기준으로 복구했습니다.");
    }

    const coverageComplete =
      prepared.coveragePercent >= minCoveragePercent;

    if (!coverageComplete) {
      sourceWarnings.push(
        `BUILDING_LOCATION: ${prepared.coveragePercent.toFixed(1)}% / required ${minCoveragePercent.toFixed(1)}%`
      );
    }

    const suspiciousZero =
      aggregate.deliveryUnitCount === 0 &&
      (
        prepared.matchedBuildingRows.length > 0 ||
        prepared.matchedKapt.length > 0 ||
        prepared.scopeMatchDiagnostics?.matchedParcels > 0
      );

    if (suspiciousZero) {
      return jsonResp({
        ok: false,
        error: "건물은 매칭됐지만 배송호수를 계산하지 못했습니다. 0호 결과는 저장하지 않습니다.",
        code: "BUILDING_UNITS_ZERO_WITH_MATCHED_PARCELS",
        scopeType: scope.scopeType,
        scopeKey: scope.scopeKey,
        geometryHash,
        diagnostics: {
          matchedBuildingRows: prepared.matchedBuildingRows.length,
          matchedKapt: prepared.matchedKapt.length,
          scope: prepared.scopeMatchDiagnostics,
          breakdown: aggregate.breakdown,
          titleRowSamples: prepared.matchedBuildingRows
            .slice(0, 30)
            .map((match, index) => {
              const row = match?.row || {};
              const classification = buildingHousingClassification(row);
              return {
                index,
                key: buildingRecordKey(row),
                parcel: buildingParcelDescriptor(row)?.key || null,
                buildingName: cleanBuildingText(row?.bldNm ?? row?.bld_nm) || null,
                dongName: cleanBuildingText(row?.dongNm ?? row?.dong_nm) || null,
                purpose: classification.purpose || null,
                hhldCnt: nonNegativeBuildingInteger(row?.hhldCnt ?? row?.hhld_cnt),
                fmlyCnt: nonNegativeBuildingInteger(row?.fmlyCnt ?? row?.fmly_cnt),
                hoCnt: nonNegativeBuildingInteger(row?.hoCnt ?? row?.ho_cnt),
                floors: buildingGroundFloorCount(row),
              };
            }),
          sourceWarnings,
          legalDongCodes,
          buildingHubQueries: buildingHubQueryDiagnostics,
        },
      }, 422);
    }

    const completeSources =
      buildingSourceOk &&
      kaptSourceOk &&
      aggregate.unitSourceComplete === true &&
      coverageComplete &&
      !titleBaselineFallbackApplied &&
      !suspiciousZero;
    const sourceMode = completeSources
      ? "BUILDING_HUB+K_APT+EXPOS"
      : (buildingSourceOk ? "BUILDING_HUB_PARTIAL" : "K_APT_FALLBACK");

    const row = buildingStatsDatabaseRow({
      scope,
      geometryHash,
      polygonAreaM2,
      aggregate,
      records: buildingRecords,
      walkupMinGroundFloors,
      locationSource:
        cleanBuildingText(body?.locationSource ?? body?.location_source) ||
        "KAKAO_JS_GEOCODER",
      sourceMode,
      sourceVersion: completeSources
        ? BUILDING_STATS_SOURCE_VERSION
        : `${BUILDING_STATS_SOURCE_VERSION}_PROVISIONAL`,
      sourceWarnings,
    });

    // 원천 두 개가 모두 정상인 결과만 1년 캐시한다.
    // 한쪽이 장애인 임시 결과를 저장하면 잘못된 세대수가 1년간 고정될 수 있다.
    if (!completeSources) {
      return jsonResp({
        ok: true,
        cached: false,
        stale: false,
        provisional: true,
        requiresGeocoding: false,
        partial: true,
        warning: sourceWarnings.join(" | ") || "일부 건물 주소가 확인되지 않아 잠정 결과로 표시합니다.",
        retryable: true,
        retryAfterMs: 3000,
        scopeType: scope.scopeType,
        scopeKey: scope.scopeKey,
        geometryHash,
        buildingStats: buildingStatsRowToResponse(row),
      });
    }

    const savedRow = await upsertBuildingStatsCache(env, row);

    return jsonResp({
      ok: true,
      cached: false,
      stale: false,
      requiresGeocoding: false,
      partial: false,
      scopeType: scope.scopeType,
      scopeKey: scope.scopeKey,
      geometryHash,
      buildingStats:
        buildingStatsRowToResponse(savedRow) ||
        buildingStatsRowToResponse(row),
    });
  } catch (error) {
    // 수동 갱신 또는 새 알고리즘 계산이 실패해도 기존 정상 분석값은 지우지 않는다.
    // 폴리곤이 같고 0호가 아닌 캐시라면 버전/만료 여부와 무관하게 stale 값으로 반환한다.
    const reusableCache = isUsableBuildingStatsCache(
      cachedRow,
      geometryHash,
      { allowExpired: true }
    );

    if (reusableCache) {
      await markBuildingStatsRefreshError(env, cachedRow, error);
      return jsonResp({
        ok: true,
        cached: true,
        stale: true,
        legacyCache:
          String(cachedRow?.source_version || "") !== BUILDING_STATS_SOURCE_VERSION,
        needsRefresh: true,
        requiresGeocoding: false,
        warning: String(error?.message || error || "Building statistics refresh failed"),
        scopeType: scope.scopeType,
        scopeKey: scope.scopeKey,
        geometryHash,
        buildingStats: buildingStatsRowToResponse(cachedRow),
      });
    }

    throw error;
  }
}


async function handleZipBoundaryRequest(url) {
  const zipcode = (url.searchParams.get("zipcode") || "").trim();
  const debug = url.searchParams.get("debug") === "1";

  if (!/^\d{5}$/.test(zipcode)) {
    return jsonResp(
      { error: "유효한 5자리 zipcode 쿼리 파라미터가 필요함" },
      400
    );
  }

  const upstream = await fetchFromJuso(zipcode, debug);

  if (!upstream.ok) {
    return jsonResp(
      {
        error: "주소정보 API 호출 실패",
        zipcode,
        status: upstream.status || 0,
        attemptCount: upstream.attemptCount || 0,
        variant: upstream.variant || null,
        detail: upstream.detail || "",
        responseSnippet: upstream.responseSnippet || "",
        sessionStatus: upstream.sessionStatus || 0,
        hasCookie: !!upstream.hasCookie,
      },
      502
    );
  }

  const data = upstream.data;

  if (!data?.results || !Array.isArray(data.results.content)) {
    return jsonResp(
      {
        error: "응답 데이터 형식 오류",
        response: data,
      },
      500
    );
  }

  if (data.results.content.length === 0) {
    return jsonResp(
      {
        error: "해당 우편번호의 경계 데이터가 없음",
        zipcode,
      },
      404
    );
  }

  const item = data.results.content[0];

  const normalized = normalizeGeometry(item?.geom);
  if (!normalized.ok) {
    return jsonResp(
      {
        error: normalized.error,
        detail: normalized.detail || null,
        type: normalized.type || null,
        geom: normalized.geom || undefined,
      },
      500
    );
  }

  const polygon5179 = normalized.geojson.coordinates;
  const center5179 = computeCenter5179(polygon5179);

  const metadata = {
    ctpvNm: item?.ctpvNm ?? null,
    sigNm: item?.sigNm ?? null,
    sbdno: item?.sbdno ?? zipcode,
    lgvReplcCd: item?.lgvReplcCd ?? null,
  };

  return jsonResp({
    zipcode,
    srid: 5179,
    center5179,
    polygon5179,
    metadata,
  });
}

export default {
  async fetch(request, env) {
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: {
          ...corsHeaders(),
          "Access-Control-Max-Age": "86400",
        },
      });
    }

    try {
      const url = new URL(request.url);
      const path = url.pathname.replace(/\/+$/, "") || "/";

      if (request.method === "GET" && (path === "/health" || path === "/share/health")) {
        return jsonResp({
          ok: true,
          service: "zipcode-boundary-share",
          version: ZIP_SHARE_WORKER_VERSION,
          kvReady: !!env?.ZIP_SHARE_KV,
          terrainMode: "process_robust_slope_scope_area_cache",
          terrainEndpoint: COPERNICUS_PROCESS_URL,
          buildingStatsVersion: BUILDING_STATS_SOURCE_VERSION,
          buildingStatsMode: "kapt_top_level_json_v4_v3_unit_register_query_variants",
          buildingHubTimeoutMs: BUILDING_HUB_TIMEOUT_MS,
          kaptTimeoutMs: KAPT_TIMEOUT_MS
        });
      }

      if (request.method === "POST" && (path === "/terrain" || path === "/zip/terrain")) {
        return await handleTerrainRequest(request, env);
      }

      if (
        request.method === "POST" &&
        (
          path === "/building/stats" ||
          path === "/households" ||
          path === "/zip/building-stats"
        )
      ) {
        return await handleBuildingStatsRequest(request, env);
      }

      if (request.method === "POST" && (path === "/share/create" || path === "/create")) {
        return await handleZipShareCreate(request, env);
      }

      if (request.method === "GET" && (path === "/share/verify" || path === "/verify")) {
        return await handleZipShareVerify(request, env, url);
      }

      if (request.method === "GET" && (path === "/zip/share" || path === "/share/view" || path === "/share")) {
        return await handleZipSharePreview(request, env, url);
      }

      if (request.method === "GET" && (path === "/" || path === "/zip")) {
        return await handleZipBoundaryRequest(url);
      }

      return jsonResp({ error: "Not Found" }, 404);
    } catch (err) {
      return jsonResp(
        {
          error: err?.message || "Worker 내부 예외 발생",
          detail: String(err),
          stack: err?.stack || null,
        },
        Number(err?.status || 500)
      );
    }
  },
};
