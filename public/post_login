<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>마루웰</title><script src="/config.js"></script><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><style>html,body{margin:0;height:100%;font-family:system-ui,-apple-system,"Noto Sans KR",sans-serif;background:#f4f7f8;color:#334155}body{display:grid;place-items:center}.box{padding:18px 22px;border:1px solid #dce5e8;border-radius:14px;background:#fff;font-weight:800}</style></head><body><div id="msg" class="box">접속 권한 확인 중...</div><script>(async()=>{const msg=document.getElementById('msg'),sleep=ms=>new Promise(r=>setTimeout(r,ms));try{const c=window.MARUWELL_CONFIG||{};if(!c.SUPABASE_URL||!c.SUPABASE_ANON_KEY||!window.supabase?.createClient)throw new Error('설정 로드 실패');const sb=window.supabase.createClient(c.SUPABASE_URL,c.SUPABASE_ANON_KEY,{auth:{persistSession:true,storage:sessionStorage,autoRefreshToken:true,detectSessionInUrl:true}});const{data:{session}}=await sb.auth.getSession();if(!session)return location.replace('/');let lastErr=null;for(let i=0;i<4;i++){try{const[{data:a,error:ae},{data:s,error:se}]=await Promise.all([sb.rpc('mw_my_access').maybeSingle(),sb.rpc('mw_my_account_state').maybeSingle()]);if(ae)throw ae;if(se)throw se;if(s?.approval_status!=='approved'||s?.app_only===true)return location.replace('/');const superAdmin=a?.is_maroowell===true&&Number(a?.max_role_level||0)>=90;return location.replace(superAdmin?'/home':'/zipcode_search')}catch(e){lastErr=e;if(i<3){msg.textContent=`접속 권한 확인 중... (${i+2}/4)`;await sleep(350*(i+1))}}}throw lastErr||new Error('권한 확인 실패')}catch(e){console.error(e);msg.textContent='권한 확인에 실패했습니다. 잠시 후 자동으로 다시 확인합니다.';setTimeout(()=>location.reload(),1800)}})();</script></body></html>