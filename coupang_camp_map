          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          width: `${metrics.width}px`,
          height: `${metrics.bubbleHeight + (showPointer ? metrics.pointerHeight : 0)}px`,
          margin: "0",
          padding: "0",
          border: "0",
          background: "transparent",
          cursor: "pointer",
          fontFamily: "Arial, Noto Sans KR, sans-serif",
          transform: `translate(${offset.x}px, ${offset.y}px)`,
          transformOrigin: "50% 100%",
          filter: "drop-shadow(0 1px 2px rgba(15,23,42,.28))",
          zIndex: "1"
        });

        const bubble = document.createElement("span");
        Object.assign(bubble.style, {
          display: "flex",
          flexDirection: metrics.lines.length > 1 ? "column" : "row",
          alignItems: "center",
          justifyContent: "center",
          gap: "0",
          width: `${metrics.width}px`,
          height: `${metrics.bubbleHeight}px`,
          padding: metrics.lines.length > 1 ? "3px 8px" : "0 10px",
          border: `1.2px solid ${metrics.isMobile ? "#e0f2fe" : "#ffffff"}`,
          borderRadius: "7px",
          background: markerLabelBackground(metrics),
          color: markerLabelColor(metrics),
          boxSizing: "border-box",
          whiteSpace: "nowrap",
          overflow: "hidden"
        });

        metrics.lines.forEach((line, index) => {
          const span = document.createElement("span");
          span.textContent = line;
          Object.assign(span.style, {
            display: "block",
            width: "100%",
            overflow: "hidden",
            textOverflow: "clip",
            whiteSpace: "nowrap",
            textAlign: "center",
            lineHeight: metrics.lines.length > 1 ? "1.08" : "1",
            fontSize: `${metrics.fontSizes[index] || metrics.fontSizes[0]}px`,
            fontWeight: index === 0 ? "900" : "800"
          });
          bubble.appendChild(span);
        });

        root.appendChild(bubble);

        if (showPointer) {
          const pointer = document.createElement("span");
          Object.assign(pointer.style, {
            display: "block",
            width: "0",
            height: "0",
            borderLeft: "5px solid transparent",
            borderRight: "5px solid transparent",
            borderTop: `6px solid ${markerLabelBackground(metrics)}`,
            marginTop: "-1px"
          });
          root.appendChild(pointer);
        }

        root.addEventListener("pointerdown", event => {
          event.stopPropagation();
        });

        root.addEventListener("click", event => {
          event.preventDefault();
          event.stopPropagation();
          state.ignoreMapClickUntil = Date.now() + 250;
          selectCamp(row, true);
        });

        return root;
      }

      function renderLabelOverlays() {
        clearLabelOverlays();

        if (!state.map) return;

        const labelRows = labelRowsForCurrentView();
        if (!labelRows.length) return;

        const groups = buildMarkerGroups(labelRows);
        const layouts = buildCollisionAwareGroupLayout(groups);
        const projection = state.map.getProjection();

        for (const group of groups) {
          const layout = layouts.get(group.key) || {
            x: 0,
            y: 0,
            anchor: projection.containerPointFromCoords(
              new kakao.maps.LatLng(group.latitude, group.longitude)
            )
          };

          const position = new kakao.maps.LatLng(
            group.latitude,
            group.longitude
          );

          let heightBelow = 0;

          for (let index = group.items.length - 1; index >= 0; index--) {
            const item = group.items[index];
            const showPointer = index === group.items.length - 1;

            const overlay = new kakao.maps.CustomOverlay({
              map: state.map,
              position,
              content: createMarkerLabelElement(
                item.row,
                item.metrics,
                showPointer,
                {
                  x: layout.x,
                  y: layout.y - heightBelow
                }
              ),
              xAnchor: 0.5,
              yAnchor: 1,
              zIndex:
                item.metrics.isSubHub
                  ? 5000 - index
                  : 4000 - index
            });

            state.labelOverlays.push(overlay);

            heightBelow +=
              item.metrics.bubbleHeight +
              (showPointer ? item.metrics.pointerHeight : 0);
          }

          // 다른 좌표의 라벨을 피하느라 그룹 전체가 이동한 경우에만
          // 실제 좌표와 이동된 그룹 끝점을 짧은 보조선으로 연결한다.
          if (Math.abs(layout.x) > 2 || Math.abs(layout.y) > 2) {
            const shiftedPoint = new kakao.maps.Point(
              layout.anchor.x + layout.x,
              layout.anchor.y + layout.y
            );
            const shiftedPosition =
              projection.coordsFromContainerPoint(shiftedPoint);

            const leader = new kakao.maps.Polyline({
              map: state.map,
              path: [position, shiftedPosition],
              strokeWeight: 2,
              strokeColor: group.hasSubHub ? "#7c3aed" : "#64748b",
              strokeOpacity: 0.62,
              strokeStyle: "solid",
              zIndex: 1800
            });

            state.labelLeaderLines.push(leader);
          }
        }
      }

      function scheduleLabelLayout() {
        if (state.labelLayoutTimer) {
          clearTimeout(state.labelLayoutTimer);
        }

        state.labelLayoutTimer = setTimeout(() => {
          state.labelLayoutTimer = null;
          syncBaseMarkersForCurrentView();
          renderLabelOverlays();
          renderSelectedSubHubMarkers();
        }, 70);
      }


      function normalizeRow(row, index) {
        const latitude = Number(row?.latitude);
        const longitude = Number(row?.longitude);
        const hasValidCoordinates =
          Number.isFinite(latitude) &&
          Number.isFinite(longitude) &&
          latitude >= -90 && latitude <= 90 &&
          longitude >= -180 && longitude <= 180 &&
          !(latitude === 0 && longitude === 0);

        return {
          id: text(row?.id) || `row_${index}`,
          camp_type: text(row?.camp_type) || "미분류",
          camp: text(row?.camp),
          mb_camp: text(row?.mb_camp),
          address: text(row?.address),
          region: text(row?.region || row?.area),
          code: text(row?.code),
          parent_camp_id: text(row?.parent_camp_id),
          receiving_sh_id: text(row?.receiving_sh_id),
          parent_camp: text(row?.parent_camp),
          parent_camp_code: text(row?.parent_camp_code),
          effective_receiving_sh_id: text(row?.effective_receiving_sh_id || row?.resolved_receiving_sh_id),
          receiving_sh: text(row?.receiving_sh),
          receiving_sh_code: text(row?.receiving_sh_code),
          receiving_sh_latitude: Number(row?.receiving_sh_latitude),
          receiving_sh_longitude: Number(row?.receiving_sh_longitude),
          sh_assignment_type: text(row?.sh_assignment_type),
          latitude,
          longitude,
          description: text(row?.description),
          hasValidCoordinates,
          coordinateSource: hasValidCoordinates ? "database" : "",
          locationError: ""
        };
      }

      function addressCandidates(address) {
        const original = text(address);
        if (!original) return [];

        const values = [
          original,
          original.replace(/\([^)]*\)/g, " ").replace(/\s+/g, " ").trim(),
          original.replace(/[，,]/g, " ").replace(/\s+/g, " ").trim()
        ].filter(Boolean);

        return [...new Set(values)];
      }

      function geocodeAddress(address) {
        const cacheKey = lower(address);
        if (!cacheKey) return Promise.resolve(null);
        if (state.geocodeCache.has(cacheKey)) {
          return Promise.resolve(state.geocodeCache.get(cacheKey));
        }

        const candidates = addressCandidates(address);

        return new Promise(resolve => {
          const searchNext = index => {
            if (index >= candidates.length) {
              setGeocodeCache(cacheKey, null);
              resolve(null);
              return;
            }

            state.geocoder.addressSearch(candidates[index], (result, status) => {
              if (status === kakao.maps.services.Status.OK && result?.[0]) {
                const latitude = Number(result[0].y);
                const longitude = Number(result[0].x);
                const found = Number.isFinite(latitude) && Number.isFinite(longitude)
                  ? { latitude, longitude }
                  : null;

                if (found) {
                  setGeocodeCache(cacheKey, found);
                  resolve(found);
                } else {
                  searchNext(index + 1);
                }
                return;
              }

              searchNext(index + 1);
            });
          };

          searchNext(0);
        });
      }

      function applyCachedGeocodeLocations(rows) {
        let applied = 0;

        for (const row of rows) {
          if (!row.address) continue;

          const cached = state.geocodeCache.get(lower(row.address));
          if (!cached) continue;

          const latitude = Number(cached.latitude);
          const longitude = Number(cached.longitude);

          if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
            continue;
          }

          row.latitude = latitude;
          row.longitude = longitude;
          row.hasValidCoordinates = true;
          row.coordinateSource = "address-cache";
          row.locationError = "";
          applied++;
        }

        return applied;
      }

      async function resolveMissingLocations(rows) {
        const targets = rows.filter(row => {
          if (!row.address) return !row.hasValidCoordinates;
          return !state.geocodeCache.has(lower(row.address));
        });

        if (!targets.length) {
          return { resolved: 0, failed: 0, fallback: 0, checked: 0 };
        }

        let cursor = 0;
        let completed = 0;
        let resolved = 0;
        let failed = 0;
        let fallback = 0;

        const worker = async () => {
          while (true) {
            const index = cursor++;
            if (index >= targets.length) return;

            const row = targets[index];
            const hadDatabaseCoordinates = row.hasValidCoordinates;

            if (row.address) {
              const found = await geocodeAddress(row.address);

              if (found) {
                row.latitude = found.latitude;
                row.longitude = found.longitude;
                row.hasValidCoordinates = true;
                row.coordinateSource = "address";
                row.locationError = "";
                resolved++;
              } else if (hadDatabaseCoordinates) {
                row.coordinateSource = "database-fallback";
                row.locationError = "주소 검색 실패 · DB 좌표 사용";
                fallback++;
              } else {
                row.hasValidCoordinates = false;
                row.coordinateSource = "";
                row.locationError = "주소 검색 실패";
                failed++;
              }
            } else if (hadDatabaseCoordinates) {
              row.coordinateSource = "database";
              row.locationError = "";
            } else {
              row.hasValidCoordinates = false;
              row.coordinateSource = "";
              row.locationError = "주소 및 좌표 없음";
              failed++;
            }

            completed++;
            dom.loadingText.textContent =
              `주소 위치를 백그라운드로 보정 중... ${completed}/${targets.length}`;
          }
        };

        const workerCount = Math.min(GEOCODE_CONCURRENCY, targets.length);
        await Promise.all(
          Array.from({ length: workerCount }, () => worker())
        );

        return {
          resolved,
          failed,
          fallback,
          checked: targets.length
        };
      }


      function sortedTypes() {
        return [...new Set(
          state.rows
            .map(row => text(row.camp_type))
            .filter(Boolean)
        )].sort((a, b) =>
          a.localeCompare(b, "ko", { numeric: true })
        );
      }

      function updateSelectOptions(select, values) {
        const currentValue = select.value;
        select.replaceChildren(new Option("전체", ""));

        for (const value of values) {
          select.add(new Option(value, value));
        }

        if (values.includes(currentValue)) {
          select.value = currentValue;
        }
      }

      function syncTypeSelect() {
        if (state.selectedTypes.size === 1) {
          dom.type.value = [...state.selectedTypes][0];
        } else {
          dom.type.value = "";
        }
      }


      function updateFilterOptions() {
        const types = sortedTypes();
        const regions = [...new Set(state.rows.map(row => row.region).filter(Boolean))]
          .sort((a, b) => a.localeCompare(b, "ko", { numeric: true }));

        state.selectedTypes = new Set(
          [...state.selectedTypes].filter(type => types.includes(type))
        );

        updateSelectOptions(dom.type, types);
        updateSelectOptions(dom.region, regions);
        syncTypeSelect();
        renderTypeChips(types);
      }

      function renderTypeChips(types = sortedTypes()) {
        const counts = new Map();
        for (const row of state.rows) {
          counts.set(row.camp_type, (counts.get(row.camp_type) || 0) + 1);
        }

        dom.chips.replaceChildren();

        for (const type of types) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = `chip${state.selectedTypes.has(type) ? " active" : ""}`;
          button.dataset.type = type;

          const dot = document.createElement("span");
          dot.className = "dot";
          dot.style.background = getColor(type);

          button.append(dot, document.createTextNode(`${type} ${counts.get(type) || 0}`));
          dom.chips.appendChild(button);
        }
      }

      function applyFilters(fitBounds = true) {
        const query = lower(dom.query.value);
        const selectedRegion = dom.region.value;

        state.filteredRows = state.rows.filter(row => {
          if (!row.hasValidCoordinates) return false;
          if (state.selectedTypes.size && !state.selectedTypes.has(row.camp_type)) return false;
          if (selectedRegion && row.region !== selectedRegion) return false;

          if (query) {
            const haystack = [
              row.camp_type,
              row.camp,
              row.mb_camp,
              row.address,
              row.region,
              row.code,
              row.parent_camp,
              row.receiving_sh,
              row.receiving_sh_code,
              row.description
            ].map(lower).join("\n");

            if (!haystack.includes(query)) return false;
          }

          return true;
        });

        if (state.selected && !state.filteredRows.some(row => rowId(row) === rowId(state.selected))) {
          clearSelection();
        }

        renderMarkers(fitBounds);
        renderList();
        renderStats();
        renderTypeChips();
      }

      function clearSelection() {
        const hadSelection = !!state.selected;

        state.selected = null;
        dom.detail.classList.remove("show");

        if (state.overlay) state.overlay.setMap(null);
        state.overlay = null;

        if (state.routeOverlay) state.routeOverlay.setMap(null);
        state.routeOverlay = null;

        clearSelectedRelationMarkers();

        if (state.map && state.clusterer) {
          clearRelationLines();
          renderRelationLines();
          scheduleLabelLayout();
        }

        if (hadSelection) {
          renderList();
        }
      }


      function isValidLatLng(latitude, longitude) {
        return Number.isFinite(latitude) &&
          Number.isFinite(longitude) &&
          latitude >= -90 && latitude <= 90 &&
          longitude >= -180 && longitude <= 180 &&
          !(latitude === 0 && longitude === 0);
      }

      function receivingShPosition(row) {
        if (isValidLatLng(row.receiving_sh_latitude, row.receiving_sh_longitude)) {
          return {
            latitude: row.receiving_sh_latitude,
            longitude: row.receiving_sh_longitude
          };
        }

        const shId = text(row.effective_receiving_sh_id);
        if (!shId) return null;

        const shRow = state.rows.find(item => text(item.id) === shId);
        if (!shRow?.hasValidCoordinates) return null;

        return {
          latitude: shRow.latitude,
          longitude: shRow.longitude
        };
      }

      function clearRelationLines() {
        for (const item of state.relationLines) {
          item.visible?.setMap(null);
          item.hit?.setMap(null);
        }
        state.relationLines = [];

        if (state.routeOverlay) {
          state.routeOverlay.setMap(null);
          state.routeOverlay = null;
        }
      }

      function formatDistance(meters) {
        const value = Number(meters || 0);
        if (value < 1000) return `${Math.round(value)}m`;
        return `${(value / 1000).toFixed(value < 10000 ? 1 : 0)}km`;
      }

      function formatDuration(seconds) {
        const totalMinutes = Math.max(1, Math.round(Number(seconds || 0) / 60));
        if (totalMinutes < 60) return `${totalMinutes}분`;
        const hours = Math.floor(totalMinutes / 60);
        const minutes = totalMinutes % 60;
        return minutes ? `${hours}시간 ${minutes}분` : `${hours}시간`;
      }

      function makeRouteOverlay(position, row, data = null, error = "") {
        if (state.routeOverlay) state.routeOverlay.setMap(null);

        const box = document.createElement("div");
        box.className = `routeInfo${!data && !error ? " loadingRoute" : ""}`;

        const title = document.createElement("strong");
        title.textContent = `${row.receiving_sh_code || row.receiving_sh || "서브허브"} → ${campName(row)}`;

        const arrow = document.createElement("div");
        arrow.className = "routeArrow";
        arrow.textContent = "서브허브 출발 · 캠프 도착";

        box.append(title, arrow);

        const addRow = (key, value) => {
          const line = document.createElement("div");
          line.className = "routeRow";
          const keyNode = document.createElement("span");
          keyNode.className = "routeKey";
          keyNode.textContent = key;
          const valueNode = document.createElement("span");
          valueNode.className = "routeVal";
          valueNode.textContent = value;
          line.append(keyNode, valueNode);
          box.appendChild(line);
        };

        if (error) {
          addRow("길찾기", error);
        } else if (!data) {
          addRow("카카오지도", "현재 교통정보 조회 중...");
        } else {
          addRow(
            "최단거리",
            `${formatDistance(data.shortestDistance?.distance)} · ${formatDuration(data.shortestDistance?.duration)}`
          );
          addRow(
            "현재 최단시간",
            `${formatDuration(data.fastestTime?.duration)} · ${formatDistance(data.fastestTime?.distance)}`
          );

          const checked = document.createElement("div");
          checked.className = "routeTime";
          const queriedAt = data.queriedAt ? new Date(data.queriedAt) : new Date();
          checked.textContent = `${queriedAt.toLocaleString("ko-KR")} 기준 · 카카오지도 자동차 길찾기`;
          box.appendChild(checked);
        }

        state.routeOverlay = new kakao.maps.CustomOverlay({
          position,
          content: box,
          yAnchor: 1.1,
          zIndex: 40,
          clickable: true
        });
        state.routeOverlay.setMap(state.map);
      }

      async function showRelationshipRoute(row, source, position) {
        makeRouteOverlay(position, row);

        const key = [
          source.longitude,
          source.latitude,
          row.longitude,
          row.latitude
        ].join("|");

        const cached = state.routeCache.get(key);
        if (cached && Date.now() - cached.savedAt < 60000) {
          makeRouteOverlay(position, row, cached.data);
          return;
        }

        try {
          if (state.supabaseClient) {
            const { data: sessionData } = await state.supabaseClient.auth.getSession();
            state.accessToken = sessionData?.session?.access_token || state.accessToken;
          }
          if (!state.accessToken) throw new Error("로그인 세션을 확인할 수 없습니다.");

          const params = new URLSearchParams({
            origin_lng: String(source.longitude),
            origin_lat: String(source.latitude),
            destination_lng: String(row.longitude),
            destination_lat: String(row.latitude)
          });

          const response = await fetch(`${API_BASE}/directions?${params}`, {
            method: "GET",
            headers: {
              Authorization: `Bearer ${state.accessToken}`
            },
            cache: "no-store"
          });

          const data = await response.json().catch(() => null);
          if (!response.ok) {
            throw new Error(data?.error || data?.message || `길찾기 HTTP ${response.status}`);
          }

          state.routeCache.set(key, { savedAt: Date.now(), data });
          makeRouteOverlay(position, row, data);
        } catch (error) {
          console.error(error);
          makeRouteOverlay(position, row, null, error?.message || String(error));
        }
      }

      function renderRelationLines() {
        const unique = new Set();

        for (const row of relationRowsForCurrentView()) {
          if (text(row.camp_type).toUpperCase() === "SUB_HUB") continue;
          if (!row.effective_receiving_sh_id || !row.hasValidCoordinates) continue;

          const source = receivingShPosition(row);
          if (!source) continue;

          const relationKey = [
            row.effective_receiving_sh_id,
            rowId(row),
            source.latitude,
            source.longitude,
            row.latitude,
            row.longitude
          ].join("|");
          if (unique.has(relationKey)) continue;
          unique.add(relationKey);

          const path = [
            new kakao.maps.LatLng(source.latitude, source.longitude),
            new kakao.maps.LatLng(row.latitude, row.longitude)
          ];

          const color = "#64748b";
          const visible = new kakao.maps.Polyline({
            map: state.map,
            path,
            strokeWeight: 4,
            strokeColor: color,
            strokeOpacity: 0.72,
            strokeStyle: "solid",
            zIndex: 2
          });

          // 보이는 선 자체를 충분히 굵게 표시하고, 클릭 영역은 더 넓게 확보한다.
          const hit = new kakao.maps.Polyline({
            map: state.map,
            path,
            strokeWeight: 18,
            strokeColor: "#ffffff",
            strokeOpacity: 0.01,
            strokeStyle: "solid",
            zIndex: 3
          });

          const highlight = () => visible.setOptions({
            strokeWeight: 7,
            strokeOpacity: 0.96,
            strokeColor: "#2563eb"
          });
          const restore = () => visible.setOptions({
            strokeWeight: 4,
            strokeOpacity: 0.72,
            strokeColor: color
          });

          kakao.maps.event.addListener(hit, "mouseover", highlight);
          kakao.maps.event.addListener(hit, "mouseout", restore);
          kakao.maps.event.addListener(hit, "click", event => {
            state.ignoreMapClickUntil = Date.now() + 250;
            highlight();
            showRelationshipRoute(row, source, event.latLng);
          });

          state.relationLines.push({ visible, hit, row, source });
        }
      }

      function renderMarkers(fitBounds) {
        state.clusterer.clear();
        for (const marker of state.markers) marker.setMap(null);
        state.markers = [];
        state.markerEntries = [];
        clearLabelOverlays();
        clearRelationLines();

        if (state.overlay) state.overlay.setMap(null);

        const bounds = new kakao.maps.LatLngBounds();

        for (const row of state.filteredRows) {
          const position = new kakao.maps.LatLng(row.latitude, row.longitude);
          const marker = new kakao.maps.Marker({
            position,
            image: makeClusterDotImage(row),
            title: campName(row),
            zIndex:
              text(row.camp_type).toUpperCase() === "SUB_HUB"
                ? 3200
                : 3000
          });

          kakao.maps.event.addListener(marker, "click", () => selectCamp(row, true));
          state.markers.push(marker);
          state.markerEntries.push({ marker, row });
          bounds.extend(position);
        }

        renderRelationLines();
        syncBaseMarkersForCurrentView();

        if (fitBounds && state.markers.length) {
          state.map.setBounds(bounds);
        }

        scheduleLabelLayout();
      }

      function renderList() {
        dom.count.textContent = `${state.filteredRows.length.toLocaleString()}건`;
        dom.list.replaceChildren();

        if (!state.filteredRows.length) {
          const empty = document.createElement("div");
          empty.className = "empty";
          empty.textContent = "조건에 맞는 위치 확인 캠프가 없습니다.";
          dom.list.appendChild(empty);
          return;
        }

        for (const row of state.filteredRows.slice(0, 500)) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = `item${state.selected && rowId(state.selected) === rowId(row) ? " active" : ""}`;
          button.dataset.id = rowId(row);

          const title = document.createElement("strong");
          const dot = document.createElement("i");
          dot.className = "dot";
          dot.style.background = getColor(row.camp_type);
          title.append(dot, document.createTextNode(campName(row)));

          const subtitle = document.createElement("span");
          subtitle.textContent = [row.camp_type, row.region, row.receiving_sh ? `SH ${row.receiving_sh}` : "", row.address].filter(Boolean).join(" · ");

          button.append(title, subtitle);
          dom.list.appendChild(button);
        }
      }

      function renderStats() {
        dom.visible.textContent = state.filteredRows.length.toLocaleString();
        dom.total.textContent = state.rows.length.toLocaleString();
        dom.missing.textContent = state.rows
          .filter(row => !row.hasValidCoordinates)
          .length
          .toLocaleString();
        dom.time.textContent = new Date().toLocaleTimeString("ko-KR", {
          hour: "2-digit",
          minute: "2-digit"
        });
      }

      function makeInfoOverlay(row, position) {
        const box = document.createElement("div");
        box.className = "info";

        const title = document.createElement("strong");
        title.textContent = campName(row);

        const meta = document.createElement("span");
        meta.textContent = [row.camp_type, row.region].filter(Boolean).join(" · ");

        const address = document.createElement("span");
        address.textContent = row.address || "주소 없음";

        box.append(title, meta, address);

        if (state.overlay) state.overlay.setMap(null);
        state.overlay = new kakao.maps.CustomOverlay({
          position,
          content: box,
          yAnchor: 1.32,
          zIndex: 20
        });
        state.overlay.setMap(state.map);
      }

      function selectCamp(row, focusMap) {
        state.selected = row;
        dom.detail.classList.add("show");
        dom.detailType.textContent = row.camp_type;
        dom.detailTitle.textContent = row.camp || row.mb_camp || row.code || "이름 없는 캠프";
        dom.detailSub.textContent = row.mb_camp && row.mb_camp !== row.camp
          ? `MB캠프 ${row.mb_camp}`
          : "";
        dom.detailAddress.textContent = row.address || "-";
        dom.detailRegion.textContent = row.region || "-";
        dom.detailCode.textContent = row.code || "-";
        dom.detailParent.textContent = row.parent_camp || "-";
        dom.detailSh.textContent = row.receiving_sh
          ? `${row.receiving_sh}${row.sh_assignment_type === "INHERITED" ? " (본캠프 상속)" : " (직접 지정)"}`
          : "미지정";
        dom.detailDescription.textContent = row.description || "-";
        const coordinateLabel =
          row.coordinateSource === "address"
            ? " (주소 우선 변환)"
            : row.coordinateSource === "address-cache"
              ? " (주소 캐시 적용)"
              : row.coordinateSource === "database-fallback"
              ? " (주소 검색 실패 · DB 좌표)"
              : "";
        dom.detailCoord.textContent = `${row.latitude}, ${row.longitude}${coordinateLabel}`;

        const position = new kakao.maps.LatLng(row.latitude, row.longitude);

        // 선택한 캠프의 상세정보는 왼쪽 패널에만 표시한다.
        // 지도 위의 큰 설명 말풍선은 제거한다.
        if (state.overlay) {
          state.overlay.setMap(null);
          state.overlay = null;
        }

        if (focusMap) {
          state.map.panTo(position);
          if (state.map.getLevel() > 5) state.map.setLevel(5, { anchor: position });
        }

        clearRelationLines();
        renderRelationLines();
        scheduleLabelLayout();
        renderList();

        if (window.matchMedia("(max-width:900px)").matches) {
          dom.work.classList.remove("open");
        }
      }

      async function loadRows() {
        dom.loading.classList.remove("hide");

        try {
          const response = await fetch(`${API_BASE}/camps`, { cache: "no-store" });
          const data = await response.json();

          if (!response.ok) {
            throw new Error(data?.error || data?.message || `HTTP ${response.status}`);
          }

          const rows = Array.isArray(data) ? data : (data?.rows || []);
          state.rows = rows.map(normalizeRow);

          const cachedCount = applyCachedGeocodeLocations(state.rows);

          state.rows.sort((a, b) =>
            campName(a).localeCompare(campName(b), "ko", { numeric: true })
          );

          clearSelection();
          updateFilterOptions();
          applyFilters(true);

          // 데이터와 지도는 먼저 즉시 표시한다.
          dom.loading.classList.add("hide");

          const uncachedAddressCount = state.rows.filter(row =>
            row.address && !state.geocodeCache.has(lower(row.address))
          ).length;

          if (uncachedAddressCount > 0) {
            showToast(
              `캠프 ${state.rows.length.toLocaleString()}건 표시 완료 · 주소 ${uncachedAddressCount.toLocaleString()}건 보정 중`
            );

            const geocodeResult = await resolveMissingLocations(state.rows);

            state.rows.sort((a, b) =>
              campName(a).localeCompare(campName(b), "ko", { numeric: true })
            );

            // 검색·선택 상태를 유지하고 보정된 좌표만 다시 반영한다.
            applyFilters(false);

            showToast(
              `캠프 ${state.rows.length.toLocaleString()}건 · 주소 위치 ${geocodeResult.resolved.toLocaleString()}건 보정 완료`
            );
          } else {
            showToast(
              `캠프 ${state.rows.length.toLocaleString()}건을 불러왔습니다.${cachedCount ? ` · 주소 캐시 ${cachedCount.toLocaleString()}건 적용` : ""}`
            );
          }
        } catch (error) {
          console.error(error);
          showToast(error?.message || String(error), true);
        } finally {
          dom.loadingText.textContent = "캠프 지도를 불러오는 중...";
          dom.loading.classList.add("hide");
        }
      }


      function bindEvents() {
        let searchTimer = null;

        dom.query.addEventListener("input", () => {
          clearTimeout(searchTimer);
          searchTimer = setTimeout(() => applyFilters(true), 180);
        });

        dom.type.addEventListener("change", () => {
          state.selectedTypes.clear();
          if (dom.type.value) state.selectedTypes.add(dom.type.value);
          applyFilters(true);
        });
        dom.region.addEventListener("change", () => applyFilters(true));

        dom.chips.addEventListener("click", event => {
          const button = event.target.closest("[data-type]");
          if (!button) return;

          const type = button.dataset.type;
          if (state.selectedTypes.has(type)) {
            state.selectedTypes.delete(type);
          } else {
            state.selectedTypes.add(type);
          }

          syncTypeSelect();
          applyFilters(true);
        });

        dom.list.addEventListener("click", event => {
          const button = event.target.closest("[data-id]");
          if (!button) return;
          const row = state.filteredRows.find(item => rowId(item) === button.dataset.id);
          if (row) selectCamp(row, true);
        });

        dom.reset.addEventListener("click", () => {
          dom.query.value = "";
          state.selectedTypes.clear();
          dom.type.value = "";
          dom.region.value = "";
          applyFilters(true);
        });

        dom.fit.addEventListener("click", () => applyFilters(true));
        dom.reload.addEventListener("click", loadRows);

        dom.menu.addEventListener("click", () => {
          if (isMobileSidebarLayout()) {
            dom.work.classList.toggle("open");
            updateSidebarToggleButton();
          } else {
            setSidebarCollapsed(
              !dom.work.classList.contains("side-collapsed")
            );
          }
        });

        dom.sideToggle.addEventListener("pointerdown", event => {
          event.stopPropagation();
        });

        dom.sideToggle.addEventListener("click", event => {
          event.preventDefault();
          event.stopPropagation();

          const collapsed = isMobileSidebarLayout()
            ? !dom.work.classList.contains("open")
            : dom.work.classList.contains("side-collapsed");

          setSidebarCollapsed(!collapsed);
        });

        dom.mapType.addEventListener("click", () => {
          state.isRoadmap = !state.isRoadmap;
          state.map.setMapTypeId(
            state.isRoadmap
              ? kakao.maps.MapTypeId.ROADMAP
              : kakao.maps.MapTypeId.SKYVIEW
          );
          dom.mapType.textContent = state.isRoadmap ? "위성" : "일반지도";
        });

        dom.roadview.addEventListener("click", () => {
          if (!state.map || !state.roadviewOverlay) {
            showToast("로드뷰 오버레이를 사용할 수 없습니다.", true);
            return;
          }

          state.isRoadviewOn = !state.isRoadviewOn;
          state.roadviewOverlay.setMap(state.isRoadviewOn ? state.map : null);
          dom.roadview.classList.toggle("primary", state.isRoadviewOn);
          showToast(state.isRoadviewOn ? "로드뷰 도로 표시 ON" : "로드뷰 도로 표시 OFF");
        });

        dom.current.addEventListener("click", () => {
          if (!navigator.geolocation) {
            showToast("위치 확인을 지원하지 않습니다.", true);
            return;
          }

          navigator.geolocation.getCurrentPosition(
            position => {
              const current = new kakao.maps.LatLng(
                position.coords.latitude,
                position.coords.longitude
              );
              state.map.panTo(current);
              state.map.setLevel(5, { anchor: current });
            },
            () => showToast("현재 위치를 확인할 수 없습니다.", true),
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
          );
        });

        dom.copy.addEventListener("click", async () => {
          if (!state.selected?.address) {
            showToast("복사할 주소가 없습니다.", true);
            return;
          }

          try {
            await navigator.clipboard.writeText(state.selected.address);
            showToast("주소를 복사했습니다.");
          } catch {
            showToast("주소 복사에 실패했습니다.", true);
          }
        });

        dom.openKakao.addEventListener("click", () => {
          if (!state.selected) return;
          const label = encodeURIComponent(campName(state.selected));
          const url = `https://map.kakao.com/link/map/${label},${state.selected.latitude},${state.selected.longitude}`;
          window.open(url, "_blank", "noopener,noreferrer");
        });

        // ESC를 누르면 현재 캠프/서브허브 선택과 길찾기 팝업을 모두 해제한다.
        window.addEventListener("keydown", event => {
          if (event.key !== "Escape") return;
          if (!state.selected && !state.routeOverlay) return;

          event.preventDefault();
          clearSelection();
        });

        // 지도 외부의 필터/상단 버튼 등 다른 영역을 클릭해도 선택을 해제한다.
        // 캠프 목록과 상세 패널 내부 조작은 유지하고, 지도 내부는 Kakao map click에서 처리한다.
        document.addEventListener("pointerdown", event => {
          if (!state.selected) return;

          const target = event.target;
          if (!(target instanceof Node)) return;

          const mapElement = document.getElementById("map");

          if (
            mapElement?.contains(target) ||
            dom.sideToggle?.contains(target) ||
            dom.list?.contains(target) ||
            dom.detail?.contains(target)
          ) {
            return;
          }

          clearSelection();
        });

        window.addEventListener("resize", () => {
          if (!state.map) return;

          if (isMobileSidebarLayout()) {
            dom.work.classList.remove("side-collapsed");
          } else {
            dom.work.classList.remove("open");
          }

          updateSidebarToggleButton();
          state.map.relayout();
          scheduleLabelLayout();
        });
      }


      async function loadMapAccess() {
        if (!SUPABASE_URL || !SUPABASE_ANON_KEY || !window.supabase?.createClient) return false;
        try {
          const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
            auth: { persistSession:true, storage:sessionStorage, autoRefreshToken:true, detectSessionInUrl:true }
          });
          state.supabaseClient = sb;
          const { data } = await sb.auth.getSession();
          const token = data?.session?.access_token || "";
          if (!token) return false;
          state.accessToken = token;
          const response = await fetch(`${API_BASE}/access`, {
            headers: { Authorization:`Bearer ${token}` },
            cache: "no-store"
          });
          const access = await response.json().catch(() => null);
          return response.ok && (access?.canClhi === true || access?.access?.can_clhi === true);
        } catch (error) {
          console.error(error);
          return false;
        }
      }

      const SIDEBAR_STATE_KEY = "mw_coupang_camp_map_sidebar_collapsed";

      function isMobileSidebarLayout() {
        return window.matchMedia("(max-width:900px)").matches;
      }

      function updateSidebarToggleButton() {
        const collapsed = isMobileSidebarLayout()
          ? !dom.work.classList.contains("open")
          : dom.work.classList.contains("side-collapsed");

        dom.sideToggle.textContent = collapsed ? "▶" : "◀";
        dom.sideToggle.setAttribute(
          "aria-label",
          collapsed ? "좌측 메뉴 펼치기" : "좌측 메뉴 접기"
        );
        dom.sideToggle.title = collapsed ? "좌측 메뉴 펼치기" : "좌측 메뉴 접기";
      }

      function relayoutMapAfterSidebarChange() {
        const center = state.map?.getCenter?.();

        window.setTimeout(() => {
          if (!state.map) return;

          state.map.relayout();
          if (center) state.map.setCenter(center);
          scheduleLabelLayout();
        }, 220);
      }

      function setSidebarCollapsed(collapsed, persist = true) {
        if (isMobileSidebarLayout()) {
          dom.work.classList.toggle("open", !collapsed);
        } else {
          dom.work.classList.toggle("side-collapsed", collapsed);
          dom.work.classList.remove("open");

          if (persist) {
            try {
              localStorage.setItem(
                SIDEBAR_STATE_KEY,
                collapsed ? "1" : "0"
              );
            } catch {}
          }
        }

        updateSidebarToggleButton();
        relayoutMapAfterSidebarChange();
      }

      function restoreSidebarState() {
        if (isMobileSidebarLayout()) {
          dom.work.classList.remove("open");
          dom.work.classList.remove("side-collapsed");
        } else {
          let collapsed = false;

          try {
            collapsed =
              localStorage.getItem(SIDEBAR_STATE_KEY) === "1";
          } catch {}

          dom.work.classList.toggle("side-collapsed", collapsed);
        }

        updateSidebarToggleButton();
      }


      function showDenied() {
        dom.loading.classList.add("hide");
        dom.denied.classList.add("show");
        dom.denied.setAttribute("aria-hidden", "false");
        document.documentElement.style.visibility = "visible";
      }

      async function init() {
        loadPersistentGeocodeCache();

        const allowed = await loadMapAccess();
        if (!allowed) {
          showDenied();
          return;
        }

        state.map = new kakao.maps.Map($("#map"), {
          center: new kakao.maps.LatLng(36.45, 127.85),
          level: 13
        });

        state.geocoder = new kakao.maps.services.Geocoder();

        try {
          state.roadviewOverlay = new kakao.maps.RoadviewOverlay();
        } catch (error) {
          console.warn("로드뷰 오버레이 초기화 실패", error);
          state.roadviewOverlay = null;
        }

        state.clusterer = new kakao.maps.MarkerClusterer({
          map: state.map,
          averageCenter: true,
          minLevel: 7,
          gridSize: 48,
          calculator: [10, 30, 70],
          styles: [
            {
              width:"30px", height:"30px",
              background:"rgba(56,189,248,.82)",
              border:"2px solid rgba(255,255,255,.92)",
              borderRadius:"50%",
              color:"#082f49",
              textAlign:"center",
              fontSize:"11px",
              fontWeight:"900",
              lineHeight:"26px",
              boxShadow:"0 3px 10px rgba(15,23,42,.22)"
            },
            {
              width:"33px", height:"33px",
              background:"rgba(34,197,94,.82)",
              border:"2px solid rgba(255,255,255,.92)",
              borderRadius:"50%",
              color:"#052e16",
              textAlign:"center",
              fontSize:"11px",
              fontWeight:"900",
              lineHeight:"29px",
              boxShadow:"0 3px 10px rgba(15,23,42,.22)"
            },
            {
              width:"36px", height:"36px",
              background:"rgba(132,204,22,.84)",
              border:"2px solid rgba(255,255,255,.92)",
              borderRadius:"50%",
              color:"#1a2e05",
              textAlign:"center",
              fontSize:"12px",
              fontWeight:"900",
              lineHeight:"32px",
              boxShadow:"0 3px 10px rgba(15,23,42,.22)"
            },
            {
              width:"39px", height:"39px",
              background:"rgba(245,158,11,.86)",
              border:"2px solid rgba(255,255,255,.92)",
              borderRadius:"50%",
              color:"#451a03",
              textAlign:"center",
              fontSize:"12px",
              fontWeight:"900",
              lineHeight:"35px",
              boxShadow:"0 3px 10px rgba(15,23,42,.22)"
            }
          ]
        });

        kakao.maps.event.addListener(state.map, "idle", () => {
          scheduleLabelLayout();
        });

        kakao.maps.event.addListener(state.map, "click", () => {
          if (Date.now() < state.ignoreMapClickUntil) return;
          clearSelection();
        });

        bindEvents();
        restoreSidebarState();
        loadRows();
        document.documentElement.style.visibility = "visible";
      }

      if (window.kakao?.maps) {
        kakao.maps.load(init);
      } else {
        document.documentElement.style.visibility = "visible";
        dom.loading.classList.add("hide");
        showToast("카카오 지도 SDK를 불러오지 못했습니다.", true);
      }
    })();
  </script>

  <script src="/board-menu.js"></script>
</body>
</html>
