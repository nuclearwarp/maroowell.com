<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>마루웰 공지사항</title>
  <link rel="icon" href="/favicon.ico?v=2" />
  <script src="/config.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="/board-menu.js?v=20261001-notice1" defer></script>
  <style>
    :root{
      --bg:#f6f8fc;--card:#fff;--line:#dbe3ef;--line2:#cbd5e1;--text:#0f172a;--muted:#64748b;
      --blue:#2563eb;--blueSoft:#eff6ff;--red:#dc2626;--redSoft:#fef2f2;--amber:#d97706;--amberSoft:#fffbeb;--green:#15803d;--greenSoft:#f0fdf4;
      --shadow:0 14px 36px rgba(15,23,42,.08)
    }
    *{box-sizing:border-box}
    html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Noto Sans KR",Segoe UI,Roboto,Arial,sans-serif}
    body{padding-bottom:40px}
    button,input,textarea,select{font:inherit}
    .top{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:12px;padding:13px 16px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.96);backdrop-filter:blur(10px);box-shadow:0 3px 14px rgba(15,23,42,.04)}
    .top img{width:34px;height:34px;display:block}.top h1{font-size:20px;margin:0}.top p{font-size:12px;margin:3px 0 0;color:var(--muted);font-weight:800}.spacer{flex:1}
    .badge,.menuBtn{height:36px;display:inline-flex;align-items:center;padding:0 12px;border:1px solid var(--line2);border-radius:999px;font-size:12px;font-weight:900;background:#fff;color:#334155;white-space:nowrap}
    .menuBtn{cursor:pointer;color:#1d4ed8}.menuBtn:hover{background:#eff6ff;border-color:#93c5fd}
    .wrap{max-width:1180px;margin:0 auto;padding:18px}
    .grid{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(360px,.98fr);gap:16px}
    .grid.viewerOnly{grid-template-columns:1fr;max-width:860px;margin:0 auto}
    @media(max-width:900px){.grid{grid-template-columns:1fr}.wrap{padding:12px}}
    .card{border:1px solid var(--line);border-radius:20px;background:var(--card);box-shadow:var(--shadow);overflow:hidden}.cardHead{padding:16px 18px;border-bottom:1px solid #edf2f7;display:flex;align-items:center;gap:10px}.cardHead h2{margin:0;font-size:17px}.cardBody{padding:17px}.hint{font-size:12px;color:var(--muted);line-height:1.5}
    .form{display:grid;gap:14px}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:600px){.row{grid-template-columns:1fr}.top p{display:none}.badge{display:none}}
    .field{display:grid;gap:6px}.field label{font-size:12px;font-weight:900;color:#334155}.input,.select,.textarea{width:100%;border:1px solid var(--line2);background:#fff;color:var(--text);border-radius:12px;outline:none}.input,.select{height:44px;padding:0 12px}.textarea{min-height:145px;padding:12px;resize:vertical}.input:focus,.select:focus,.textarea:focus{border-color:#60a5fa;box-shadow:0 0 0 3px rgba(96,165,250,.13)}
    .checkRow,.targetBox{display:flex;gap:8px;flex-wrap:wrap}.checkItem,.targetItem{display:flex;gap:7px;align-items:center;padding:9px 11px;border:1px solid var(--line);border-radius:12px;background:#f8fafc;cursor:pointer}.checkItem input,.targetItem input{accent-color:#2563eb}.targetItem small{color:var(--muted)}
    .actions{display:flex;gap:9px;flex-wrap:wrap}.btn{border:0;border-radius:12px;padding:11px 15px;color:#fff;font-weight:1000;cursor:pointer}.btn:disabled{opacity:.45;cursor:not-allowed}.btn.previewBtn{background:#475569}.btn.send{background:var(--red)}.btn.refresh{background:#1d4ed8}.btn.image{background:#334155}
    .previewBox{display:none;margin-top:4px;border:1px solid #bfdbfe;background:var(--blueSoft);border-radius:14px;padding:13px}.previewBox.show{display:block}.nums{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:9px}.num{padding:10px;border:1px solid #dbeafe;border-radius:12px;background:#fff;text-align:center}.num b{display:block;font-size:22px}.num span{font-size:11px;color:var(--muted);font-weight:900}
    .status{display:none;margin-bottom:12px;padding:11px 13px;border-radius:12px;font-size:13px;font-weight:800}.status.show{display:block}.status.ok{background:var(--greenSoft);border:1px solid #bbf7d0;color:#166534}.status.err{background:var(--redSoft);border:1px solid #fecaca;color:#991b1b}
    .scopeHelp{padding:10px 12px;border-radius:12px;background:#f8fafc;border:1px solid #e2e8f0;font-size:12px;color:var(--muted)}
    .imagePick{display:grid;gap:9px}.imagePick input[type=file]{display:none}.imagePreview{display:none;width:100%;max-height:320px;object-fit:cover;border:1px solid var(--line);border-radius:14px;background:#f8fafc}.imagePreview.show{display:block}
    .history{display:grid;gap:10px}.notice{border:1px solid var(--line);border-radius:14px;padding:13px;background:#fff}.noticeTop{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.pill{padding:4px 8px;border-radius:999px;font-size:11px;font-weight:1000}.pill.emergency{background:var(--redSoft);color:#b91c1c}.pill.important{background:var(--amberSoft);color:#92400e}.pill.normal{background:var(--blueSoft);color:#1d4ed8}.pill.mode{background:#f1f5f9;color:#475569}
    .notice h3{margin:9px 0 4px;font-size:16px}.notice p{margin:0;color:#475569;font-size:13px;line-height:1.55;white-space:pre-wrap}.noticeImage{display:block;width:100%;max-height:420px;object-fit:cover;margin-top:11px;border-radius:12px;border:1px solid var(--line);background:#f8fafc}.meta{margin-top:9px;color:var(--muted);font-size:11px}.statline{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.stat{font-size:11px;padding:5px 7px;border-radius:8px;background:#f1f5f9;color:#475569}.empty{padding:30px;text-align:center;color:var(--muted)}
    .loading{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(246,248,252,.96);font-weight:900;color:#334155}.loadingCard{width:min(420px,100%);padding:24px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:var(--shadow);text-align:center}.loadingCard small{display:block;margin-top:8px;color:var(--muted);font-weight:700;line-height:1.5}.loadingCard button{margin-top:14px}.hidden{display:none!important}
  </style>
  <link rel="stylesheet" href="/mw-global-font.css?v=20260925-3" />
</head>
<body>
  <div id="loading" class="loading"><div class="loadingCard"><div id="loadingText">공지사항 확인 중...</div><small id="loadingSub">로그인 세션과 마루웰 계정을 확인하고 있습니다.</small><button id="loginBtn" class="btn refresh hidden" type="button">로그인 화면으로</button></div></div>

  <header class="top">
    <a href="/home" aria-label="홈"><img src="/favicon.ico?v=2" alt="마루웰"></a>
    <div><h1>공지사항</h1><p>회사 공지 · PUSH · 로그인 팝업 통합</p></div>
    <div class="spacer"></div>
    <button id="mwBoardMenuToggle" class="menuBtn" type="button">게시판 메뉴</button>
    <span id="roleBadge" class="badge">권한 확인 중</span>
  </header>

  <main class="wrap">
    <div id="mainGrid" class="grid">
      <section id="composeCard" class="card hidden">
        <div class="cardHead"><h2>공지 등록</h2></div>
        <div class="cardBody">
          <div id="status" class="status"></div>
          <div class="form">
            <div class="row">
              <div class="field">
                <label>공지 종류</label>
                <select id="noticeType" class="select">
                  <option value="normal">🔔 일반</option>
                  <option value="important">⚠️ 중요</option>
                  <option value="emergency">🚨 긴급</option>
                </select>
              </div>
              <div class="field">
                <label>발송 대상</label>
                <select id="scope" class="select">
                  <option value="company">회사전체</option>
                  <option value="camp">캠프 단위</option>
                  <option value="account">개별 계정</option>
                </select>
              </div>
            </div>

            <div class="field hidden" id="campField">
              <label>대상 캠프</label>
              <div id="campBox" class="targetBox"></div>
            </div>

            <div class="field hidden" id="accountField">
              <label>개별 계정</label>
              <input id="accountSearch" class="input" placeholder="이름 · 이메일 · 캠프 검색">
              <div id="accountBox" class="targetBox" style="max-height:270px;overflow:auto;padding-top:4px"></div>
            </div>

            <div id="scopeHelp" class="scopeHelp">마루웰 회사전체에 전달합니다.</div>

            <div class="field">
              <label>노출 방식</label>
              <div class="checkRow">
                <label class="checkItem"><input id="sendPush" type="checkbox" checked><b>PUSH 발송</b></label>
                <label class="checkItem"><input id="showPopup" type="checkbox" checked><b>로그인 팝업 표시</b></label>
              </div>
            </div>

            <div id="popupOptions" class="field">
              <label>팝업 옵션</label>
              <div class="checkRow">
                <label class="checkItem"><input id="popupDismiss" type="checkbox" checked><b>다시 보지 않음 허용</b></label>
                <label class="checkItem"><input id="requireAck" type="checkbox"><b>확인 필수</b></label>
              </div>
            </div>

            <div class="field">
              <label>공지 이미지</label>
              <div class="imagePick">
                <input id="imageInput" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif">
                <button id="imageBtn" class="btn image" type="button">이미지 선택</button>
                <div id="imageName" class="hint">선택된 이미지 없음 · 최대 10MB</div>
                <img id="imagePreview" class="imagePreview" alt="공지 이미지 미리보기">
              </div>
            </div>

            <div class="field"><label>제목</label><input id="title" class="input" maxlength="120" placeholder="공지 제목"></div>
            <div class="field"><label>내용</label><textarea id="body" class="textarea" maxlength="2000" placeholder="공지 내용을 입력하세요."></textarea></div>

            <div class="actions">
              <button id="previewBtn" class="btn previewBtn" type="button">대상 확인</button>
              <button id="sendBtn" class="btn send" type="button" disabled>공지 발송</button>
            </div>

            <div id="preview" class="previewBox">
              <b>발송 대상</b>
              <div class="nums">
                <div class="num"><b id="recipientCount">0</b><span>등록 인원</span></div>
                <div class="num"><b id="deviceCount">0</b><span>수신 가능 기기</span></div>
                <div class="num"><b id="targetLabel">-</b><span>대상 범위</span></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="cardHead"><h2>공지 목록</h2><div class="spacer"></div><button id="refreshBtn" class="btn refresh" type="button">새로고침</button></div>
        <div class="cardBody"><div id="history" class="history"><div class="empty">공지를 불러오는 중...</div></div></div>
      </section>
    </div>
  </main>

<script>
(async () => {
  'use strict';

  const cfg = window.MARUWELL_CONFIG || {};
  const $ = id => document.getElementById(id);
  const state = {
    session:null,
    access:null,
    context:null,
    canEdit:false,
    preview:null,
    imageFile:null,
    imageObjectUrl:null,
    adminStats:new Map(),
  };
  const fnBase = String(cfg.SUPABASE_URL || '').replace(/\/+$/, '') + '/functions/v1';
  let sb = null;

  function getProjectRef(){ try{return new URL(cfg.SUPABASE_URL).hostname.split('.')[0]||'';}catch{return '';} }
  function authBaseKey(){ const ref=getProjectRef(); return ref ? `sb-${ref}-auth-token` : ''; }
  function matchesAuthKey(key){ const base=authBaseKey(); return !!base && !!key && (key===base || key.startsWith(base+'.') || key.startsWith(base+'-code-verifier')); }
  function hasSessionStorage(){
    try{
      for(let i=0;i<sessionStorage.length;i++){
        const k=sessionStorage.key(i);
        if(matchesAuthKey(k) && !String(k).includes('code-verifier') && sessionStorage.getItem(k)) return true;
      }
    }catch{}
    return false;
  }

  async function requestSessionCopy(timeoutMs=1600){
    if(hasSessionStorage()) return true;
    const projectRef=getProjectRef();
    if(!projectRef || !('BroadcastChannel' in window)) return false;
    const channel=new BroadcastChannel('mw-auth-bridge:'+projectRef);
    const requestId='notice-'+Date.now().toString(36)+Math.random().toString(36).slice(2);
    return await new Promise(resolve=>{
      let done=false;
      const finish=ok=>{ if(done)return; done=true; clearTimeout(timer); try{channel.close();}catch{} resolve(ok); };
      const timer=setTimeout(()=>finish(hasSessionStorage()),Math.max(500,timeoutMs));
      channel.addEventListener('message',ev=>{
        const msg=ev.data||{};
        if(msg.projectRef!==projectRef || msg.type!=='MW_SESSION_RESPONSE' || msg.requestId!==requestId) return;
        try{
          for(const row of msg.entries||[]){
            if(!row || !matchesAuthKey(row.key)) continue;
            if(row.value==null) sessionStorage.removeItem(row.key); else sessionStorage.setItem(row.key,row.value);
          }
        }catch{}
        finish(hasSessionStorage());
      });
      try{ channel.postMessage({type:'MW_SESSION_REQUEST',projectRef,requestId,fromTabId:'notice-board'}); }catch{}
    });
  }

  function createSupabase(){
    let storage;
    try{storage=window.sessionStorage;}catch{storage=undefined;}
    return window.supabase.createClient(cfg.SUPABASE_URL,cfg.SUPABASE_ANON_KEY,{
      auth:{persistSession:!!storage,storage,autoRefreshToken:true,detectSessionInUrl:true}
    });
  }

  function esc(v){ return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function formatDate(v){
    try{return new Intl.DateTimeFormat('ko-KR',{year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}).format(new Date(v));}
    catch{return String(v||'');}
  }
  function showStatus(msg,ok=false){ const el=$('status'); el.textContent=msg; el.className='status show '+(ok?'ok':'err'); }
  function clearStatus(){ $('status').className='status'; $('status').textContent=''; }

  async function callFunction(name,payload){
    let token=state.session?.access_token;
    if(!token && sb){
      const {data:{session}}=await sb.auth.getSession();
      state.session=session;
      token=session?.access_token;
    }
    if(!token) throw new Error('로그인 세션을 확인할 수 없습니다.');
    const res=await fetch(`${fnBase}/${name}`,{
      method:'POST',
      headers:{'Content-Type':'application/json','apikey':cfg.SUPABASE_ANON_KEY,'Authorization':`Bearer ${token}`},
      body:JSON.stringify(payload),
      cache:'no-store'
    });
    const text=await res.text();
    let data={};
    try{data=JSON.parse(text);}catch{data={error:text};}
    if(!res.ok) throw new Error(data?.error||`HTTP ${res.status}`);
    return data;
  }

  async function loadAccess(){
    const {data,error}=await sb.rpc('mw_my_access');
    if(error) throw error;
    const row=Array.isArray(data)?data[0]:data;
    if(!row?.is_maroowell) throw new Error('마루웰 소속 계정만 이용할 수 있습니다.');
    state.access=row;
    state.canEdit=row.is_admin===true && Number(row.max_role_level||0)>=90;
    $('roleBadge').textContent=state.canEdit?'최고관리자':'마루웰';
    $('composeCard').classList.toggle('hidden',!state.canEdit);
    $('mainGrid').classList.toggle('viewerOnly',!state.canEdit);
  }

  function selectedCamps(){ return [...document.querySelectorAll('#campBox input:checked')].map(x=>x.value); }
  function selectedAccounts(){ return [...document.querySelectorAll('#accountBox input:checked')].map(x=>x.value); }

  function invalidatePreview(){
    state.preview=null;
    $('preview').classList.remove('show');
    $('sendBtn').disabled=true;
  }

  function renderTargets(){
    if(!state.canEdit || !state.context) return;
    const scope=$('scope').value;
    $('campField').classList.toggle('hidden',scope!=='camp');
    $('accountField').classList.toggle('hidden',scope!=='account');

    const camps=state.context.camps||[];
    $('campBox').innerHTML=camps.length
      ? camps.map(c=>`<label class="targetItem"><input type="checkbox" value="${esc(c.camp)}"><b>${esc(c.camp)}</b><small>${c.registered_users||0}명 / ${c.active_devices||0}기기</small></label>`).join('')
      : '<div class="hint">선택 가능한 캠프가 없습니다.</div>';
    document.querySelectorAll('#campBox input').forEach(x=>x.addEventListener('change',invalidatePreview));

    renderAccounts();
    $('scopeHelp').textContent=scope==='company'
      ? '마루웰 회사전체에 전달합니다.'
      : scope==='camp'
        ? '선택한 캠프의 마루웰 소속 계정에게 전달합니다.'
        : '선택한 개별 계정에게만 전달합니다.';
    invalidatePreview();
  }

  function renderAccounts(){
    if(!state.canEdit || !state.context) return;
    const q=String($('accountSearch').value||'').trim().toLowerCase();
    const rows=(state.context.accounts||[]).filter(a=>!q || [a.display_name,a.email,a.camp].some(v=>String(v||'').toLowerCase().includes(q)));
    $('accountBox').innerHTML=rows.length
      ? rows.map(a=>`<label class="targetItem" style="width:100%"><input type="checkbox" value="${esc(a.user_id)}"><span><b>${esc(a.display_name||a.email||a.user_id)}</b><small style="display:block">${esc(a.camp||'캠프 미지정')} · ${esc(a.email||'')} · ${a.active_devices||0}기기</small></span></label>`).join('')
      : '<div class="hint">검색 결과가 없습니다.</div>';
    document.querySelectorAll('#accountBox input').forEach(x=>x.addEventListener('change',invalidatePreview));
  }

  function syncPopupOptions(){
    const enabled=$('showPopup').checked;
    $('popupOptions').classList.toggle('hidden',!enabled);
    $('imageBtn').disabled=!enabled;
    $('imageInput').disabled=!enabled;
    $('popupDismiss').disabled=!enabled || $('requireAck').checked;
    $('requireAck').disabled=!enabled;
    invalidatePreview();
  }

  function clearImage(){
    if(state.imageObjectUrl){ try{URL.revokeObjectURL(state.imageObjectUrl);}catch{} }
    state.imageObjectUrl=null;
    state.imageFile=null;
    $('imageInput').value='';
    $('imageName').textContent='선택된 이미지 없음 · 최대 10MB';
    $('imagePreview').removeAttribute('src');
    $('imagePreview').classList.remove('show');
  }

  function selectImage(file){
    if(!file){ clearImage(); return; }
    const allowed=['image/jpeg','image/png','image/webp','image/heic','image/heif'];
    if(!allowed.includes(String(file.type||'').toLowerCase())){ showStatus('JPG, PNG, WEBP, HEIC, HEIF 이미지만 등록할 수 있습니다.'); clearImage(); return; }
    if(file.size>10*1024*1024){ showStatus('이미지는 10MB 이하만 등록할 수 있습니다.'); clearImage(); return; }
    clearImage();
    state.imageFile=file;
    state.imageObjectUrl=URL.createObjectURL(file);
    $('imageName').textContent=`${file.name} · ${(file.size/1024/1024).toFixed(2)}MB`;
    $('imagePreview').src=state.imageObjectUrl;
    $('imagePreview').classList.add('show');
    invalidatePreview();
  }

  async function uploadImage(){
    const file=state.imageFile;
    if(!file || !$('showPopup').checked) return '';
    const mime=String(file.type||'image/jpeg').toLowerCase();
    const ext= mime==='image/png'?'png' : mime==='image/webp'?'webp' : mime==='image/heic'?'heic' : mime==='image/heif'?'heif' : 'jpg';
    const uid=state.session?.user?.id || state.access?.user_id || 'unknown';
    const uuid=(crypto.randomUUID?crypto.randomUUID():Math.random().toString(36).slice(2)+Date.now().toString(36));
    const path=`notices/${uid}/${Date.now()}-${uuid}.${ext}`;
    const {data,error}=await sb.storage.from('app-notice-images').upload(path,file,{contentType:mime,upsert:false});
    if(error) throw error;
    return sb.storage.from('app-notice-images').getPublicUrl(data.path).data.publicUrl;
  }

  function payload(action){
    const scope=$('scope').value;
    return {
      action,
      target_scope:scope,
      target_camps:scope==='camp'?selectedCamps():[],
      target_user_ids:scope==='account'?selectedAccounts():[],
      notice_type:$('noticeType').value,
      title:$('title').value.trim(),
      body:$('body').value.trim(),
      send_push:$('sendPush').checked,
      show_as_popup:$('showPopup').checked,
      popup_image_url:'',
      popup_allow_dismiss:$('popupDismiss').checked,
      require_ack:$('requireAck').checked
    };
  }

  async function preview(){
    clearStatus();
    const p=payload('preview');
    if(p.target_scope==='camp'&&!p.target_camps.length) return showStatus('대상 캠프를 하나 이상 선택하세요.');
    if(p.target_scope==='account'&&!p.target_user_ids.length) return showStatus('대상 계정을 하나 이상 선택하세요.');
    if(!p.send_push&&!p.show_as_popup) return showStatus('PUSH 또는 로그인 팝업을 하나 이상 선택하세요.');
    $('previewBtn').disabled=true;
    try{
      const data=await callFunction('app-notice-dispatch',p);
      state.preview=data;
      $('recipientCount').textContent=data.recipient_count??0;
      $('deviceCount').textContent=data.active_device_count??0;
      $('targetLabel').textContent=p.target_scope==='company'?'전체':p.target_scope==='camp'?'캠프':'개별';
      $('preview').classList.add('show');
      $('sendBtn').disabled=(data.recipient_count??0)<1;
      if(p.send_push&&(data.active_device_count??0)<1) showStatus('대상 인원은 있으나 현재 PUSH 수신 가능 기기가 0대입니다.');
    }catch(e){
      showStatus(e.message||String(e));
    }finally{
      $('previewBtn').disabled=false;
    }
  }

  async function send(){
    const p=payload('send');
    if(!p.title||!p.body) return showStatus('제목과 내용을 입력하세요.');
    if(!state.preview) return showStatus('먼저 대상 확인을 눌러주세요.');
    const modes=[p.send_push?'PUSH':'',p.show_as_popup?'로그인 팝업':''].filter(Boolean).join(' + ');
    if(!confirm(`대상 ${state.preview.recipient_count||0}명에게 ${modes} 공지를 발송할까요?\n\n${p.title}`)) return;

    $('sendBtn').disabled=true;
    $('previewBtn').disabled=true;
    clearStatus();

    try{
      if(state.imageFile && p.show_as_popup){
        showStatus('이미지를 업로드하고 있습니다.',true);
        p.popup_image_url=await uploadImage();
      }
      const data=await callFunction('app-notice-dispatch',p);
      showStatus(`공지 발송 완료 · 성공 ${data.sent_users||0}명 / 실패 ${data.failed_users||0}명 / 미수신 ${data.skipped_users||0}명`,true);
      $('title').value='';
      $('body').value='';
      $('noticeType').value='normal';
      $('sendPush').checked=true;
      $('showPopup').checked=true;
      $('popupDismiss').checked=true;
      $('requireAck').checked=false;
      clearImage();
      invalidatePreview();
      syncPopupOptions();
      await loadNotices();
    }catch(e){
      showStatus(e.message||String(e));
      $('sendBtn').disabled=false;
    }finally{
      $('previewBtn').disabled=false;
    }
  }

  function scopeLabel(n){
    if(n.target_scope==='company') return '회사전체';
    if(n.target_scope==='account') return '개별 계정';
    return (n.target_camps||[]).join(', ') || '캠프';
  }

  function typeLabel(type){ return type==='emergency'?'긴급':type==='important'?'중요':'일반'; }

  function renderNotices(rows){
    if(!rows?.length){
      $('history').innerHTML='<div class="empty">등록된 공지가 없습니다.</div>';
      return;
    }

    $('history').innerHTML=rows.map(n=>{
      const type=n.notice_type||'normal';
      const modes=[n.send_push?'PUSH':'',n.show_as_popup?'팝업':''].filter(Boolean);
      const stats=state.adminStats.get(n.id);
      const image=n.popup_image_url
        ? `<img class="noticeImage" src="${esc(n.popup_image_url)}" alt="공지 이미지" loading="lazy">`
        : '';
      const statline=state.canEdit && stats
        ? `<div class="statline"><span class="stat">대상 ${n.recipient_count||0}</span><span class="stat">성공 ${stats.sent||0}</span><span class="stat">실패 ${stats.failed||0}</span><span class="stat">미수신 ${stats.skipped||0}</span><span class="stat">열람 ${stats.opened||0}</span><span class="stat">확인 ${stats.acknowledged||0}</span></div>`
        : '';

      return `<article class="notice">
        <div class="noticeTop">
          <span class="pill ${esc(type)}">${esc(typeLabel(type))}</span>
          <span class="pill normal">${esc(scopeLabel(n))}</span>
          ${modes.map(m=>`<span class="pill mode">${esc(m)}</span>`).join('')}
        </div>
        <h3>${esc(n.title)}</h3>
        <p>${esc(n.body)}</p>
        ${image}
        <div class="meta">${esc(formatDate(n.created_at))}</div>
        ${statline}
      </article>`;
    }).join('');
  }

  async function loadAdminStats(){
    state.adminStats=new Map();
    if(!state.canEdit) return;
    try{
      const data=await callFunction('app-push-console',{action:'history'});
      for(const n of data.notices||[]) state.adminStats.set(n.id,n.stats||{});
    }catch{}
  }

  async function loadNotices(){
    $('history').innerHTML='<div class="empty">공지를 불러오는 중...</div>';
    try{
      await loadAdminStats();
      const {data,error}=await sb.from('app_notices')
        .select('id,title,body,notice_type,target_scope,target_camps,send_push,show_as_popup,popup_image_url,require_ack,recipient_count,is_active,expires_at,created_at,updated_at')
        .eq('is_active',true)
        .order('created_at',{ascending:false})
        .limit(100);
      if(error) throw error;
      renderNotices(data||[]);
    }catch(e){
      $('history').innerHTML=`<div class="empty">${esc(e.message||String(e))}</div>`;
    }
  }

  async function initComposer(){
    if(!state.canEdit) return;
    const data=await callFunction('app-push-console',{action:'context'});
    state.context=data;
    renderTargets();
    syncPopupOptions();
  }

  async function init(){
    try{
      if(!cfg.SUPABASE_URL||!cfg.SUPABASE_ANON_KEY||!window.supabase?.createClient) throw new Error('Supabase 웹 설정을 불러오지 못했습니다.');
      await requestSessionCopy(1800);
      sb=createSupabase();
      let {data:{session}}=await sb.auth.getSession();
      if(!session){
        await requestSessionCopy(1200);
        ({data:{session}}=await sb.auth.getSession());
      }
      if(!session){
        $('loadingText').textContent='로그인이 필요합니다.';
        $('loadingSub').textContent='로그인 후 공지사항을 이용할 수 있습니다.';
        $('loginBtn').classList.remove('hidden');
        return;
      }

      state.session=session;
      await loadAccess();
      await initComposer();
      await loadNotices();
      $('loading').classList.add('hidden');
    }catch(e){
      $('loadingText').textContent='공지사항을 불러오지 못했습니다.';
      $('loadingSub').textContent=e.message||String(e);
      $('loginBtn').classList.remove('hidden');
    }
  }

  $('loginBtn').addEventListener('click',()=>{ location.href='/?next='+encodeURIComponent('/maroowell_push'); });
  $('refreshBtn').addEventListener('click',loadNotices);
  $('scope').addEventListener('change',renderTargets);
  $('accountSearch').addEventListener('input',renderAccounts);
  $('sendPush').addEventListener('change',invalidatePreview);
  $('showPopup').addEventListener('change',syncPopupOptions);
  $('popupDismiss').addEventListener('change',invalidatePreview);
  $('requireAck').addEventListener('change',()=>{
    if($('requireAck').checked) $('popupDismiss').checked=false;
    $('popupDismiss').disabled=!$('showPopup').checked || $('requireAck').checked;
    invalidatePreview();
  });
  $('noticeType').addEventListener('change',invalidatePreview);
  $('title').addEventListener('input',invalidatePreview);
  $('body').addEventListener('input',invalidatePreview);
  $('imageBtn').addEventListener('click',()=>{ if(!$('imageInput').disabled) $('imageInput').click(); });
  $('imageInput').addEventListener('change',()=>selectImage($('imageInput').files?.[0]||null));
  $('previewBtn').addEventListener('click',preview);
  $('sendBtn').addEventListener('click',send);

  await init();
})();
</script>
</body>
</html>