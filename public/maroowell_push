<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>마루웰 PUSH 알림</title>
  <link rel="icon" href="/favicon.ico?v=2" />
  <script src="/config.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="/board-menu.js?v=20260823-push2" defer></script>
  <style>
    :root{
      --bg:#f6f8fc;--card:#fff;--line:#dbe3ef;--line2:#cbd5e1;--text:#0f172a;--muted:#64748b;
      --blue:#2563eb;--blueSoft:#eff6ff;--red:#dc2626;--redSoft:#fef2f2;--amber:#d97706;--amberSoft:#fffbeb;--green:#15803d;--greenSoft:#f0fdf4;
      --shadow:0 14px 36px rgba(15,23,42,.08)
    }
    *{box-sizing:border-box}
    html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Noto Sans KR",Segoe UI,Roboto,Arial,sans-serif}
    body{padding-bottom:40px}
    button,input,textarea,select{font:inherit}
    .top{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:12px;padding:13px 16px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.96);backdrop-filter:blur(10px);box-shadow:0 3px 14px rgba(15,23,42,.04)}
    .top img{width:34px;height:34px;display:block}.top h1{font-size:20px;margin:0}.top p{font-size:12px;margin:3px 0 0;color:var(--muted);font-weight:800}.spacer{flex:1}
    .badge,.menuBtn{height:36px;display:inline-flex;align-items:center;padding:0 12px;border:1px solid var(--line2);border-radius:999px;font-size:12px;font-weight:900;background:#fff;color:#334155;white-space:nowrap}
    .menuBtn{cursor:pointer;color:#1d4ed8}.menuBtn:hover{background:#eff6ff;border-color:#93c5fd}
    .wrap{max-width:1180px;margin:0 auto;padding:18px}.grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(360px,.92fr);gap:16px}@media(max-width:900px){.grid{grid-template-columns:1fr}.wrap{padding:12px}}
    .card{border:1px solid var(--line);border-radius:20px;background:var(--card);box-shadow:var(--shadow);overflow:hidden}.cardHead{padding:16px 18px;border-bottom:1px solid #edf2f7;display:flex;align-items:center;gap:10px}.cardHead h2{margin:0;font-size:17px}.cardBody{padding:17px}.hint{font-size:12px;color:var(--muted);line-height:1.5}
    .form{display:grid;gap:14px}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:600px){.row{grid-template-columns:1fr}.top p{display:none}.badge{display:none}}
    .field{display:grid;gap:6px}.field label{font-size:12px;font-weight:900;color:#334155}.input,.select,.textarea{width:100%;border:1px solid var(--line2);background:#fff;color:var(--text);border-radius:12px;outline:none}.input,.select{height:44px;padding:0 12px}.textarea{min-height:145px;padding:12px;resize:vertical}.input:focus,.select:focus,.textarea:focus{border-color:#60a5fa;box-shadow:0 0 0 3px rgba(96,165,250,.13)}
    .typeRow{display:flex;gap:8px;flex-wrap:wrap}.typeBtn{border:1px solid var(--line2);background:#fff;color:#334155;border-radius:999px;padding:9px 13px;font-weight:900;cursor:pointer}.typeBtn.active[data-value="emergency"]{background:var(--redSoft);border-color:#fca5a5;color:#b91c1c}.typeBtn.active[data-value="important"]{background:var(--amberSoft);border-color:#fcd34d;color:#92400e}.typeBtn.active[data-value="normal"]{background:var(--blueSoft);border-color:#93c5fd;color:#1d4ed8}
    .campBox{display:flex;gap:8px;flex-wrap:wrap}.camp{display:flex;gap:7px;align-items:center;padding:9px 11px;border:1px solid var(--line);border-radius:12px;background:#f8fafc;cursor:pointer}.camp input{accent-color:#2563eb}.camp small{color:var(--muted)}
    .actions{display:flex;gap:9px;flex-wrap:wrap}.btn{border:0;border-radius:12px;padding:11px 15px;color:#fff;font-weight:1000;cursor:pointer}.btn:disabled{opacity:.45;cursor:not-allowed}.btn.previewBtn{background:#475569}.btn.send{background:var(--red)}.btn.refresh{background:#1d4ed8}
    .previewBox{display:none;margin-top:4px;border:1px solid #bfdbfe;background:var(--blueSoft);border-radius:14px;padding:13px}.previewBox.show{display:block}.nums{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:9px}.num{padding:10px;border:1px solid #dbeafe;border-radius:12px;background:#fff;text-align:center}.num b{display:block;font-size:22px}.num span{font-size:11px;color:var(--muted);font-weight:900}
    .status{display:none;margin-bottom:12px;padding:11px 13px;border-radius:12px;font-size:13px;font-weight:800}.status.show{display:block}.status.ok{background:var(--greenSoft);border:1px solid #bbf7d0;color:#166534}.status.err{background:var(--redSoft);border:1px solid #fecaca;color:#991b1b}
    .scopeHelp{padding:10px 12px;border-radius:12px;background:#f8fafc;border:1px solid #e2e8f0;font-size:12px;color:var(--muted)}
    .history{display:grid;gap:10px}.notice{border:1px solid var(--line);border-radius:14px;padding:13px;background:#fff}.noticeTop{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.pill{padding:4px 8px;border-radius:999px;font-size:11px;font-weight:1000}.pill.emergency{background:var(--redSoft);color:#b91c1c}.pill.important{background:var(--amberSoft);color:#92400e}.pill.normal{background:var(--blueSoft);color:#1d4ed8}.notice h3{margin:9px 0 4px;font-size:15px}.notice p{margin:0;color:#475569;font-size:13px;line-height:1.45;white-space:pre-wrap}.meta{margin-top:9px;color:var(--muted);font-size:11px}.statline{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.stat{font-size:11px;padding:5px 7px;border-radius:8px;background:#f1f5f9;color:#475569}.empty{padding:30px;text-align:center;color:var(--muted)}
    .loading{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(246,248,252,.96);font-weight:900;color:#334155}.loadingCard{width:min(420px,100%);padding:24px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:var(--shadow);text-align:center}.loadingCard small{display:block;margin-top:8px;color:var(--muted);font-weight:700;line-height:1.5}.loadingCard button{margin-top:14px}.hidden{display:none!important}
  </style>
</head>
<body>
  <div id="loading" class="loading"><div class="loadingCard"><div id="loadingText">PUSH 발송 권한 확인 중...</div><small id="loadingSub">로그인 세션과 팀장 권한을 확인하고 있습니다.</small><button id="loginBtn" class="btn refresh hidden" type="button">로그인 화면으로</button></div></div>
  <header class="top">
    <a href="/zipcode_search" aria-label="홈"><img src="/favicon.ico?v=2" alt="마루웰"></a>
    <div><h1>PUSH 알림</h1><p>긴급 상황 · 팀 공지 · 전사 알림</p></div>
    <div class="spacer"></div>
    <button id="mwBoardMenuToggle" class="menuBtn" type="button">게시판 메뉴</button>
    <span id="roleBadge" class="badge">권한 확인 중</span>
  </header>

  <main class="wrap">
    <div class="grid">
      <section class="card">
        <div class="cardHead"><h2>알림 발송</h2></div>
        <div class="cardBody">
          <div id="status" class="status"></div>
          <div class="form">
            <div class="field"><label>알림 종류</label><div class="typeRow"><button class="typeBtn active" data-value="emergency" type="button">🚨 긴급</button><button class="typeBtn" data-value="important" type="button">⚠️ 중요</button><button class="typeBtn" data-value="normal" type="button">🔔 일반</button></div></div>
            <div class="row"><div class="field"><label>소속</label><select id="vendor" class="select"></select></div><div class="field"><label>발송 범위</label><select id="scope" class="select"></select></div></div>
            <div class="field" id="campField"><label>대상 캠프</label><div id="campBox" class="campBox"></div><div class="hint">팀장은 본인에게 등록된 캠프만 선택할 수 있고, 총괄팀장 이상은 소속 벤더 전체 캠프를 선택할 수 있습니다.</div></div>
            <div id="scopeHelp" class="scopeHelp"></div>
            <div class="field"><label>제목</label><input id="title" class="input" maxlength="120" placeholder="예: 카카오톡 장애 관련 긴급 안내"></div>
            <div class="field"><label>내용</label><textarea id="body" class="textarea" maxlength="2000" placeholder="기사님에게 전달할 내용을 입력하세요."></textarea></div>
            <div class="actions"><button id="previewBtn" class="btn previewBtn" type="button">대상 확인</button><button id="sendBtn" class="btn send" type="button" disabled>긴급 PUSH 발송</button></div>
            <div id="preview" class="previewBox"><b>발송 대상</b><div class="nums"><div class="num"><b id="recipientCount">0</b><span>등록 인원</span></div><div class="num"><b id="deviceCount">0</b><span>수신 가능 기기</span></div><div class="num"><b id="roleLevel">-</b><span>발송 권한</span></div></div><p class="hint" style="margin-bottom:0">실제 PUSH는 앱 1.1.8 이상에서 FCM 토큰이 등록된 기기에 전송됩니다.</p></div>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="cardHead"><h2>발송 이력</h2><div class="spacer"></div><button id="refreshBtn" class="btn refresh" type="button">새로고침</button></div>
        <div class="cardBody"><div id="history" class="history"><div class="empty">발송 이력을 불러오는 중...</div></div></div>
      </section>
    </div>
  </main>

<script>
(async () => {
  'use strict';
  const cfg = window.MARUWELL_CONFIG || {};
  const $ = id => document.getElementById(id);
  const state = { session:null, context:null, noticeType:'emergency', preview:null };
  const fnBase = String(cfg.SUPABASE_URL || '').replace(/\/+$/, '') + '/functions/v1';

  function getProjectRef(){ try{return new URL(cfg.SUPABASE_URL).hostname.split('.')[0]||'';}catch{return '';} }
  function authBaseKey(){ const ref=getProjectRef(); return ref?`sb-${ref}-auth-token`:''; }
  function matchesAuthKey(key){ const base=authBaseKey(); return !!base && !!key && (key===base || key.startsWith(base+'.') || key.startsWith(base+'-code-verifier')); }
  function hasSessionStorage(){ try{ for(let i=0;i<sessionStorage.length;i++){ const k=sessionStorage.key(i); if(matchesAuthKey(k)&&!String(k).includes('code-verifier')&&sessionStorage.getItem(k)) return true; } }catch{} return false; }

  async function requestSessionCopy(timeoutMs=1600){
    if(hasSessionStorage()) return true;
    const projectRef=getProjectRef();
    if(!projectRef || !('BroadcastChannel' in window)) return false;
    const channel=new BroadcastChannel('mw-auth-bridge:'+projectRef);
    const requestId='push-'+Date.now().toString(36)+Math.random().toString(36).slice(2);
    return await new Promise(resolve=>{
      let done=false;
      const timer=setTimeout(()=>finish(hasSessionStorage()),Math.max(500,timeoutMs));
      const finish=ok=>{ if(done)return; done=true; clearTimeout(timer); try{channel.close();}catch{} resolve(ok); };
      channel.addEventListener('message',ev=>{
        const msg=ev.data||{};
        if(msg.projectRef!==projectRef || msg.type!=='MW_SESSION_RESPONSE' || msg.requestId!==requestId) return;
        try{ for(const row of msg.entries||[]){ if(!row||!matchesAuthKey(row.key)) continue; if(row.value==null) sessionStorage.removeItem(row.key); else sessionStorage.setItem(row.key,row.value); } }catch{}
        finish(hasSessionStorage());
      });
      try{ channel.postMessage({type:'MW_SESSION_REQUEST',projectRef,requestId,fromTabId:'push-console'}); }catch{}
    });
  }

  function createSupabase(){
    let storage;
    try{storage=window.sessionStorage;}catch{storage=undefined;}
    return window.supabase.createClient(cfg.SUPABASE_URL,cfg.SUPABASE_ANON_KEY,{auth:{persistSession:!!storage,storage,autoRefreshToken:true,detectSessionInUrl:true}});
  }

  function showStatus(msg, ok=false){ const el=$('status'); el.textContent=msg; el.className='status show '+(ok?'ok':'err'); }
  function clearStatus(){ $('status').className='status'; $('status').textContent=''; }
  function selectedMembership(){ const id=$('vendor').value; return (state.context?.memberships||[]).find(m=>m.vendor_id===id)||null; }
  function selectedCamps(){ return [...document.querySelectorAll('#campBox input:checked')].map(x=>x.value); }
  function formatDate(v){ try{return new Intl.DateTimeFormat('ko-KR',{dateStyle:'short',timeStyle:'short'}).format(new Date(v));}catch{return String(v||'');} }
  function esc(v){ return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  let sb=null;
  async function callFunction(name,payload){
    let token=state.session?.access_token;
    if(!token && sb){ const {data:{session}}=await sb.auth.getSession(); state.session=session; token=session?.access_token; }
    if(!token) throw new Error('로그인 세션을 확인할 수 없습니다.');
    const res=await fetch(`${fnBase}/${name}`,{method:'POST',headers:{'Content-Type':'application/json','apikey':cfg.SUPABASE_ANON_KEY,'Authorization':`Bearer ${token}`},body:JSON.stringify(payload),cache:'no-store'});
    const text=await res.text(); let data={}; try{data=JSON.parse(text);}catch{data={error:text};}
    if(!res.ok) throw new Error(data?.error||`HTTP ${res.status}`);
    return data;
  }

  function renderVendors(){
    const memberships=state.context?.memberships||[];
    $('vendor').innerHTML=memberships.map(m=>`<option value="${esc(m.vendor_id)}">${esc(m.vendor_name)} · Lv.${m.role_level}</option>`).join('');
    if(state.context?.company_admin) $('vendor').insertAdjacentHTML('beforeend','<option value="__company__">마루웰 전사 관리자</option>');
    renderScope();
  }
  function renderScope(){
    const company=$('vendor').value==='__company__'; const m=selectedMembership(); const opts=[];
    if(company) opts.push('<option value="company">전사 전체</option>');
    else if(m){ opts.push('<option value="camp">캠프 선택</option>'); if(m.can_vendor_broadcast) opts.push('<option value="vendor">소속 전체 캠프</option>'); }
    $('scope').innerHTML=opts.join(''); renderCamps(); invalidatePreview();
  }
  function renderCamps(){
    const m=selectedMembership(); const scope=$('scope').value;
    $('campField').classList.toggle('hidden',scope!=='camp');
    if(!m){ $('campBox').innerHTML=''; $('scopeHelp').textContent='전사 공지는 전체 앱 사용자에게 발송됩니다.'; return; }
    const camps=m.camps||[];
    $('campBox').innerHTML=camps.length?camps.map(c=>`<label class="camp"><input type="checkbox" value="${esc(c.camp)}"><b>${esc(c.camp)}</b><small>${c.registered_users}명 / ${c.active_devices}기기</small></label>`).join(''):'<div class="hint">등록된 담당 캠프가 없습니다.</div>';
    document.querySelectorAll('#campBox input').forEach(x=>x.addEventListener('change',invalidatePreview));
    $('scopeHelp').textContent=(m.role_level||0)>=60?'총괄팀장 이상: 소속 전체 또는 원하는 캠프를 선택해서 발송할 수 있습니다.':'팀장: 등록된 담당 캠프의 등록 인원에게만 발송할 수 있습니다.';
  }
  function invalidatePreview(){ state.preview=null; $('preview').classList.remove('show'); $('sendBtn').disabled=true; }
  function payload(action){ const scope=$('scope').value; const company=scope==='company'; const m=selectedMembership(); return {action,target_scope:scope,vendor_id:company?null:m?.vendor_id||null,target_camps:scope==='camp'?selectedCamps():[],notice_type:state.noticeType,title:$('title').value.trim(),body:$('body').value.trim(),send_push:true,show_on_home:false,require_ack:false}; }

  async function preview(){
    clearStatus(); const p=payload('preview');
    if(p.target_scope==='camp'&&!p.target_camps.length) return showStatus('대상 캠프를 하나 이상 선택하세요.');
    $('previewBtn').disabled=true;
    try{
      const data=await callFunction('app-push-dispatch',p); state.preview=data;
      $('recipientCount').textContent=data.recipient_count??0; $('deviceCount').textContent=data.active_device_count??0; $('roleLevel').textContent='Lv.'+(data.sender_role_level??'-'); $('preview').classList.add('show'); $('sendBtn').disabled=(data.recipient_count??0)<1;
      if((data.active_device_count??0)<1) showStatus('대상 인원은 있으나 현재 PUSH 수신 가능 기기가 0대입니다. 앱 1.1.8 로그인 후 토큰이 등록되어야 합니다.');
    }catch(e){showStatus(e.message||String(e));}finally{$('previewBtn').disabled=false;}
  }
  async function send(){
    const p=payload('send'); if(!p.title||!p.body) return showStatus('제목과 내용을 입력하세요.'); if(!state.preview) return showStatus('먼저 대상 확인을 눌러주세요.');
    if(!confirm(`등록 ${state.preview.recipient_count||0}명 / 수신 가능 ${state.preview.active_device_count||0}기기에게 PUSH를 발송할까요?\n\n${p.title}`)) return;
    $('sendBtn').disabled=true; clearStatus();
    try{ const data=await callFunction('app-push-dispatch',p); showStatus(`발송 완료 · 성공 ${data.sent_users||0}명 / 실패 ${data.failed_users||0}명 / 미수신 ${data.skipped_users||0}명`,true); $('title').value=''; $('body').value=''; invalidatePreview(); await loadHistory(); }
    catch(e){showStatus(e.message||String(e)); $('sendBtn').disabled=false;}
  }
  function renderHistory(rows){
    if(!rows?.length){ $('history').innerHTML='<div class="empty">아직 발송된 알림이 없습니다.</div>'; return; }
    $('history').innerHTML=rows.map(n=>{const s=n.stats||{};const type=n.notice_type||'normal';const scope=n.target_scope==='company'?'전사':n.target_scope==='vendor'?'소속 전체':(n.target_camps||[]).join(', ');return `<article class="notice"><div class="noticeTop"><span class="pill ${esc(type)}">${type==='emergency'?'긴급':type==='important'?'중요':'일반'}</span><span class="pill normal">${esc(scope||'-')}</span></div><h3>${esc(n.title)}</h3><p>${esc(n.body)}</p><div class="meta">${esc(formatDate(n.created_at))} · 대상 ${n.recipient_count||0}명</div><div class="statline"><span class="stat">성공 ${s.sent||0}</span><span class="stat">실패 ${s.failed||0}</span><span class="stat">미수신 ${s.skipped||0}</span><span class="stat">대기 ${s.pending||0}</span><span class="stat">열람 ${s.opened||0}</span><span class="stat">확인 ${s.acknowledged||0}</span></div></article>`;}).join('');
  }
  async function loadHistory(){ try{ const data=await callFunction('app-push-console',{action:'history'}); renderHistory(data.notices||[]); }catch(e){ $('history').innerHTML=`<div class="empty">${esc(e.message||String(e))}</div>`; } }

  async function init(){
    try{
      if(!cfg.SUPABASE_URL||!cfg.SUPABASE_ANON_KEY||!window.supabase?.createClient) throw new Error('Supabase 웹 설정을 불러오지 못했습니다.');
      await requestSessionCopy(1800);
      sb=createSupabase();
      let {data:{session}}=await sb.auth.getSession();
      if(!session){ await requestSessionCopy(1200); ({data:{session}}=await sb.auth.getSession()); }
      if(!session){
        $('loadingText').textContent='로그인이 필요합니다.';
        $('loadingSub').textContent='기존 로그인 세션을 찾지 못했습니다. 자동으로 계속 튕기지 않도록 이 화면에서 멈춥니다.';
        $('loginBtn').classList.remove('hidden');
        return;
      }
      state.session=session;
      const data=await callFunction('app-push-console',{action:'bootstrap'}); state.context=data;
      const maxLevel=Math.max(0,...(data.memberships||[]).map(m=>Number(m.role_level||0)));
      $('roleBadge').textContent=data.company_admin?'전사 관리자':`팀장 Lv.${maxLevel}`;
      renderVendors(); renderHistory(data.notices||[]); $('loading').classList.add('hidden');
    }catch(e){
      $('loadingText').textContent='PUSH 권한 확인 실패'; $('loadingSub').textContent=e.message||String(e); $('loginBtn').classList.remove('hidden');
    }
  }

  $('loginBtn').addEventListener('click',()=>{location.href='/?next='+encodeURIComponent('/maroowell_push');});
  $('vendor').addEventListener('change',renderScope); $('scope').addEventListener('change',()=>{renderCamps();invalidatePreview();});
  $('previewBtn').addEventListener('click',preview); $('sendBtn').addEventListener('click',send); $('refreshBtn').addEventListener('click',loadHistory);
  $('title').addEventListener('input',invalidatePreview); $('body').addEventListener('input',invalidatePreview);
  document.querySelectorAll('.typeBtn').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.typeBtn').forEach(x=>x.classList.remove('active'));btn.classList.add('active');state.noticeType=btn.dataset.value;invalidatePreview();$('sendBtn').textContent=state.noticeType==='emergency'?'긴급 PUSH 발송':'PUSH 발송';}));
  await init();
})();
</script>
</body>
</html>
