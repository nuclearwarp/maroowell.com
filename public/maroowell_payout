function openAssignment(row=null,existing=null){const r=existing||{},v=row||{},source=r.source_id||String(v.source_id||'').replace(/@df$/i,''),target=r.target_driver_id||((v.driver_id&&v.driver_id!=='company')?v.driver_id:'');
 const list=(state.data?.assignments||[]).map(a=>`<tr><td>${esc(a.source_id)}</td><td>${esc(name(a.target_kind==='company'?'company':a.target_driver_id))}</td><td>${esc([a.date_from,a.date_to,a.camp,a.route,a.classify].filter(Boolean).join(' / ')||'해당 월 전체')}${a.source_row_key?' / 원본 행':''}</td><td><button class="small" data-edit-assignment="${esc(a.id)}">수정</button> <button class="small danger" data-delete-assignment="${esc(a.id)}" ${locked()?'disabled':''}>삭제</button></td></tr>`).join('');
 openDialog('월별 귀속 변경',`<p class="note">${esc(state.month)}에만 적용됩니다. 원본 ID는 고치지 않고 실제 정산 대상을 별도 기록합니다. 행 지정 → 조건부 → 월 전체 순으로 우선합니다.</p><div class="formGrid">${field('원본 ID','source_id',source)}${select('귀속 대상','target',r.target_kind==='company'?'company':target,[['','기사 선택'],['company','회사 귀속'],...(state.data?.drivers||[]).map(d=>[d.pk_id,`${d.person_name} / ${d.coupang_id}`])])}${field('시작일 (비우면 제한 없음)','date_from',r.date_from||'','date')}${field('종료일','date_to',r.date_to||'','date')}${field('캠프 조건','camp',r.camp||'')}${field('라우트 조건','route',r.route||'')}${field('주간/심야 조건','wave',r.wave||'')}${field('구분 조건','classify',r.classify||'')}${field('사유 (필수)','reason',r.reason||'', 'text',true)}${field('특정 원본 행 키 (선택)','source_row_key',r.source_row_key||v.row_key||'','text',true)}</div><h3>저장된 규칙</h3><div class="tableWrap"><table><thead><tr><th>원본 ID</th><th>귀속</th><th>범위</th><th></th></tr></thead><tbody>${list||'<tr><td colspan="4">규칙이 없습니다.</td></tr>'}</tbody></table></div>`,buttons('saveAssignment'));
 $('#saveAssignment').onclick=()=>{const x=values();if(!x.source_id.trim()||!x.target||!x.reason.trim())return toast('원본 ID, 귀속 대상, 사유를 입력하세요.');if(x.date_from&&x.date_to&&x.date_from>x.date_to)return toast('날짜 범위를 확인하세요.');busy(async()=>{await command('assignment_save',{...x,id:r.id||null,target_kind:x.target==='company'?'company':'driver',target_driver_id:x.target==='company'?null:x.target});$('#dialog').close();});};
}
function openDriver(id){const d=state.data.drivers.find(x=>String(x.pk_id)===String(id));if(!d)return;const s=state.data.driver_settings?.[id]||{};const section=t=>`<div class="formSection">${t}</div>`;
 openDialog(`${d.person_name} · ${state.month} 정산 기준`,`<p class="note">기사정보 원본을 고치지 않고 이번 달 적용값만 저장합니다. 빈 숫자칸은 원본 기본값으로 돌아갑니다.</p><div class="formGrid">${field('캠프','camp',s.camp??d.camp_code)}${field('주간/야간','wave',s.wave??d.wave)}${select('단가 방식','rate_mode',s.rate_mode||'', [['','기사정보 기본'],['commission','원본 단가 - 건당 수수료'],['fixed','고정 단가'],['route','라우트별 단가']])}${select('라우트 단가 구분','rate_kind',s.rate_kind||'고정',[['고정','고정'],['백업','백업'],['백업2','백업2'],['팀장','팀장']])}${field('고정 단가 (VAT 포함)','unit_price',s.unit_price??'','number')}${field('건당 수수료','commission',s.commission??'','number')}${select('고용산재','insurance_flag',s.insurance_flag||d.employment_accident_insurance||'',[['','확인 필요'],['O','적용'],['X','제외']])}${field('배번호 관리비 (빈칸=차량기준)','license_fee',s.license_fee??'','number')}${check('보험 기준 금액이 이미 부가세 제외 금액 (엑셀 U열 O)','vat_excluded',s.vat_excluded)}${section('프로모션 / 수수료')}${field('월 고정 프로모션','promotion_fixed',s.promotion_fixed??0,'number')}${field('배송+반품 건당 프로모션','promotion_per_unit',s.promotion_per_unit??0,'number')}${field('동일 캠프 타 기사 건당 운영비','management_per_unit',s.management_per_unit??0,'number')}${field('운영비 대상 캠프','management_camp',s.management_camp||'')}${field('수동 지급 조정 (+/-)','gross_adjustment',s.gross_adjustment??0,'number')}${field('조정 사유','adjustment_reason',s.adjustment_reason||'')}${section('외부 용차 / 타 정산')}${field('회사가 받은 외부 수입','external_receipt',s.external_receipt??0,'number')}${field('외부 실지급액 (보험 합산 기준)','other_paid',s.other_paid??0,'number')}${field('외부 선공제 고용산재','other_insurance',s.other_insurance??0,'number')}${field('외부 회사 보험 부담','other_employer',s.other_employer??'','number')}${check('용차 DB와 대조하고 위 입력금액을 확인함','external_reviewed',s.external_reviewed)}${field('외부 정산 확인 사유','external_reason',s.external_reason||'','text',true)}${section('엑셀 비교 / 제외 항목 검토')}${field('엑셀 실지급 참고액','reference_net',s.reference_net??'','number')}${field('차이 확인 사유','reference_reason',s.reference_reason||'')}${check('엑셀 참고액과의 차이를 확인함 (사유 필수)','reference_reviewed',s.reference_reviewed)}${check('수기반영 배송 수량을 자동 지급에서 제외함을 확인','manual_parcel_reviewed',s.manual_parcel_reviewed)}${check('산정기간 밖 배송/수기 수량의 제외를 확인','outside_period_reviewed',s.outside_period_reviewed)}${check('이 기사의 월별 정산 기준을 확인함','reviewed',s.reviewed)}</div>`,buttons('saveDriver'));
 $('#saveDriver').onclick=()=>{const x=values();if(x.reference_reviewed&&!x.reference_reason.trim())return toast('차이 확인 사유를 입력하세요.');busy(async()=>{if(x.rate_mode==='')x.rate_mode=null;await command('driver_save',{driver_id:id,settings:x});$('#dialog').close();});};
}
function openMonthSettings(){const s=state.data?.meta?.settings||{};
 openDialog('월별 계산 기준',`<p class="note">보험 계산은 첨부 엑셀의 계수(0.654, 0.8%, 0.88%, 최저 기준)를 이식한 것입니다. 법령·공단 고지서 적합성이 자동 검증된 것은 아닙니다.</p><div class="formGrid">${check('이번 달 고용·산재 계산 기준을 확인함','insurance_rules_reviewed',s.insurance_rules_reviewed)}${check('이번 달 고정비 목록을 확인함','company_costs_reviewed',s.company_costs_reviewed)}${field('확인 메모','review_note',s.review_note||'','text',true)}<label class="wide">월별 라우트 단가 (JSON / 빈 배열이면 DB 기본값)<textarea id="routeJson" class="mono" rows="9">${esc(JSON.stringify(s.route_rates||[],null,2))}</textarea></label><label class="wide">추가 구분 처리 (JSON; pay_raw=원본×1.1 지급, company_only=회사에 유보)<textarea id="categoryJson" class="mono" rows="4">${esc(JSON.stringify(s.category_policy||{},null,2))}</textarea></label></div>`,buttons('saveMonthSettings'));
 $('#saveMonthSettings').onclick=()=>{try{const r=JSON.parse($('#routeJson').value),c=JSON.parse($('#categoryJson').value);if(!Array.isArray(r)||typeof c!=='object'||c===null||Array.isArray(c))throw new Error('JSON 형식을 확인하세요.');busy(async()=>{await command('month_settings',{settings:{...values(),route_rates:r,category_policy:c}});$('#dialog').close();});}catch(e){toast(e.message);}};
}
function openCosts(){const costs=state.data?.meta?.costs||[],templates=state.data?.fixed_costs||[];
 const costInput=(c,i)=>`<div class="costRow" data-cost-row><input data-cost-desc aria-label="내역" value="${esc(c.description)}" style="flex:1;min-width:100px"><input data-cost-amount type="number" min="0" step="0.01" aria-label="금액" value="${esc(c.amount)}" style="width:150px"><button class="small danger" data-remove-cost ${locked()?'disabled':''}>삭제</button></div>`;
 openDialog('고정비 관리',`<p class="note">기본 비용표는 PK / 내역 / 금액 3개 컬럼입니다. 월별 정산에는 별도 복사본을 저장합니다.</p><h3>${esc(state.month)} 적용 비용</h3><div id="monthlyCosts">${costs.map(costInput).join('')}</div><button id="addCost" class="small" ${locked()?'disabled':''}>+ 이번 달 비용</button> <button id="applyCostDefaults" class="small" ${locked()?'disabled':''}>기본표에서 다시 가져오기</button><h3>기본 비용표</h3><div class="tableWrap"><table><thead><tr><th>PK</th><th>내역</th><th class="num">금액</th><th></th></tr></thead><tbody>${templates.map(c=>`<tr><td>${c.id}</td><td>${esc(c.description)}</td><td class="num">${fmt(c.amount)}</td><td><button class="small" data-edit-template="${c.id}" ${locked()?'disabled':''}>수정</button> <button class="small danger" data-delete-template="${c.id}" ${locked()?'disabled':''}>삭제</button></td></tr>`).join('')}</tbody></table></div><button id="addTemplate" class="small" ${locked()?'disabled':''}>+ 기본 비용</button>`,buttons('saveCosts','이번 달 비용 저장'));
 $('#addCost').onclick=()=>$('#monthlyCosts').insertAdjacentHTML('beforeend',costInput({description:'',amount:0},0));
 $('#saveCosts').onclick=()=>{const a=[...$('#monthlyCosts').querySelectorAll('[data-cost-row]')].map(r=>({description:r.querySelector('[data-cost-desc]').value.trim(),amount:Number(r.querySelector('[data-cost-amount]').value)}));if(a.some(x=>!x.description||!Number.isFinite(x.amount)||x.amount<0))return toast('내역과 금액을 확인하세요.');busy(async()=>{await command('costs_save',{costs:a});$('#dialog').close();});};
 $('#applyCostDefaults').onclick=()=>{if(confirm('이번 달 비용을 기본표로 바꾸겠습니까?'))busy(async()=>{await command('costs_apply');openCosts();});};$('#addTemplate').onclick=()=>editTemplate();
}
function editTemplate(id){const t=state.data.fixed_costs.find(x=>String(x.id)===String(id));const description=prompt('고정비 내역',t?.description||'');if(description===null)return;const a=prompt('금액 (원)',String(t?.amount??0));if(a===null)return;const amount=Number(a.replace(/,/g,''));if(!description.trim()||!Number.isFinite(amount)||amount<0)return toast('내역과 금액을 확인하세요.');busy(async()=>{await command('cost_master_save',{id:t?.id||null,description,amount});openCosts();});}
function openHistory(){openDialog('저장 / 수정 이력',`<p class="note">과거 버전은 DB에 보존됩니다. 본 화면은 현재 저장본을 표시합니다.</p><table><thead><tr><th>버전</th><th>저장시각</th><th>계산기</th></tr></thead><tbody>${(state.data?.history||[]).map(x=>`<tr><td>v${x.version}</td><td>${esc(new Date(x.created_at).toLocaleString('ko-KR'))}</td><td>${esc(x.engine_version)}</td></tr>`).join('')}</tbody></table><h3>최근 변경</h3><table><thead><tr><th>작업</th><th>시각</th></tr></thead><tbody>${(state.data?.audit||[]).map(x=>`<tr><td>${esc(x.action)}</td><td>${esc(new Date(x.created_at).toLocaleString('ko-KR'))}</td></tr>`).join('')}</tbody></table>`);}
function csv(name,header,rows){const cell=v=>{const s=String(v??'');return '"'+(/^[=+\-@\t\r]/.test(s)&&typeof v!=='number'?"'"+s:s).replaceAll('"','""')+'"';};download(new Blob(['﻿'+[header,...rows].map(r=>r.map(cell).join(',')).join('\r\n')],{type:'text/csv;charset=utf-8'}),name);}
function download(blob,name){const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}
$('#driverFilter').oninput=renderMain;$('#qtyFilter').oninput=()=>{state.page=0;renderQty();};$('#qtyDriver').onchange=()=>{state.page=0;renderQty();};$('#statementDriver').onchange=()=>{state.driver=$('#statementDriver').value;renderStatement();renderActions();};$('#qtyPrev').onclick=()=>{state.page--;renderQty();};$('#qtyNext').onclick=()=>{state.page++;renderQty();};
$('#reload').onclick=()=>busy(load);$('#month').onchange=()=>busy(load);$('#openAssignment').onclick=()=>openAssignment();$('#openCosts').onclick=openCosts;$('#openMonthSettings').onclick=openMonthSettings;$('#openHistory').onclick=openHistory;$('#closeDialog').onclick=()=>$('#dialog').close();
$('#calculate').onclick=()=>busy(async()=>{await ensureMonth();await api('/calculate',{month:state.month,expected_revision:rev(),expected_run_id:state.data.run?.id||null});await load();toast('계산 결과를 새 버전으로 저장했습니다.');});
$('#checkSource').onclick=()=>busy(async()=>{const r=await api('/check',{month:state.month});state.sourceChanged=!!r.changed;render();toast(r.changed?'원본이 변경되었습니다.':'저장본과 같은 원본입니다.');});
$('#confirmMonth').onclick=()=>{if(locked()){const reason=prompt('재개방 사유를 입력하세요.');if(reason?.trim())busy(()=>command('reopen',{reason}));}else if(confirm('현재 저장본을 확정하고 잠글까요?'))busy(async()=>{await command('confirm');toast('정산을 확정했습니다.');});};
$('#exportMain').onclick=()=>csv(`maroowell_${state.month}_main.csv`,['기사','캠프','ID','배송','반품','원본 수입','지급총액','보험','실지급','이체액'],(payload()?.drivers||[]).map(x=>[x.name,x.camp,x.primary_id,x.delivery,x.return,x.raw_gross,x.gross,x.insurance,x.net,x.bank_transfer]));
$('#exportQty').onclick=()=>csv(`maroowell_${state.month}_quantity.csv`,['날짜','구분','원본ID','귀속','캠프','라우트','원본배송','원본반품','지급배송','지급반품','단가','금액'],qtyRows().map(x=>[x.date,x.classify,x.source_id,name(x.driver_id),x.camp,x.route,x.parcel,x.return,x.pay_delivery,x.pay_return,x.unit,x.amount]));
$('#printStatement').onclick=()=>{if(!state.data?.run)return toast('계산 후 저장된 정산서만 출력할 수 있습니다.');window.print();};
$('#logoutBtn').onclick=async()=>{if(!confirm('로그아웃하시겠습니까?'))return;try{await supa.auth.signOut();}finally{location.replace('/');}};$('#pngStatement').onclick=()=>busy(async()=>{if(!state.data?.run)throw new Error('미저장 정산서는 PNG로 내려받을 수 없습니다.');if(!window.html2canvas)throw new Error('PNG 모듈 로드 실패');const canvas=await html2canvas($('#paper'),{backgroundColor:'#ffffff',scale:2,useCORS:true});const blob=await new Promise(r=>canvas.toBlob(r,'image/png'));if(!blob)throw new Error('PNG 생성 실패');download(blob,`${state.month}_${name(state.driver)}_settlement.png`);});
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.tab)tab(b.dataset.tab);if(b.hasAttribute('data-close'))$('#dialog').close();if(b.dataset.statement){state.driver=b.dataset.statement;$('#statementDriver').value=state.driver;renderStatement();tab('statement');}if(b.dataset.driverSettings)openDriver(b.dataset.driverSettings);if(b.hasAttribute('data-issue-driver'))b.dataset.issueDriver?openDriver(b.dataset.issueDriver):(/OWNER|ASSIGNMENT|UNASSIGNED/.test(b.dataset.issueCode||'')?openAssignment():openMonthSettings());if(b.dataset.rowRule)openAssignment(payload()?.details.find(x=>x.row_key===b.dataset.rowRule));if(b.dataset.editAssignment)openAssignment(null,state.data.assignments.find(x=>x.id===b.dataset.editAssignment));if(b.dataset.deleteAssignment&&confirm('귀속 규칙을 삭제할까요?'))busy(async()=>{await command('assignment_delete',{id:b.dataset.deleteAssignment});openAssignment();});if(b.hasAttribute('data-remove-cost'))b.closest('[data-cost-row]').remove();if(b.dataset.editTemplate)editTemplate(b.dataset.editTemplate);if(b.dataset.deleteTemplate&&confirm('기본 비용을 삭제할까요?'))busy(async()=>{await command('cost_master_delete',{id:b.dataset.deleteTemplate});openCosts();});});
function deny(message){state.data=null;$('#app').hidden=true;$('#app').replaceChildren();$('#loadingGate').hidden=false;$('#gateTitle').textContent='접근할 수 없습니다.';$('#gateText').textContent=ERR[message]||message;$('#loginLink').hidden=false;if($('#dialog').open)$('#dialog').close();}
async function init(){try{if(!window.supabase||!cfg.SUPABASE_URL||!cfg.SUPABASE_ANON_KEY)throw new Error('config.js 또는 로그인 모듈 확인 필요');supa=window.supabase.createClient(cfg.SUPABASE_URL,cfg.SUPABASE_ANON_KEY,{auth:{persistSession:true,autoRefreshToken:true}});
 let{data}=await supa.auth.getSession();if(!data.session){try{const key=`sb-${new URL(cfg.SUPABASE_URL).hostname.split('.')[0]}-auth-token`;let raw=sessionStorage.getItem(key);if(raw?.startsWith('base64-')){let b=raw.slice(7).replace(/-/g,'+').replace(/_/g,'/');b+='='.repeat((4-b.length%4)%4);raw=new TextDecoder().decode(Uint8Array.from(atob(b),c=>c.charCodeAt(0)));}const parsed=JSON.parse(raw||'null'),session=parsed?.currentSession||parsed?.session||parsed;if(session?.access_token&&session?.refresh_token)await supa.auth.setSession(session);}catch{}}
 const a=await api('/access');$('#viewer').textContent=a.email;$('#loadingGate').hidden=true;$('#app').hidden=false;const now=new Date();$('#month').value=new Intl.DateTimeFormat('sv-SE',{timeZone:'Asia/Seoul',year:'numeric',month:'2-digit'}).format(now);await busy(load);
 supa.auth.onAuthStateChange((event,session)=>{if(event==='SIGNED_OUT'||(event==='SIGNED_IN'&&session?.user?.email?.toLowerCase()!==a.email.toLowerCase()))deny('LOGIN_REQUIRED');});
 }catch(e){deny(e.message);}}
init();
})();
