<!doctype html>
<html lang="ko">
<head>
  <style>html{visibility:hidden}
    /* =========================================================
       zipcode_search compact font override
       문경감홍사과체 기준 전체 글자 크기 과대 표시 보정
       기능 로직 변경 없음
       ========================================================= */

    body{
      font-size:13px !important;
    }

    header h1{
      font-size:17px !important;
      line-height:1.08 !important;
      letter-spacing:-.04em !important;
    }

    .headerSub{
      font-size:11px !important;
      line-height:1.2 !important;
    }

    .brand img{
      width:30px !important;
      height:30px !important;
    }

    header a.saveLink,
    header button,
    .panelToggle,
    button{
      font-size:11px !important;
      font-weight:950 !important;
      letter-spacing:-.03em !important;
    }

    .panelHead .muted,
    .muted,
    .hintBox,
    .pill,
    .modal-copy,
    .modalBody,
    .modalBody .pill{
      font-size:11px !important;
      line-height:1.45 !important;
      letter-spacing:-.03em !important;
    }

    label{
      font-size:11px !important;
      letter-spacing:-.03em !important;
    }

    textarea,
    input{
      font-size:13px !important;
      font-weight:900 !important;
      letter-spacing:-.035em !important;
    }

    textarea::placeholder,
    input::placeholder{
      font-size:13px !important;
      letter-spacing:-.04em !important;
    }

    .chip{
      font-size:11px !important;
      letter-spacing:-.03em !important;
    }

    .chip button{
      font-size:12px !important;
    }

    .map-controls button{
      font-size:11px !important;
      letter-spacing:-.03em !important;
    }

    .map-controls .hint{
      font-size:11px !important;
      letter-spacing:-.03em !important;
    }

    .zip-label{
      font-size:11px !important;
      letter-spacing:-.02em !important;
      padding:3px 8px !important;
    }

    .modal-title,
    .modalTop b{
      font-size:15px !important;
      letter-spacing:-.04em !important;
    }

    @media (max-width: 480px){
      body{
        font-size:12px !important;
      }

      header h1{
        font-size:16px !important;
      }

      header a.saveLink,
      header button,
      .panelToggle,
      button{
        font-size:10.5px !important;
      }

      textarea,
      input,
      textarea::placeholder,
      input::placeholder{
        font-size:12px !important;
      }
    }

  </style>
  <script src="/config.js"></script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="referrer" content="origin" />

  <meta property="og:image" content="https://maroowell.com/assets/og/maroowell-1200x630.png?v=1" />
  <meta property="og:image:secure_url" content="https://maroowell.com/assets/og/maroowell-1200x630.png?v=1" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Maroowell" />

  <title>마루웰</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />

  <style>

    /*
      문경감홍사과체 실제 적용용
      - 아래 파일 중 하나를 repo의 public/assets/fonts/ 경로에 올려두면 적용됩니다.
      - 파일이 없으면 Noto Sans KR / system font로 자동 fallback 됩니다.
      - 권장 파일명: MungyeongGamhong.woff2
    */
    @font-face{
      font-family:"문경감홍사과체";
      src:
        url("/assets/fonts/MungyeongGamhong.woff2") format("woff2"),
        url("/assets/fonts/MungyeongGamhong.woff") format("woff"),
        url("/assets/fonts/MungyeongGamhong.ttf") format("truetype");
      font-weight:400 1000;
      font-style:normal;
      font-display:swap;
    }

    @font-face{
      font-family:"문경사과감홍체";
      src:
        url("/assets/fonts/MungyeongGamhong.woff2") format("woff2"),
        url("/assets/fonts/MungyeongGamhong.woff") format("woff"),
        url("/assets/fonts/MungyeongGamhong.ttf") format("truetype");
      font-weight:400 1000;
      font-style:normal;
      font-display:swap;
    }

    :root{
      --headerH:64px;
      --bg:#f6f8fc;
      --surface:#ffffff;
      --surface2:#f8fafc;
      --panel:#ffffff;
      --text:#0f172a;
      --muted:#64748b;
      --muted2:#94a3b8;
      --line:#d8e0ee;
      --line2:#edf2f7;
      --blue:#2563eb;
      --blue2:#1d4ed8;
      --blueSoft:#dbeafe;
      --green:#16a34a;
      --greenSoft:#dcfce7;
      --red:#dc2626;
      --redSoft:#fee2e2;
      --yellow:#f59e0b;
      --shadow:0 14px 42px rgba(15,23,42,.10);
      --shadow2:0 8px 24px rgba(15,23,42,.08);
      --radius:18px;
      --font-mw:"문경감홍사과체","문경사과감홍체","Mungyeong Apple Gamhong","MungyeongGamhong","Noto Sans KR",system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
    }

    *{box-sizing:border-box}

    html,body{
      height:100%;
      margin:0;
      overflow:hidden;
      background:
        radial-gradient(circle at 15% 8%, rgba(37,99,235,.08), transparent 32%),
        radial-gradient(circle at 88% 4%, rgba(14,165,233,.08), transparent 30%),
        linear-gradient(180deg,#ffffff 0%,var(--bg) 100%);
      color:var(--text);
      font-family:var(--font-mw);
      font-weight:800;
      -webkit-font-smoothing:antialiased;
      text-rendering:geometricPrecision;
    }

    body.panel-collapsed #panel{display:none}
    body.panel-collapsed #app{grid-template-columns:1fr}

    header{
      display:flex;
      gap:12px;
      align-items:center;
      padding:10px 16px;
      height:var(--headerH);
      background:rgba(255,255,255,.92);
      border-bottom:1px solid var(--line);
      position:sticky;
      top:0;
      z-index:50;
      backdrop-filter:blur(12px);
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
    }

    .brand img{
      width:34px;
      height:34px;
      display:block;
      cursor:pointer;
      filter:drop-shadow(0 4px 10px rgba(15,23,42,.08));
    }

    .titleGroup{
      min-width:0;
      display:flex;
      flex-direction:column;
      gap:2px;
    }

    header h1{
      font-size:20px;
      font-weight:1000;
      letter-spacing:-.4px;
      margin:0;
      line-height:1.05;
      color:#0f172a;
      white-space:nowrap;
    }

    .headerSub{
      color:var(--muted);
      font-size:12px;
      font-weight:900;
      white-space:nowrap;
    }

    .spacer{flex:1}

    .headerActions{
      display:flex;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    header a.saveLink,
    header button,
    .panelToggle{
      min-height:36px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      color:#1e3a8a;
      font-size:12px;
      text-decoration:none;
      padding:0 12px;
      border-radius:999px;
      border:1px solid #cbd5e1;
      background:#fff;
      cursor:pointer;
      font-weight:950;
      user-select:none;
      box-shadow:0 1px 0 rgba(255,255,255,.7);
      font-family:var(--font-mw);
    }

    header a.saveLink:hover,
    header button:hover,
    .panelToggle:hover{
      border-color:#93c5fd;
      background:#f8fbff;
    }

    header button.logoutBtn{
      color:#b91c1c;
      border-color:#fecaca;
      display:none;
    }

    header button.logoutBtn:hover{
      background:#fff5f5;
      border-color:#fca5a5;
    }

    #app{
      display:grid;
      grid-template-columns:minmax(320px,390px) 1fr;
      height:calc(100dvh - var(--headerH));
      min-height:0;
      gap:0;
    }

    #panel{
      padding:14px;
      border-right:1px solid var(--line);
      background:linear-gradient(180deg,#ffffff,#f8fafc);
      overflow:auto;
      min-height:0;
    }

    .panelCard{
      background:#fff;
      border:1px solid var(--line);
      border-radius:20px;
      padding:14px;
      box-shadow:var(--shadow2);
    }

    .panelHead{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      margin-bottom:12px;
    }

    .muted{
      color:var(--muted);
      font-size:12px;
      font-weight:900;
      line-height:1.45;
    }

    label{
      display:block;
      margin:12px 0 7px;
      color:#334155;
      font-size:12px;
      font-weight:1000;
      letter-spacing:.01em;
    }

    input,textarea,button{
      font:inherit;
      font-family:var(--font-mw);
    }

    textarea,
    input{
      width:100%;
      background:#f8fafc;
      border:1px solid #cbd5e1;
      color:var(--text);
      padding:11px 12px;
      border-radius:14px;
      outline:none;
      font-weight:900;
      font-size:14px;
    }

    textarea{
      min-height:116px;
      line-height:1.45;
      resize:vertical;
    }

    textarea:focus,
    input:focus{
      background:#fff;
      border-color:#60a5fa;
      box-shadow:0 0 0 3px rgba(37,99,235,.12);
    }

    textarea::placeholder,
    input::placeholder{
      color:#94a3b8;
      font-weight:800;
    }

    button{
      min-height:38px;
      background:#fff;
      border:1px solid #cbd5e1;
      color:#0f172a;
      padding:0 13px;
      border-radius:999px;
      cursor:pointer;
      font-weight:950;
      box-shadow:0 1px 0 rgba(255,255,255,.7);
    }

    button:hover{
      border-color:#93c5fd;
      background:#f8fbff;
    }

    button:disabled{
      opacity:.62;
      cursor:not-allowed;
      transform:none;
    }

    button.primary,
    #searchBtn{
      background:linear-gradient(180deg,#3475f7,#2563eb);
      color:#fff;
      border-color:#1d4ed8;
      box-shadow:0 10px 22px rgba(37,99,235,.18);
    }

    button.primary:hover,
    #searchBtn:hover{
      background:linear-gradient(180deg,#2f6ff0,#1d4ed8);
    }

    button.danger{
      background:#fff;
      border-color:#fecaca;
      color:#b91c1c;
    }

    button.danger:hover{
      background:#fff5f5;
      border-color:#fca5a5;
    }

    #shareMapBtn{
      display:none;
    }

    #shareMapBtn.share-visible{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:96px;
      min-height:38px;
      padding:0 16px;
      line-height:1;
      white-space:nowrap;
      text-align:center;
      vertical-align:middle;
      background:linear-gradient(180deg,#22c55e,#16a34a);
      color:#fff;
      border-color:#15803d;
      box-shadow:0 10px 22px rgba(22,163,74,.18);
    }

    #shareMapBtn.share-visible:hover{
      background:linear-gradient(180deg,#16b84f,#15803d);
      border-color:#166534;
    }

    .shareToast{
      position:fixed;
      left:50%;
      bottom:24px;
      z-index:2147483000;
      transform:translate(-50%, 16px);
      min-width:170px;
      max-width:calc(100vw - 32px);
      padding:12px 18px;
      border-radius:999px;
      background:rgba(15,23,42,.94);
      color:#fff;
      font-size:13px;
      font-weight:1000;
      text-align:center;
      box-shadow:0 18px 42px rgba(15,23,42,.24);
      opacity:0;
      pointer-events:none;
      transition:opacity .18s ease, transform .18s ease;
    }

    .shareToast.show{
      opacity:1;
      transform:translate(-50%, 0);
    }

    button.merge-on{
      background:#ecfdf5;
      border-color:#86efac;
      color:#166534;
    }

    button.merge-on:hover{
      background:#dcfce7;
      border-color:#4ade80;
    }

    .row{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      align-items:center;
    }

    .row .grow{flex:1}

    .list{
      margin-top:12px;
      display:flex;
      flex-wrap:wrap;
      gap:7px;
      min-height:38px;
    }

    .chip{
      border:1px solid #cbd5e1;
      border-radius:999px;
      padding:7px 9px 7px 11px;
      background:#fff;
      display:inline-flex;
      align-items:center;
      gap:7px;
      font-size:12px;
      font-weight:1000;
      color:#0f172a;
      box-shadow:0 1px 0 rgba(255,255,255,.8);
    }

    .chip button{
      min-height:0;
      width:22px;
      height:22px;
      padding:0;
      border:none;
      background:#f1f5f9;
      color:#64748b;
      cursor:pointer;
      box-shadow:none;
    }

    .chip button:hover{
      background:#e2e8f0;
      color:#0f172a;
    }

    .hintBox{
      margin-top:12px;
      padding:11px 12px;
      border-radius:16px;
      border:1px solid #e2e8f0;
      background:#f8fafc;
      color:#64748b;
      font-size:12px;
      font-weight:900;
      line-height:1.55;
    }

    #mapWrap{
      position:relative;
      height:100%;
      min-height:0;
      display:flex;
      background:#eaf0f8;
      overflow:hidden;
      overscroll-behavior:contain;
      touch-action:none;
    }

    #map,#roadview{
      flex:1;
      width:100%;
      height:100%;
      min-width:0;
      min-height:0;
      overscroll-behavior:contain;
      touch-action:none;
    }

    #roadview{display:none}
    #mapWrap.roadview-open #roadview{display:block}

    .map-controls{
      position:absolute;
      top:12px;
      right:12px;
      z-index:10;
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .map-controls button{
      background:rgba(255,255,255,.92);
      border-color:#cbd5e1;
      backdrop-filter:blur(8px);
      color:#0f172a;
      box-shadow:0 6px 16px rgba(15,23,42,.10);
    }

    .map-controls .hint{
      display:inline-flex;
      align-items:center;
      min-height:36px;
      padding:0 12px;
      border-radius:999px;
      border:1px solid #cbd5e1;
      background:rgba(255,255,255,.92);
      color:#475569;
      font-size:12px;
      font-weight:950;
      box-shadow:0 6px 16px rgba(15,23,42,.10);
    }

    .zip-label{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:4px 10px;
      border-radius:999px;
      font-weight:1000;
      font-size:12px;
      letter-spacing:.2px;
      color:#0b1220;
      background:rgba(255,255,255,.96);
      border:2px solid rgba(15,23,42,.24);
      box-shadow:0 4px 12px rgba(15,23,42,.22);
      user-select:none;
      pointer-events:auto;
      cursor:pointer;
      transform:translateY(-2px);
      white-space:nowrap;
    }

    .modal{
      position:fixed;
      inset:0;
      display:none;
      align-items:center;
      justify-content:center;
      background:rgba(15,23,42,.36);
      backdrop-filter:blur(10px);
      z-index:9999;
      padding:16px;
    }

    .modal.open{display:flex}

    .modalCard{
      width:min(520px, 100%);
      background:#fff;
      border:1px solid var(--line);
      border-radius:22px;
      box-shadow:0 24px 80px rgba(15,23,42,.20);
      overflow:hidden;
    }

    .modalTop{
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:15px 16px;
      background:#fff;
      border-bottom:1px solid #eef2f7;
    }

    .modalTop b{
      font-size:17px;
      font-weight:1000;
      color:#0f172a;
    }

    .modalTop button{
      min-height:34px;
      padding:0 12px;
      background:#f8fafc;
      border-color:#dbe3ef;
      color:#334155;
    }

    .modalBody{
      padding:16px;
    }

    .modalBody .row{
      justify-content:flex-end;
      margin-top:12px;
    }

    .pill{
      display:flex;
      align-items:flex-start;
      gap:8px;
      padding:11px 12px;
      border:1px solid #e2e8f0;
      border-radius:16px;
      background:#f8fafc;
      color:#475569;
      font-size:12px;
      margin-bottom:12px;
      line-height:1.55;
      width:100%;
      font-weight:850;
    }

    @media (max-width: 900px){
      html,body{
        height:auto;
        min-height:100%;
        overflow:auto;
      }

      header{
        height:auto;
        min-height:var(--headerH);
        align-items:flex-start;
        flex-wrap:wrap;
      }

      .headerSub{
        display:none;
      }

      .headerActions{
        width:100%;
        justify-content:flex-start;
      }

      #app{
        grid-template-columns:1fr;
        height:auto;
        min-height:calc(100dvh - var(--headerH));
      }

      #panel{
        order:2;
        height:auto;
        max-height:none;
        border-right:none;
        border-top:1px solid var(--line);
      }

      body.panel-collapsed #panel{
        display:none;
      }

      body.panel-collapsed #mapWrap{
        height:calc(100dvh - 114px);
      }

      #mapWrap{
        order:1;
        height:62dvh;
        min-height:360px;
      }

      #mapWrap.roadview-open{
        flex-direction:column;
        height:72dvh;
      }

      .map-controls{
        top:10px;
        right:10px;
        left:10px;
      }

      .panelCard{
        box-shadow:none;
      }
    }

    @media (max-width: 480px){
      header{
        padding:9px 11px;
        gap:9px;
      }

      .brand img{
        width:30px;
        height:30px;
      }

      header h1{
        font-size:18px;
      }

      .headerActions{
        gap:6px;
      }

      header a.saveLink,
      header button,
      .panelToggle,
      button{
        min-height:34px;
        padding:0 10px;
        font-size:12px;
      }

      #panel{
        padding:10px;
      }

      .panelCard{
        padding:12px;
        border-radius:18px;
      }

      textarea{
        min-height:94px;
      }

      #mapWrap{
        min-height:330px;
      }
    }


    /* ---------- 우편번호 지형정보 ---------- */
    .terrainSection{
      margin-top:12px;
      padding-top:12px;
      border-top:1px solid var(--line2);
    }

    .terrainHead{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:10px;
      margin-bottom:9px;
    }

    .terrainHead b{
      display:block;
      color:#0f172a;
      font-size:13px;
      font-weight:1000;
      line-height:1.25;
    }

    .terrainSub{
      display:block;
      margin-top:2px;
      color:var(--muted);
      font-size:10px;
      font-weight:900;
      line-height:1.35;
    }

    .terrainSourceBadge{
      display:inline-flex;
      align-items:center;
      min-height:24px;
      padding:0 8px;
      border:1px solid #bfdbfe;
      border-radius:999px;
      background:#eff6ff;
      color:#1d4ed8;
      font-size:9px;
      font-weight:1000;
      white-space:nowrap;
    }

    .terrainList{
      display:grid;
      gap:8px;
    }

    .terrainEmpty{
      padding:11px 12px;
      border:1px dashed #cbd5e1;
      border-radius:14px;
      background:#f8fafc;
      color:#64748b;
      font-size:10px;
      font-weight:900;
      line-height:1.45;
      text-align:center;
    }

    .terrainCard{
      padding:11px;
      border:1px solid #dbe3ef;
      border-radius:16px;
      background:linear-gradient(180deg,#ffffff,#f8fafc);
      box-shadow:0 4px 14px rgba(15,23,42,.05);
    }

    .terrainCard.loading{
      border-color:#bfdbfe;
      background:#f8fbff;
    }

    .terrainCard.error{
      border-color:#fecaca;
      background:#fffafa;
    }

    .terrainCardTop{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
    }

    .terrainZip{
      color:#0f172a;
      font-size:13px;
      font-weight:1000;
      letter-spacing:.02em;
    }

    .terrainStatus{
      display:inline-flex;
      align-items:center;
      min-height:21px;
      padding:0 7px;
      border-radius:999px;
      border:1px solid #cbd5e1;
      background:#fff;
      color:#64748b;
      font-size:9px;
      font-weight:1000;
      white-space:nowrap;
    }

    .terrainStatus.cache{
      border-color:#bbf7d0;
      background:#f0fdf4;
      color:#15803d;
    }

    .terrainStatus.fresh{
      border-color:#bfdbfe;
      background:#eff6ff;
      color:#1d4ed8;
    }

    .terrainGrid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:7px;
      margin-top:9px;
    }

    .terrainMetric{
      min-width:0;
      padding:8px 9px;
      border:1px solid #e2e8f0;
      border-radius:12px;
      background:#fff;
    }

