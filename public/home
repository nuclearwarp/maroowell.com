function buildFreshMaps(freshRows){
  const byPk=new Map(),byKey=new Map(),byCid=new Map(),byName=new Map();
  for(const f of freshRows||[]){
    if(f.driver_pk!=null)byPk.set(`${f.batch_id}|${Number(f.driver_pk)}`,f);
    if(f.meta_worker_key)byKey.set(`${f.batch_id}|${String(f.meta_worker_key).toLowerCase()}`,f);
    if(f.coupang_id)byCid.set(`${f.batch_id}|${String(f.coupang_id).trim().toLowerCase()}`,f);
    if(f.driver_name)byName.set(`${f.batch_id}|${nameKey(f.driver_name)}`,f);
  }
  return{byPk,byKey,byCid,byName};
}
function mergeFresh(rows,freshRows){
  const fm=buildFreshMaps(freshRows);
  return (rows||[]).map(r=>{
    const f=
      (r.driver_pk!=null&&fm.byPk.get(`${r.batch_id}|${Number(r.driver_pk)}`))||
      (r.meta_worker_key&&fm.byKey.get(`${r.batch_id}|${String(r.meta_worker_key).toLowerCase()}`))||
      (r.coupang_id&&fm.byCid.get(`${r.batch_id}|${String(r.coupang_id).trim().toLowerCase()}`))||
      (r.driver_name&&fm.byName.get(`${r.batch_id}|${nameKey(r.driver_name)}`));

    if(!f){
      return{...r,fresh_delivery_total:null,fresh_delivery_complete_rate:null};
    }
    return{
      ...r,
      fresh_delivery_assigned:f.delivery_assigned,
      fresh_delivery_scanned:f.delivery_scanned,
      fresh_delivery_completed:f.delivery_completed,
      fresh_delivery_impossible:f.delivery_impossible,
      fresh_delivery_pdd_miss:f.delivery_pdd_miss,
      fresh_delivery_total:f.delivery_total,
      fresh_delivery_complete_rate:f.delivery_complete_rate,
      fresh_miss:f.fresh_miss||r.fresh_miss
    };
  });
}

