async function load(){
 const month=$('#month').value;
 if(!/^20\d{2}-(0[1-9]|1[0-2])$/.test(month))throw new Error('정산월을 선택하세요.');
 const d=await api('/month?month='+encodeURIComponent(month));
 state.data=d;state.preview=null;state.previewError='';state.month=month;state.sourceChanged=false;state.page=0;
 // Existing saved version always wins. Only the not-yet-saved draft is previewed.
 if(!d.run){
  try{
   const preview=await api('/preview?month='+encodeURIComponent(month));
   if(preview?.payload)state.preview=preview;
   else state.previewError='DB의 원본 자료를 확인할 수 없습니다.';
  }catch(e){state.previewError=e.message||'원본 데이터 미리보기에 실패했습니다.';}
 }
 render();
}
async function ensureMonth(){if(state.data?.meta)return;await api('/command',{month:state.month,expected_revision:0,action:'init',data:{}});await load();}
