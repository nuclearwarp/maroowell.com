async function fetchTerrainCache(env, scopeType, scopeKey) {
  const supabaseUrl = requireEnv(env, "SUPABASE_URL").replace(/\/+$/, "");
  const params = new URLSearchParams();
  params.set("scope_type", `eq.${scopeType}`);
  params.set("scope_key", `eq.${scopeKey}`);
  params.set("select", terrainSelectColumns());
  params.set("limit", "1");

  const res = await fetchWithTimeout(
    `${supabaseUrl}/rest/v1/${ZIPCODE_TERRAIN_TABLE}?${params.toString()}`,
    {
      method: "GET",
      headers: terrainSupabaseHeaders(env),
      cf: { cacheTtl: 0, cacheEverything: false },
    },
    TERRAIN_SUPABASE_TIMEOUT_MS
  );

  const text = await res.text();
  let rows = null;
  try { rows = text ? JSON.parse(text) : []; } catch {}

  if (!res.ok) {
    throw httpError(502, `Terrain cache lookup failed: ${snippet(text) || `HTTP ${res.status}`}`);
  }

  return Array.isArray(rows) && rows.length ? rows[0] : null;
}

async function upsertTerrainCache(env, row) {
  const supabaseUrl = requireEnv(env, "SUPABASE_URL").replace(/\/+$/, "");
  const params = new URLSearchParams();
  params.set("on_conflict", "scope_type,scope_key");

  const res = await fetchWithTimeout(
    `${supabaseUrl}/rest/v1/${ZIPCODE_TERRAIN_TABLE}?${params.toString()}`,
    {
      method: "POST",
      headers: terrainSupabaseHeaders(env, "resolution=merge-duplicates,return=representation"),
      body: JSON.stringify(row),
      cf: { cacheTtl: 0, cacheEverything: false },
    },
    TERRAIN_SUPABASE_TIMEOUT_MS
  );

  const text = await res.text();
  let rows = null;
  try { rows = text ? JSON.parse(text) : []; } catch {}

  if (!res.ok) {
    throw httpError(502, `Terrain cache save failed: ${snippet(text) || `HTTP ${res.status}`}`);
  }

  return Array.isArray(rows) && rows.length ? rows[0] : row;
}

function terrainRowToResponse(row) {
  if (!row || typeof row !== "object") return null;

  const minElevation = finiteNumberOrNull(row.min_elevation);
  const maxElevation = finiteNumberOrNull(row.max_elevation);
  const meanElevation = finiteNumberOrNull(row.mean_elevation);
  const p10Elevation = finiteNumberOrNull(row.p10_elevation);
  const p90Elevation = finiteNumberOrNull(row.p90_elevation);

  if (
    minElevation == null ||
    maxElevation == null ||
    meanElevation == null ||
    p10Elevation == null ||
    p90Elevation == null
  ) {
    return null;
  }

  const elevationRange = finiteNumberOrNull(row.elevation_range);
  const effectiveRange = finiteNumberOrNull(row.effective_range);

  const meanSlopeDegrees = finiteNumberOrNull(row.mean_slope_degrees);
  const maxSlopeDegrees = finiteNumberOrNull(row.max_slope_degrees);
  const flatPercent = finiteNumberOrNull(row.flat_percent);
  const gentlePercent = finiteNumberOrNull(row.gentle_percent);
  const steepPercent = finiteNumberOrNull(row.steep_percent);
  const slopeSampleCount = Math.max(0, Math.trunc(Number(row.slope_sample_count) || 0));

  const polygonAreaM2 = finiteNumberOrNull(row.polygon_area_m2);

  const slope = (
    meanSlopeDegrees != null &&
    maxSlopeDegrees != null &&
    flatPercent != null &&
    gentlePercent != null &&
    steepPercent != null &&
    slopeSampleCount > 0
  ) ? {
    meanDegrees: roundTerrainNumber(meanSlopeDegrees),
    maxDegrees: roundTerrainNumber(maxSlopeDegrees),
    flatPercent: roundTerrainNumber(flatPercent, 1),
    gentlePercent: roundTerrainNumber(gentlePercent, 1),
    steepPercent: roundTerrainNumber(steepPercent, 1),
    sampleCount: slopeSampleCount,
    method: String(row.slope_method || TERRAIN_SLOPE_METHOD),
    calculatedAt: row.slope_calculated_at || null,
  } : null;

  return {
    source: String(row.source || COPERNICUS_TERRAIN_SOURCE),
    minElevation: roundTerrainNumber(minElevation),
    maxElevation: roundTerrainNumber(maxElevation),
    meanElevation: roundTerrainNumber(meanElevation),
    stdevElevation: roundTerrainNumber(row.stdev_elevation),
    p10Elevation: roundTerrainNumber(p10Elevation),
    p90Elevation: roundTerrainNumber(p90Elevation),
    elevationRange: roundTerrainNumber(
      elevationRange == null ? maxElevation - minElevation : elevationRange
    ),
    effectiveRange: roundTerrainNumber(
      effectiveRange == null ? p90Elevation - p10Elevation : effectiveRange
    ),
    sampleCount: Math.max(0, Math.trunc(Number(row.sample_count) || 0)),
    noDataCount: Math.max(0, Math.trunc(Number(row.no_data_count) || 0)),
    resolutionMeters: Math.max(
      1,
      Math.trunc(Number(row.resolution_m) || TERRAIN_RESOLUTION_METERS)
    ),
    calculatedAt: row.calculated_at || null,
    polygonAreaM2: roundTerrainNumber(polygonAreaM2, 2),
    areaSquareKilometers: polygonAreaM2 == null
      ? null
      : roundTerrainNumber(polygonAreaM2 / 1000000, 4),
    areaPyeong: polygonAreaM2 == null
      ? null
      : roundTerrainNumber(polygonAreaM2 / TERRAIN_SQUARE_METERS_PER_PYEONG, 0),
    slope,
  };
}

async function getCopernicusAccessToken(env, forceRefresh = false) {
  const now = Date.now();

  if (
    !forceRefresh &&
    copernicusTokenCache.accessToken &&
    copernicusTokenCache.expiresAt > now + 60000
  ) {
    return copernicusTokenCache.accessToken;
  }

  const clientId = requireEnv(env, "COPERNICUS_CLIENT_ID");
  const clientSecret = requireEnv(env, "COPERNICUS_CLIENT_SECRET");

  const form = new URLSearchParams();
  form.set("grant_type", "client_credentials");
  form.set("client_id", clientId);
  form.set("client_secret", clientSecret);

  const res = await fetchWithTimeout(
    COPERNICUS_TOKEN_URL,
    {
      method: "POST",
      headers: {
        "Content-Type": "application/x-www-form-urlencoded",
        Accept: "application/json",
      },
      body: form.toString(),
      cf: { cacheTtl: 0, cacheEverything: false },
    },
    COPERNICUS_TOKEN_TIMEOUT_MS
  );

  const text = await res.text();
  let data = null;
  try { data = text ? JSON.parse(text) : null; } catch {}

  if (!res.ok || !data?.access_token) {
    throw httpError(
      502,
      `Copernicus OAuth failed: ${data?.error_description || data?.error || snippet(text) || `HTTP ${res.status}`}`
    );
  }

  const expiresInSeconds = Math.max(60, Number(data.expires_in) || 600);
  copernicusTokenCache = {
    accessToken: String(data.access_token),
    expiresAt: now + expiresInSeconds * 1000,
  };

  return copernicusTokenCache.accessToken;
}

function clampTerrainImageSide(value) {
  return Math.max(
    TERRAIN_MIN_IMAGE_SIDE,
    Math.min(TERRAIN_MAX_IMAGE_SIDE, Math.ceil(Number(value) || TERRAIN_MIN_IMAGE_SIDE))
  );
}

function buildTerrainImageSize(bbox) {
  const [minLon, minLat, maxLon, maxLat] = bbox;
  const midLatRad = ((minLat + maxLat) / 2) * Math.PI / 180;
  const widthMeters = Math.max(1, (maxLon - minLon) * 111320 * Math.cos(midLatRad));
  const heightMeters = Math.max(1, (maxLat - minLat) * 110574);

  return {
    width: clampTerrainImageSide(widthMeters / TERRAIN_RESOLUTION_METERS),
    height: clampTerrainImageSide(heightMeters / TERRAIN_RESOLUTION_METERS),
  };
}

function buildCopernicusProcessPayload(normalized) {
  const size = buildTerrainImageSize(normalized.bbox);

  return {
    input: {
      bounds: {
        geometry: normalized.geometry,
        properties: {
          crs: "http://www.opengis.net/def/crs/OGC/1.3/CRS84",
        },
      },
      data: [
        {
          type: "dem",
          dataFilter: {
            demInstance: COPERNICUS_DEM_INSTANCE,
          },
          processing: {
            upsampling: "BILINEAR",
            downsampling: "BILINEAR",
          },
        },
      ],
    },
    output: {
      width: size.width,
      height: size.height,
      responses: [
        {
          identifier: "default",
          format: { type: "image/png" },
        },
      ],
    },
    evalscript: TERRAIN_PROCESS_EVALSCRIPT,
  };
}

function readUint32BE(bytes, offset) {
  return (
    ((bytes[offset] << 24) >>> 0) |
    (bytes[offset + 1] << 16) |
    (bytes[offset + 2] << 8) |
    bytes[offset + 3]
  ) >>> 0;
}

function concatUint8Arrays(parts) {
  const size = parts.reduce((sum, part) => sum + part.length, 0);
  const out = new Uint8Array(size);
  let offset = 0;
  for (const part of parts) {
    out.set(part, offset);
    offset += part.length;
  }
  return out;
}

async function inflatePngData(compressed) {
  if (typeof DecompressionStream !== "function") {
    throw httpError(500, "DecompressionStream is unavailable in this Worker runtime");
  }

  const stream = new Blob([compressed]).stream().pipeThrough(new DecompressionStream("deflate"));
  return new Uint8Array(await new Response(stream).arrayBuffer());
}

function paethPredictor(a, b, c) {
  const p = a + b - c;
  const pa = Math.abs(p - a);
  const pb = Math.abs(p - b);
  const pc = Math.abs(p - c);
  if (pa <= pb && pa <= pc) return a;
  if (pb <= pc) return b;
  return c;
}

function unfilterPngScanlines(raw, width, height, bytesPerPixel) {
  const stride = width * bytesPerPixel;
  const expected = height * (stride + 1);
  if (raw.length < expected) {
    throw httpError(502, `PNG decompressed data is truncated (${raw.length}/${expected})`);
  }

  const out = new Uint8Array(height * stride);
  let srcOffset = 0;
  let dstOffset = 0;

  for (let y = 0; y < height; y++) {
    const filter = raw[srcOffset++];

    for (let x = 0; x < stride; x++) {
      const current = raw[srcOffset++];
      const left = x >= bytesPerPixel ? out[dstOffset + x - bytesPerPixel] : 0;
      const up = y > 0 ? out[dstOffset + x - stride] : 0;
      const upLeft = y > 0 && x >= bytesPerPixel
        ? out[dstOffset + x - stride - bytesPerPixel]
        : 0;

      let value;
      switch (filter) {
        case 0:
          value = current;
          break;
        case 1:
          value = (current + left) & 255;
          break;
        case 2:
          value = (current + up) & 255;
          break;
        case 3:
          value = (current + Math.floor((left + up) / 2)) & 255;
          break;
        case 4:
          value = (current + paethPredictor(left, up, upLeft)) & 255;
          break;
        default:
          throw httpError(502, `Unsupported PNG filter type: ${filter}`);
      }

      out[dstOffset + x] = value;
    }

    dstOffset += stride;
  }

  return out;
}

async function decodeTerrainPng(arrayBuffer) {
  const bytes = new Uint8Array(arrayBuffer);
  const signature = [137, 80, 78, 71, 13, 10, 26, 10];

  if (bytes.length < 33 || !signature.every((value, index) => bytes[index] === value)) {
    throw httpError(502, "Copernicus response is not a valid PNG");
  }

  let offset = 8;
  let width = 0;
  let height = 0;
  let bitDepth = 0;
  let colorType = 0;
  let interlace = 0;
  const idatParts = [];

  while (offset + 12 <= bytes.length) {
    const length = readUint32BE(bytes, offset);
    offset += 4;
    const type = String.fromCharCode(
      bytes[offset],
      bytes[offset + 1],
      bytes[offset + 2],
      bytes[offset + 3]
    );
    offset += 4;

    if (offset + length + 4 > bytes.length) {
      throw httpError(502, "PNG chunk is truncated");
    }

    const data = bytes.subarray(offset, offset + length);
    offset += length + 4; // CRC 포함

    if (type === "IHDR") {
      width = readUint32BE(data, 0);
      height = readUint32BE(data, 4);
      bitDepth = data[8];
      colorType = data[9];
      interlace = data[12];
    } else if (type === "IDAT") {
      idatParts.push(data);
    } else if (type === "IEND") {
      break;
    }
  }

  if (!width || !height || !idatParts.length) {
    throw httpError(502, "PNG does not contain usable image data");
  }

  if (bitDepth !== 8 || colorType !== 6 || interlace !== 0) {
    throw httpError(
      502,
      `Unsupported PNG layout: bitDepth=${bitDepth}, colorType=${colorType}, interlace=${interlace}`
    );
  }

  const decompressed = await inflatePngData(concatUint8Arrays(idatParts));
  const rgba = unfilterPngScanlines(decompressed, width, height, 4);
  return { width, height, rgba };
}

function percentileFromSorted(sorted, percentile) {
  if (!sorted.length) return null;
  const position = (sorted.length - 1) * percentile;
  const lower = Math.floor(position);
  const upper = Math.ceil(position);
  if (lower === upper) return sorted[lower];
  const ratio = position - lower;
  return sorted[lower] * (1 - ratio) + sorted[upper] * ratio;
}

function terrainPixelSizeMeters(bbox, width, height) {
  const [minLon, minLat, maxLon, maxLat] = bbox;
  const midLatRad = ((minLat + maxLat) / 2) * Math.PI / 180;
  const widthMeters = Math.max(1, (maxLon - minLon) * 111320 * Math.cos(midLatRad));
  const heightMeters = Math.max(1, (maxLat - minLat) * 110574);

  return {
    x: Math.max(0.01, widthMeters / Math.max(1, width)),
    y: Math.max(0.01, heightMeters / Math.max(1, height)),
  };
}

function medianTerrainNumber(values) {
  if (!Array.isArray(values) || values.length === 0) return null;
  const sorted = [...values].sort((a, b) => a - b);
  return percentileFromSorted(sorted, 0.5);
}

function robustTerrainWindowSample(elevations, width, height, centerX, centerY, cell) {
  const radius = TERRAIN_SLOPE_WINDOW_RADIUS;
  const size = radius * 2 + 1;
  const rows = Array.from({ length: size }, () => []);
  const columns = Array.from({ length: size }, () => []);
  const points = [];

  for (let dy = -radius; dy <= radius; dy++) {
    const y = centerY + dy;
    if (y < 0 || y >= height) continue;

    for (let dx = -radius; dx <= radius; dx++) {
      const x = centerX + dx;
      if (x < 0 || x >= width) continue;

      const elevation = elevations[y * width + x];
      if (!Number.isFinite(elevation)) continue;

      const point = {
        dx,
        dy,
        xMeters: dx * cell.x,
        yMeters: dy * cell.y,
        elevation,
      };

      points.push(point);
      rows[dy + radius].push(point);
      columns[dx + radius].push(point);
    }
  }

  if (points.length < TERRAIN_SLOPE_MIN_WINDOW_POINTS) return null;

  const xSlopes = [];
  const ySlopes = [];

  // 같은 행의 모든 점쌍을 비교한다. 건물 경계에서 발생하는 큰 기울기는
  // 일부 점쌍에만 나타나므로 전체 중앙값에는 거의 영향을 주지 않는다.
  for (const row of rows) {
    row.sort((a, b) => a.dx - b.dx);
    for (let i = 0; i < row.length; i++) {
      for (let j = i + 1; j < row.length; j++) {
        const distance = row[j].xMeters - row[i].xMeters;
        if (Math.abs(distance) < 0.01) continue;
        xSlopes.push((row[j].elevation - row[i].elevation) / distance);
      }
    }
  }

  // 같은 열의 모든 점쌍을 비교해 남북 방향 기울기를 구한다.
  for (const column of columns) {
    column.sort((a, b) => a.dy - b.dy);
    for (let i = 0; i < column.length; i++) {
      for (let j = i + 1; j < column.length; j++) {
        const distance = column[j].yMeters - column[i].yMeters;
        if (Math.abs(distance) < 0.01) continue;
        ySlopes.push((column[j].elevation - column[i].elevation) / distance);
      }
    }
  }

  if (xSlopes.length < 3 || ySlopes.length < 3) return null;

  const gradientX = medianTerrainNumber(xSlopes);
  const gradientY = medianTerrainNumber(ySlopes);
  if (!Number.isFinite(gradientX) || !Number.isFinite(gradientY)) return null;

  // 추정 평면 z = ax + by + c에서 c 후보를 구한다.
  // DSM의 건물/수목은 대체로 지면보다 높은 방향의 이상치이므로 중앙값보다 조금 낮은
  // 35백분위수를 지면 대표 높이로 사용한다. 실제 평면에서는 모든 후보가 거의 동일하다.
  const interceptCandidates = points
    .map((point) => point.elevation - gradientX * point.xMeters - gradientY * point.yMeters)
    .filter(Number.isFinite)
    .sort((a, b) => a - b);

  if (!interceptCandidates.length) return null;

  const groundElevation = percentileFromSorted(
    interceptCandidates,
    TERRAIN_GROUND_INTERCEPT_PERCENTILE
  );
  const slopeDegrees = Math.atan(Math.hypot(gradientX, gradientY)) * 180 / Math.PI;

  if (!Number.isFinite(groundElevation) || !Number.isFinite(slopeDegrees)) return null;

  return {
    groundElevation,
    slopeDegrees,
    pointCount: points.length,
  };
}

function calculateTerrainStatsFromRgba(rgba, width, height, bbox) {
  const pixelCount = width * height;
  if (rgba.length < pixelCount * 4) {
    throw httpError(502, "Decoded terrain image is smaller than expected");
  }

  const elevations = new Float32Array(pixelCount);
  elevations.fill(Number.NaN);

  const rawValues = [];
  let noDataCount = 0;

  for (let pixelIndex = 0; pixelIndex < pixelCount; pixelIndex++) {
    const i = pixelIndex * 4;
    const alpha = rgba[i + 3];
    if (alpha === 0) {
      noDataCount += 1;
      continue;
    }

    const encoded = rgba[i] * 65536 + rgba[i + 1] * 256 + rgba[i + 2];
    const elevation = encoded / TERRAIN_HEIGHT_SCALE - TERRAIN_HEIGHT_OFFSET;

    if (!Number.isFinite(elevation) || elevation < -500 || elevation > 10000) {
      noDataCount += 1;
      continue;
    }

    elevations[pixelIndex] = elevation;
    rawValues.push(elevation);
  }

  if (!rawValues.length) {
    throw httpError(502, "Copernicus Process API returned no valid elevation pixels");
  }

  const cell = terrainPixelSizeMeters(bbox, width, height);
  const stride = Math.max(
    1,
    Math.ceil(Math.sqrt(pixelCount / TERRAIN_SLOPE_MAX_SAMPLES))
  );

  const groundValues = [];
  const slopeValues = [];

  for (let y = 0; y < height; y += stride) {
    for (let x = 0; x < width; x += stride) {
      if (!Number.isFinite(elevations[y * width + x])) continue;

      const sample = robustTerrainWindowSample(
        elevations,
        width,
        height,
        x,
        y,
        cell
      );

      if (!sample) continue;
      groundValues.push(sample.groundElevation);
      slopeValues.push(sample.slopeDegrees);
    }
  }

  if (slopeValues.length <= 0 || groundValues.length <= 0) {
    throw httpError(502, "Terrain area is too small to calculate robust slope statistics");
  }

  groundValues.sort((a, b) => a - b);
  slopeValues.sort((a, b) => a - b);

  // 화면의 최저/최고는 DSM 원시 극값이 아니라 보정 지면의 P10/P90을 사용한다.
  // 건물 옥상 픽셀 하나 때문에 고저차가 10~20m로 튀는 현상을 막는다.
  const p10Elevation = percentileFromSorted(groundValues, 0.10);
  const p90Elevation = percentileFromSorted(groundValues, 0.90);
  const minElevation = p10Elevation;
  const maxElevation = p90Elevation;

  let sum = 0;
  let sumSquares = 0;
  for (const value of groundValues) {
    const winsorized = Math.max(p10Elevation, Math.min(p90Elevation, value));
    sum += winsorized;
    sumSquares += winsorized * winsorized;
  }

  const meanElevation = sum / groundValues.length;
  const variance = Math.max(
    0,
    sumSquares / groundValues.length - meanElevation * meanElevation
  );
  const stdevElevation = Math.sqrt(variance);

  const slopeSampleCount = slopeValues.length;
  const slopeP95 = percentileFromSorted(slopeValues, 0.95);
  let slopeSum = 0;
  let flatCount = 0;
  let gentleCount = 0;
  let steepCount = 0;

  for (const rawSlope of slopeValues) {
    // 평균과 최대값도 소수의 DSM 이상치 영향을 줄이기 위해 P95에서 winsorize한다.
    const slopeDegrees = Math.min(rawSlope, slopeP95);
    slopeSum += slopeDegrees;

    if (rawSlope < TERRAIN_SLOPE_FLAT_MAX_DEGREES) {
      flatCount += 1;
    } else if (rawSlope < TERRAIN_SLOPE_GENTLE_MAX_DEGREES) {
      gentleCount += 1;
    } else {
      steepCount += 1;
    }
  }

  // 95% 이상의 대표 표본이 평지 기준 안이면 나머지는 DSM 구조물 노이즈로 보고
  // 배송 난이도 관점에서 평지 100%로 정규화한다.
  if (slopeP95 < TERRAIN_SLOPE_FLAT_MAX_DEGREES) {
    flatCount = slopeSampleCount;
    gentleCount = 0;
    steepCount = 0;
  }

  return {
    minElevation,
    maxElevation,
    meanElevation,
    stdevElevation,
    p10Elevation,
    p90Elevation,
    elevationRange: maxElevation - minElevation,
    effectiveRange: p90Elevation - p10Elevation,
    sampleCount: rawValues.length,
    noDataCount,
    meanSlopeDegrees: slopeSum / slopeSampleCount,
    maxSlopeDegrees: slopeP95,
    flatPercent: flatCount / slopeSampleCount * 100,
    gentlePercent: gentleCount / slopeSampleCount * 100,
    steepPercent: steepCount / slopeSampleCount * 100,
    slopeSampleCount,
    slopeMethod: TERRAIN_SLOPE_METHOD,
  };
}

async function requestCopernicusTerrainStatistics(env, normalized) {
  const payload = buildCopernicusProcessPayload(normalized);

  for (let attempt = 0; attempt < 2; attempt++) {
    const forceRefresh = attempt === 1;
    const accessToken = await getCopernicusAccessToken(env, forceRefresh);

    const res = await fetchWithTimeout(
      COPERNICUS_PROCESS_URL,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
        cf: { cacheTtl: 0, cacheEverything: false },
      },
      COPERNICUS_PROCESS_TIMEOUT_MS
    );

    if (res.status === 401 && attempt === 0) {
      copernicusTokenCache = { accessToken: "", expiresAt: 0 };
      continue;
    }

    if (!res.ok) {
      const text = await res.text().catch(() => "");
      let data = null;
      try { data = text ? JSON.parse(text) : null; } catch {}
      const message =
        data?.error?.message ||
        data?.error_description ||
        data?.message ||
        data?.error ||
        snippet(text) ||
        `HTTP ${res.status}`;
      throw httpError(502, `Copernicus Process API failed: ${message}`);
    }

    const contentType = (res.headers.get("content-type") || "").toLowerCase();
    if (!contentType.includes("image/png")) {
      const text = await res.text().catch(() => "");
      throw httpError(502, `Copernicus Process API returned ${contentType || "unknown content type"}: ${snippet(text)}`);
    }

    const png = await decodeTerrainPng(await res.arrayBuffer());
    return calculateTerrainStatsFromRgba(
      png.rgba,
      png.width,
      png.height,
      normalized.bbox
    );
  }

  throw httpError(502, "Copernicus authentication retry failed");
}

function terrainStatsToDatabaseRow(scope, geometryHash, stats, polygonAreaM2) {
  const calculatedAt = new Date().toISOString();

  return {
    zipcode: scope.zipcode,
    scope_type: scope.scopeType,
    scope_key: scope.scopeKey,
    geometry_hash: geometryHash,
    subsubroute_id: scope.subsubrouteId,
    subroute_id: scope.subrouteId,
    vendor_id: scope.vendorId,
    display_name: scope.displayName,
    min_elevation: stats.minElevation,
    max_elevation: stats.maxElevation,
    mean_elevation: stats.meanElevation,
    stdev_elevation: stats.stdevElevation,
    p10_elevation: stats.p10Elevation,
    p90_elevation: stats.p90Elevation,
    elevation_range: stats.elevationRange,
    effective_range: stats.effectiveRange,
    sample_count: stats.sampleCount,
    no_data_count: stats.noDataCount,
    resolution_m: TERRAIN_RESOLUTION_METERS,
    source: COPERNICUS_TERRAIN_SOURCE,
    calculated_at: calculatedAt,
    mean_slope_degrees: stats.meanSlopeDegrees,
    max_slope_degrees: stats.maxSlopeDegrees,
    flat_percent: stats.flatPercent,
    gentle_percent: stats.gentlePercent,
    steep_percent: stats.steepPercent,
    slope_sample_count: stats.slopeSampleCount,
    slope_method: stats.slopeMethod || TERRAIN_SLOPE_METHOD,
    slope_calculated_at: calculatedAt,
    polygon_area_m2: polygonAreaM2,
  };
}

async function handleTerrainRequest(request, env) {
  await verifySupabaseUserByJwt(request, env);

  const body = await readJsonBody(request);
  const scope = normalizeTerrainScope(body);
  const normalized = normalizeTerrainGeometry(
    body?.geometry || body?.polygon || body?.geojson
  );
  const geometryHash = await terrainGeometryHash(normalized);
  const polygonAreaM2 = calculateTerrainPolygonAreaM2(normalized.geometry);

  if (polygonAreaM2 == null) {
    throw httpError(400, "Failed to calculate polygon area");
  }

  const cachedRow = await fetchTerrainCache(env, scope.scopeType, scope.scopeKey);
  const cachedTerrain = terrainRowToResponse(cachedRow);

  // 같은 식별자라도 폴리곤이나 알고리즘이 달라지면 반드시 재계산한다.
  const cachedSlopeMethod = String(cachedRow?.slope_method || "");
  const cachedGeometryHash = String(cachedRow?.geometry_hash || "");
  if (
    cachedTerrain?.slope &&
    cachedSlopeMethod === TERRAIN_SLOPE_METHOD &&
    cachedGeometryHash === geometryHash
  ) {
    let effectiveCachedRow = cachedRow;

    // 기존 고도/경사 캐시는 그대로 쓰되, 면적이 비어 있는 과거 행만 즉시 보충한다.
    if (finiteNumberOrNull(cachedRow?.polygon_area_m2) == null) {
      effectiveCachedRow = await upsertTerrainCache(env, {
        ...cachedRow,
        polygon_area_m2: polygonAreaM2,
      });
    }

    return jsonResp({
      ok: true,
      zipcode: scope.zipcode,
      scopeType: scope.scopeType,
      scopeKey: scope.scopeKey,
      geometryHash,
      cached: true,
      terrain: terrainRowToResponse(effectiveCachedRow) || {
        ...cachedTerrain,
        polygonAreaM2,
        areaSquareKilometers: roundTerrainNumber(polygonAreaM2 / 1000000, 4),
        areaPyeong: roundTerrainNumber(
          polygonAreaM2 / TERRAIN_SQUARE_METERS_PER_PYEONG,
          0
        ),
      },
    });
  }

  const stats = await requestCopernicusTerrainStatistics(env, normalized);
  const row = terrainStatsToDatabaseRow(scope, geometryHash, stats, polygonAreaM2);
  const savedRow = await upsertTerrainCache(env, row);
  const terrain = terrainRowToResponse(savedRow) || terrainRowToResponse(row);

  return jsonResp({
    ok: true,
    zipcode: scope.zipcode,
    scopeType: scope.scopeType,
    scopeKey: scope.scopeKey,
    geometryHash,
    cached: false,
    terrain,
  });
}


