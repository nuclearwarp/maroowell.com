// ---------- Copernicus GLO-30 terrain statistics ----------
//
// 기존 우편번호 경계 GET, 지도 공유, Supabase 인증 로직은 그대로 유지한다.
// 프론트가 EPSG:5179 경계를 WGS84로 변환한 뒤 아래 엔드포인트로 전달한다.
//   POST /terrain
//   POST /zip/terrain
// Body:
//   { zipcode: "13581", geometry: { type: "Polygon|MultiPolygon", coordinates: [...] } }
//
// 최초 조회: Supabase 캐시 확인 -> Copernicus Process API -> 표고/경사도 계산 -> Supabase 저장
// 재조회: 표고와 경사도 캐시가 모두 있으면 Supabase 캐시만 반환
// 기존 표고 캐시에 경사도가 없으면 DEM을 다시 계산해 경사도 컬럼까지 보충한다.

const ZIPCODE_TERRAIN_TABLE = "zipcode_terrain";
const COPERNICUS_TOKEN_URL =
  "https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token";
const COPERNICUS_PROCESS_URL =
  "https://sh.dataspace.copernicus.eu/process/v1";
const COPERNICUS_DEM_INSTANCE = "COPERNICUS_30";
const COPERNICUS_TERRAIN_SOURCE = "COPERNICUS_30";

const TERRAIN_RESOLUTION_METERS = 30;
const TERRAIN_SUPABASE_TIMEOUT_MS = 5000;
const COPERNICUS_TOKEN_TIMEOUT_MS = 6000;
const COPERNICUS_PROCESS_TIMEOUT_MS = 20000;
const TERRAIN_MAX_POINTS = 100000;
const TERRAIN_MAX_BBOX_DEGREES = 2;
const TERRAIN_MAX_IMAGE_SIDE = 1024;
// 작은 우편번호 구역을 32픽셀로 강제 확대하면 30m DEM이 과도하게 보간되어
// 건물 경계가 가짜 경사로 증폭될 수 있으므로 최소 크기를 낮춘다.
const TERRAIN_MIN_IMAGE_SIDE = 8;

// 경사도 분류 기준
// 평지: 0도 이상 5도 미만 / 완경사: 5도 이상 15도 미만 / 급경사: 15도 이상
const TERRAIN_SLOPE_FLAT_MAX_DEGREES = 5;
const TERRAIN_SLOPE_GENTLE_MAX_DEGREES = 15;

// Copernicus GLO-30은 건물/수목이 포함될 수 있는 DSM이므로
// 인접 픽셀의 단순 Horn 미분 대신 7x7 창의 중앙값 쌍기울기를 사용한다.
// 가로/세로 방향의 모든 점쌍 기울기 중앙값은 건물 모서리 같은 급격한 이상치에 강하다.
const TERRAIN_SLOPE_WINDOW_RADIUS = 3;
const TERRAIN_SLOPE_MIN_WINDOW_POINTS = 15;
const TERRAIN_SLOPE_MAX_SAMPLES = 5000;
const TERRAIN_GROUND_INTERCEPT_PERCENTILE = 0.35;
const TERRAIN_SLOPE_METHOD = "robust_pairwise_plane_7x7_v2";

// 고도값을 PNG RGB 24비트 정수로 저장하기 위한 규칙.
// encoded = round((elevationMeters + 12000) * 10)
// decoded elevation = encoded / 10 - 12000
const TERRAIN_HEIGHT_OFFSET = 12000;
const TERRAIN_HEIGHT_SCALE = 10;

let copernicusTokenCache = {
  accessToken: "",
  expiresAt: 0,
};

const TERRAIN_PROCESS_EVALSCRIPT = `//VERSION=3
function setup() {
  return {
    input: [{
      bands: ["DEM", "dataMask"]
    }],
    output: {
      id: "default",
      bands: 4,
      sampleType: "UINT8"
    }
  };
}

function evaluatePixel(sample) {
  if (!sample.dataMask) return [0, 0, 0, 0];

  var encoded = Math.round((sample.DEM + ${TERRAIN_HEIGHT_OFFSET}) * ${TERRAIN_HEIGHT_SCALE});
  encoded = Math.max(0, Math.min(16777215, encoded));

  var r = Math.floor(encoded / 65536);
  var g = Math.floor((encoded - r * 65536) / 256);
  var b = encoded - r * 65536 - g * 256;

  return [r, g, b, 255];
}`;

function finiteNumberOrNull(value) {
  const n = Number(value);
  return Number.isFinite(n) ? n : null;
}

function roundTerrainNumber(value, digits = 2) {
  const n = finiteNumberOrNull(value);
  if (n == null) return null;
  const factor = 10 ** digits;
  return Math.round(n * factor) / factor;
}

function normalizeTerrainZipcode(value) {
  const text = String(value ?? "").trim();
  return /^\d{5}$/.test(text) ? text : "";
}

function normalizeTerrainScope(body) {
  const zipcode = normalizeTerrainZipcode(body?.zipcode);
  if (zipcode) {
    return {
      scopeType: "zipcode",
      scopeKey: zipcode,
      zipcode,
      subsubrouteId: null,
      subrouteId: null,
      vendorId: null,
      displayName: zipcode,
    };
  }

  const rawType = String(body?.scopeType ?? body?.scope_type ?? "").trim().toLowerCase();
  const rawKey = String(body?.scopeKey ?? body?.scope_key ?? "").trim();
  const allowed = new Set(["subsubroute", "subroute", "route_set", "camp"]);

  if (!allowed.has(rawType)) {
    throw httpError(400, "scopeType must be subsubroute, subroute, route_set, or camp");
  }
  if (!rawKey || rawKey.length > 160 || !/^[0-9A-Za-z._:-]+$/.test(rawKey)) {
    throw httpError(400, "A valid scopeKey is required");
  }

  const toPositiveIntegerOrNull = (v) => {
    const n = Number(v);
    return Number.isSafeInteger(n) && n > 0 ? n : null;
  };

  return {
    scopeType: rawType,
    scopeKey: rawKey,
    zipcode: null,
    subsubrouteId: toPositiveIntegerOrNull(body?.subsubrouteId ?? body?.subsubroute_id),
    subrouteId: toPositiveIntegerOrNull(body?.subrouteId ?? body?.subroute_id),
    vendorId: String(body?.vendorId ?? body?.vendor_id ?? "").trim() || null,
    displayName: String(body?.displayName ?? body?.display_name ?? "").trim().slice(0, 240) || null,
  };
}

async function terrainGeometryHash(normalized) {
  const encoded = new TextEncoder().encode(JSON.stringify(normalized.geometry));
  const digest = await crypto.subtle.digest("SHA-256", encoded);
  return Array.from(new Uint8Array(digest), b => b.toString(16).padStart(2, "0")).join("");
}

const TERRAIN_EARTH_RADIUS_METERS = 6371008.8;
const TERRAIN_SQUARE_METERS_PER_PYEONG = 3.305785;

function terrainDegreesToRadians(value) {
  return Number(value) * Math.PI / 180;
}

/*
 * Turf.js area와 같은 구면 링 면적 계산식이다.
 * WGS84 Polygon/MultiPolygon을 외부 라이브러리 없이 Worker에서 바로 계산한다.
 */
function terrainRingAreaSquareMeters(ring) {
  if (!Array.isArray(ring) || ring.length < 3) return 0;

  let total = 0;
  const length = ring.length;

  for (let i = 0; i < length; i++) {
    const lower = ring[(i + length - 1) % length];
    const middle = ring[i];
    const upper = ring[(i + 1) % length];

    if (
      !Array.isArray(lower) || lower.length < 2 ||
      !Array.isArray(middle) || middle.length < 2 ||
      !Array.isArray(upper) || upper.length < 2
    ) {
      continue;
    }

    const lowerLon = terrainDegreesToRadians(lower[0]);
    const middleLat = terrainDegreesToRadians(middle[1]);
    const upperLon = terrainDegreesToRadians(upper[0]);

    if (
      !Number.isFinite(lowerLon) ||
      !Number.isFinite(middleLat) ||
      !Number.isFinite(upperLon)
    ) {
      continue;
    }

    total += (upperLon - lowerLon) * Math.sin(middleLat);
  }

  return total * TERRAIN_EARTH_RADIUS_METERS * TERRAIN_EARTH_RADIUS_METERS / 2;
}

function terrainPolygonAreaSquareMeters(polygonCoordinates) {
  if (!Array.isArray(polygonCoordinates) || !polygonCoordinates.length) return 0;

  const outerArea = Math.abs(terrainRingAreaSquareMeters(polygonCoordinates[0]));
  let holesArea = 0;

  for (let i = 1; i < polygonCoordinates.length; i++) {
    holesArea += Math.abs(terrainRingAreaSquareMeters(polygonCoordinates[i]));
  }

  return Math.max(0, outerArea - holesArea);
}

function calculateTerrainPolygonAreaM2(geometry) {
  if (!geometry || typeof geometry !== "object") return null;

  let area = 0;

  if (geometry.type === "Polygon") {
    area = terrainPolygonAreaSquareMeters(geometry.coordinates);
  } else if (geometry.type === "MultiPolygon") {
    for (const polygon of geometry.coordinates || []) {
      area += terrainPolygonAreaSquareMeters(polygon);
    }
  } else {
    return null;
  }

  return Number.isFinite(area) && area > 0
    ? Math.round(area * 100) / 100
    : null;
}

function sameCoordinate(a, b) {
  return Array.isArray(a) &&
    Array.isArray(b) &&
    a.length >= 2 &&
    b.length >= 2 &&
    Number(a[0]) === Number(b[0]) &&
    Number(a[1]) === Number(b[1]);
}

function normalizeTerrainGeometry(rawGeometry) {
  let geometry = rawGeometry;

  if (geometry?.type === "Feature" && geometry.geometry) {
    geometry = geometry.geometry;
  }

  if (!geometry || typeof geometry !== "object") {
    throw httpError(400, "WGS84 geometry is required");
  }

  const type = geometry.type;
  const coordinates = geometry.coordinates;

  if (type !== "Polygon" && type !== "MultiPolygon") {
    throw httpError(400, "geometry.type must be Polygon or MultiPolygon");
  }

  if (!Array.isArray(coordinates) || coordinates.length === 0) {
    throw httpError(400, "geometry.coordinates is empty");
  }

  let pointCount = 0;
  let minLon = Infinity;
  let minLat = Infinity;
  let maxLon = -Infinity;
  let maxLat = -Infinity;

  function normalizeRing(rawRing) {
    if (!Array.isArray(rawRing) || rawRing.length < 3) {
      throw httpError(400, "Each polygon ring must have at least 3 points");
    }

    const ring = [];

    for (const rawPoint of rawRing) {
      if (!Array.isArray(rawPoint) || rawPoint.length < 2) {
        throw httpError(400, "Invalid coordinate in geometry");
      }

      const lon = Number(rawPoint[0]);
      const lat = Number(rawPoint[1]);

      if (!Number.isFinite(lon) || !Number.isFinite(lat)) {
        throw httpError(400, "Geometry contains a non-numeric coordinate");
      }

      if (lon < 120 || lon > 135 || lat < 30 || lat > 45) {
        throw httpError(400, "Geometry coordinate is outside the supported Korea range");
      }

      ring.push([lon, lat]);
      pointCount += 1;
      minLon = Math.min(minLon, lon);
      minLat = Math.min(minLat, lat);
      maxLon = Math.max(maxLon, lon);
      maxLat = Math.max(maxLat, lat);

      if (pointCount > TERRAIN_MAX_POINTS) {
        throw httpError(413, `Geometry exceeds ${TERRAIN_MAX_POINTS} points`);
      }
    }

    if (!sameCoordinate(ring[0], ring[ring.length - 1])) {
      ring.push([...ring[0]]);
      pointCount += 1;
    }

    if (ring.length < 4) {
      throw httpError(400, "Polygon ring must contain at least 4 coordinates including closure");
    }

    return ring;
  }

  function normalizePolygon(rawPolygon) {
    if (!Array.isArray(rawPolygon) || rawPolygon.length === 0) {
      throw httpError(400, "Polygon has no rings");
    }
    return rawPolygon.map(normalizeRing);
  }

  const normalizedCoordinates = type === "Polygon"
    ? normalizePolygon(coordinates)
    : coordinates.map(normalizePolygon);

  if (
    !Number.isFinite(minLon) ||
    !Number.isFinite(minLat) ||
    !Number.isFinite(maxLon) ||
    !Number.isFinite(maxLat)
  ) {
    throw httpError(400, "Failed to calculate geometry bounds");
  }

  if (
    maxLon - minLon > TERRAIN_MAX_BBOX_DEGREES ||
    maxLat - minLat > TERRAIN_MAX_BBOX_DEGREES
  ) {
    throw httpError(413, "Terrain request area is too large");
  }

  return {
    geometry: {
      type,
      coordinates: normalizedCoordinates,
    },
    bbox: [minLon, minLat, maxLon, maxLat],
  };
}

function terrainSupabaseHeaders(env, prefer = "") {
