<body>
<main class="wrap">
<header class="card topbar">
  <button id="mwBoardMenuToggle" class="brandLogo" type="button" aria-label="마루웰 메뉴 열기"><img src="/favicon.ico?v=2" alt="M"></button>
  <h1 class="brandTitle">Home</h1>
