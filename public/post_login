<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>마루웰</title><script src="/config.js"></script><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><style>html,body{margin:0;height:100%;font-family:system-ui,-apple-system,"Noto Sans KR",sans-serif;background:#f4f7f8;color:#334155}body{display:grid;place-items:center}.box{padding:18px 22px;border:1px solid #dce5e8;border-radius:14px;background:#fff;font-weight:800}</style></head><body><div class="box">접속 권한 확인 중...</div><script>(async()=>{try{const c=window.MARUWELL_CONFIG||{};if(!c.SUPABASE_URL||!c.SUPABASE_ANON_KEY||!window.supabase?.createClient)throw new Error('config');const sb=window.supabase.createClient(c.SUPABASE_URL,c.SUPABASE_ANON_KEY,{auth:{persistSession:true,storage:sessionStorage,autoRefreshToken:true,detectSessionInUrl:true}});const{data:{session}}=await sb.auth.getSession();if(!session)return location.replace('/');const[{data:a,error:ae},{data:s,error:se}]=await Promise.all([sb.rpc('mw_my_access').maybeSingle(),sb.rpc('mw_my_account_state').maybeSingle()]);if(ae)throw ae;if(se)throw se;const ok=s?.approval_status==='approved'&&s?.app_only!==true;if(!ok)return location.replace('/');const superAdmin=a?.is_maroowell===true&&a?.is_admin===true&&Number(a?.max_role_level||0)>=90;location.replace(superAdmin?'/home':'/zipcode_search')}catch(e){console.error(e);location.replace('/zipcode_search')}})();</script></body></html>