function analyzeCamp(code,name,mainMeta,freshMeta,schedule){const assignments=schedule?.assignments||[],owners=new Map(),own=new Set((schedule?.routes||[]).map(norm));for(const a of assignments){const r=norm(a.route),d=String(a.driver||a.display_name||a.owner||"").trim();if(r&&d)owners.set(r,d)}const ownerOf=r=>{if(owners.has(r))return owners.get(r);let best="",o="";for(const[a,d]of owners){if(r.startsWith(a)&&a.length>best.length){best=a;o=d}}return o},isOwn=r=>own.has(r)||[...owners.keys()].some(a=>a.length===4&&r.startsWith(a));const fm=freshMap(freshMeta),rows=[],totals={delivery:{total:0,misscan:0,remaining:0,completed:0},returns:{total:0,completed:0,remaining:0},fresh:{total:0,completed:0,remaining:0}};for(const src of contentOf(mainMeta)){const w=src?.workerInfo||{},d=delivery(src?.deliverySummary||{}),ret=collection(src?.returnSummary||{},true),fresh=fm.get(workerKey(src))||collection(src?.freshbagSummary||{},false);for(const k of["total","misscan","remaining","completed"])totals.delivery[k]+=d[k]||0;for(const k of["total","completed","remaining"]){totals.returns[k]+=ret[k]||0;totals.fresh[k]+=fresh[k]||0}const routes=uniq((w.workSubRoutes||[]).map(norm).filter(Boolean)),counts=new Map();for(const r of routes){const o=ownerOf(r);if(o)counts.set(o,(counts.get(o)||0)+1)}let driver="",best=-1;for(const[x,c]of counts){if(c>best){driver=x;best=c}}if(!driver)driver=String(w.workerName||w.name||w.workerDisplayName||"담당 확인").trim()||"담당 확인";let external=false,mismatch=false;const warns=[];for(const r of routes){const o=ownerOf(r);if(!isOwn(r)){external=true;warns.push(`${r} → 관리 라우트 아님`)}else if(o&&o!==driver){mismatch=true;warns.push(`${r} → 등록 ${o}`)}}rows.push({campKey:name,camp:name,driver,routes:uniq(routes.map(subRoute)),delivery:d,returns:ret,fresh,status:external?"external":mismatch?"mismatch":"ok",warns})}totals.delivery.rate=ratio(totals.delivery.completed,totals.delivery.total);totals.returns.rate=ratio(totals.returns.completed,totals.returns.total);totals.fresh.rate=ratio(totals.fresh.completed,totals.fresh.total);const attendance=new Set(assignments.map(a=>String(a.driver||a.display_name||a.owner||"").trim()).filter(Boolean)).size;return{key:name,code,name,totals,rows,workers:rows.length,attendance}}
function mergeCamps(list){const map=new Map();for(const c of list){if(!map.has(c.name))map.set(c.name,{...c,code:c.code,rows:[...c.rows],totals:JSON.parse(JSON.stringify(c.totals))});else{const x=map.get(c.name);x.rows.push(...c.rows);x.workers+=c.workers;x.attendance+=c.attendance;x.code+=`,`+c.code;for(const k of["total","misscan","remaining","completed"])x.totals.delivery[k]+=c.totals.delivery[k]||0;for(const group of["returns","fresh"])for(const k of["total","completed","remaining"])x.totals[group][k]+=c.totals[group][k]||0;x.totals.delivery.rate=ratio(x.totals.delivery.completed,x.totals.delivery.total);x.totals.returns.rate=ratio(x.totals.returns.completed,x.totals.returns.total);x.totals.fresh.rate=ratio(x.totals.fresh.completed,x.totals.fresh.total)}}return[...map.values()]}
function aggregate(camps){const a={attendance:0,workers:0,delivery:{total:0,misscan:0,completed:0,remaining:0},returns:{total:0,completed:0,remaining:0},fresh:{total:0,completed:0,remaining:0}};for(const c of camps){a.attendance+=c.attendance||0;a.workers+=c.workers||0;for(const k of["total","misscan","completed","remaining"])a.delivery[k]+=c.totals.delivery[k]||0;for(const g of["returns","fresh"])for(const k of["total","completed","remaining"])a[g][k]+=c.totals[g][k]||0}a.delivery.rate=ratio(a.delivery.completed,a.delivery.total);a.returns.rate=ratio(a.returns.completed,a.returns.total);a.fresh.rate=ratio(a.fresh.completed,a.fresh.total);return a}
function metricPanel(cls,label,m){return`<div class="metricPanel ${cls}"><div class="k">${label}</div><div class="rate">${pct(m.rate)}</div><div class="detail">${num(m.completed)} / ${num(m.total)} · 남음 ${num(m.remaining)}</div></div>`}
function renderSummary(){const a=aggregate(S.camps),wave=night()?"야간":"주간";$("summaryTitle").textContent=`전체 ${wave} 현황`;$("campCount").textContent=num(S.camps.length);$("attendanceCount").textContent=num(a.attendance);$("deliveryTotal").textContent=num(a.delivery.total);$("deliveryRate").textContent=pct(a.delivery.rate);$("deliverySub").textContent=`완료 ${num(a.delivery.completed)} / ${num(a.delivery.total)}`;$("returnRate").textContent=pct(a.returns.rate);$("returnSub").textContent=`완료 ${num(a.returns.completed)} / ${num(a.returns.total)}`;$("freshRate").textContent=pct(a.fresh.rate);$("freshSub").textContent=`회수 ${num(a.fresh.completed)} / ${num(a.fresh.total)}`;$("misscanTotal").textContent=num(a.delivery.misscan);$("workerCount").textContent=num(a.workers);$("summaryCaption").textContent=`${$("scheduleDate").value} · ${new Date().toLocaleTimeString("ko-KR",{hour:"2-digit",minute:"2-digit"})}`}
function renderCamps(){const body=$("campBody");$("campCaption").textContent=`${S.camps.length}개 캠프 · 클릭해 기사 필터`;if(!S.camps.length){body.className="empty";body.textContent="실제 META 데이터가 있는 캠프가 없습니다.";return}body.className="campGrid";body.innerHTML=S.camps.slice().sort((a,b)=>a.totals.delivery.rate-b.totals.delivery.rate||a.name.localeCompare(b.name,"ko")).map(c=>`<article class="campCard ${S.selected.has(c.key)?"selected":""}" data-camp-key="${esc(c.key)}"><div class="campTop"><div><div class="campName">${esc(c.name)}</div><div class="campMeta">기사 ${num(c.workers)}명 · 출근 예정 ${num(c.attendance)}명 · 배송 ${num(c.totals.delivery.total)}건</div></div></div><div class="triple">${metricPanel("delivery","배송 완료율",c.totals.delivery)}${metricPanel("return","반품 완료율",c.totals.returns)}${metricPanel("fresh","프백 회수율",c.totals.fresh)}</div>${c.totals.delivery.misscan?`<div class="missLine">미스캔 ${num(c.totals.delivery.misscan)}건</div>`:""}</article>`).join("");body.querySelectorAll(".campCard").forEach(el=>el.addEventListener("click",()=>{const k=el.dataset.campKey;if(S.selected.has(k))S.selected.delete(k);else S.selected.add(k);renderCamps();renderDrivers()}))}
function renderDrivers(){const selected=S.selected,rows=S.camps.flatMap(c=>c.rows).filter(r=>!selected.size||selected.has(r.campKey)).sort((a,b)=>a.delivery.rate-b.delivery.rate||b.delivery.misscan-a.delivery.misscan||a.camp.localeCompare(b.camp,"ko")||a.driver.localeCompare(b.driver,"ko"));$("driverCaption").textContent=selected.size?`${rows.length}명 · 선택 캠프 ${[...selected].join(", ")} · 완료율 낮은 순`:`${rows.length}명 · 전체 캠프 · 완료율 낮은 순`;const body=$("driverBody");if(!rows.length){body.className="empty";body.textContent="표시할 기사 데이터가 없습니다.";return}body.className="driverGrid";body.innerHTML=rows.map(r=>`<article class="driverCard ${r.status}"><div class="driverTop"><div><div class="driverName"><span class="driverCamp">${esc(r.camp)}</span>${esc(r.driver)}</div><div class="routeLabel">${esc(r.routes.join(", ")||"라우트 없음")}</div></div><div class="driverScore"><b>${pct(r.delivery.rate)}</b><small>배송 완료율</small></div></div><div class="triple">${metricPanel("delivery","배송 완료율",r.delivery)}${metricPanel("return","반품 완료율",r.returns)}${metricPanel("fresh","프백 회수율",r.fresh)}</div>${r.delivery.misscan?`<div class="missLine">미스캔 ${num(r.delivery.misscan)}건</div>`:""}${r.warns.length?`<div class="warn ${r.status==="external"?"red":""}">${esc(r.warns.join("\n"))}</div>`:""}</article>`).join("")}
function renderAll(){renderSummary();renderCamps();renderDrivers()}
async function queryAll(){if(S.busy)return;const date=$("scheduleDate").value;if(!date)return setStatus("일자를 선택해 주세요.",true);setBusy(true);try{if(!(await refreshMeta(true)))throw new Error("META 로그인이 필요합니다.");const codes=uniq((S.ctx.vendorCodes||[]).map(v=>String(v||"").trim().toUpperCase())).filter(Boolean);if(!codes.length)throw new Error("META 계약 캠프 목록을 확인하지 못했습니다.");const found=[];for(let i=0;i<codes.length;i++){const code=codes[i],name=campName(code);setStatus(`<strong>${i+1}/${codes.length}</strong> ${esc(name)} · ${night()?"야간":"주간"} 조회 중`);let main;try{main=await metaSearch({campCodes:[code],waveCode:S.wave,sortType:"DELIVERY_COMPLETED_RATIO",sortDirection:"ASC",workDate:workDate(),page:0,size:50})}catch(e){console.warn("META",code,e);if(/401|403/.test(String(e?.message||e)))throw e;continue}let fresh=null;if(!night()){try{fresh=await metaSearch({campCodes:[code],waveCode:S.wave,pddTime:"20:00",sortType:"DELIVERY_COMPLETED_RATIO",sortDirection:"ASC",workDate:workDate(),page:0,size:50})}catch(e){console.warn("fresh",code,e)}}const mainRows=contentOf(main),freshRows=contentOf(fresh);if(!mainRows.length&&!freshRows.length)continue;const schedule=await scheduleFor(code,date);found.push(analyzeCamp(code,name,main,fresh,schedule))}S.camps=mergeCamps(found);S.selected.clear();renderAll();setStatus(`${date} · ${night()?"야간":"주간"} · ${S.camps.length}개 캠프 조회 완료`);restartAuto()}catch(e){console.error(e);setStatus(esc(e?.message||String(e)),true);if(/401|403|로그인|세션/.test(String(e?.message||e)))metaUI(false)}finally{setBusy(false)}}
function restartAuto(){clearInterval(S.timer);S.timer=null;localStorage.setItem("mwHomeAuto",String(S.auto));if(S.auto>0)S.timer=setInterval(()=>{if(!S.busy)queryAll()},S.auto*60000)}
async function metaLogin(){setBusy(true);try{setStatus("META 로그인 창을 여는 중입니다.");const r=await bridge("login",{},130000);S.ctx=r.context||S.ctx;metaUI(true);setStatus("META 로그인 완료");setBusy(false);await queryAll()}catch(e){setStatus(esc(e?.message||String(e)),true);metaUI(false)}finally{setBusy(false)}}
async function copySection(id,name){const el=$(id);if(!el||!window.htmlToImage)return setStatus("이미지 캡처 모듈을 불러오지 못했습니다.",true);const buttons=[...el.querySelectorAll(".copyBtn")];buttons.forEach(b=>b.style.visibility="hidden");el.classList.add("copying");try{const ratio=Math.max(1,Math.min(2,15000/Math.max(1,el.scrollHeight)));const blob=await window.htmlToImage.toBlob(el,{backgroundColor:"#f3f6f8",pixelRatio:ratio,cacheBust:true});if(!blob)throw new Error("이미지 생성 실패");if(!navigator.clipboard?.write||typeof ClipboardItem==="undefined")throw new Error("이 브라우저는 이미지 클립보드 복사를 지원하지 않습니다.");await navigator.clipboard.write([new ClipboardItem({"image/png":blob})]);setStatus(`${esc(name)} 이미지를 클립보드에 복사했습니다.`)}catch(e){console.error(e);setStatus(`이미지 복사 실패: ${esc(e?.message||String(e))}`,true)}finally{buttons.forEach(b=>b.style.visibility="");el.classList.remove("copying")}}
function bind(){$("scheduleDate").value=defaultDate();document.querySelectorAll(".waveBtn").forEach(b=>b.addEventListener("click",()=>{S.wave=b.dataset.wave;document.querySelectorAll(".waveBtn").forEach(x=>x.classList.toggle("active",x===b));$("scheduleDate").value=defaultDate();queryAll()}));document.querySelectorAll(".autoBtn").forEach(b=>{const m=Number(b.dataset.min);b.classList.toggle("active",m===S.auto);b.addEventListener("click",()=>{S.auto=m;document.querySelectorAll(".autoBtn").forEach(x=>x.classList.toggle("active",x===b));restartAuto();setStatus(m?`자동 조회 ${m}분 간격으로 설정했습니다.`:"자동 조회를 껐습니다.")})});$("queryBtn").addEventListener("click",queryAll);$("metaLoginBtn").addEventListener("click",metaLogin);$("logoutBtn").addEventListener("click",logout);$("scheduleDate").addEventListener("change",()=>{if(!S.busy)queryAll()});document.querySelectorAll("[data-copy-section]").forEach(b=>b.addEventListener("click",e=>{e.stopPropagation();copySection(b.dataset.copySection,b.dataset.copyName)}));document.addEventListener("keydown",e=>{if(e.key==="Escape"&&S.selected.size){S.selected.clear();renderCamps();renderDrivers();setStatus("캠프 선택을 모두 해제했습니다.")}})}
async function boot(){bind();try{if(!(await auth()))return;await loadCampMap();document.documentElement.style.visibility="visible";const ok=await refreshMeta(true);setStatus(ok?"META 연결됨":"META 로그인이 필요합니다.");if(ok)queryAll();restartAuto()}catch(e){document.documentElement.style.visibility="visible";$("userPill").className="pill err user";$("userPill").textContent="접근 불가";setStatus(esc(e?.message||String(e)),true);$("queryBtn").disabled=true}}
boot();
})();
</script>
