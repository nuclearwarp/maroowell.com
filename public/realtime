[6] 자동수집 상태 버튼 함수 교체/추가
기존 metaUI() 를 아래로 교체:

function metaUI(ok,detail=""){
  S.metaConnected=!!ok;
  const b=$("metaLoginBtn");
  b.title=detail||"";
  b.disabled=!S.isAdmin;
  if(S.collectorPaused){
    b.className="btn collectorPaused";
    b.textContent="자동 수집 정지됨";
  }else if(ok){
    b.className="btn metaConnected";
    b.textContent="자동 수집 정상";
  }else{
    b.className="btn danger";
    b.textContent="수집 확인 필요";
  }
}

async function loadCollectorState(){
  try{
    const{data,error}=await S.sb.rpc("mw_meta_collector_state");
    if(error)throw error;
    const x=Array.isArray(data)?data[0]:data;
    S.collectorPaused=x?.paused===true;
    metaUI(!S.collectorPaused,x?.last_error||"");
  }catch(e){
    console.warn("collector state",e);
  }
}

async function toggleCollector(){
  if(!S.isAdmin)return;
  const next=!S.collectorPaused;
  if(!confirm(next?"자동 수집을 잠시 정지할까요?":"자동 수집을 다시 시작할까요?"))return;
  const{error}=await S.sb.rpc("mw_set_meta_collector_paused",{p_paused:next});
  if(error){
    setStatus(esc(error.message||String(error)),true);
    return;
  }
  S.collectorPaused=next;
  metaUI(!next);
  setStatus(next?"자동 수집을 정지했습니다.":"자동 수집을 재개했습니다.");
  await queryAll();
}

※ Supabase에는 mw_set_meta_collector_paused(boolean), mw_meta_collector_state() RPC가 이미 반영되어 있음.

