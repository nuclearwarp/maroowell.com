async function fetchKaptComplexes(env, legalDongCodes) {
  const rows = [];

  for (const dong of legalDongCodes) {
    let expectedTotal = null;

    for (let pageNo = 1; pageNo <= KAPT_MAX_PAGES_PER_DONG; pageNo++) {
      const page = await fetchKaptLegalDongPage(
        env,
        dong.legalDongCode,
        pageNo
      );

      if (expectedTotal == null) expectedTotal = page.totalCount;
      rows.push(...page.items);

      if (
        page.items.length === 0 ||
        page.items.length < KAPT_PAGE_SIZE ||
        pageNo * KAPT_PAGE_SIZE >= expectedTotal
      ) {
        break;
      }
    }
  }

  const deduped = [];
  const seen = new Set();

  for (const row of rows) {
    const key = kaptComplexKey(row);
    if (!key || seen.has(key)) continue;
    seen.add(key);
    deduped.push(row);
  }

  return deduped;
}


