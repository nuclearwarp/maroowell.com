<!doctype html>
<html lang="ko">
<head>
  <style>html{visibility:hidden}</style>
  <script src="/config.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="referrer" content="origin">
  <title>쿠팡 캠프 지도</title>
  <link rel="icon" href="/favicon.ico?v=2">

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://dapi.kakao.com/v2/maps/sdk.js?appkey=add4ce93b38c0ff9d9b9053728e067b3&autoload=false&libraries=clusterer,services"></script>

  <style>
    @font-face{
      font-family:"문경감홍사과체";
      src:url("/assets/fonts/MungyeongGamhong.woff2") format("woff2");
      font-display:swap;
    }

    :root{
      --line:#d8e0ee;
      --text:#0f172a;
      --muted:#64748b;
      --blue:#2563eb;
      --bg:#eef3f8;
      --font:"문경감홍사과체","Noto Sans KR",system-ui,sans-serif;
    }

    *{box-sizing:border-box}
    html,body{
      width:100%;
      height:100%;
      margin:0;
      font-family:var(--font);
      color:var(--text);
      background:var(--bg);
    }
    body{overflow:hidden}
    button,input,select{font:inherit}

    .app{
      height:100%;
      display:grid;
      grid-template-rows:56px 1fr;
    }

    .top{
      display:flex;
      align-items:center;
      gap:10px;
      padding:0 14px;
      background:#fff;
      border-bottom:1px solid var(--line);
      z-index:30;
    }

    .logo{
      width:32px;
      height:32px;
      display:flex;
      align-items:center;
      justify-content:center;
      flex:0 0 auto;
    }
    .logo img{width:30px;height:30px;object-fit:contain}

    .title{display:flex;flex-direction:column;min-width:0}
    .title b{font-size:18px;white-space:nowrap}
    .title small{
      margin-top:2px;
      color:var(--muted);
      font-size:11px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .spacer{flex:1}

    .btn{
      height:38px;
      padding:0 13px;
      border:1px solid #cbd5e1;
      border-radius:999px;
      background:#fff;
      color:var(--text);
      font-size:12px;
      font-weight:800;
      cursor:pointer;
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      white-space:nowrap;
    }
    .btn:hover{border-color:#93c5fd;background:#f8fbff}
    .btn.primary{background:var(--blue);border-color:var(--blue);color:#fff}
    .menuBtn{display:none;width:38px;padding:0;font-size:18px}

    .work{
      position:relative;
      min-height:0;
      display:grid;
      grid-template-columns:390px 1fr;
    }

    .side{
      min-height:0;
      background:#fff;
      border-right:1px solid var(--line);
      overflow:auto;
      z-index:20;
    }
    .inner{padding:14px}

    .card{
      margin-bottom:12px;
      padding:13px;
      border:1px solid var(--line);
      border-radius:18px;
      background:#fff;
      box-shadow:0 7px 20px rgba(15,23,42,.05);
    }

    .head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:10px;
    }
    .head b{font-size:14px}
    .head span{font-size:11px;color:var(--muted)}

    .field{display:grid;gap:6px;margin-top:9px}
    .field label{font-size:11px;font-weight:800;color:#475569}
    .control{
      width:100%;
      height:40px;
      padding:0 11px;
      border:1px solid #cbd5e1;
      border-radius:12px;
      background:#f8fafc;
      outline:0;
    }
    .control:focus{
      border-color:#60a5fa;
      background:#fff;
      box-shadow:0 0 0 3px rgba(37,99,235,.1);
    }

    .cols{display:grid;grid-template-columns:1fr 1fr;gap:9px}
    .actions{display:flex;gap:8px;margin-top:11px}
    .actions > *{flex:1}

    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
    .stat{
      padding:10px 6px;
      border:1px solid var(--line);
      border-radius:14px;
      background:#f8fafc;
      text-align:center;
    }
    .stat strong{display:block;font-size:17px}
    .stat span{display:block;margin-top:4px;font-size:10px;color:var(--muted)}

    .chips{display:flex;flex-wrap:wrap;gap:7px}
    .chip{
      min-height:30px;
      padding:0 10px;
      border:1px solid var(--line);
      border-radius:999px;
      background:#fff;
      font-size:11px;
      font-weight:800;
      cursor:pointer;
    }
    .chip.active{border-color:#60a5fa;background:#eff6ff;color:#1d4ed8}
    .dot{
      display:inline-block;
      width:9px;
      height:9px;
      margin-right:6px;
      border-radius:50%;
      vertical-align:1px;
    }

    .list{display:grid;gap:7px;max-height:38vh;overflow:auto}
    .item{
      width:100%;
      padding:10px 11px;
      border:1px solid var(--line);
      border-radius:14px;
      background:#fff;
      text-align:left;
      cursor:pointer;
    }
    .item:hover,.item.active{border-color:#60a5fa;background:#f8fbff}
    .item strong{
      display:block;
      font-size:13px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .item span{
      display:block;
      margin-top:5px;
      color:var(--muted);
      font-size:11px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .empty{
      padding:20px 10px;
      border:1px dashed #cbd5e1;
      border-radius:14px;
      color:var(--muted);
      font-size:12px;
      text-align:center;
    }

    .detail{display:none}
    .detail.show{display:block}
    .detail h3{margin:0;font-size:16px}
    .detail p{margin:5px 0 0;color:var(--muted);font-size:11px}
    .rows{display:grid;gap:7px;margin-top:12px}
    .row{
      display:grid;
      grid-template-columns:64px 1fr;
      gap:8px;
      font-size:12px;
      line-height:1.45;
      word-break:break-word;
    }
    .row b{color:var(--muted)}

    .mapPane{position:relative;min-width:0;min-height:0}
    #map{position:absolute;inset:0}
    .tools{
      position:absolute;
      top:12px;
      right:12px;
      z-index:10;
      display:flex;
      gap:8px;
    }
    .tools .btn{box-shadow:0 10px 28px rgba(15,23,42,.15)}

    .toast{
      position:absolute;
      left:50%;
      bottom:18px;
      transform:translate(-50%,10px);
      z-index:40;
      max-width:calc(100vw - 30px);
      padding:10px 14px;
      border-radius:999px;
      background:rgba(15,23,42,.9);
      color:#fff;
      font-size:12px;
      font-weight:800;
      text-align:center;
      opacity:0;
      pointer-events:none;
      transition:.18s;
    }
    .toast.show{opacity:1;transform:translate(-50%,0)}
    .toast.err{background:rgba(185,28,28,.92)}

    .loading{
      position:absolute;
      inset:0;
      z-index:25;
      display:flex;
      align-items:center;
      justify-content:center;
      background:rgba(238,243,248,.82);
    }
    .loading.hide{display:none}
    .loading div{
      padding:16px 20px;
      border:1px solid var(--line);
      border-radius:18px;
      background:#fff;
      font-size:13px;
      font-weight:900;
      box-shadow:0 14px 38px rgba(15,23,42,.12);
    }

    .info{
      min-width:210px;
      max-width:280px;
      padding:11px 12px;
      border:1px solid rgba(15,23,42,.12);
      border-radius:14px;
      background:#fff;
      box-shadow:0 14px 34px rgba(15,23,42,.2);
      transform:translateY(-8px);
    }
    .info strong{display:block;font-size:13px}
    .info span{display:block;margin-top:4px;color:var(--muted);font-size:11px}

    @media(max-width:900px){
      .app{grid-template-rows:54px 1fr}
      .top{padding:0 10px}
      .title b{font-size:16px}
      .title small,.listLink{display:none}
      .menuBtn{display:inline-flex}
      .work{display:block}
      .side{
        position:absolute;
        left:0;
        top:0;
        bottom:0;
        width:min(88vw,390px);
        transform:translateX(-105%);
        transition:.2s;
        box-shadow:0 14px 38px rgba(15,23,42,.18);
      }
      .work.open .side{transform:translateX(0)}
      .mapPane{position:absolute;inset:0}
      .list{max-height:34vh}
    }

    .denied{
      position:fixed;inset:0;z-index:30000;display:none;align-items:center;justify-content:center;
      padding:24px;background:rgba(15,23,42,.72);backdrop-filter:blur(8px)
    }
    .denied.show{display:flex}
    .deniedCard{width:min(460px,100%);padding:26px;border-radius:24px;background:#fff;border:1px solid #e2e8f0;text-align:center;box-shadow:0 28px 90px rgba(15,23,42,.35)}
    .deniedCard h2{margin:0 0 10px;font-size:22px}.deniedCard p{margin:0 0 18px;color:#64748b;line-height:1.6}.deniedCard .actions{display:flex;justify-content:center;gap:10px}
  </style>
</head>

<body>

  <div id="denied" class="denied" aria-hidden="true">
    <div class="deniedCard">
      <h2>지도 조회 권한이 없습니다</h2>
      <p>클렌징 히스토리를 조회할 수 있는 계정만 캠프 지도를 열 수 있습니다.</p>
      <div class="actions"><a class="btn primary" href="/coupang_camp">캠프 목록으로</a><a class="btn" href="/login.html?next=%2Fcoupang_camp_map">로그인</a></div>
    </div>
  </div>
  <div class="app">
    <header class="top">
      <a id="mwBoardMenuToggle" class="logo" href="/index.html" title="마루웰 메뉴">
        <img src="/favicon.ico" alt="Maroowell">
      </a>
      <div class="title">
        <b>쿠팡 캠프 지도</b>
        <small>등록 캠프 위치 · 구분/지역별 조회</small>
      </div>
      <div class="spacer"></div>
      <button id="menu" class="btn menuBtn" type="button" aria-label="필터 열기">☰</button>
      <a class="btn listLink" href="/coupang_camp">목록 보기</a>
      <button id="reload" class="btn primary" type="button">새로고침</button>
    </header>

    <main id="work" class="work">
      <aside class="side">
        <div class="inner">
          <section class="card">
            <div class="head"><b>캠프 필터</b><span>실시간 반영</span></div>
            <div class="field">
              <label for="q">검색</label>
              <input id="q" class="control" type="search" placeholder="캠프명, 주소, 코드, 설명">
            </div>
            <div class="cols">
              <div class="field">
                <label for="type">구분</label>
                <select id="type" class="control"><option value="">전체</option></select>
              </div>
              <div class="field">
                <label for="region">지역</label>
                <select id="region" class="control"><option value="">전체</option></select>
              </div>
            </div>
            <div class="actions">
              <button id="reset" class="btn" type="button">필터 초기화</button>
              <button id="fit" class="btn" type="button">전체 위치 보기</button>
            </div>
          </section>

          <section class="card">
            <div class="head"><b>조회 현황</b><span id="time">-</span></div>
            <div class="stats">
              <div class="stat"><strong id="visible">0</strong><span>표시 캠프</span></div>
              <div class="stat"><strong id="total">0</strong><span>전체 캠프</span></div>
              <div class="stat"><strong id="missing">0</strong><span>위치 확인 실패</span></div>
            </div>
          </section>

          <section class="card">
            <div class="head"><b>구분별 보기</b><span>클릭 필터</span></div>
            <div id="chips" class="chips"></div>
          </section>

          <section id="detail" class="card detail">
            <div class="head"><b>선택 캠프</b><span id="dType"></span></div>
            <h3 id="dTitle"></h3>
            <p id="dSub"></p>
            <div class="rows">
              <div class="row"><b>주소</b><span id="dAddress"></span></div>
              <div class="row"><b>지역</b><span id="dRegion"></span></div>
              <div class="row"><b>코드</b><span id="dCode"></span></div>
              <div class="row"><b>본캠프</b><span id="dParent"></span></div>
              <div class="row"><b>받는 SH</b><span id="dSh"></span></div>
              <div class="row"><b>설명</b><span id="dDesc"></span></div>
              <div class="row"><b>좌표</b><span id="dCoord"></span></div>
            </div>
            <div class="actions">
              <button id="copy" class="btn" type="button">주소 복사</button>
              <button id="openKakao" class="btn primary" type="button">카카오맵 열기</button>
            </div>
          </section>

          <section class="card">
            <div class="head"><b>캠프 목록</b><span id="count">0건</span></div>
            <div id="list" class="list"></div>
          </section>
        </div>
      </aside>

      <section class="mapPane">
        <div id="map"></div>
        <div class="tools">
          <button id="mapType" class="btn" type="button">위성</button>
          <button id="current" class="btn" type="button">내 위치</button>
        </div>
        <div id="toast" class="toast" role="status" aria-live="polite"></div>
        <div id="loading" class="loading"><div id="loadingText">캠프 지도를 불러오는 중...</div></div>
      </section>
    </main>
  </div>

  <script>
    (() => {
      "use strict";

      const CONFIG = window.MARUWELL_CONFIG || {};
      const API_BASE =
        CONFIG.BACKENDS?.coupangCamp ||
        CONFIG.COUPANG_CAMP_API ||
        "https://coupangcamp.brain-0f6.workers.dev";
      const SUPABASE_URL = CONFIG.SUPABASE_URL || "";
      const SUPABASE_ANON_KEY = CONFIG.SUPABASE_ANON_KEY || CONFIG.SUPABASE_PUBLISHABLE_KEY || "";

      const MARKER_COLORS = [
        "#2563eb", "#16a34a", "#f97316", "#7c3aed", "#db2777",
        "#0891b2", "#ca8a04", "#475569", "#dc2626", "#0f766e"
      ];

      const $ = selector => document.querySelector(selector);

      const dom = {
        work: $("#work"),
        menu: $("#menu"),
        reload: $("#reload"),
        query: $("#q"),
        type: $("#type"),
        region: $("#region"),
        reset: $("#reset"),
        fit: $("#fit"),
        chips: $("#chips"),
        list: $("#list"),
        count: $("#count"),
        visible: $("#visible"),
        total: $("#total"),
        missing: $("#missing"),
        time: $("#time"),
        detail: $("#detail"),
        detailType: $("#dType"),
        detailTitle: $("#dTitle"),
        detailSub: $("#dSub"),
        detailAddress: $("#dAddress"),
        detailRegion: $("#dRegion"),
        detailCode: $("#dCode"),
        detailParent: $("#dParent"),
        detailSh: $("#dSh"),
        detailDescription: $("#dDesc"),
        denied: $("#denied"),
        detailCoord: $("#dCoord"),
        copy: $("#copy"),
        openKakao: $("#openKakao"),
        mapType: $("#mapType"),
        current: $("#current"),
        toast: $("#toast"),
        loading: $("#loading"),
        loadingText: $("#loadingText")
      };

      const state = {
        map: null,
        clusterer: null,
        geocoder: null,
        geocodeCache: new Map(),
        rows: [],
        filteredRows: [],
        markers: [],
        markerImages: new Map(),
        colors: new Map(),
        selected: null,
        overlay: null,
        isRoadmap: true,
        selectedTypes: new Set()
      };

      const text = value => String(value ?? "").trim();
      const lower = value => text(value).toLowerCase();

      function rowId(row) {
        return row.id || [
          row.camp,
          row.mb_camp,
          row.code,
          row.latitude,
          row.longitude
        ].join("|");
      }

      function campName(row) {
        if (row.camp && row.mb_camp && row.camp !== row.mb_camp) {
          return `${row.camp} · ${row.mb_camp}`;
        }
        return row.camp || row.mb_camp || row.code || "이름 없는 캠프";
      }

      function getColor(type) {
        const key = type || "미분류";
        if (!state.colors.has(key)) {
          state.colors.set(key, MARKER_COLORS[state.colors.size % MARKER_COLORS.length]);
        }
        return state.colors.get(key);
      }

      function showToast(message, isError = false) {
        dom.toast.textContent = message;
        dom.toast.className = `toast show${isError ? " err" : ""}`;
        clearTimeout(showToast.timer);
        showToast.timer = setTimeout(() => {
          dom.toast.className = "toast";
        }, 2400);
      }

      function makeMarkerImage(type) {
        const key = type || "미분류";
        if (state.markerImages.has(key)) return state.markerImages.get(key);

        const color = getColor(key);
        const svg = [
          '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="31" viewBox="0 0 24 31">',
          `<path d="M12 1C5.9 1 1 5.9 1 12c0 8.4 11 18 11 18s11-9.6 11-18C23 5.9 18.1 1 12 1z" fill="${color}" stroke="white" stroke-width="1.5"/>`,
          '<circle cx="12" cy="12" r="4.5" fill="white"/>',
          `<circle cx="12" cy="12" r="2.1" fill="${color}"/>`,
          "</svg>"
        ].join("");

        const image = new kakao.maps.MarkerImage(
          "data:image/svg+xml;charset=UTF-8," + encodeURIComponent(svg),
          new kakao.maps.Size(24, 31),
          { offset: new kakao.maps.Point(12, 30) }
        );

        state.markerImages.set(key, image);
        return image;
      }

      function normalizeRow(row, index) {
        const latitude = Number(row?.latitude);
        const longitude = Number(row?.longitude);
        const hasValidCoordinates =
          Number.isFinite(latitude) &&
          Number.isFinite(longitude) &&
          latitude >= -90 && latitude <= 90 &&
          longitude >= -180 && longitude <= 180 &&
          !(latitude === 0 && longitude === 0);

        return {
          id: text(row?.id) || `row_${index}`,
          camp_type: text(row?.camp_type) || "미분류",
          camp: text(row?.camp),
          mb_camp: text(row?.mb_camp),
          address: text(row?.address),
          region: text(row?.region || row?.area),
          code: text(row?.code),
          parent_camp_id: text(row?.parent_camp_id),
          receiving_sh_id: text(row?.receiving_sh_id),
          parent_camp: text(row?.parent_camp),
          parent_camp_code: text(row?.parent_camp_code),
          effective_receiving_sh_id: text(row?.effective_receiving_sh_id || row?.resolved_receiving_sh_id),
          receiving_sh: text(row?.receiving_sh),
          receiving_sh_code: text(row?.receiving_sh_code),
          sh_assignment_type: text(row?.sh_assignment_type),
          latitude,
          longitude,
          description: text(row?.description),
          hasValidCoordinates,
          coordinateSource: hasValidCoordinates ? "database" : "",
          locationError: ""
        };
      }

      function addressCandidates(address) {
        const original = text(address);
        if (!original) return [];

        const values = [
          original,
          original.replace(/\([^)]*\)/g, " ").replace(/\s+/g, " ").trim(),
          original.replace(/[，,]/g, " ").replace(/\s+/g, " ").trim()
        ].filter(Boolean);

        return [...new Set(values)];
      }

      function geocodeAddress(address) {
        const cacheKey = lower(address);
        if (!cacheKey) return Promise.resolve(null);
        if (state.geocodeCache.has(cacheKey)) {
          return Promise.resolve(state.geocodeCache.get(cacheKey));
        }

        const candidates = addressCandidates(address);

        return new Promise(resolve => {
          const searchNext = index => {
            if (index >= candidates.length) {
              state.geocodeCache.set(cacheKey, null);
              resolve(null);
              return;
            }

            state.geocoder.addressSearch(candidates[index], (result, status) => {
              if (status === kakao.maps.services.Status.OK && result?.[0]) {
                const latitude = Number(result[0].y);
                const longitude = Number(result[0].x);
                const found = Number.isFinite(latitude) && Number.isFinite(longitude)
                  ? { latitude, longitude }
                  : null;

                if (found) {
                  state.geocodeCache.set(cacheKey, found);
                  resolve(found);
                } else {
                  searchNext(index + 1);
                }
                return;
              }

              searchNext(index + 1);
            });
          };

          searchNext(0);
        });
      }

      async function resolveMissingLocations(rows) {
        const targets = rows.filter(row => !row.hasValidCoordinates);
        if (!targets.length) return { resolved: 0, failed: 0 };

        let resolved = 0;
        let failed = 0;

        for (let index = 0; index < targets.length; index++) {
          const row = targets[index];
          dom.loadingText.textContent = `주소로 위치 찾는 중... ${index + 1}/${targets.length}`;

          if (!row.address) {
            row.locationError = "주소 없음";
            failed++;
            continue;
          }

          const found = await geocodeAddress(row.address);
          if (found) {
            row.latitude = found.latitude;
            row.longitude = found.longitude;
            row.hasValidCoordinates = true;
            row.coordinateSource = "address";
            row.locationError = "";
            resolved++;
          } else {
            row.locationError = "주소 검색 실패";
            failed++;
          }

          await new Promise(resolve => setTimeout(resolve, 40));
        }

        return { resolved, failed };
      }

      function sortedTypes() {
        return [...new Set(state.rows.map(row => row.camp_type))]
          .sort((a, b) => a.localeCompare(b, "ko", { numeric: true }));
      }

      function updateSelectOptions(select, values) {
        const currentValue = select.value;
        select.replaceChildren(new Option("전체", ""));

        for (const value of values) {
          select.add(new Option(value, value));
        }

        if (values.includes(currentValue)) select.value = currentValue;
      }

      function syncTypeSelect() {
        if (state.selectedTypes.size === 1) {
          dom.type.value = [...state.selectedTypes][0];
        } else {
          dom.type.value = "";
        }
      }

      function updateFilterOptions() {
        const types = sortedTypes();
        const regions = [...new Set(state.rows.map(row => row.region).filter(Boolean))]
          .sort((a, b) => a.localeCompare(b, "ko", { numeric: true }));

        state.selectedTypes = new Set(
          [...state.selectedTypes].filter(type => types.includes(type))
        );

        updateSelectOptions(dom.type, types);
        updateSelectOptions(dom.region, regions);
        syncTypeSelect();
        renderTypeChips(types);
      }

      function renderTypeChips(types = sortedTypes()) {
        const counts = new Map();
        for (const row of state.rows) {
          counts.set(row.camp_type, (counts.get(row.camp_type) || 0) + 1);
        }

        dom.chips.replaceChildren();

        for (const type of types) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = `chip${state.selectedTypes.has(type) ? " active" : ""}`;
          button.dataset.type = type;

          const dot = document.createElement("span");
          dot.className = "dot";
          dot.style.background = getColor(type);

          button.append(dot, document.createTextNode(`${type} ${counts.get(type) || 0}`));
          dom.chips.appendChild(button);
        }
      }

      function applyFilters(fitBounds = true) {
        const query = lower(dom.query.value);
        const selectedRegion = dom.region.value;

        state.filteredRows = state.rows.filter(row => {
          if (!row.hasValidCoordinates) return false;
          if (state.selectedTypes.size && !state.selectedTypes.has(row.camp_type)) return false;
          if (selectedRegion && row.region !== selectedRegion) return false;

          if (query) {
            const haystack = [
              row.camp_type,
              row.camp,
              row.mb_camp,
              row.address,
              row.region,
              row.code,
              row.parent_camp,
              row.receiving_sh,
              row.receiving_sh_code,
              row.description
            ].map(lower).join("\n");

            if (!haystack.includes(query)) return false;
          }

          return true;
        });

        if (state.selected && !state.filteredRows.some(row => rowId(row) === rowId(state.selected))) {
          clearSelection();
        }

        renderMarkers(fitBounds);
        renderList();
        renderStats();
        renderTypeChips();
      }

      function clearSelection() {
        state.selected = null;
        dom.detail.classList.remove("show");
        if (state.overlay) state.overlay.setMap(null);
      }

      function renderMarkers(fitBounds) {
        state.clusterer.clear();
        for (const marker of state.markers) marker.setMap(null);
        state.markers = [];

        if (state.overlay) state.overlay.setMap(null);

        const bounds = new kakao.maps.LatLngBounds();

        for (const row of state.filteredRows) {
          const position = new kakao.maps.LatLng(row.latitude, row.longitude);
          const marker = new kakao.maps.Marker({
            position,
            image: makeMarkerImage(row.camp_type),
            title: campName(row)
          });

          kakao.maps.event.addListener(marker, "click", () => selectCamp(row, true));
          state.markers.push(marker);
          bounds.extend(position);
        }

        state.clusterer.addMarkers(state.markers);
        if (fitBounds && state.markers.length) state.map.setBounds(bounds);
      }

      function renderList() {
        dom.count.textContent = `${state.filteredRows.length.toLocaleString()}건`;
        dom.list.replaceChildren();

        if (!state.filteredRows.length) {
          const empty = document.createElement("div");
          empty.className = "empty";
          empty.textContent = "조건에 맞는 위치 확인 캠프가 없습니다.";
          dom.list.appendChild(empty);
          return;
        }

        for (const row of state.filteredRows.slice(0, 500)) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = `item${state.selected && rowId(state.selected) === rowId(row) ? " active" : ""}`;
          button.dataset.id = rowId(row);

          const title = document.createElement("strong");
          const dot = document.createElement("i");
          dot.className = "dot";
          dot.style.background = getColor(row.camp_type);
          title.append(dot, document.createTextNode(campName(row)));

          const subtitle = document.createElement("span");
          subtitle.textContent = [row.camp_type, row.region, row.receiving_sh ? `SH ${row.receiving_sh}` : "", row.address].filter(Boolean).join(" · ");

          button.append(title, subtitle);
          dom.list.appendChild(button);
        }
      }

      function renderStats() {
        dom.visible.textContent = state.filteredRows.length.toLocaleString();
        dom.total.textContent = state.rows.length.toLocaleString();
        dom.missing.textContent = state.rows
          .filter(row => !row.hasValidCoordinates)
          .length
          .toLocaleString();
        dom.time.textContent = new Date().toLocaleTimeString("ko-KR", {
          hour: "2-digit",
          minute: "2-digit"
        });
      }

      function makeInfoOverlay(row, position) {
        const box = document.createElement("div");
        box.className = "info";

        const title = document.createElement("strong");
        title.textContent = campName(row);

        const meta = document.createElement("span");
        meta.textContent = [row.camp_type, row.region].filter(Boolean).join(" · ");

        const address = document.createElement("span");
        address.textContent = row.address || "주소 없음";

        box.append(title, meta, address);

        if (state.overlay) state.overlay.setMap(null);
        state.overlay = new kakao.maps.CustomOverlay({
          position,
          content: box,
          yAnchor: 1.32,
          zIndex: 20
        });
        state.overlay.setMap(state.map);
      }

      function selectCamp(row, focusMap) {
        state.selected = row;
        dom.detail.classList.add("show");
        dom.detailType.textContent = row.camp_type;
        dom.detailTitle.textContent = row.camp || row.mb_camp || row.code || "이름 없는 캠프";
        dom.detailSub.textContent = row.mb_camp && row.mb_camp !== row.camp
          ? `MB캠프 ${row.mb_camp}`
          : "";
        dom.detailAddress.textContent = row.address || "-";
        dom.detailRegion.textContent = row.region || "-";
        dom.detailCode.textContent = row.code || "-";
        dom.detailParent.textContent = row.parent_camp || "-";
        dom.detailSh.textContent = row.receiving_sh
          ? `${row.receiving_sh}${row.sh_assignment_type === "INHERITED" ? " (본캠프 상속)" : " (직접 지정)"}`
          : "미지정";
        dom.detailDescription.textContent = row.description || "-";
        dom.detailCoord.textContent = `${row.latitude}, ${row.longitude}${row.coordinateSource === "address" ? " (주소 변환)" : ""}`;

        const position = new kakao.maps.LatLng(row.latitude, row.longitude);
        makeInfoOverlay(row, position);

        if (focusMap) {
          state.map.panTo(position);
          if (state.map.getLevel() > 5) state.map.setLevel(5, { anchor: position });
        }

        renderList();

        if (window.matchMedia("(max-width:900px)").matches) {
          dom.work.classList.remove("open");
        }
      }

      async function loadRows() {
        dom.loading.classList.remove("hide");

        try {
          const response = await fetch(`${API_BASE}/camps`, { cache: "no-store" });
          const data = await response.json();

          if (!response.ok) {
            throw new Error(data?.error || data?.message || `HTTP ${response.status}`);
          }

          const rows = Array.isArray(data) ? data : (data?.rows || []);
          state.rows = rows.map(normalizeRow);

          const geocodeResult = await resolveMissingLocations(state.rows);
          state.rows.sort((a, b) => campName(a).localeCompare(campName(b), "ko", { numeric: true }));

          clearSelection();
          updateFilterOptions();
          applyFilters(true);

          const message = geocodeResult.resolved
            ? `캠프 ${state.rows.length.toLocaleString()}건 · 주소로 ${geocodeResult.resolved.toLocaleString()}건 위치 확인`
            : `캠프 ${state.rows.length.toLocaleString()}건을 불러왔습니다.`;
          showToast(message);
        } catch (error) {
          console.error(error);
          showToast(error?.message || String(error), true);
        } finally {
          dom.loadingText.textContent = "캠프 지도를 불러오는 중...";
          dom.loading.classList.add("hide");
        }
      }

      function bindEvents() {
        let searchTimer = null;

        dom.query.addEventListener("input", () => {
          clearTimeout(searchTimer);
          searchTimer = setTimeout(() => applyFilters(true), 180);
        });

        dom.type.addEventListener("change", () => {
          state.selectedTypes.clear();
          if (dom.type.value) state.selectedTypes.add(dom.type.value);
          applyFilters(true);
        });
        dom.region.addEventListener("change", () => applyFilters(true));

        dom.chips.addEventListener("click", event => {
          const button = event.target.closest("[data-type]");
          if (!button) return;

          const type = button.dataset.type;
          if (state.selectedTypes.has(type)) {
            state.selectedTypes.delete(type);
          } else {
            state.selectedTypes.add(type);
          }

          syncTypeSelect();
          applyFilters(true);
        });

        dom.list.addEventListener("click", event => {
          const button = event.target.closest("[data-id]");
          if (!button) return;
          const row = state.filteredRows.find(item => rowId(item) === button.dataset.id);
          if (row) selectCamp(row, true);
        });

        dom.reset.addEventListener("click", () => {
          dom.query.value = "";
          state.selectedTypes.clear();
          dom.type.value = "";
          dom.region.value = "";
          applyFilters(true);
        });

        dom.fit.addEventListener("click", () => applyFilters(true));
        dom.reload.addEventListener("click", loadRows);
        dom.menu.addEventListener("click", () => dom.work.classList.toggle("open"));

        dom.mapType.addEventListener("click", () => {
          state.isRoadmap = !state.isRoadmap;
          state.map.setMapTypeId(
            state.isRoadmap
              ? kakao.maps.MapTypeId.ROADMAP
              : kakao.maps.MapTypeId.SKYVIEW
          );
          dom.mapType.textContent = state.isRoadmap ? "위성" : "일반지도";
        });

        dom.current.addEventListener("click", () => {
          if (!navigator.geolocation) {
            showToast("위치 확인을 지원하지 않습니다.", true);
            return;
          }

          navigator.geolocation.getCurrentPosition(
            position => {
              const current = new kakao.maps.LatLng(
                position.coords.latitude,
                position.coords.longitude
              );
              state.map.panTo(current);
              state.map.setLevel(5, { anchor: current });
            },
            () => showToast("현재 위치를 확인할 수 없습니다.", true),
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
          );
        });

        dom.copy.addEventListener("click", async () => {
          if (!state.selected?.address) {
            showToast("복사할 주소가 없습니다.", true);
            return;
          }

          try {
            await navigator.clipboard.writeText(state.selected.address);
            showToast("주소를 복사했습니다.");
          } catch {
            showToast("주소 복사에 실패했습니다.", true);
          }
        });

        dom.openKakao.addEventListener("click", () => {
          if (!state.selected) return;
          const label = encodeURIComponent(campName(state.selected));
          const url = `https://map.kakao.com/link/map/${label},${state.selected.latitude},${state.selected.longitude}`;
          window.open(url, "_blank", "noopener,noreferrer");
        });

        window.addEventListener("resize", () => state.map?.relayout());
      }


      async function loadMapAccess() {
        if (!SUPABASE_URL || !SUPABASE_ANON_KEY || !window.supabase?.createClient) return false;
        try {
          const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
            auth: { persistSession:true, storage:sessionStorage, autoRefreshToken:true, detectSessionInUrl:true }
          });
          const { data } = await sb.auth.getSession();
          const token = data?.session?.access_token || "";
          if (!token) return false;
          const response = await fetch(`${API_BASE}/access`, {
            headers: { Authorization:`Bearer ${token}` },
            cache: "no-store"
          });
          const access = await response.json().catch(() => null);
          return response.ok && (access?.canClhi === true || access?.access?.can_clhi === true);
        } catch (error) {
          console.error(error);
          return false;
        }
      }

      function showDenied() {
        dom.loading.classList.add("hide");
        dom.denied.classList.add("show");
        dom.denied.setAttribute("aria-hidden", "false");
        document.documentElement.style.visibility = "visible";
      }

      async function init() {
        const allowed = await loadMapAccess();
        if (!allowed) {
          showDenied();
          return;
        }

        state.map = new kakao.maps.Map($("#map"), {
          center: new kakao.maps.LatLng(36.45, 127.85),
          level: 13
        });

        state.geocoder = new kakao.maps.services.Geocoder();

        state.clusterer = new kakao.maps.MarkerClusterer({
          map: state.map,
          averageCenter: true,
          minLevel: 7,
          gridSize: 48,
          calculator: [10, 30, 70],
          styles: [
            {
              width:"30px", height:"30px",
              background:"rgba(56,189,248,.82)",
              border:"2px solid rgba(255,255,255,.92)",
              borderRadius:"50%",
              color:"#082f49",
              textAlign:"center",
              fontSize:"11px",
              fontWeight:"900",
              lineHeight:"26px",
              boxShadow:"0 3px 10px rgba(15,23,42,.22)"
            },
            {
              width:"33px", height:"33px",
              background:"rgba(34,197,94,.82)",
              border:"2px solid rgba(255,255,255,.92)",
              borderRadius:"50%",
              color:"#052e16",
              textAlign:"center",
              fontSize:"11px",
              fontWeight:"900",
              lineHeight:"29px",
              boxShadow:"0 3px 10px rgba(15,23,42,.22)"
            },
            {
              width:"36px", height:"36px",
              background:"rgba(132,204,22,.84)",
              border:"2px solid rgba(255,255,255,.92)",
              borderRadius:"50%",
              color:"#1a2e05",
              textAlign:"center",
              fontSize:"12px",
              fontWeight:"900",
              lineHeight:"32px",
              boxShadow:"0 3px 10px rgba(15,23,42,.22)"
            },
            {
              width:"39px", height:"39px",
              background:"rgba(245,158,11,.86)",
              border:"2px solid rgba(255,255,255,.92)",
              borderRadius:"50%",
              color:"#451a03",
              textAlign:"center",
              fontSize:"12px",
              fontWeight:"900",
              lineHeight:"35px",
              boxShadow:"0 3px 10px rgba(15,23,42,.22)"
            }
          ]
        });

        kakao.maps.event.addListener(state.map, "click", () => {
          if (state.overlay) state.overlay.setMap(null);
        });

        bindEvents();
        loadRows();
        document.documentElement.style.visibility = "visible";
      }

      if (window.kakao?.maps) {
        kakao.maps.load(init);
      } else {
        document.documentElement.style.visibility = "visible";
        dom.loading.classList.add("hide");
        showToast("카카오 지도 SDK를 불러오지 못했습니다.", true);
      }
    })();
  </script>

  <script src="/board-menu.js"></script>
</body>
</html>
