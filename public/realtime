[10] 캠프별 미출근 / 완료 시각 계산 함수 추가
renderSummary() 앞에 아래 함수 추가:

function decorateCampOps(){
  const today=$("scheduleDate").value||defaultDate();

  for(const c of S.camps){
    const sch=(S.scheduleRows||[]).filter(x=>
      x.schedule_date===today &&
      String(x.camp||"").trim()===c.name &&
      String(x.wave||"").toUpperCase()===c.wave &&
      x.is_active!==false &&
      norm(x.route_label)!=="휴무자"
    );

    const people=new Map();
    for(const x of sch){
      const n=String(
        x.driver_display_name||
        x.driver_name||
        x.driver_owner_name||
        x.driver_coupang_id||
        ""
      ).trim();
      if(n)people.set(nameKey(n),n);
    }

    const present=new Set(c.rows.map(r=>nameKey(r.driver)).filter(Boolean));
    c.absentNames=[...people.entries()]
      .filter(([k])=>!present.has(k))
      .map(([,v])=>v);

    c.scheduledCount=people.size;

    const completed=c.rows.filter(r=>r.allCompletedAt);
    c.allScheduledDone=
      people.size>0 &&
      c.absentNames.length===0 &&
      c.rows.length>=people.size &&
      completed.length>=people.size;

    c.campCompletedAt=c.allScheduledDone
      ? completed.map(r=>r.allCompletedAt).sort().at(-1)
      : null;
  }
}

