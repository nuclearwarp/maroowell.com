      function normalizeLegalDongCode(value) {
        const digits = String(value ?? "").replace(/\D/g, "");
        if (digits.length === 10) return digits;
        if (digits.length > 10) return digits.slice(0, 10);
        return "";
      }

      function isLikelyLegalDongCode(value) {
        const code = normalizeLegalDongCode(value);
        if (!code) return false;
        const suffix = Number(code.slice(5, 10));
        return Number.isFinite(suffix) && suffix > 0 && suffix < 50000;
      }

      function geometrySamplePoints(feature) {
        const geometry = feature?.geometry;
        if (!geometry) return [];

        const points = [];
        const seen = new Set();
        const push = (lng, lat) => {
          const x = Number(lng);
          const y = Number(lat);
          if (!Number.isFinite(x) || !Number.isFinite(y)) return;
          const key = `${x.toFixed(6)},${y.toFixed(6)}`;
          if (seen.has(key)) return;
          try {
            if (!turf.booleanPointInPolygon(turf.point([x, y]), feature)) return;
          } catch {
            return;
          }
          seen.add(key);
          points.push({ lng: x, lat: y });
        };

        const pushFeaturePoint = (pointFeature) => {
          const coordinates = pointFeature?.geometry?.coordinates;
          if (Array.isArray(coordinates)) push(coordinates[0], coordinates[1]);
        };

        try { pushFeaturePoint(turf.pointOnFeature(feature)); } catch {}
        try { pushFeaturePoint(turf.centerOfMass(feature)); } catch {}

        const polygons = geometry.type === "Polygon"
          ? [geometry.coordinates]
          : (geometry.type === "MultiPolygon" ? geometry.coordinates : []);

        for (const polygon of polygons) {
          if (!Array.isArray(polygon) || !polygon.length) continue;
          try {
            const component = turf.polygon(polygon);
            pushFeaturePoint(turf.pointOnFeature(component));
            pushFeaturePoint(turf.centerOfMass(component));
          } catch {}

          const outer = Array.isArray(polygon[0]) ? polygon[0] : [];
          const step = Math.max(1, Math.ceil(outer.length / 16));
          for (let i = 0; i < outer.length; i += step) {
            const current = outer[i];
            const next = outer[(i + step) % outer.length];
            if (Array.isArray(current)) push(current[0], current[1]);
            if (Array.isArray(current) && Array.isArray(next)) {
              push((Number(current[0]) + Number(next[0])) / 2, (Number(current[1]) + Number(next[1])) / 2);
            }
          }
        }

        try {
          const [minLng, minLat, maxLng, maxLat] = turf.bbox(feature).map(Number);
          const gridSteps = 9;
          if ([minLng, minLat, maxLng, maxLat].every(Number.isFinite)) {
            for (let iy = 0; iy < gridSteps; iy++) {
              for (let ix = 0; ix < gridSteps; ix++) {
                const lng = minLng + (maxLng - minLng) * ((ix + 0.5) / gridSteps);
                const lat = minLat + (maxLat - minLat) * ((iy + 0.5) / gridSteps);
                push(lng, lat);
              }
            }
          }
        } catch {}

        return points.slice(0, 120);
      }

      function coordToLegalDongRegionCode(point) {
        return new Promise((resolve) => {
          if (!state.kakaoGeocoder || !point) return resolve("");
          state.kakaoGeocoder.coord2RegionCode(point.lng, point.lat, (result, status) => {
            if (status !== kakao.maps.services.Status.OK || !Array.isArray(result)) {
              resolve("");
              return;
            }
            const legal = result.find((row) => row?.region_type === "B");
            resolve(normalizeLegalDongCode(legal?.code));
          });
        });
      }

      async function coordToLegalDongCandidates(point) {
        const [regionCode, reverse] = await Promise.all([
          coordToLegalDongRegionCode(point),
          reverseAddressMetaFromPoint(point.lng, point.lat).catch(() => null),
        ]);

        const rows = [];
        if (regionCode) rows.push({ code: regionCode, source: "REGION_B", score: isLikelyLegalDongCode(regionCode) ? 6 : 0.2 });
        const addressCode = normalizeLegalDongCode(reverse?.legalDongCode);
        if (addressCode) rows.push({ code: addressCode, source: "ADDRESS_B_CODE", score: isLikelyLegalDongCode(addressCode) ? 12 : 0.4 });
        return rows;
      }

      async function resolveLegalDongCodes(zip, feature) {
        const scores = new Map();
        const addScore = (code, score = 1, source = "unknown") => {
          const normalized = normalizeLegalDongCode(code);
          if (!normalized) return;
          const current = scores.get(normalized) || { score: 0, sources: new Set(), likely: isLikelyLegalDongCode(normalized) };
          current.score += Number(score) || 0;
          current.sources.add(source);
          current.likely = current.likely || isLikelyLegalDongCode(normalized);
          scores.set(normalized, current);
        };

        const metadata = state.metadataByZip.get(zip) || {};
        const metadataCode = normalizeLegalDongCode(
          metadata.lgvReplcCd ?? metadata.lgv_replc_cd ?? metadata.legalDongCode
        );
        if (metadataCode) addScore(metadataCode, isLikelyLegalDongCode(metadataCode) ? 1 : 0.05, "BOUNDARY_METADATA");

        if (state.kakaoGeocoder) {
          const allPoints = geometrySamplePoints(feature);
          const sampleLimit = 42;
          const step = Math.max(1, Math.ceil(allPoints.length / sampleLimit));
          const points = allPoints.filter((_, index) => index % step === 0).slice(0, sampleLimit);

          for (let i = 0; i < points.length; i += BUILDING_GEOCODE_CONCURRENCY) {
            const chunk = points.slice(i, i + BUILDING_GEOCODE_CONCURRENCY);
            const found = await Promise.all(chunk.map(coordToLegalDongCandidates));
            found.flat().forEach((row) => addScore(row.code, row.score, row.source));
          }
        }

        const ordered = [...scores.entries()]
          .sort((a, b) => {
            if (a[1].likely !== b[1].likely) return a[1].likely ? -1 : 1;
            return b[1].score - a[1].score || a[0].localeCompare(b[0]);
          })
          .slice(0, BUILDING_MAX_LEGAL_DONG_CODES);

        console.info("[BUILDING_LEGAL_DONG_CODES]", zip, ordered.map(([code, info]) => ({
          code,
          bjdongCd: code.slice(5, 10),
          score: Math.round(info.score * 10) / 10,
          likelyLegalDong: info.likely,
          sources: [...info.sources],
        })));

        return ordered.map(([code]) => code);
      }

      function normalizeGeocodeAddressText(value) {
        return String(value || "")
          .toLowerCase()
          .replace(/\([^)]*\)/g, " ")
          .replace(/[,_·]/g, " ")
          .replace(/\s+/g, " ")
          .trim();
      }

      function normalizeParcelNo(value) {
        const digits = String(value ?? "").replace(/\D/g, "");
        return digits ? String(Number(digits)) : "0";
      }

      function normalizeTargetLegalDongCode(value) {
        const digits = String(value ?? "").replace(/\D/g, "");
        return digits.length >= 10 ? digits.slice(0, 10) : "";
      }

      function geocodeAddressNumbers(value) {
        return [...new Set(
          normalizeGeocodeAddressText(value).match(/\d+(?:-\d+)?/g) || []
        )];
      }

      function geocodeAddressTokens(value) {
        const ignored = new Set([
          "서울특별시", "서울시", "부산광역시", "대구광역시", "인천광역시",
          "광주광역시", "대전광역시", "울산광역시", "세종특별자치시",
          "경기도", "강원특별자치도", "충청북도", "충청남도", "전북특별자치도",
          "전라남도", "경상북도", "경상남도", "제주특별자치도", "대한민국"
        ]);

        return normalizeGeocodeAddressText(value)
          .split(" ")
          .map((token) => token.trim())
          .filter((token) => token.length >= 2 && !ignored.has(token));
      }

      function geocodeReturnedAddresses(result) {
        return [
          result?.road_address?.address_name,
          result?.address?.address_name,
          result?.address_name
        ].map((value) => String(value || "").trim()).filter(Boolean);
      }

      function geocodeTextMatchScore(query, result) {
        const queryNumbers = geocodeAddressNumbers(query);
        const queryTokens = geocodeAddressTokens(query);
        let best = 0;

        for (const returnedAddress of geocodeReturnedAddresses(result)) {
          const returnedNumbers = geocodeAddressNumbers(returnedAddress);
          const returnedTokens = geocodeAddressTokens(returnedAddress);
          const numberMatches = queryNumbers.filter((value) => returnedNumbers.includes(value)).length;
          const tokenMatches = queryTokens.filter((value) => returnedTokens.includes(value)).length;
          const exact = normalizeGeocodeAddressText(query) === normalizeGeocodeAddressText(returnedAddress);
          const score = (exact ? 100 : 0) + numberMatches * 18 + tokenMatches * 4;
          best = Math.max(best, score);
        }

        return best;
      }

      function reverseAddressMetaFromPoint(lng, lat) {
        return new Promise((resolve) => {
          if (!state.kakaoGeocoder) return resolve(null);

          state.kakaoGeocoder.coord2Address(lng, lat, (result, status) => {
            if (status !== kakao.maps.services.Status.OK || !Array.isArray(result)) {
              resolve(null);
              return;
            }

            const row = result[0] || null;
            if (!row) return resolve(null);

            const address = row.address || {};
            const road = row.road_address || {};
            const zoneDigits = String(
              road.zone_no ??
              address.zone_no ??
              ""
            ).replace(/\D/g, "");

            // coord2Address의 지번 주소에는 법정동 코드가 보장되지 않는다.
            // discovery 단계에서는 아래 regionNameKey를 기준으로 coord2RegionCode를
            // 한 번만 호출해 법정동 코드를 보충한다.
            const regionNameKey = [
              address.region_1depth_name,
              address.region_2depth_name,
              address.region_3depth_name
            ]
              .map((value) => String(value || "").replace(/\s+/g, " ").trim())
              .filter(Boolean)
              .join("|");

            resolve({
              zonecode: zoneDigits.length === 5 ? zoneDigits : null,
              legalDongCode: normalizeTargetLegalDongCode(address.b_code),
              regionNameKey,
              platGbCd: String(address.mountain_yn || "N").toUpperCase() === "Y" ? "1" : "0",
              parcelMainNo: normalizeParcelNo(address.main_address_no),
              parcelSubNo: normalizeParcelNo(address.sub_address_no),
              parcelAddress: address.address_name || null,
              roadAddress: road.address_name || null,
              matchedAddress: address.address_name || road.address_name || null,
            });
          });
        });
      }


      function scopeParcelKey(meta) {
        const legal = normalizeTargetLegalDongCode(meta?.legalDongCode);
        const main = normalizeParcelNo(meta?.parcelMainNo);
        const sub = normalizeParcelNo(meta?.parcelSubNo);
        const plat = String(meta?.platGbCd ?? "0") === "1" ? "1" : "0";
        if (!legal || main === "0") return "";
        return `${legal.slice(0, 5)}|${legal.slice(5, 10)}|${plat}|${main.padStart(4, "0")}|${sub.padStart(4, "0")}`;
      }

      function featureBoundaryDistanceMeters(feature, lng, lat) {
        try {
          const line = turf.polygonToLine(feature);
          return turf.pointToLineDistance(
            turf.point([lng, lat]),
            line,
            { units: "meters" }
          );
        } catch {
          return 0;
        }
      }

      function buildScopeDiscoveryPoints(feature) {
        const points = [];
        const seen = new Set();
        const push = (lng, lat) => {
          const x = Number(lng);
          const y = Number(lat);
          if (!Number.isFinite(x) || !Number.isFinite(y)) return;
          const key = `${x.toFixed(7)},${y.toFixed(7)}`;
          if (seen.has(key)) return;
          try {
            if (!turf.booleanPointInPolygon(turf.point([x, y]), feature)) return;
          } catch {
            return;
          }
          seen.add(key);
          points.push({ lng: x, lat: y });
        };

        try {
          const coordinates = turf.pointOnFeature(feature)?.geometry?.coordinates;
          if (Array.isArray(coordinates)) push(coordinates[0], coordinates[1]);
        } catch {}
        try {
          const coordinates = turf.centerOfMass(feature)?.geometry?.coordinates;
          if (Array.isArray(coordinates)) push(coordinates[0], coordinates[1]);
        } catch {}

        let bbox = null;
        let areaM2 = 0;
        try {
          bbox = turf.bbox(feature).map(Number);
          areaM2 = Math.max(1, Number(turf.area(feature)) || 1);
        } catch {}
        if (!bbox || bbox.some((value) => !Number.isFinite(value))) {
          return { points, spacingMeters: null, areaM2 };
        }

        const [minLng, minLat, maxLng, maxLat] = bbox;
        const midLatRad = ((minLat + maxLat) / 2) * Math.PI / 180;
        const widthMeters = Math.max(1, (maxLng - minLng) * 111320 * Math.cos(midLatRad));
        const heightMeters = Math.max(1, (maxLat - minLat) * 110574);
        let spacingMeters = Math.sqrt(areaM2 / BUILDING_SCOPE_DISCOVERY_MAX_POINTS);
        spacingMeters = Math.max(
          BUILDING_SCOPE_DISCOVERY_MIN_SPACING_METERS,
          Math.min(BUILDING_SCOPE_DISCOVERY_MAX_SPACING_METERS, spacingMeters)
        );

        let columns = Math.max(1, Math.ceil(widthMeters / spacingMeters));
        let rows = Math.max(1, Math.ceil(heightMeters / spacingMeters));
        const projectedCount = columns * rows;
        if (projectedCount > BUILDING_SCOPE_DISCOVERY_MAX_POINTS) {
          const scale = Math.sqrt(projectedCount / BUILDING_SCOPE_DISCOVERY_MAX_POINTS);
          spacingMeters *= scale;
          columns = Math.max(1, Math.ceil(widthMeters / spacingMeters));
          rows = Math.max(1, Math.ceil(heightMeters / spacingMeters));
        }

        const offsets = [[0.5, 0.5], [0.2, 0.8]];
        for (const [offsetX, offsetY] of offsets) {
          for (let iy = 0; iy < rows; iy++) {
            for (let ix = 0; ix < columns; ix++) {
              if (points.length >= BUILDING_SCOPE_DISCOVERY_MAX_POINTS) break;
              const lng = minLng + (maxLng - minLng) * ((ix + offsetX) / columns);
              const lat = minLat + (maxLat - minLat) * ((iy + offsetY) / rows);
              push(lng, lat);
            }
            if (points.length >= BUILDING_SCOPE_DISCOVERY_MAX_POINTS) break;
          }
          if (points.length >= BUILDING_SCOPE_DISCOVERY_MAX_POINTS) break;
        }

        return { points, spacingMeters, areaM2 };
      }

      async function discoverScopeParcels(zip, feature, force = false) {
        const cached = state.scopeParcelsByZip.get(zip);
        if (!force && cached?.parcels?.length) return cached;

        const plan = buildScopeDiscoveryPoints(feature);
        const parcelMap = new Map();
        const legalDongPromiseByRegion = new Map();
        let cursor = 0;
        let reverseSuccessCount = 0;
        let legalDongLookupCount = 0;
        let legalDongLookupSuccessCount = 0;
        let legalDongPointCount = 0;
        let invalidParcelKeyCount = 0;
        let parcelKeyPointCount = 0;
        let exactZipHitCount = 0;
        let interiorHitCount = 0;
        let postcodeMismatchInteriorHitCount = 0;
        let scopeRejectedCount = 0;

        async function resolvePointLegalDongCode(point, reverse) {
          const direct = normalizeTargetLegalDongCode(reverse?.legalDongCode);
          if (direct) return direct;

          const regionKey = String(reverse?.regionNameKey || "").trim();
          if (!regionKey) {
            legalDongLookupCount += 1;
            const code = await coordToLegalDongRegionCode(point).catch(() => "");
            if (code) legalDongLookupSuccessCount += 1;
            return code;
          }

          let pending = legalDongPromiseByRegion.get(regionKey);
          if (!pending) {
            legalDongLookupCount += 1;
            pending = coordToLegalDongRegionCode(point)
              .then((code) => {
                if (code) legalDongLookupSuccessCount += 1;
                return code || "";
              })
              .catch(() => "");
            legalDongPromiseByRegion.set(regionKey, pending);
          }
          return await pending;
        }

        async function worker() {
          while (true) {
            const index = cursor++;
            if (index >= plan.points.length) return;

            const point = plan.points[index];
            const reverse = await reverseAddressMetaFromPoint(point.lng, point.lat).catch(() => null);
            if (BUILDING_SCOPE_DISCOVERY_DELAY_MS > 0) {
              await new Promise((resolve) => setTimeout(resolve, BUILDING_SCOPE_DISCOVERY_DELAY_MS));
            }
            if (!reverse) continue;
            reverseSuccessCount += 1;

            const legalDongCode = await resolvePointLegalDongCode(point, reverse);
            if (!legalDongCode) {
              invalidParcelKeyCount += 1;
              continue;
            }
            legalDongPointCount += 1;

            const normalizedReverse = {
              ...reverse,
              legalDongCode
            };
            const key = scopeParcelKey(normalizedReverse);
            if (!key) {
              invalidParcelKeyCount += 1;
              continue;
            }
            parcelKeyPointCount += 1;

            const exactZip = String(reverse.zonecode || "") === String(zip);
            const boundaryDistance = featureBoundaryDistanceMeters(feature, point.lng, point.lat);
            const interiorThresholdMeters = Math.max(
              6,
              Number(plan.spacingMeters || 0) * 0.45
            );
            // 우편번호가 비어 있거나 인접 도로의 우편번호가 반환되더라도,
            // 실제 표본 좌표가 폴리곤 경계에서 충분히 안쪽이면 해당 필지를 인정한다.
            const interiorVerified = boundaryDistance >= interiorThresholdMeters;

            if (!exactZip && !interiorVerified) {
              scopeRejectedCount += 1;
              continue;
            }

            if (exactZip) exactZipHitCount += 1;
            if (interiorVerified) interiorHitCount += 1;
            if (
              reverse.zonecode &&
              String(reverse.zonecode) !== String(zip) &&
              interiorVerified
            ) {
              postcodeMismatchInteriorHitCount += 1;
            }

            const previous = parcelMap.get(key);
            if (previous) {
              previous.hitCount += 1;
              previous.zoneVerified = previous.zoneVerified || exactZip;
              previous.interiorVerified = previous.interiorVerified || interiorVerified;
              if (boundaryDistance > previous.boundaryDistanceMeters) {
                previous.lat = point.lat;
                previous.lng = point.lng;
                previous.boundaryDistanceMeters = boundaryDistance;
                previous.zonecode = reverse.zonecode || previous.zonecode || null;
                previous.parcelAddress = reverse.parcelAddress || previous.parcelAddress || null;
                previous.roadAddress = reverse.roadAddress || previous.roadAddress || null;
                previous.matchedAddress = reverse.matchedAddress || previous.matchedAddress || null;
              }
              continue;
            }

            parcelMap.set(key, {
              key,
              legalDongCode,
              platGbCd: reverse.platGbCd || "0",
              parcelMainNo: reverse.parcelMainNo,
              parcelSubNo: reverse.parcelSubNo,
              zonecode: reverse.zonecode || null,
              zoneVerified: exactZip,
              interiorVerified,
              parcelAddress: reverse.parcelAddress || null,
              roadAddress: reverse.roadAddress || null,
              matchedAddress: reverse.matchedAddress || reverse.parcelAddress || reverse.roadAddress || null,
              lat: point.lat,
              lng: point.lng,
              hitCount: 1,
              boundaryDistanceMeters: Math.round(boundaryDistance * 10) / 10,
            });
          }
        }

        const workerCount = Math.min(
          BUILDING_SCOPE_DISCOVERY_CONCURRENCY,
          Math.max(1, plan.points.length)
        );
        await Promise.all(Array.from({ length: workerCount }, worker));

        const result = {
          parcels: [...parcelMap.values()],
          diagnostics: {
            sampleCount: plan.points.length,
            reverseSuccessCount,
            legalDongLookupCount,
            legalDongLookupSuccessCount,
            legalDongPointCount,
            invalidParcelKeyCount,
            parcelKeyPointCount,
            exactZipHitCount,
            interiorHitCount,
            postcodeMismatchInteriorHitCount,
            scopeRejectedCount,
            parcelCount: parcelMap.size,
            regionCacheCount: legalDongPromiseByRegion.size,
            spacingMeters: Number.isFinite(plan.spacingMeters)
              ? Math.round(plan.spacingMeters * 10) / 10
              : null,
            areaM2: Math.round(Number(plan.areaM2 || 0)),
          }
        };

        state.scopeParcelsByZip.set(zip, result);
        console.info(
          "[BUILDING_SCOPE_PARCELS]",
          zip,
          result.diagnostics,
          result.parcels.slice(0, 20)
        );
        return result;
      }

      function runKakaoAddressSearch(query, analyzeType) {
        return new Promise((resolve) => {
          if (!state.kakaoGeocoder || !query) return resolve([]);
          const options = analyzeType ? { analyze_type: analyzeType } : undefined;
          state.kakaoGeocoder.addressSearch(query, (result, status) => {
            resolve(
              status === kakao.maps.services.Status.OK && Array.isArray(result)
                ? result
                : []
            );
          }, options);
        });
      }

      function pointInsideZipFeature(feature, lng, lat) {
        try {
          return turf.booleanPointInPolygon(turf.point([lng, lat]), feature);
        } catch {
          return false;
        }
      }

      async function geocodeResultCandidate(query, row, target, zip, feature, analyzeType) {
        const lng = Number(row?.x);
        const lat = Number(row?.y);
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) return null;

        const address = row?.address || {};
        const road = row?.road_address || {};
        let zonecode = String(road.zone_no ?? address.zone_no ?? row?.zone_no ?? "").replace(/\D/g, "");
        let legalDongCode = normalizeTargetLegalDongCode(address.b_code);
        let parcelMainNo = normalizeParcelNo(address.main_address_no);
        let parcelSubNo = normalizeParcelNo(address.sub_address_no);
        let matchedAddress = road.address_name || address.address_name || row?.address_name || null;

        if (zonecode.length !== 5 || !legalDongCode) {
          const reverse = await reverseAddressMetaFromPoint(lng, lat);
          if (reverse) {
            if (zonecode.length !== 5 && reverse.zonecode) zonecode = reverse.zonecode;
            if (!legalDongCode && reverse.legalDongCode) legalDongCode = reverse.legalDongCode;
            if (!matchedAddress && reverse.matchedAddress) matchedAddress = reverse.matchedAddress;
            if (parcelMainNo === "0" && reverse.parcelMainNo) parcelMainNo = reverse.parcelMainNo;
            if (parcelSubNo === "0" && reverse.parcelSubNo) parcelSubNo = reverse.parcelSubNo;
          }
        }

        const targetLegalDongCode = normalizeTargetLegalDongCode(
          target?.legalDongCode ?? target?.legal_dong_code
        );
        const targetMainNo = normalizeParcelNo(
          target?.parcelMainNo ?? target?.parcel_main_no ?? target?.bun
        );
        const targetSubNo = normalizeParcelNo(
          target?.parcelSubNo ?? target?.parcel_sub_no ?? target?.ji
        );
        const parcelTarget = target?.sourceType === "BUILDING_PARCEL" || target?.identityRequired === true;
        const legalMatch = !!targetLegalDongCode && legalDongCode === targetLegalDongCode;
        const mainMatch = targetMainNo !== "0" && parcelMainNo === targetMainNo;
        const subMatch = targetSubNo === "0" || parcelSubNo === targetSubNo;
        const parcelIdentity = parcelTarget && legalMatch && mainMatch && subMatch;
        const textScore = geocodeTextMatchScore(query, row);
        const addressVerified = textScore >= 22;
        const inside = pointInsideZipFeature(feature, lng, lat);
        const exactZip = String(zonecode) === String(zip);

        let score = 0;
        if (parcelIdentity) score += 1000;
        if (legalMatch) score += 250;
        if (mainMatch) score += 160;
        if (subMatch) score += 30;
        if (inside) score += 220;
        if (exactZip) score += 120;
        if (addressVerified) score += Math.min(120, textScore);
        if (analyzeType === "EXACT") score += 25;
        if (parcelTarget && targetLegalDongCode && !legalMatch) score -= 800;
        if (parcelTarget && targetMainNo !== "0" && !mainMatch) score -= 800;

        const accepted = parcelTarget
          ? (parcelIdentity || (inside && legalMatch && addressVerified))
          : (addressVerified && (inside || exactZip));

        if (!accepted) return null;

        return {
          lat,
          lng,
          zonecode: zonecode.length === 5 ? zonecode : null,
          legalDongCode: legalDongCode || null,
          parcelMainNo,
          parcelSubNo,
          matchedAddress,
          identityVerified: parcelIdentity,
          addressVerified,
          insidePolygon: inside,
          exactZip,
          matchScore: score,
          matchType: parcelIdentity
            ? "PARCEL_IDENTITY"
            : inside
              ? "POLYGON_VERIFIED_ADDRESS"
              : "POSTCODE_VERIFIED_ADDRESS",
        };
      }

      async function geocodeBuildingTarget(target, zip, feature) {
        const key = String(
          target?.key || target?.parcelKey || target?.managementKey || ""
        ).trim();
        const parcelKey = String(target?.parcelKey || target?.parcel_key || "").trim();
        const addresses = [
          target?.parcelAddress,
          target?.roadAddress,
          target?.address,
          ...(Array.isArray(target?.addressAliases) ? target.addressAliases : []),
          ...(Array.isArray(target?.address_aliases) ? target.address_aliases : [])
        ].map((value) => String(value || "").replace(/\s+/g, " ").trim())
          .filter(Boolean);

        const cacheKeys = [
          key ? `${zip}|${key}` : "",
          parcelKey ? `${zip}|parcel:${parcelKey}` : ""
        ].filter(Boolean);
        for (const cacheKey of cacheKeys) {
          const cached = state.buildingLocationCache.get(cacheKey);
          if (cached) return { ...cached, key: key || cached.key };
        }

        const exactType = kakao?.maps?.services?.AnalyzeType?.EXACT || "EXACT";
        const similarType = kakao?.maps?.services?.AnalyzeType?.SIMILAR || "SIMILAR";
        const candidates = [];
        const seen = new Set();

        for (const address of [...new Set(addresses)]) {
          for (const analyzeType of [exactType, similarType]) {
            const rows = await runKakaoAddressSearch(address, analyzeType);
            for (const row of rows.slice(0, 10)) {
              const rawKey = `${row?.x}|${row?.y}|${row?.address?.b_code || ""}|${row?.address?.main_address_no || ""}|${row?.address?.sub_address_no || ""}`;
              if (seen.has(rawKey)) continue;
              seen.add(rawKey);
              const candidate = await geocodeResultCandidate(
                address,
                row,
                target,
                zip,
                feature,
                analyzeType === exactType ? "EXACT" : "SIMILAR"
              );
              if (candidate) candidates.push({ ...candidate, queryAddress: address });
            }
          }
        }

        candidates.sort((a, b) => b.matchScore - a.matchScore);
        const point = candidates[0] || null;
        if (!point) return null;

        const location = {
          key,
          parcelKey: parcelKey || null,
          managementKey: target?.managementKey || null,
          sourceType: target?.sourceType || null,
          address: point.queryAddress || target?.address || null,
          roadAddress: target?.roadAddress || null,
          parcelAddress: target?.parcelAddress || null,
          addressAliases: [...new Set(addresses)],
          lat: point.lat,
          lng: point.lng,
          zonecode: point.zonecode,
          legalDongCode: point.legalDongCode,
          parcelMainNo: point.parcelMainNo,
          parcelSubNo: point.parcelSubNo,
          matchedAddress: point.matchedAddress,
          identityVerified: point.identityVerified === true,
          addressVerified: point.addressVerified === true,
          matchScore: point.matchScore,
          matchType: point.matchType,
        };

        cacheKeys.forEach((cacheKey) => state.buildingLocationCache.set(cacheKey, location));
        return location;
      }

      async function geocodeBuildingTargets(targets, zip, feature) {
        const uniqueTargets = [];
        const seenKeys = new Set();

        for (const target of Array.isArray(targets) ? targets : []) {
          const key = String(
            target?.key ||
            target?.parcelKey ||
            target?.managementKey ||
            target?.address ||
            ""
          ).trim();

          if (!key || seenKeys.has(key)) continue;
          seenKeys.add(key);
          uniqueTargets.push(target);
        }

        const results = [];
        let cursor = 0;

        async function worker() {
          while (true) {
            const index = cursor++;
            if (index >= uniqueTargets.length) return;

            const target = uniqueTargets[index];
            const resolved = await geocodeBuildingTarget(target, zip, feature);
            if (resolved) results.push(resolved);

            if (BUILDING_GEOCODE_DELAY_MS > 0) {
              await new Promise((resolve) => setTimeout(resolve, BUILDING_GEOCODE_DELAY_MS));
            }
          }
        }

        const workerCount = Math.min(
          BUILDING_GEOCODE_CONCURRENCY,
          Math.max(1, uniqueTargets.length)
        );

        await Promise.all(Array.from({ length: workerCount }, worker));
        return results;
      }

      async function postBuildingStats(session, payload) {
        const res = await fetchWithTimeout(
          BUILDING_STATS_API_URL,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Authorization": `Bearer ${session.access_token}`
            },
            body: JSON.stringify(payload),
            cache: "no-store"
          },
          BUILDING_STATS_FETCH_TIMEOUT_MS
        );

        const text = await res.text();
        let data = null;
        try { data = text ? JSON.parse(text) : null; } catch {}

        if (!res.ok || data?.ok === false) {
          const error = new Error(data?.error || data?.message || text || `HTTP ${res.status}`);
          error.responseData = data && typeof data === "object" ? data : null;
          error.httpStatus = res.status;
          throw error;
        }

        return data || {};
      }

      function queueBuildingStatsForZip(zip, feature, force = false) {
        if (!/^\d{5}$/.test(String(zip || "")) || !feature?.geometry) return Promise.resolve();
        if (!force && state.buildingStatsByZip.has(zip)) return Promise.resolve();
        if (state.buildingQueuedZips.has(zip)) return state.buildingQueue;

        state.buildingQueuedZips.add(zip);
        state.buildingStatusByZip.set(zip, {
          state: "queued",
          message: "배송 호수 분석 대기 중입니다."
        });
        renderTerrainList();

        state.buildingQueue = state.buildingQueue
          .catch(() => {})
          .then(async () => {
            state.buildingQueuedZips.delete(zip);
            if (!state.selectedZips.has(zip)) return;
            await fetchBuildingStatsForZip(zip, feature, force);
          });

        return state.buildingQueue;
      }

      async function fetchBuildingStatsForZip(zip, feature, force = false) {
        if (!/^\d{5}$/.test(String(zip || "")) || !feature?.geometry) return;
        if (!state.selectedZips.has(zip)) return;

        const currentStatus = state.buildingStatusByZip.get(zip);
        if (!force && (state.buildingStatsByZip.has(zip) || currentStatus?.state === "loading")) return;

        // 수동 갱신이 실패해도 기존 정상 분석 카드를 지우지 않는다.
        const previousStats = state.buildingStatsByZip.get(zip) || null;
        state.buildingStatusByZip.set(zip, {
          state: "loading",
          message: previousStats
            ? "기존 분석값을 유지한 채 새 데이터로 갱신하고 있습니다."
            : "주거·상업 배송 호수를 확인하고 있습니다."
        });
        renderTerrainList();

        try {
          if (!state.kakaoGeocoder) {
            throw new Error("카카오 주소 검색 라이브러리를 불러오지 못했습니다.");
          }

          const session = await getCurrentSession();
          if (!session?.access_token) {
            throw new Error("로그인 세션을 확인하지 못했습니다. 새로고침 후 다시 시도해주세요.");
          }

          const legalDongCodes = await resolveLegalDongCodes(zip, feature);
          if (!legalDongCodes.length) {
            throw new Error("건축물 조회에 필요한 법정동 코드를 확인하지 못했습니다.");
          }

          const basePayload = {
            zipcode: zip,
            geometry: feature.geometry,
            legalDongCodes,
            forceRefresh: force === true,
            force_refresh: force === true,
            walkupMinGroundFloors: 3,
            minCoveragePercent: 75,
            scopeMatchMode: "V21_BULK_EXCLUSIVE_VALIDATION",
            legalDongCodeCandidates: legalDongCodes
          };

          let data = await postBuildingStats(session, basePayload);
          let scopeDiscovery = null;

          if (data?.requiresScopeDiscovery === true) {
            state.buildingStatusByZip.set(zip, {
              state: "loading",
              message: "폴리곤 내부 필지를 확인하고 있습니다."
            });
            renderTerrainList();

            scopeDiscovery = await discoverScopeParcels(zip, feature, force === true);
            if (!scopeDiscovery.parcels.length) {
              throw new Error(
                `폴리곤 내부 필지를 확인하지 못했습니다. 표본 ${scopeDiscovery.diagnostics.sampleCount.toLocaleString("ko-KR")}개 / 역지오코딩 ${scopeDiscovery.diagnostics.reverseSuccessCount.toLocaleString("ko-KR")}건 / 법정동확인 ${scopeDiscovery.diagnostics.legalDongPointCount.toLocaleString("ko-KR")}건 / 필지키 ${scopeDiscovery.diagnostics.parcelKeyPointCount.toLocaleString("ko-KR")}건`
              );
            }

            data = await postBuildingStats(session, {
              ...basePayload,
              forceRefresh: false,
              force_refresh: false,
              scopeParcels: scopeDiscovery.parcels,
              scopeParcelDiscovery: scopeDiscovery.diagnostics,
              locationSource: "KAKAO_POLYGON_REVERSE_PARCEL"
            });
          }

          const locationsByKey = new Map();

          for (
            let round = 0;
            data?.requiresGeocoding === true && round < BUILDING_GEOCODE_MAX_ROUNDS;
            round++
          ) {
            const targets = Array.isArray(data.geocodingTargets) ? data.geocodingTargets : [];
            if (!targets.length) break;

            state.buildingStatusByZip.set(zip, {
              state: "loading",
              message: `건축물 위치 확인 중 ${round + 1}/${BUILDING_GEOCODE_MAX_ROUNDS} · ${targets.length.toLocaleString("ko-KR")}건`
            });
            renderTerrainList();

            const locations = await geocodeBuildingTargets(targets, zip, feature);
            const beforeCount = locationsByKey.size;
            locations.forEach((location) => {
              if (location?.key) locationsByKey.set(location.key, location);
              if (location?.parcelKey) locationsByKey.set(`parcel:${location.parcelKey}`, location);
            });

            if (locationsByKey.size === beforeCount && targets.length > 0) {
              break;
            }

            data = await postBuildingStats(session, {
              ...basePayload,
              forceRefresh: false,
              force_refresh: false,
              buildingLocations: [...locationsByKey.values()],
              scopeParcels: scopeDiscovery?.parcels || undefined,
              scopeParcelDiscovery: scopeDiscovery?.diagnostics || undefined,
              locationSource: scopeDiscovery?.parcels?.length
                ? "KAKAO_POLYGON_REVERSE_PARCEL+ADDRESS_SEARCH"
                : "KAKAO_JS_GEOCODER"
            });
          }

          if (!state.selectedZips.has(zip)) return;

          // 공터·하천·도로가 넓은 우편번호라도 건물 데이터 자체는 분석한다.
          // 주소검색이 끝까지 되지 않은 고유 건물만 남은 경우에는 1년 캐시에 저장하지 않고
          // 현재 확인된 건물 기준 잠정 결과를 받아 화면에 표시한다.
          if (data?.requiresGeocoding === true) {
            data = await postBuildingStats(session, {
              ...basePayload,
              forceRefresh: false,
              force_refresh: false,
              allowPartial: true,
              allow_partial: true,
              buildingLocations: [...locationsByKey.values()],
              scopeParcels: scopeDiscovery?.parcels || undefined,
              scopeParcelDiscovery: scopeDiscovery?.diagnostics || undefined,
              locationSource: scopeDiscovery?.parcels?.length
                ? "KAKAO_POLYGON_REVERSE_PARCEL+ADDRESS_SEARCH"
                : "KAKAO_JS_GEOCODER"
            });
          }

          if (data?.requiresGeocoding === true) {
            const coverage = Number(data?.coveragePercent);
            const coverageText = Number.isFinite(coverage)
              ? ` 현재 건물주소 확인율 ${coverage.toLocaleString("ko-KR", { maximumFractionDigits: 1 })}%.`
              : "";
            throw new Error(`건물주소 확인을 완료하지 못했습니다.${coverageText}`);
          }

          if (!data?.buildingStats) {
            throw new Error("배송 호수 분석 결과가 비어 있습니다.");
          }

          const deliveryCount = Number(data?.buildingStats?.deliveryUnitCount || 0);
          const diagnostics = data?.buildingStats?.breakdown || data?.diagnostics || null;
          if (deliveryCount === 0) {
            const breakdown = diagnostics?.breakdown || diagnostics || {};
            const kapt = breakdown?.kapt || {};
            const source = breakdown?.source || {};
            const unitDiagnostics = source?.unitDiagnostics || {};
            const matchedRows = Number(
              diagnostics?.matchedBuildingRows ??
              source?.matchedTitleRowCount ??
              data?.diagnostics?.matchedBuildingRows ??
              0
            );
            const detail = [
              `표제부 ${matchedRows}건`,
              `K-APT ${Number(kapt?.complexCount || 0)}단지/${Number(kapt?.householdCount || 0)}호`,
              `전유부 ${Number(unitDiagnostics?.exposRows || 0)}건`,
              `전유공용 ${Number(unitDiagnostics?.areaRows || 0)}건`,
              `총괄표제 ${Number(unitDiagnostics?.recapRows || 0)}건`,
              `주택가격 ${Number(unitDiagnostics?.housePriceRows || 0)}건`,
            ].join(" · ");

            console.error("[BUILDING_STATS_ZERO_DIAGNOSTICS]", zip, {
              diagnostics,
              kaptDiagnostics: kapt?.complexes || [],
              parcelDiagnostics: source?.parcelQueries || [],
              response: data,
            });
            throw new Error(
              data?.error ||
              `배송호수 원천 연결 실패 (${detail}). 콘솔 BUILDING_STATS_ZERO_DIAGNOSTICS에서 폴리곤 필지 직접조회와 K-APT 응답을 확인해주세요.`
            );
          }

          console.info("[BUILDING_STATS_RESULT]", zip, {
            sourceVersion: data?.buildingStats?.sourceVersion,
            unitAnalysisVersion: data?.buildingStats?.unitAnalysisVersion,
            deliveryUnitCount: data?.buildingStats?.deliveryUnitCount,
            residentialUnitCount: data?.buildingStats?.residentialUnitCount,
            commercialUnitCount: data?.buildingStats?.commercialUnitCount,
            coveragePercent: data?.buildingStats?.coveragePercent,
            breakdown: data?.buildingStats?.breakdown,
            kaptDiagnostics: data?.buildingStats?.breakdown?.kapt?.complexes || [],
            parcelDiagnostics: data?.buildingStats?.breakdown?.source?.parcelQueries || [],
            dataQuality: data?.buildingStats?.breakdown?.dataQuality || null,
            bulkExclusive: data?.buildingStats?.breakdown?.source?.bulkExclusive || null,
            warning: data?.warning || null
          });

          state.buildingStatsByZip.set(zip, {
            ...data.buildingStats,
            cached: data.cached === true,
            stale: data.stale === true,
            legacyCache: data.legacyCache === true,
            needsRefresh: data.needsRefresh === true,
            partial: data.partial === true,
            provisional: data.provisional === true,
            warning: data.warning || (
              data.legacyCache === true
                ? "기존 정상 캐시를 표시합니다. 필요할 때 배송호수 갱신을 눌러주세요."
                : null
            )
          });
          state.buildingStatusByZip.set(zip, { state: "ready" });
        } catch (e) {
          const responseData = e?.responseData || null;
          const diagnostics = responseData?.diagnostics || null;
          console.warn("[BUILDING_STATS_API] fetch failed", zip, {
            error: e,
            responseData,
            legalDongCodes: diagnostics?.legalDongCodes || null,
            buildingHubQueries: diagnostics?.buildingHubQueries || null,
          });

          let displayMessage = String(e?.message || e || "배송 호수 분석 실패");
          if (diagnostics?.legalDongCodes?.length) {
            const codeText = diagnostics.legalDongCodes
              .map((row) => typeof row === "string" ? row : row?.legalDongCode)
              .filter(Boolean)
              .join(", ");
            if (codeText) displayMessage += ` · 조회 법정동 ${codeText}`;
          }
          if (Array.isArray(diagnostics?.buildingHubQueries)) {
            const queryText = diagnostics.buildingHubQueries
              .slice(0, 6)
              .map((row) => `${row?.bjdongCd || "?"}:${row?.status || "?"}${row?.gateway?.code ? `[${row.gateway.code}]` : ""}`)
              .join(", ");
            if (queryText) displayMessage += ` · 표제부 ${queryText}`;
          }

          if (previousStats) {
            state.buildingStatsByZip.set(zip, {
              ...previousStats,
              stale: true,
              needsRefresh: true,
              warning: `갱신 실패 · 기존 분석값 유지: ${displayMessage}`
            });
            state.buildingStatusByZip.set(zip, { state: "ready" });
          } else {
            state.buildingStatusByZip.set(zip, {
              state: "error",
              message: e?.name === "AbortError"
                ? `요청 시간초과(${Math.round(BUILDING_STATS_FETCH_TIMEOUT_MS / 1000)}초)`
                : displayMessage
            });
          }
        } finally {
          renderTerrainList();
        }
      }

      function renderTerrainList() {
        const list = $("#terrainList");
        if (!list) return;

        const zips = [...state.selectedZips].sort();
        if (!zips.length) {
          list.innerHTML = '<div class="terrainEmpty">지도표시 후 우편번호별 분석정보가 표시됩니다.</div>';
          return;
        }

        list.innerHTML = zips.map((zip) => {
          const terrain = state.terrainByZip.get(zip) || null;
          const terrainStatus = state.terrainStatusByZip.get(zip) || null;
          const buildingRaw = state.buildingStatsByZip.get(zip) || null;
          const buildingStatus = state.buildingStatusByZip.get(zip) || null;
          const building = buildingRaw ? buildingStatsFromResponse(buildingRaw) : null;
          const safeZip = escapeTerrainHtml(zip);

          const terrainCached = terrain?.cached === true;
          const terrainBadge = terrainCached ? "캐시" : (terrain ? "완료" : "대기");
          const terrainBadgeClass = terrainCached ? "cache" : (terrain ? "fresh" : "");

          let terrainHtml = "";
          if (terrainStatus?.state === "loading") {
            terrainHtml = '<div class="terrainMessage">구역 고저차와 경사도를 계산하고 있습니다.</div>';
          } else if (terrainStatus?.state === "error") {
            terrainHtml = `
              <div class="terrainMessage">${escapeTerrainHtml(terrainErrorMessage(terrainStatus.message))}</div>
              <button class="terrainRetry" type="button" data-terrain-retry="${safeZip}">지형 다시 조회</button>`;
          } else if (terrain) {
            const metrics = terrainMetricsFromResponse(terrain);
            const calculatedAt =
              terrain.slope?.calculatedAt ??
              terrain.slope?.calculated_at ??
              terrain.calculatedAt ??
              terrain.calculated_at;
            const calculatedText = calculatedAt
              ? new Date(calculatedAt).toLocaleString("ko-KR")
              : "-";

            terrainHtml = `
              <div class="terrainCompactRange">
                <span>구역 고저차</span>
                <strong>${formatTerrainMeters(metrics.elevationRange)}</strong>
              </div>
              <div class="terrainCompactSlope">
                <div class="terrainSlopeTitle">경사도 분포</div>
                ${terrainSlopeHtml("평지", metrics.flatPercent, "flat")}
                ${terrainSlopeHtml("완경사", metrics.gentlePercent, "gentle")}
                ${terrainSlopeHtml("급경사", metrics.steepPercent, "steep")}
              </div>
              <div class="terrainCompactMeta">계산 ${escapeTerrainHtml(calculatedText)}</div>`;
          } else {
            terrainHtml = `<div class="terrainMessage">${state.geoByZip.has(zip) ? "지형정보 조회를 준비하고 있습니다." : "지도표시를 누르면 지형정보를 조회합니다."}</div>`;
          }

          let buildingHtml = "";
          if (buildingStatus?.state === "loading" || buildingStatus?.state === "queued") {
            buildingHtml = `
              <div class="buildingStatsMessage">${escapeTerrainHtml(buildingStatus.message || "주거·상업 배송 호수와 엘리베이터를 분석하고 있습니다.")}</div>`;
          } else if (buildingStatus?.state === "error") {
            buildingHtml = `
              <div class="buildingStatsMessage error">${escapeTerrainHtml(buildingStatus.message || "배송 호수 분석 실패")}</div>`;
          } else if (building) {
            const calculatedText = building.calculatedAt
              ? new Date(building.calculatedAt).toLocaleString("ko-KR")
              : "-";
            const coverageText = Number.isFinite(Number(building.coveragePercent))
              ? ` · 건물주소 확인 ${Number(building.coveragePercent).toLocaleString("ko-KR", { maximumFractionDigits: 1 })}%`
              : "";

            const totalUnits = Number(building.deliveryUnitCount || 0);
            const residentialUnits = Number(building.residentialUnitCount || 0);
            const commercialUnits = Number(building.commercialUnitCount || 0);
            const unclassifiedUnits = Number(building.unclassifiedUnitCount || 0);
            const confirmedElevatorUnits = Number(building.confirmedElevatorUnitCount || 0);
            const inferredElevatorUnits = Number(building.inferredElevatorUnitCount || 0);
            const noElevatorUnits = Number(building.noElevatorUnitCount || 0);
            const unknownElevatorUnits = Number(building.unknownElevatorUnitCount || 0);
            const authoritativeUnits = Number(building.authoritativeUnitCount ?? totalUnits);
            const estimatedUnits = Number(building.estimatedUnitCount || 0);
            const elevatorBuildings = Number(building.elevatorBuildingCount || 0);
            const noElevatorBuildings = Number(building.noElevatorBuildingCount || 0);
            const unknownElevatorBuildings = Number(building.unknownElevatorBuildingCount || 0);
            const qualityClass = estimatedUnits > 0 ? " warn" : "";

            buildingHtml = `
              <div class="buildingStatsGrid">
                <div class="buildingStatsMetric total">
                  <span>총 배송호수</span>
                  <strong>${formatDeliveryUnitCount(totalUnits)}</strong>
                </div>
                <div class="buildingStatsMetric residential">
                  <span>주거</span>
                  <strong>${formatDeliveryUnitCount(residentialUnits)}</strong>
                  <small>${formatUnitPercent(residentialUnits, totalUnits)}</small>
                </div>
                <div class="buildingStatsMetric commercial">
                  <span>상업·업무</span>
                  <strong>${formatDeliveryUnitCount(commercialUnits)}</strong>
                  <small>${formatUnitPercent(commercialUnits, totalUnits)}</small>
                </div>
                ${unclassifiedUnits > 0 ? `
                <div class="buildingStatsMetric unknown">
                  <span>용도 미분류</span>
                  <strong>${formatDeliveryUnitCount(unclassifiedUnits)}</strong>
                  <small>${formatUnitPercent(unclassifiedUnits, totalUnits)}</small>
                </div>` : ""}
                <div class="buildingStatsMetric">
                  <span>엘베 확인</span>
                  <strong>${formatDeliveryUnitCount(confirmedElevatorUnits)}</strong>
                  <small>${formatUnitPercent(confirmedElevatorUnits, totalUnits)}</small>
                </div>
                <div class="buildingStatsMetric inferred">
                  <span>엘베 추정</span>
                  <strong>${formatDeliveryUnitCount(inferredElevatorUnits)}</strong>
                  <small>${formatUnitPercent(inferredElevatorUnits, totalUnits)}</small>
                </div>
                <div class="buildingStatsMetric walkup">
                  <span>엘베 없음</span>
                  <strong>${formatDeliveryUnitCount(noElevatorUnits)}</strong>
                  <small>${formatUnitPercent(noElevatorUnits, totalUnits)}</small>
                </div>
                <div class="buildingStatsMetric unknown">
                  <span>엘베 미확인</span>
                  <strong>${formatDeliveryUnitCount(unknownElevatorUnits)}</strong>
                  <small>${formatUnitPercent(unknownElevatorUnits, totalUnits)}</small>
                </div>
              </div>
              <div class="buildingStatsQuality${qualityClass}">
                호수 검증 · 확정 ${formatDeliveryUnitCount(authoritativeUnits)} · 추정 ${formatDeliveryUnitCount(estimatedUnits)}<br/>
                엘베 건물 · 있음/추정 ${formatBuildingCount(elevatorBuildings)} · 없음 ${formatBuildingCount(noElevatorBuildings)} · 미확인 ${formatBuildingCount(unknownElevatorBuildings)}
              </div>
              <div class="terrainCompactMeta">분석 ${escapeTerrainHtml(calculatedText)}${escapeTerrainHtml(coverageText)}</div>`;
          } else {
            buildingHtml = '<div class="buildingStatsMessage">지도표시 후 주거·상업 배송 호수와 엘리베이터를 분석합니다.</div>';
          }

          return `
            <article class="terrainCard${terrainStatus?.state === "error" ? " error" : ""}${state.activeZip === zip ? " is-active" : ""}" data-terrain-zip="${safeZip}">
              <div class="terrainCardTop">
                <span class="terrainZip">${safeZip}</span>
                <div class="terrainCardTopRight">
                  <span class="terrainStatus ${terrainBadgeClass}">${terrainBadge}</span>
                  <button class="analysisRefresh" type="button" data-building-refresh="${safeZip}">배송호수 갱신</button>
                </div>
              </div>
              ${terrainHtml}
              <div class="buildingStatsBlock">
                <div class="buildingStatsHead">
                  <b>배송호수·엘리베이터</b>
                  <span class="buildingStatsState">${building?.cached
                    ? (building?.stale
                      ? "기존값"
                      : (building?.legacyCache ? "기존 캐시" : "캐시"))
                    : (building?.partial || building?.provisional
                      ? "잠정"
                      : (building ? "완료" : ""))}</span>
                </div>
                ${buildingHtml}
              </div>
            </article>`;
        }).join("");

        list.querySelectorAll("[data-terrain-retry]").forEach((button) => {
          button.addEventListener("click", () => {
            const zip = button.getAttribute("data-terrain-retry") || "";
            const feature = state.geoByZip.get(zip);
            if (!feature) {
              alert("우편번호 경계를 먼저 지도에 표시해주세요.");
              return;
            }
            void fetchTerrainForZip(zip, feature, true);
          });
        });

        list.querySelectorAll("[data-building-refresh]").forEach((button) => {
          button.addEventListener("click", (event) => {
            event.stopPropagation();
            const zip = button.getAttribute("data-building-refresh") || "";
            const feature = state.geoByZip.get(zip);
            if (!feature) {
              alert("우편번호 경계를 먼저 지도에 표시해주세요.");
              return;
            }
            void queueBuildingStatsForZip(zip, feature, true);
          });
        });

        list.querySelectorAll("[data-terrain-retry]").forEach((button) => {
          button.addEventListener("click", (event) => event.stopPropagation());
        });

        list.querySelectorAll("[data-terrain-zip]").forEach((card) => {
          card.addEventListener("click", (event) => {
            if (event.target.closest("button")) return;
            const zip = card.getAttribute("data-terrain-zip") || "";
            focusZip(zip, { focusMap: true, scrollCard: false });
          });
        });

        updateZipSelectionVisuals();
      }

      async function fetchTerrainForZip(zip, feature, force = false) {
        if (!/^\d{5}$/.test(String(zip || "")) || !feature?.geometry) return;

        const areaSquareMeters = featureAreaSquareMeters(feature);
        if (areaSquareMeters != null && areaSquareMeters >= 0) {
          state.areaByZip.set(zip, areaSquareMeters);
        }

        const currentStatus = state.terrainStatusByZip.get(zip);
        if (!force && (state.terrainByZip.has(zip) || currentStatus?.state === "loading")) return;

        if (force) state.terrainByZip.delete(zip);
        state.terrainStatusByZip.set(zip, { state: "loading" });
        renderTerrainList();

        try {
          const session = await getCurrentSession();
          if (!session?.access_token) {
            throw new Error("로그인 세션을 확인하지 못했습니다. 새로고침 후 다시 시도해주세요.");
          }

          const res = await fetchWithTimeout(
            TERRAIN_API_URL,
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${session.access_token}`
              },
              body: JSON.stringify({
                zipcode: zip,
                geometry: feature.geometry
              }),
              cache: "no-store"
            },
            TERRAIN_FETCH_TIMEOUT_MS
          );

          const text = await res.text();
          let data = null;
          try { data = text ? JSON.parse(text) : null; } catch {}

          if (!res.ok || data?.ok === false || !data?.terrain) {
            throw new Error(data?.error || data?.message || text || `HTTP ${res.status}`);
          }

          state.terrainByZip.set(zip, {
            ...data.terrain,
            cached: data.cached === true,
            areaSquareMeters:
              terrainNumber(
                data?.terrain?.polygonAreaM2 ??
                data?.terrain?.polygon_area_m2 ??
                data?.terrain?.areaSquareMeters ??
                data?.terrain?.area_sqm
              ) ??
              terrainNumber(state.areaByZip.get(zip)) ??
              areaSquareMeters
          });
          state.terrainStatusByZip.set(zip, { state: "ready" });
        } catch (e) {
          console.warn("[TERRAIN_API] fetch failed", zip, e);
          state.terrainStatusByZip.set(zip, {
            state: "error",
            message: e?.name === "AbortError"
              ? `요청 시간초과(${Math.round(TERRAIN_FETCH_TIMEOUT_MS / 1000)}초)`
              : terrainErrorMessage(e?.message || e)
          });
        } finally {
          renderTerrainList();
        }
      }


      function removeZipData(zip) {
        if (state.polygons.has(zip)) {
          state.polygons.get(zip).forEach(p => p.setMap(null));
          state.polygons.delete(zip);
        }

        if (state.labels.has(zip)) {
          state.labels.get(zip).forEach(l => l.setMap(null));
          state.labels.delete(zip);
        }

        state.geoByZip.delete(zip);
        state.areaByZip.delete(zip);
        state.terrainByZip.delete(zip);
        state.terrainStatusByZip.delete(zip);
        state.metadataByZip.delete(zip);
        state.buildingStatsByZip.delete(zip);
        state.buildingStatusByZip.delete(zip);
