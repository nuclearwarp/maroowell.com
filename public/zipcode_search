}

function buildingStatsTargetAddressAliases(target) {
  const values = [
    target?.roadAddress,
    target?.road_address,
    target?.parcelAddress,
    target?.parcel_address,
    target?.address,
    ...(Array.isArray(target?.addressAliases)
      ? target.addressAliases
      : []),
    ...(Array.isArray(target?.address_aliases)
      ? target.address_aliases
      : []),
  ];

  const result = [];
  const seen = new Set();

  for (const value of values) {
    const text = cleanBuildingText(value);
    const normalized = normalizedBuildingAddress(text);
    if (!text || !normalized || seen.has(normalized)) continue;
    seen.add(normalized);
    result.push(text);
  }

  return result;
}

function buildingStatsTargetAliasKeys(target) {
  const keys = buildingStatsTargetAddressAliases(target)
    .map(normalizedBuildingAddress)
    .filter(Boolean)
    .map((value) => `addr:${value}`);

  if (keys.length) return keys;

  const fallback = cleanBuildingText(
    target?.key ??
    target?.managementKey ??
    target?.management_key
  );

  return fallback ? [`key:${fallback}`] : [];
}

function dedupeBuildingStatsGeocodingTargets(targets) {
  // V11: 주소 별칭이 같다는 이유로 서로 다른 필지를 합치지 않는다.
  // 집합건축물·구축 빌라는 동일 도로명 주소 아래 여러 관리대장/필지가 존재할 수 있다.
  const result = [];
  const seen = new Set();

  for (const target of Array.isArray(targets) ? targets : []) {
    if (!target || typeof target !== "object") continue;

    const key = cleanBuildingText(
      target?.key ??
      target?.parcelKey ??
      target?.parcel_key ??
      target?.managementKey ??
      target?.management_key
    );

    if (!key || seen.has(key)) continue;
    seen.add(key);

    result.push({
      ...target,
      addressAliases: buildingStatsTargetAddressAliases(target),
    });
  }

  return result;
}

function buildBuildingParcelGroupsV11(records) {
  const groups = new Map();

  for (const row of Array.isArray(records) ? records : []) {
    if (!row || typeof row !== "object") continue;

    const parcel = buildingParcelDescriptor(row);
    const recordKey = buildingRecordKey(row);
    const groupKey = parcel?.key || `record:${recordKey}`;

    if (!groups.has(groupKey)) {
      groups.set(groupKey, {
        key: groupKey,
        parcel,
        rows: [],
      });
    }

    groups.get(groupKey).rows.push(row);
  }

  return [...groups.values()];
}

function buildingParcelGeocodingTargetV13(group) {
  const rows = Array.isArray(group?.rows) ? group.rows : [];
  const aliases = [];
  const aliasSeen = new Set();
  let roadAddress = "";
  let parcelAddress = "";
  let buildingName = "";

  for (const row of rows) {
    const addresses = buildingRecordAddresses(row);
    if (!roadAddress && addresses.roadAddress) roadAddress = addresses.roadAddress;
    if (!parcelAddress && addresses.parcelAddress) parcelAddress = addresses.parcelAddress;
    if (!buildingName) buildingName = cleanBuildingText(row?.bldNm ?? row?.bld_nm);

    for (const value of [addresses.parcelAddress, addresses.roadAddress]) {
      const normalized = normalizedBuildingAddress(value);
      if (!normalized || aliasSeen.has(normalized)) continue;
      aliasSeen.add(normalized);
      aliases.push(value);
    }
  }

  const parcel = group?.parcel || null;
  const key = `parcel:${group?.key || "unknown"}`;
  const legalDongCode = parcel
    ? `${parcel.sigunguCd}${parcel.bjdongCd}`
    : "";

  return {
    key,
    parcelKey: group?.key || null,
    managementKey: key,
    sourceType: "BUILDING_PARCEL",
    roadAddress: roadAddress || null,
    parcelAddress: parcelAddress || null,
    address: parcelAddress || roadAddress || aliases[0] || null,
    addressAliases: aliases,
    buildingName: buildingName || null,
    mergedRecordCount: rows.length,
    sigunguCd: parcel?.sigunguCd || null,
    bjdongCd: parcel?.bjdongCd || null,
    legalDongCode: legalDongCode.length === 10 ? legalDongCode : null,
    platGbCd: parcel?.platGbCd || "0",
    parcelMainNo: parcel?.bun || null,
    parcelSubNo: parcel?.ji || "0000",
    identityRequired: !!parcel,
  };
}

function buildingParcelScopeDecisionV13(location, geometry, scopeZipcode) {
  if (!location) {
    return { matched: false, reason: "missing_location", distanceMeters: null };
  }

  const lng = Number(location.lng);
  const lat = Number(location.lat);
  if (!Number.isFinite(lng) || !Number.isFinite(lat)) {
    return { matched: false, reason: "invalid_location", distanceMeters: null };
  }

  // 실제 좌표가 폴리곤 안이면 역지오코딩 우편번호가 인접 도로값으로 나오더라도 포함한다.
  const inside = pointInBuildingGeometry(lng, lat, geometry);
  if (inside) {
    return { matched: true, reason: "inside_polygon", distanceMeters: 0 };
  }

  const distanceMeters = buildingDistanceToGeometryMeters(lng, lat, geometry);
  const normalizedScopeZipcode = normalizeTerrainZipcode(scopeZipcode);
  const normalizedLocationZipcode = normalizeTerrainZipcode(
    location.zonecode ?? location.zoneCode ?? location.zone_no ?? location.zoneNo ??
    location.postcode ?? location.postalCode
  );
  const identityVerified = location.identityVerified === true;
  const addressVerified = location.addressVerified === true;

  if (normalizedScopeZipcode) {
    // 필지의 법정동코드+본번+부번이 카카오 결과와 일치한 경우에만
    // 우편번호를 폴리곤 좌표보다 우선한다. 단순 유사주소 결과는 절대 사용하지 않는다.
    if (
      identityVerified &&
      normalizedLocationZipcode === normalizedScopeZipcode
    ) {
      return {
        matched: true,
        reason: "verified_parcel_postcode",
        distanceMeters,
      };
    }

    // 공동주택 목록처럼 필지번호가 없는 원천은 주소가 검증되고 경계와 가까운 경우만 보정한다.
    if (
      addressVerified &&
      normalizedLocationZipcode === normalizedScopeZipcode &&
      distanceMeters <= BUILDING_STATS_ZIPCODE_EDGE_TOLERANCE_METERS
    ) {
      return {
        matched: true,
        reason: "verified_address_edge",
        distanceMeters,
      };
    }

    return {
      matched: false,
      reason: identityVerified || addressVerified
        ? "verified_outside_scope"
        : "unverified_location",
      distanceMeters,
    };
  }

  if (
    (identityVerified || addressVerified) &&
    distanceMeters <= BUILDING_STATS_ROUTE_EDGE_TOLERANCE_METERS
  ) {
    return {
      matched: true,
      reason: "verified_route_edge",
      distanceMeters,
    };
  }

  return { matched: false, reason: "outside_polygon", distanceMeters };
}

function findBuildingStatsTargetLocation(target, locationIndex) {
  if (!target || !locationIndex) return null;

  const direct = normalizeBuildingLocationPoint(target);
  if (direct) return direct;

  const directKeys = [
    target?.key,
    target?.recordKey,
    target?.record_key,
    target?.managementKey,
    target?.management_key,
  ].map(cleanBuildingText).filter(Boolean);

  for (const key of directKeys) {
    if (locationIndex.has(key)) return locationIndex.get(key);
  }

  for (const address of buildingStatsTargetAddressAliases(target)) {
    const normalized = normalizedBuildingAddress(address);
    if (normalized && locationIndex.has(normalized)) {
      return locationIndex.get(normalized);
    }
  }

  return null;
}

