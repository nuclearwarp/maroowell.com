<!doctype html>
<html lang="ko">
<head>
  <style>html{visibility:hidden}</style>
  <script src="/config.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="referrer" content="origin">
  <title>쿠팡 캠프 지도</title>
  <link rel="icon" href="/favicon.ico?v=2">

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://dapi.kakao.com/v2/maps/sdk.js?appkey=add4ce93b38c0ff9d9b9053728e067b3&autoload=false&libraries=clusterer,services"></script>

  <style>
    @font-face{
      font-family:"문경감홍사과체";
      src:url("/assets/fonts/MungyeongGamhong.woff2") format("woff2");
      font-display:swap;
    }

    :root{
      --line:#d8e0ee;
      --text:#0f172a;
      --muted:#64748b;
      --blue:#2563eb;
      --bg:#eef3f8;
      --font:"문경감홍사과체","Noto Sans KR",system-ui,sans-serif;
    }

    *{box-sizing:border-box}
    html,body{
      width:100%;
      height:100%;
      margin:0;
      font-family:var(--font);
      color:var(--text);
      background:var(--bg);
    }
    body{overflow:hidden}
    button,input,select{font:inherit}

    .app{
      height:100%;
      display:grid;
      grid-template-rows:56px 1fr;
    }

    .top{
      display:flex;
      align-items:center;
      gap:10px;
      padding:0 14px;
      background:#fff;
      border-bottom:1px solid var(--line);
      z-index:30;
    }

    .logo{
      width:32px;
      height:32px;
      display:flex;
      align-items:center;
      justify-content:center;
      flex:0 0 auto;
    }
    .logo img{width:30px;height:30px;object-fit:contain}

    .title{display:flex;flex-direction:column;min-width:0}
    .title b{font-size:18px;white-space:nowrap}
    .title small{
      margin-top:2px;
      color:var(--muted);
      font-size:11px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .spacer{flex:1}

    .btn{
      height:38px;
      padding:0 13px;
      border:1px solid #cbd5e1;
      border-radius:999px;
      background:#fff;
      color:var(--text);
      font-size:12px;
      font-weight:800;
      cursor:pointer;
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      white-space:nowrap;
    }
    .btn:hover{border-color:#93c5fd;background:#f8fbff}
    .btn.primary{background:var(--blue);border-color:var(--blue);color:#fff}
    .menuBtn{display:none;width:38px;padding:0;font-size:18px}

    .work{
      position:relative;
      min-height:0;
      display:grid;
      grid-template-columns:390px minmax(0,1fr);
      transition:grid-template-columns .2s ease;
    }

    .work.side-collapsed{
      grid-template-columns:0 minmax(0,1fr);
    }

    .side{
      min-width:0;
      min-height:0;
      background:#fff;
      border-right:1px solid var(--line);
      overflow:auto;
      z-index:20;
      transition:opacity .16s ease;
    }

    .work.side-collapsed .side{
      width:0;
      opacity:0;
      overflow:hidden;
      pointer-events:none;
      border-right:0;
    }

    .sideToggle{
      position:absolute;
      top:12px;
      left:12px;
      z-index:18;
      width:38px;
      min-width:38px;
      padding:0;
      font-size:18px;
      line-height:1;
      box-shadow:0 10px 28px rgba(15,23,42,.18);
    }
    .inner{padding:14px}

    .card{
      margin-bottom:12px;
      padding:13px;
      border:1px solid var(--line);
      border-radius:18px;
      background:#fff;
      box-shadow:0 7px 20px rgba(15,23,42,.05);
    }

    .head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:10px;
    }
    .head b{font-size:14px}
    .head span{font-size:11px;color:var(--muted)}

    .field{display:grid;gap:6px;margin-top:9px}
    .field label{font-size:11px;font-weight:800;color:#475569}
    .control{
      width:100%;
      height:40px;
      padding:0 11px;
      border:1px solid #cbd5e1;
      border-radius:12px;
      background:#f8fafc;
      outline:0;
    }
    .control:focus{
      border-color:#60a5fa;
      background:#fff;
      box-shadow:0 0 0 3px rgba(37,99,235,.1);
    }

    .cols{display:grid;grid-template-columns:1fr 1fr;gap:9px}
    .actions{display:flex;gap:8px;margin-top:11px}
    .actions > *{flex:1}

    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
    .stat{
      padding:10px 6px;
      border:1px solid var(--line);
      border-radius:14px;
      background:#f8fafc;
      text-align:center;
    }
    .stat strong{display:block;font-size:17px}
    .stat span{display:block;margin-top:4px;font-size:10px;color:var(--muted)}

    .chips{display:flex;flex-wrap:wrap;gap:7px}
    .chip{
      min-height:30px;
      padding:0 10px;
      border:1px solid var(--line);
      border-radius:999px;
      background:#fff;
      font-size:11px;
      font-weight:800;
      cursor:pointer;
    }
    .chip.active{border-color:#60a5fa;background:#eff6ff;color:#1d4ed8}
    .dot{
      display:inline-block;
      width:9px;
      height:9px;
      margin-right:6px;
      border-radius:50%;
      vertical-align:1px;
    }

    .list{display:grid;gap:7px;max-height:38vh;overflow:auto}
    .item{
      width:100%;
      padding:10px 11px;
      border:1px solid var(--line);
      border-radius:14px;
      background:#fff;
      text-align:left;
      cursor:pointer;
    }
    .item:hover,.item.active{border-color:#60a5fa;background:#f8fbff}
    .item strong{
      display:block;
      font-size:13px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .item span{
      display:block;
      margin-top:5px;
      color:var(--muted);
      font-size:11px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .empty{
      padding:20px 10px;
      border:1px dashed #cbd5e1;
      border-radius:14px;
      color:var(--muted);
      font-size:12px;
      text-align:center;
    }

    .detail{display:none}
    .detail.show{display:block}
    .detail h3{margin:0;font-size:16px}
    .detail p{margin:5px 0 0;color:var(--muted);font-size:11px}
    .rows{display:grid;gap:7px;margin-top:12px}
    .row{
      display:grid;
      grid-template-columns:64px 1fr;
      gap:8px;
      font-size:12px;
      line-height:1.45;
      word-break:break-word;
    }
    .row b{color:var(--muted)}

    .mapPane{position:relative;min-width:0;min-height:0}
    #map{position:absolute;inset:0}
    .tools{
      position:absolute;
      top:12px;
      right:12px;
      z-index:10;
      display:flex;
      gap:8px;
    }
    .tools .btn{box-shadow:0 10px 28px rgba(15,23,42,.15)}

    .toast{
      position:absolute;
      left:50%;
      bottom:18px;
      transform:translate(-50%,10px);
      z-index:40;
      max-width:calc(100vw - 30px);
      padding:10px 14px;
      border-radius:999px;
      background:rgba(15,23,42,.9);
      color:#fff;
      font-size:12px;
      font-weight:800;
      text-align:center;
      opacity:0;
      pointer-events:none;
      transition:.18s;
    }
    .toast.show{opacity:1;transform:translate(-50%,0)}
    .toast.err{background:rgba(185,28,28,.92)}

    .loading{
      position:absolute;
      inset:0;
      z-index:25;
      display:flex;
      align-items:center;
      justify-content:center;
      background:rgba(238,243,248,.82);
    }
    .loading.hide{display:none}
    .loading div{
      padding:16px 20px;
      border:1px solid var(--line);
      border-radius:18px;
      background:#fff;
      font-size:13px;
      font-weight:900;
      box-shadow:0 14px 38px rgba(15,23,42,.12);
    }

    .info{
      min-width:210px;
      max-width:280px;
      padding:11px 12px;
      border:1px solid rgba(15,23,42,.12);
      border-radius:14px;
      background:#fff;
      box-shadow:0 14px 34px rgba(15,23,42,.2);
      transform:translateY(-8px);
    }
    .info strong{display:block;font-size:13px}
    .info span{display:block;margin-top:4px;color:var(--muted);font-size:11px}

    .routeInfo{
      min-width:238px;
      max-width:310px;
      padding:12px 13px;
      border:1px solid rgba(15,23,42,.14);
      border-radius:14px;
      background:#fff;
      box-shadow:0 14px 34px rgba(15,23,42,.22);
      transform:translateY(-7px);
    }
    .routeInfo strong{display:block;font-size:13px;line-height:1.35}
    .routeInfo .routeArrow{margin:4px 0 8px;color:#64748b;font-size:11px;font-weight:800}
    .routeInfo .routeRow{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-top:6px}
    .routeInfo .routeKey{color:#64748b;font-size:11px;font-weight:800}
    .routeInfo .routeVal{color:#0f172a;font-size:12px;font-weight:950;text-align:right}
    .routeInfo .routeTime{margin-top:8px;padding-top:7px;border-top:1px solid #e2e8f0;color:#94a3b8;font-size:10px}
    .routeInfo.loadingRoute .routeVal{color:#2563eb}

    @media(max-width:900px){
      .app{grid-template-rows:54px 1fr}
      .top{padding:0 10px}
      .title b{font-size:16px}
      .title small,.listLink{display:none}
      .menuBtn{display:inline-flex}
      .work,
      .work.side-collapsed{
        display:block;
      }
      .side,
      .work.side-collapsed .side{
        position:absolute;
        left:0;
        top:0;
        bottom:0;
        width:min(88vw,390px);
        opacity:1;
        overflow:auto;
        pointer-events:auto;
        border-right:1px solid var(--line);
        transform:translateX(-105%);
        transition:transform .2s ease;
        box-shadow:0 14px 38px rgba(15,23,42,.18);
      }
      .work.open .side,
      .work.side-collapsed.open .side{
        transform:translateX(0);
      }
      .sideToggle{
        top:10px;
        left:10px;
      }
      .mapPane{position:absolute;inset:0}
      .list{max-height:34vh}
    }

    .denied{
      position:fixed;inset:0;z-index:30000;display:none;align-items:center;justify-content:center;
      padding:24px;background:rgba(15,23,42,.72);backdrop-filter:blur(8px)
    }
    .denied.show{display:flex}
    .deniedCard{width:min(460px,100%);padding:26px;border-radius:24px;background:#fff;border:1px solid #e2e8f0;text-align:center;box-shadow:0 28px 90px rgba(15,23,42,.35)}
    .deniedCard h2{margin:0 0 10px;font-size:22px}.deniedCard p{margin:0 0 18px;color:#64748b;line-height:1.6}.deniedCard .actions{display:flex;justify-content:center;gap:10px}
  </style>
</head>

<body>

  <div id="denied" class="denied" aria-hidden="true">
    <div class="deniedCard">
      <h2>지도 조회 권한이 없습니다</h2>
      <p>클렌징 히스토리를 조회할 수 있는 계정만 캠프 지도를 열 수 있습니다.</p>
      <div class="actions"><a class="btn primary" href="/coupang_camp">캠프 목록으로</a><a class="btn" href="/login.html?next=%2Fcoupang_camp_map">로그인</a></div>
    </div>
  </div>
  <div class="app">
    <header class="top">
      <a id="mwBoardMenuToggle" class="logo" href="/index.html" title="마루웰 메뉴">
        <img src="/favicon.ico" alt="Maroowell">
      </a>
      <div class="title">
        <b>쿠팡 캠프 지도</b>
        <small>등록 캠프 위치 · 구분/지역별 조회</small>
      </div>
      <div class="spacer"></div>
      <button id="menu" class="btn menuBtn" type="button" aria-label="필터 열기">☰</button>
      <a class="btn listLink" href="/coupang_camp">목록 보기</a>
      <button id="reload" class="btn primary" type="button">새로고침</button>
    </header>

    <main id="work" class="work">
      <aside class="side">
        <div class="inner">
          <section class="card">
            <div class="head"><b>캠프 필터</b><span>실시간 반영</span></div>
            <div class="field">
              <label for="q">검색</label>
              <input id="q" class="control" type="search" placeholder="캠프명, 주소, 코드, 설명">
            </div>
            <div class="cols">
              <div class="field">
                <label for="type">구분</label>
                <select id="type" class="control"><option value="">전체</option></select>
              </div>
              <div class="field">
                <label for="region">지역</label>
                <select id="region" class="control"><option value="">전체</option></select>
              </div>
            </div>
            <div class="actions">
              <button id="reset" class="btn" type="button">필터 초기화</button>
              <button id="fit" class="btn" type="button">전체 위치 보기</button>
            </div>
          </section>

          <section class="card">
            <div class="head"><b>조회 현황</b><span id="time">-</span></div>
            <div class="stats">
              <div class="stat"><strong id="visible">0</strong><span>표시 캠프</span></div>
              <div class="stat"><strong id="total">0</strong><span>전체 캠프</span></div>
              <div class="stat"><strong id="missing">0</strong><span>위치 확인 실패</span></div>
            </div>
          </section>

          <section class="card">
            <div class="head"><b>구분별 보기</b><span>클릭 필터</span></div>
            <div id="chips" class="chips"></div>
          </section>

          <section id="detail" class="card detail">
            <div class="head"><b>선택 캠프</b><span id="dType"></span></div>
            <h3 id="dTitle"></h3>
            <p id="dSub"></p>
            <div class="rows">
              <div class="row"><b>주소</b><span id="dAddress"></span></div>
              <div class="row"><b>지역</b><span id="dRegion"></span></div>
              <div class="row"><b>코드</b><span id="dCode"></span></div>
              <div class="row"><b>본캠프</b><span id="dParent"></span></div>
              <div class="row"><b>받는 SH</b><span id="dSh"></span></div>
              <div class="row"><b>설명</b><span id="dDesc"></span></div>
              <div class="row"><b>좌표</b><span id="dCoord"></span></div>
            </div>
            <div class="actions">
              <button id="copy" class="btn" type="button">주소 복사</button>
              <button id="openKakao" class="btn primary" type="button">카카오맵 열기</button>
            </div>
          </section>

          <section class="card">
            <div class="head"><b>캠프 목록</b><span id="count">0건</span></div>
            <div id="list" class="list"></div>
          </section>
        </div>
      </aside>

      <section class="mapPane">
        <div id="map"></div>
        <button
          id="sideToggle"
          class="btn sideToggle"
          type="button"
          aria-label="좌측 메뉴 접기"
          title="좌측 메뉴 접기"
        >◀</button>
        <div class="tools">
          <button id="mapType" class="btn" type="button">위성</button>
          <button id="roadview" class="btn" type="button">로드뷰</button>
          <button id="current" class="btn" type="button">내 위치</button>
        </div>
        <div id="toast" class="toast" role="status" aria-live="polite"></div>
        <div id="loading" class="loading"><div id="loadingText">캠프 지도를 불러오는 중...</div></div>
      </section>
    </main>
  </div>

  <script>
    (() => {
      "use strict";

      const CONFIG = window.MARUWELL_CONFIG || {};
      const API_BASE =
        CONFIG.BACKENDS?.coupangCamp ||
        CONFIG.COUPANG_CAMP_API ||
        "https://coupangcamp.brain-0f6.workers.dev";
      const SUPABASE_URL = CONFIG.SUPABASE_URL || "";
      const SUPABASE_ANON_KEY = CONFIG.SUPABASE_ANON_KEY || CONFIG.SUPABASE_PUBLISHABLE_KEY || "";

      const MARKER_COLORS = [
        "#2563eb", "#16a34a", "#f97316", "#7c3aed", "#db2777",
        "#0891b2", "#ca8a04", "#475569", "#dc2626", "#0f766e"
      ];

      const $ = selector => document.querySelector(selector);

      const dom = {
        work: $("#work"),
        menu: $("#menu"),
        sideToggle: $("#sideToggle"),
        reload: $("#reload"),
        query: $("#q"),
        type: $("#type"),
        region: $("#region"),
        reset: $("#reset"),
        fit: $("#fit"),
        chips: $("#chips"),
        list: $("#list"),
        count: $("#count"),
        visible: $("#visible"),
        total: $("#total"),
        missing: $("#missing"),
        time: $("#time"),
        detail: $("#detail"),
        detailType: $("#dType"),
        detailTitle: $("#dTitle"),
        detailSub: $("#dSub"),
        detailAddress: $("#dAddress"),
        detailRegion: $("#dRegion"),
        detailCode: $("#dCode"),
        detailParent: $("#dParent"),
        detailSh: $("#dSh"),
        detailDescription: $("#dDesc"),
        denied: $("#denied"),
        detailCoord: $("#dCoord"),
        copy: $("#copy"),
        openKakao: $("#openKakao"),
        mapType: $("#mapType"),
        roadview: $("#roadview"),
        current: $("#current"),
        toast: $("#toast"),
        loading: $("#loading"),
        loadingText: $("#loadingText")
      };

      const state = {
        map: null,
        clusterer: null,
        geocoder: null,
        geocodeCache: new Map(),
        rows: [],
        filteredRows: [],
        markers: [],
        markerEntries: [],
        markerImages: new Map(),
        labelOverlays: [],
        labelLeaderLines: [],
        labelLayoutTimer: null,
        selectedRelationMarkers: [],
        geocodeCacheSaveTimer: null,
        colors: new Map(),
        selected: null,
        overlay: null,
        routeOverlay: null,
        relationLines: [],
        routeCache: new Map(),
        accessToken: "",
        supabaseClient: null,
        ignoreMapClickUntil: 0,
        isRoadmap: true,
        isRoadviewOn: false,
        roadviewOverlay: null,
        selectedTypes: new Set()
      };

      const text = value => String(value ?? "").trim();
      const lower = value => text(value).toLowerCase();

      const GEOCODE_CACHE_STORAGE_KEY = "mw_coupang_camp_geocode_v2";
      const GEOCODE_CACHE_MAX_AGE = 1000 * 60 * 60 * 24 * 45;
      const GEOCODE_CONCURRENCY = 8;

      function loadPersistentGeocodeCache() {
        try {
          const raw = localStorage.getItem(GEOCODE_CACHE_STORAGE_KEY);
          if (!raw) return;

          const parsed = JSON.parse(raw);
          const now = Date.now();

          for (const [key, entry] of Object.entries(parsed || {})) {
            if (!entry || now - Number(entry.savedAt || 0) > GEOCODE_CACHE_MAX_AGE) {
              continue;
            }

            state.geocodeCache.set(key, entry.value ?? null);
          }
        } catch (error) {
          console.warn("지오코딩 캐시를 읽지 못했습니다.", error);
        }
      }

      function persistGeocodeCacheSoon() {
        if (state.geocodeCacheSaveTimer) {
          clearTimeout(state.geocodeCacheSaveTimer);
        }

        state.geocodeCacheSaveTimer = setTimeout(() => {
          state.geocodeCacheSaveTimer = null;

          try {
            const savedAt = Date.now();
            const payload = {};

            for (const [key, value] of state.geocodeCache.entries()) {
              payload[key] = { savedAt, value };
            }

            localStorage.setItem(
              GEOCODE_CACHE_STORAGE_KEY,
              JSON.stringify(payload)
            );
          } catch (error) {
            console.warn("지오코딩 캐시를 저장하지 못했습니다.", error);
          }
        }, 250);
      }

      function setGeocodeCache(key, value) {
        state.geocodeCache.set(key, value);
        persistGeocodeCacheSoon();
      }

      function rowId(row) {
        return row.id || [
          row.camp,
          row.mb_camp,
          row.code,
          row.latitude,
          row.longitude
        ].join("|");
      }

      function campName(row) {
        if (row.camp && row.mb_camp && row.camp !== row.mb_camp) {
          return `${row.camp} · ${row.mb_camp}`;
        }
        return row.camp || row.mb_camp || row.code || "이름 없는 캠프";
      }

      function getColor(type) {
        const key = type || "미분류";
        if (!state.colors.has(key)) {
          state.colors.set(key, MARKER_COLORS[state.colors.size % MARKER_COLORS.length]);
        }
        return state.colors.get(key);
      }

      function showToast(message, isError = false) {
        dom.toast.textContent = message;
        dom.toast.className = `toast show${isError ? " err" : ""}`;
        clearTimeout(showToast.timer);
        showToast.timer = setTimeout(() => {
          dom.toast.className = "toast";
        }, 2400);
      }

      function isMobileRocketCamp(row) {
        const type = text(row?.camp_type).toUpperCase();
        const mbCamp = text(row?.mb_camp);

        return (
          type === "로켓" &&
          mbCamp &&
          mbCamp !== "본캠프" &&
          mbCamp !== text(row?.camp)
        );
      }

      function markerLabelLines(row) {
        const type = text(row?.camp_type).toUpperCase();

        // 서브허브는 코드 한 줄로 표시한다.
        if (type === "SUB_HUB") {
          return [text(row?.code) || text(row?.camp) || "SH"];
        }

        // 로켓캠프 중 MB캠프가 본캠프가 아니면
        // 1행: 본 캠프명 / 2행: MB캠프명
        if (isMobileRocketCamp(row)) {
          return [
            text(row?.camp) || "캠프",
            text(row?.mb_camp) || "모바일캠프"
          ];
        }

        return [
          text(row?.camp) || text(row?.mb_camp) || text(row?.code) || "캠프"
        ];
      }

      function escapeSvgText(value) {
        return String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");
      }

      let markerMeasureContext = null;

      function markerTextWidth(label, fontSize, fontWeight = 900) {
        try {
          if (!markerMeasureContext) {
            const canvas = document.createElement("canvas");
            markerMeasureContext = canvas.getContext("2d");
          }

          if (markerMeasureContext) {
            markerMeasureContext.font = `${fontWeight} ${fontSize}px Arial, "Noto Sans KR", sans-serif`;
            return Math.ceil(markerMeasureContext.measureText(String(label || "")).width);
          }
        } catch {}

        const scale = fontSize / 9.5;
        return Array.from(String(label || "")).reduce((sum, ch) => {
          return sum + (/^[\x20-\x7E]$/.test(ch) ? 6.3 : 10.2) * scale;
        }, 0);
      }

      function markerLabelWidth(lines, fontSizes, isSubHub, isMobile) {
        const widest = Math.max(
          ...lines.map((line, index) => {
            const fontSize = fontSizes[index] || fontSizes[0] || 10.5;
            const fontWeight = index === 0 ? 900 : 800;
            return markerTextWidth(line, fontSize, fontWeight);
          })
        );

        // 실제 렌더링 폭에 브라우저/폰트 차이 안전 여백을 더해 끝 글자 잘림을 방지한다.
        const horizontalPadding = isSubHub ? 42 : isMobile ? 34 : 32;
        const minimum = isSubHub ? 72 : isMobile ? 64 : 56;
        const maximum = isSubHub ? 260 : isMobile ? 240 : 220;

        return Math.max(
          minimum,
          Math.min(maximum, Math.ceil(widest + horizontalPadding))
        );
      }

      const LABEL_MAX_LEVEL = 6;
      const LABEL_STACK_GAP = 0;
      const LABEL_COLLISION_PADDING = 6;

      function markerVisualMetrics(row) {
        const type = text(row?.camp_type) || "미분류";
        const isSubHub = type.toUpperCase() === "SUB_HUB";
        const isMobile = isMobileRocketCamp(row);
        const lines = markerLabelLines(row);

        const fontSizes = isSubHub
          ? [13.5]
          : isMobile
            ? [12.5, 11.5]
            : [12.5];

        const width = markerLabelWidth(lines, fontSizes, isSubHub, isMobile);
        const bubbleHeight = lines.length > 1 ? 40 : isSubHub ? 25 : 24;

        return {
          type,
          isSubHub,
          isMobile,
          lines,
          fontSizes,
          width,
          bubbleHeight,
          pointerHeight: 6
        };
      }

      function overlapMarkerKey(row) {
        const latitude = Number(row?.latitude);
        const longitude = Number(row?.longitude);

        if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
          return `invalid:${rowId(row)}`;
        }

        // 약 1m 안팎의 동일 위치는 하나의 붙임 그룹으로 묶는다.
        return `${latitude.toFixed(5)}|${longitude.toFixed(5)}`;
      }

      function overlapSortLabel(row) {
        return markerLabelLines(row).join(" ");
      }

      function compareOverlapRows(a, b) {
        const aIsSubHub = text(a?.camp_type).toUpperCase() === "SUB_HUB";
        const bIsSubHub = text(b?.camp_type).toUpperCase() === "SUB_HUB";

        // 같은 위치에서는 SUB_HUB를 맨 위에 둔다.
        if (aIsSubHub !== bIsSubHub) return aIsSubHub ? -1 : 1;

        // 나머지는 가나다순 정렬
        return overlapSortLabel(a).localeCompare(
          overlapSortLabel(b),
          "ko",
          { numeric: true, sensitivity: "base" }
        );
      }

      function markerDistanceMeters(a, b) {
        const aLat = Number(a?.latitude);
        const aLng = Number(a?.longitude);
        const bLat = Number(b?.latitude);
        const bLng = Number(b?.longitude);
        if (![aLat,aLng,bLat,bLng].every(Number.isFinite)) return Infinity;
        const rad = Math.PI / 180;
        const dLat = (bLat - aLat) * rad;
        const dLng = (bLng - aLng) * rad;
        const lat1 = aLat * rad;
        const lat2 = bLat * rad;
        const h = Math.sin(dLat / 2) ** 2 + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLng / 2) ** 2;
        return 6371000 * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
      }

      function rowsShareSubHubRelation(a, b) {
        const aType = text(a?.camp_type).toUpperCase();
        const bType = text(b?.camp_type).toUpperCase();
        const aId = text(a?.id);
        const bId = text(b?.id);
        const aSh = text(a?.effective_receiving_sh_id);
        const bSh = text(b?.effective_receiving_sh_id);
        return (
          (aType === "SUB_HUB" && aId && bSh === aId) ||
          (bType === "SUB_HUB" && bId && aSh === bId)
        );
      }

      function shouldMergeSelectedRelationRows(a, b) {
        if (overlapMarkerKey(a) === overlapMarkerKey(b)) return true;
        const distance = markerDistanceMeters(a, b);
        if (distance <= 4) return true;
        if (rowsShareSubHubRelation(a, b) && distance <= 18) return true;
        return false;
      }

      function buildMarkerGroups(rows, mergeNearbyRelated = false) {
        const groupedRows = [];

        if (!mergeNearbyRelated) {
          const grouped = new Map();
          for (const row of rows) {
            const key = overlapMarkerKey(row);
            if (!grouped.has(key)) grouped.set(key, []);
            grouped.get(key).push(row);
          }
          for (const [key, groupRows] of grouped.entries()) {
            groupedRows.push({ key, groupRows });
          }
        } else {
          for (const row of rows) {
            let group = groupedRows.find(candidate =>
              candidate.groupRows.some(existing => shouldMergeSelectedRelationRows(existing, row))
            );
            if (!group) {
              group = { key: `near:${rowId(row)}`, groupRows: [] };
              groupedRows.push(group);
            }
            group.groupRows.push(row);
          }
        }

        return groupedRows.map(({ key, groupRows }) => {
          groupRows.sort(compareOverlapRows);

          const items = groupRows.map(row => ({
            row,
            metrics: markerVisualMetrics(row)
          }));

          const width = Math.max(...items.map(item => item.metrics.width));
          const height =
            items.reduce((sum, item) => sum + item.metrics.bubbleHeight, 0) +
            Math.max(0, items.length - 1) * LABEL_STACK_GAP +
            items[items.length - 1].metrics.pointerHeight;

          const validRows = groupRows.filter(row =>
            Number.isFinite(Number(row?.latitude)) && Number.isFinite(Number(row?.longitude))
          );
          const latitude = validRows.length
            ? validRows.reduce((sum, row) => sum + Number(row.latitude), 0) / validRows.length
            : Number(groupRows[0]?.latitude);
          const longitude = validRows.length
            ? validRows.reduce((sum, row) => sum + Number(row.longitude), 0) / validRows.length
            : Number(groupRows[0]?.longitude);

          return {
            key,
            items,
            width,
            height,
            latitude,
            longitude,
            hasSubHub: groupRows.some(row => text(row?.camp_type).toUpperCase() === "SUB_HUB"),
            sortLabel: groupRows.map(overlapSortLabel).join(" ")
          };
        });
      }

      function rectanglesOverlap(a, b, padding = LABEL_COLLISION_PADDING) {
        return !(
          a.right + padding <= b.left ||
          a.left >= b.right + padding ||
          a.bottom + padding <= b.top ||
          a.top >= b.bottom + padding
        );
      }

      function rectangleOverlapArea(a, b) {
        const width = Math.max(
          0,
          Math.min(a.right, b.right) - Math.max(a.left, b.left)
        );
        const height = Math.max(
          0,
          Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top)
        );
        return width * height;
      }

      function groupRectangle(group, anchor, offset) {
        const left = anchor.x + offset.x - group.width / 2;
        const bottom = anchor.y + offset.y;

        return {
          left,
          top: bottom - group.height,
          right: left + group.width,
          bottom
        };
      }

      function markerLayoutCandidates(group) {
        const xStep = Math.max(54, Math.min(112, Math.round(group.width * 0.72)));
        const yStep = Math.max(30, Math.min(68, Math.round(group.height * 0.48)));
        const candidates = [{ x: 0, y: 0 }];

        for (let level = 1; level <= 5; level++) {
          const x = xStep * level;
          const y = yStep * level;

          candidates.push(
            { x: 0, y: -y },
            { x, y: 0 },
            { x: -x, y: 0 },
            { x: Math.round(x * 0.72), y: -Math.round(y * 0.65) },
            { x: -Math.round(x * 0.72), y: -Math.round(y * 0.65) },
            { x: Math.round(x * 0.72), y: Math.round(y * 0.62) },
            { x: -Math.round(x * 0.72), y: Math.round(y * 0.62) },
            { x: 0, y }
          );
        }

        return candidates;
      }

      function viewportPenalty(rect, width, height) {
        let penalty = 0;

        if (rect.left < 4) penalty += (4 - rect.left) * 300;
        if (rect.right > width - 4) penalty += (rect.right - width + 4) * 300;
        if (rect.top < 4) penalty += (4 - rect.top) * 300;
        if (rect.bottom > height - 4) penalty += (rect.bottom - height + 4) * 300;

        return penalty;
      }

      function buildCollisionAwareGroupLayout(groups) {
        const projection = state.map.getProjection();
        const mapElement = document.getElementById("map");
        const viewportWidth = mapElement?.clientWidth || window.innerWidth;
        const viewportHeight = mapElement?.clientHeight || window.innerHeight;
        const placed = [];
        const layouts = new Map();

        const prepared = groups
          .map(group => {
            const position = new kakao.maps.LatLng(
              group.latitude,
              group.longitude
            );
            const anchor = projection.containerPointFromCoords(position);

            return { group, position, anchor };
          })
          .sort((a, b) => {
            // SUB_HUB가 포함된 그룹은 원래 위치를 우선 확보한다.
            if (a.group.hasSubHub !== b.group.hasSubHub) {
              return a.group.hasSubHub ? -1 : 1;
            }

            return (
              a.anchor.y - b.anchor.y ||
              a.anchor.x - b.anchor.x ||
              a.group.sortLabel.localeCompare(
                b.group.sortLabel,
                "ko",
                { numeric: true, sensitivity: "base" }
              )
            );
          });

        for (const preparedGroup of prepared) {
          const { group, anchor } = preparedGroup;
          const candidates = markerLayoutCandidates(group);

          let best = null;

          for (const offset of candidates) {
            const rect = groupRectangle(group, anchor, offset);
            const collisions = placed.filter(item =>
              rectanglesOverlap(rect, item.rect)
            );

            const overlapArea = collisions.reduce(
              (sum, item) => sum + rectangleOverlapArea(rect, item.rect),
              0
            );

            const score =
              overlapArea * 10000 +
              collisions.length * 1000000 +
              viewportPenalty(
                rect,
                viewportWidth,
                viewportHeight
              ) +
              Math.hypot(offset.x, offset.y);

            if (!best || score < best.score) {
              best = { offset, rect, score, collisions: collisions.length };
            }

            // 화면 안쪽이고 다른 마커와 겹치지 않는 가장 가까운 후보를 즉시 사용
            if (
              collisions.length === 0 &&
              viewportPenalty(rect, viewportWidth, viewportHeight) === 0
            ) {
              best = { offset, rect, score, collisions: 0 };
              break;
            }
          }

          layouts.set(group.key, {
            x: best?.offset?.x || 0,
            y: best?.offset?.y || 0,
            anchor,
            rect: best?.rect || groupRectangle(group, anchor, { x: 0, y: 0 })
          });

          placed.push({
            key: group.key,
            rect: layouts.get(group.key).rect
          });
        }

        return layouts;
      }

      function makeClusterDotImage(row) {
        const type = text(row?.camp_type) || "미분류";
        const isMobile = isMobileRocketCamp(row);
        const key = `dot-one:${type}:${isMobile ? "mobile" : "base"}`;

        if (state.markerImages.has(key)) {
          return state.markerImages.get(key);
        }

        const color = isMobile ? "#7dd3fc" : getColor(type);
        const textColor = isMobile ? "#0c4a6e" : "#ffffff";
        const size = 24;
        const center = size / 2;

        const svg = [
          `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">`,
          '<defs>',
          '<filter id="shadow" x="-30%" y="-30%" width="160%" height="160%">',
          '<feDropShadow dx="0" dy="1.2" stdDeviation="1.4" flood-color="#0f172a" flood-opacity=".28"/>',
          '</filter>',
          '</defs>',
          '<g filter="url(#shadow)">',
          `<circle cx="${center}" cy="${center}" r="10.5" fill="${color}" stroke="#ffffff" stroke-width="2"/>`,
          '</g>',
          `<text x="${center}" y="${center + 0.5}" text-anchor="middle" dominant-baseline="middle"`,
          ` font-family="Arial, Noto Sans KR, sans-serif" font-size="11.5" font-weight="900"`,
          ` fill="${textColor}">1</text>`,
          '</svg>'
        ].join("");

        const image = new kakao.maps.MarkerImage(
          "data:image/svg+xml;charset=UTF-8," + encodeURIComponent(svg),
          new kakao.maps.Size(size, size),
          { offset: new kakao.maps.Point(center, center) }
        );

        state.markerImages.set(key, image);
        return image;
      }

      function selectedSubHubId() {
        if (text(state.selected?.camp_type).toUpperCase() !== "SUB_HUB") {
          return "";
        }

        return text(state.selected?.id);
      }

      function selectedSubHubRelatedRows() {
        const shId = selectedSubHubId();
        if (!shId) return [];

        return state.rows
          .filter(row => {
            if (!row.hasValidCoordinates) return false;

            return (
              text(row.id) === shId ||
              text(row.effective_receiving_sh_id) === shId
            );
          })
          .sort((a, b) => {
            const aIsSh = text(a.camp_type).toUpperCase() === "SUB_HUB";
            const bIsSh = text(b.camp_type).toUpperCase() === "SUB_HUB";

            if (aIsSh !== bIsSh) return aIsSh ? -1 : 1;

            return campName(a).localeCompare(
              campName(b),
              "ko",
              { numeric: true, sensitivity: "base" }
            );
          });
      }

      function uniqueRows(rows) {
        const seen = new Set();

        return rows.filter(row => {
          const key = rowId(row);
          if (seen.has(key)) return false;
          seen.add(key);
          return true;
        });
      }

      function labelRowsForCurrentView() {
        // SUB_HUB 선택 중에는 선택한 SH와 연결 캠프를
        // renderSelectedSubHubMarkers()가 확대 단계와 무관하게 전담한다.
        // 일반 라벨까지 동시에 그리면 같은 SH/캠프가 이중으로 표시되어 겹친다.
        if (selectedSubHubId()) {
          return [];
        }

        if (state.map.getLevel() <= LABEL_MAX_LEVEL) {
          return state.filteredRows;
        }

        return [];
      }

      function relationRowsForCurrentView() {
        return uniqueRows([
          ...state.filteredRows,
          ...selectedSubHubRelatedRows()
        ]);
      }


      function forcedLabelRowIds() {
        return new Set(
          selectedSubHubRelatedRows().map(row => rowId(row))
        );
      }

      function syncBaseMarkersForCurrentView() {
        if (!state.clusterer) return;

        state.clusterer.clear();

        for (const entry of state.markerEntries) {
          entry.marker.setMap(null);
        }

        const closeZoomShowsAllLabels =
          state.map && state.map.getLevel() <= LABEL_MAX_LEVEL;

        const forcedIds = forcedLabelRowIds();

        const visibleMarkers = state.markerEntries
          .filter(entry => {
            // 가까이 확대된 상태에서는 모든 캠프가 텍스트 라벨로 표시되므로
            // 뒤에 있는 숫자 1 마커를 전부 숨긴다.
            if (closeZoomShowsAllLabels) return false;

            // SUB_HUB 선택 중에는 선택한 SH와 연결 캠프가
            // 강제 텍스트 라벨로 표시되므로 해당 숫자 마커만 숨긴다.
            if (forcedIds.has(rowId(entry.row))) return false;

            return true;
          })
          .map(entry => entry.marker);

        if (visibleMarkers.length) {
          state.clusterer.addMarkers(visibleMarkers);
        }
      }


      function clearSelectedRelationMarkers() {
        for (const marker of state.selectedRelationMarkers) {
          marker.setMap(null);
        }

        state.selectedRelationMarkers = [];
      }

      function makeForcedRelationLabelImage(row, offsetX = 0, offsetY = 0) {
        const metrics = markerVisualMetrics(row);
        const key = [
          "forced-relation",
          metrics.type,
          metrics.isMobile ? "mobile" : "base",
          ...metrics.lines,
          ...metrics.fontSizes,
          Math.round(offsetX),
          Math.round(offsetY)
        ].join("|");

        if (state.markerImages.has(key)) {
          return state.markerImages.get(key);
        }

        const labelWidth = metrics.width;
        const labelHeight = metrics.bubbleHeight + metrics.pointerHeight;
        const padding = 5;

        const minX = Math.min(0, offsetX - labelWidth / 2);
        const maxX = Math.max(0, offsetX + labelWidth / 2);
        const minY = Math.min(0, offsetY - labelHeight);
        const maxY = Math.max(0, offsetY);

        const imageWidth = Math.ceil(maxX - minX + padding * 2);
        const imageHeight = Math.ceil(maxY - minY + padding * 2);
        const anchorX = -minX + padding;
        const anchorY = -minY + padding;
        const labelLeft = anchorX + offsetX - labelWidth / 2;
        const labelTop = anchorY + offsetY - labelHeight;
        const bubbleColor = markerLabelBackground(metrics);
        const textColor = markerLabelColor(metrics);
        const borderColor = metrics.isMobile ? "#e0f2fe" : "#ffffff";
        const centerX = labelLeft + labelWidth / 2;
        const bubbleBottom = labelTop + metrics.bubbleHeight;

        const textSvg = metrics.lines.length > 1
          ? [
              `<text x="${centerX}" y="${labelTop + 12.5}" text-anchor="middle" dominant-baseline="middle"`,
              ` font-family="Arial, Noto Sans KR, sans-serif" font-size="${metrics.fontSizes[0]}" font-weight="900" fill="${textColor}">`,
              `${escapeSvgText(metrics.lines[0])}</text>`,
              `<text x="${centerX}" y="${labelTop + 29.2}" text-anchor="middle" dominant-baseline="middle"`,
              ` font-family="Arial, Noto Sans KR, sans-serif" font-size="${metrics.fontSizes[1]}" font-weight="800" fill="${textColor}">`,
              `${escapeSvgText(metrics.lines[1])}</text>`
            ].join("")
          : [
              `<text x="${centerX}" y="${labelTop + 1 + metrics.bubbleHeight / 2}" text-anchor="middle" dominant-baseline="middle"`,
              ` font-family="Arial, Noto Sans KR, sans-serif" font-size="${metrics.fontSizes[0]}" font-weight="900" fill="${textColor}">`,
              `${escapeSvgText(metrics.lines[0])}</text>`
            ].join("");

        const connectorSvg =
          Math.abs(offsetX) > 2 || Math.abs(offsetY) > 2
            ? `<line x1="${anchorX}" y1="${anchorY}" x2="${centerX}" y2="${labelTop + labelHeight}" stroke="${bubbleColor}" stroke-width="1.8" stroke-opacity=".72"/>`
            : "";

        const svg = [
          `<svg xmlns="http://www.w3.org/2000/svg" width="${imageWidth}" height="${imageHeight}" viewBox="0 0 ${imageWidth} ${imageHeight}" overflow="visible">`,
          '<defs>',
          '<filter id="shadow" x="-30%" y="-30%" width="160%" height="180%">',
          '<feDropShadow dx="0" dy="1" stdDeviation="1.2" flood-color="#0f172a" flood-opacity=".28"/>',
          '</filter>',
          '</defs>',
          connectorSvg,
          '<g filter="url(#shadow)">',
          `<rect x="${labelLeft}" y="${labelTop}" width="${labelWidth}" height="${metrics.bubbleHeight}" rx="7" fill="${bubbleColor}" stroke="${borderColor}" stroke-width="1.2"/>`,
          `<path d="M${centerX - 4} ${bubbleBottom} L${centerX} ${labelTop + labelHeight} L${centerX + 4} ${bubbleBottom} Z" fill="${bubbleColor}" stroke="${borderColor}" stroke-width="1"/>`,
          '</g>',
          textSvg,
          '</svg>'
        ].join("");

        const image = new kakao.maps.MarkerImage(
          "data:image/svg+xml;charset=UTF-8," + encodeURIComponent(svg),
          new kakao.maps.Size(imageWidth, imageHeight),
          { offset: new kakao.maps.Point(anchorX, anchorY) }
        );

        state.markerImages.set(key, image);
        return image;
      }

      function renderSelectedSubHubMarkers() {
        clearSelectedRelationMarkers();

        if (!state.map || !selectedSubHubId()) return;

        const relatedRows = selectedSubHubRelatedRows();
        if (!relatedRows.length) return;

        const groups = buildMarkerGroups(relatedRows, true);
        const layouts = buildCollisionAwareGroupLayout(groups);

        for (const group of groups) {
          const layout = layouts.get(group.key) || { x: 0, y: 0 };
          let heightBelow = 0;

          for (let index = group.items.length - 1; index >= 0; index--) {
            const item = group.items[index];
            const showPointer = index === group.items.length - 1;

            const marker = new kakao.maps.Marker({
              map: state.map,
              position: new kakao.maps.LatLng(
                group.latitude,
                group.longitude
              ),
              image: makeForcedRelationLabelImage(
                item.row,
                layout.x,
                layout.y - heightBelow
              ),
              title: campName(item.row),
              zIndex: item.metrics.isSubHub ? 30000 - index : 29000 - index
            });

            kakao.maps.event.addListener(marker, "click", () => {
              state.ignoreMapClickUntil = Date.now() + 250;
              selectCamp(item.row, true);
            });

            state.selectedRelationMarkers.push(marker);

            heightBelow +=
              item.metrics.bubbleHeight +
              (showPointer ? item.metrics.pointerHeight : 0);
          }
        }
      }


      function clearLabelOverlays() {
        if (state.labelLayoutTimer) {
          clearTimeout(state.labelLayoutTimer);
          state.labelLayoutTimer = null;
        }

        for (const overlay of state.labelOverlays) {
          overlay.setMap(null);
        }

        for (const line of state.labelLeaderLines) {
          line.setMap(null);
        }

        state.labelOverlays = [];
        state.labelLeaderLines = [];
      }

      function markerLabelColor(metrics) {
        return metrics.isMobile ? "#0c4a6e" : "#ffffff";
      }

      function markerLabelBackground(metrics) {
        return metrics.isMobile ? "#7dd3fc" : getColor(metrics.type);
      }

