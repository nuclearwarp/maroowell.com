function timeoutError(label, ms) {
  const err = new Error(`${label} timeout after ${ms}ms`);
  err.name = "AbortError";
  return err;
}

async function fetchWithTimeout(url, init = {}, timeoutMs = 3000) {
  const controller = new AbortController();
  const timer = setTimeout(() => {
    controller.abort(timeoutError("upstream fetch", timeoutMs));
  }, timeoutMs);

  try {
    return await fetch(url, {
      ...init,
      signal: controller.signal,
    });
  } finally {
    clearTimeout(timer);
  }
}

function corsHeaders() {
  return {
    "Content-Type": "application/json; charset=utf-8",
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, Authorization",
  };
}

function jsonResp(obj, status = 200) {
  return new Response(JSON.stringify(obj), {
    status,
    headers: corsHeaders(),
  });
}

function cloneJson(value) {
  return JSON.parse(JSON.stringify(value));
}

function makeBasePageable() {
  return {
    first: 0,
    totalRecords: 0,
    currentRecords: 0,
    totalPages: 0,
    page: 0,
    size: 10,
    linkSize: 5,
    orders: [{ property: "", direction: "" }],
  };
}

function buildBootstrapHeaders() {
  return {
    "Accept":
      "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
    "Accept-Language": "ko-KR,ko;q=0.9,en-US;q=0.8,en;q=0.7",
    "User-Agent": USER_AGENT,
    "Referer": JUSO_ORIGIN,
    "sec-ch-ua": SEC_CH_UA,
    "sec-ch-ua-mobile": SEC_CH_UA_MOBILE,
    "sec-ch-ua-platform": SEC_CH_UA_PLATFORM,
    "Upgrade-Insecure-Requests": "1",
    "Cache-Control": "no-cache",
    "Pragma": "no-cache",
  };
}

function buildBrowserLikeHeaders(cookieHeader = "") {
  const headers = {
    "Accept": "application/json, text/plain, */*",
    "Accept-Language": "ko-KR,ko;q=0.9,en-US;q=0.8,en;q=0.7",
    "Content-Type": "application/json",
    "Origin": JUSO_ORIGIN,
    "Referer": JUSO_MAP_URL,
    "User-Agent": USER_AGENT,
    "Sec-Fetch-Dest": "empty",
    "Sec-Fetch-Mode": "cors",
    "Sec-Fetch-Site": "same-origin",
    "sec-ch-ua": SEC_CH_UA,
    "sec-ch-ua-mobile": SEC_CH_UA_MOBILE,
    "sec-ch-ua-platform": SEC_CH_UA_PLATFORM,
    "Pragma": "no-cache",
    "Cache-Control": "no-cache",
  };

  if (cookieHeader) {
    headers["Cookie"] = cookieHeader;
  }

  return headers;
}

function snippet(text, maxLen = ERROR_BODY_SNIPPET) {
  const s = String(text || "").replace(/\s+/g, " ").trim();
  return s.length > maxLen ? `${s.slice(0, maxLen)}...` : s;
}

function collectSetCookieHeaders(headers) {
  try {
    if (typeof headers.getSetCookie === "function") {
      const rows = headers.getSetCookie();
      if (Array.isArray(rows) && rows.length) return rows;
    }
  } catch {}

  const raw = headers.get("set-cookie");
  return raw ? [raw] : [];
}

function extractCookieHeaderFromSetCookie(setCookieHeaders) {
  const wanted = ["WMONID", "JSESSIONID"];
  const found = new Map();

  for (const raw of setCookieHeaders || []) {
    const text = String(raw || "");
    for (const name of wanted) {
      const re = new RegExp(`${name}=([^;,\\s]+)`, "i");
      const m = text.match(re);
      if (m?.[1]) {
        found.set(name, `${name}=${m[1]}`);
      }
    }
  }

  return [...found.values()].join("; ");
}

async function bootstrapJusoSession() {
  try {
    const res = await fetchWithTimeout(
      JUSO_MAP_URL,
      {
        method: "GET",
        headers: buildBootstrapHeaders(),
        redirect: "follow",
        cf: {
          cacheTtl: 0,
          cacheEverything: false,
        },
      },
      BOOTSTRAP_TIMEOUT_MS
    );

    const setCookieHeaders = collectSetCookieHeaders(res.headers);
    const cookieHeader = extractCookieHeaderFromSetCookie(setCookieHeaders);

    return {
      ok: res.ok,
      status: res.status,
      cookieHeader,
    };
  } catch (e) {
    return {
      ok: false,
      status: 0,
      cookieHeader: "",
      detail: String(e),
    };
  }
}

/**
 * 원본 브라우저 요청에 가깝게, params_sido_data는 전체 목록을 넣고
 * 선택값만 비워둔 variant를 1순위로 둔다.
 * 2순위는 null/blank 스타일 fallback.
 */
function buildPayloadVariants(zipcode) {
  const districtNo = String(zipcode || "").trim();

  return [
    {
      name: "browser_like_full_sido_data",
      body: {
        params_sido_val: "",
        params_sido_data: cloneJson(JUSO_SIDO_DATA),
        params_sgg_val: null,
        params_sgg_data: cloneJson(JUSO_EMPTY_SGG_DATA),
        search_result: [],
        result_count: 0,
        result_offset: 0,
        ctpvCd: "",
        lgvReplcCd: "",
        districtNo,
        pageable: makeBasePageable(),
      },
    },
    {
      name: "fallback_null_style",
      body: {
        params_sido_val: null,
        params_sido_data: cloneJson(JUSO_SIDO_DATA),
        params_sgg_val: null,
        params_sgg_data: cloneJson(JUSO_EMPTY_SGG_DATA),
        search_result: [],
        result_count: 0,
        result_offset: 0,
        ctpvCd: "",
        lgvReplcCd: "",
        districtNo,
        pageable: makeBasePageable(),
      },
    },
  ];
}

async function postSelectKarbSbdList(payloadVariant, cookieHeader) {
  const res = await fetchWithTimeout(
    JUSO_API_URL,
    {
      method: "POST",
      headers: buildBrowserLikeHeaders(cookieHeader),
      body: JSON.stringify(payloadVariant.body),
      cf: {
        cacheTtl: 0,
        cacheEverything: false,
      },
    },
    API_TIMEOUT_MS
  );

  const text = await res.text();

  let data = null;
  try {
    data = text ? JSON.parse(text) : null;
  } catch {}

  return {
    ok: res.ok,
    status: res.status,
    text,
    data,
    variant: payloadVariant.name,
  };
}

function normalizeGeometry(rawGeom) {
  let geojson = rawGeom;

  if (!geojson) return { ok: false, error: "geom 필드가 없음" };

  try {
    geojson = typeof geojson === "string" ? JSON.parse(geojson) : geojson;
  } catch (e) {
    return {
      ok: false,
      error: "GeoJSON 파싱 실패",
      detail: String(e),
      geom: rawGeom,
    };
  }

  if (geojson?.type === "Feature" && geojson.geometry) {
    geojson = geojson.geometry;
  }

  if (geojson?.type === "Polygon" && Array.isArray(geojson.coordinates)) {
    geojson = {
      type: "MultiPolygon",
      coordinates: [geojson.coordinates],
    };
  }

  if (geojson?.type !== "MultiPolygon" || !Array.isArray(geojson.coordinates)) {
    return {
      ok: false,
      error: "예상치 못한 geometry 타입",
      type: geojson?.type ?? null,
    };
  }

  return {
    ok: true,
    geojson,
  };
}

function computeCenter5179(polygon5179) {
  try {
    if (
      !Array.isArray(polygon5179) ||
      !polygon5179.length ||
      !Array.isArray(polygon5179[0]) ||
      !polygon5179[0].length ||
      !Array.isArray(polygon5179[0][0]) ||
      !polygon5179[0][0].length
    ) {
      return null;
    }

    const firstRing = polygon5179[0][0];
    let sumX = 0;
    let sumY = 0;
    let count = 0;

    for (const pt of firstRing) {
      if (!Array.isArray(pt) || pt.length < 2) continue;
      const x = Number(pt[0]);
      const y = Number(pt[1]);
      if (!Number.isFinite(x) || !Number.isFinite(y)) continue;
      sumX += x;
      sumY += y;
      count += 1;
    }

    if (!count) return null;
    return [sumX / count, sumY / count];
  } catch {
    return null;
  }
}

async function fetchFromJuso(zipcode, debug = false) {
  const payloadVariants = buildPayloadVariants(zipcode);

  const session = await bootstrapJusoSession();
  const cookieHeader = session.cookieHeader || "";

  let lastFailure = {
    ok: false,
    status: session.status || 0,
    attemptCount: 0,
    variant: null,
    detail: session.ok ? "" : (session.detail || `bootstrap failed (${session.status || 0})`),
    responseSnippet: "",
    sessionStatus: session.status || 0,
    hasCookie: !!cookieHeader,
  };

  for (let i = 0; i < payloadVariants.length; i++) {
    const payloadVariant = payloadVariants[i];
    const attemptCount = i + 1;

    try {
      const result = await postSelectKarbSbdList(payloadVariant, cookieHeader);

      if (debug) {
        console.log(
          JSON.stringify({
            tag: "ZIP_API_ATTEMPT",
            zipcode,
            attempt: attemptCount,
            variant: payloadVariant.name,
            sessionStatus: session.status,
            hasCookie: !!cookieHeader,
            payloadPreview: {
              params_sido_val: payloadVariant.body.params_sido_val,
              params_sgg_val: payloadVariant.body.params_sgg_val,
              ctpvCd: payloadVariant.body.ctpvCd,
              districtNo: payloadVariant.body.districtNo,
              sidoCount: Array.isArray(payloadVariant.body.params_sido_data)
                ? payloadVariant.body.params_sido_data.length
                : 0,
              sggCount: Array.isArray(payloadVariant.body.params_sgg_data)
                ? payloadVariant.body.params_sgg_data.length
                : 0,
            },
            httpStatus: result.status,
            ok: result.ok,
            contentLength: Array.isArray(result.data?.results?.content)
              ? result.data.results.content.length
              : null,
          })
        );
      }

      if (result.ok && result.data?.results && Array.isArray(result.data.results.content)) {
        if (result.data.results.content.length > 0) {
          return {
            ok: true,
            status: result.status,
            data: result.data,
            attemptCount,
            variant: payloadVariant.name,
            sessionStatus: session.status || 0,
            hasCookie: !!cookieHeader,
          };
        }

        lastFailure = {
          ok: false,
          status: result.status || 0,
          attemptCount,
          variant: payloadVariant.name,
          detail: "results.content empty",
          responseSnippet: snippet(result.text),
          sessionStatus: session.status || 0,
          hasCookie: !!cookieHeader,
        };
        continue;
      }

      lastFailure = {
        ok: false,
        status: result.status || 0,
        attemptCount,
        variant: payloadVariant.name,
        detail:
          result.data?.message ||
          result.data?.error ||
          `HTTP ${result.status || 0}`,
        responseSnippet: snippet(result.text),
        sessionStatus: session.status || 0,
        hasCookie: !!cookieHeader,
      };
    } catch (e) {
      lastFailure = {
        ok: false,
        status: 0,
        attemptCount,
        variant: payloadVariant.name,
        detail: e?.name === "AbortError"
          ? `timeout after ${API_TIMEOUT_MS}ms`
          : String(e),
        responseSnippet: "",
        sessionStatus: session.status || 0,
        hasCookie: !!cookieHeader,
      };
    }
  }

  return lastFailure;
}



// ---------- zipcode map share helpers ----------
const ZIP_SHARE_WORKER_VERSION = "2026-07-23-terrain-scope-area-v8";
const ZIP_SHARE_DEFAULT_TTL_HOURS = 72;
const ZIP_SHARE_MAX_TTL_HOURS = 72;
const ZIP_SHARE_MAX_ZIPS = 500;
const ZIP_SHARE_TOKEN_BYTES = 9;
const ZIP_SHARE_KV_PREFIX = "zipcode_share:";

function httpError(status, message) {
  const err = new Error(message);
  err.status = status;
  return err;
}

function requireEnv(env, key) {
  const value = env?.[key];
  if (!value) throw httpError(500, `Missing Worker env: ${key}`);
  return String(value);
}

function cleanText(v) {
  return String(v ?? "").trim();
}

async function readJsonBody(request) {
  try {
    return await request.json();
  } catch {
    throw httpError(400, "Invalid JSON body");
  }
}

function getBearerToken(request) {
  const auth = request.headers.get("Authorization") || "";
  const m = auth.match(/^Bearer\s+(.+)$/i);
  if (!m?.[1]) throw httpError(401, "Authorization Bearer token is required");
  return m[1].trim();
}

function normalizeZipShareZip(v) {
  const m = cleanText(v).match(/\d{5}/);
  return m ? m[0] : "";
}

function uniqueShareZips(input) {
  const source = Array.isArray(input)
    ? input
    : (cleanText(input).match(/\d{5}/g) || []);

  const out = [];
  const seen = new Set();

  for (const value of source) {
    const zip = normalizeZipShareZip(value);
    if (!zip || seen.has(zip)) continue;
    seen.add(zip);
    out.push(zip);
    if (out.length >= ZIP_SHARE_MAX_ZIPS) break;
  }

  return out;
}

function publicShareOrigin(env) {
  return String(env?.PUBLIC_SHARE_ORIGIN || "https://maroowell.com").replace(/\/+$/, "");
}

function getZipShareKv(env) {
  const kv = env?.ZIP_SHARE_KV;
  if (!kv || typeof kv.get !== "function" || typeof kv.put !== "function") {
    throw httpError(500, "Missing KV binding: ZIP_SHARE_KV");
  }
  return kv;
}

function randomZipShareId() {
  const bytes = new Uint8Array(ZIP_SHARE_TOKEN_BYTES);
  crypto.getRandomValues(bytes);
  return base64UrlEncodeBytes(bytes);
}

async function createUniqueZipShareId(env) {
  const kv = getZipShareKv(env);

  for (let i = 0; i < 8; i++) {
    const id = randomZipShareId();
    const exists = await kv.get(ZIP_SHARE_KV_PREFIX + id);

    if (!exists) return id;
  }

  throw httpError(500, "Failed to create unique share id");
}

async function verifySupabaseUserByJwt(request, env) {
  const token = getBearerToken(request);
  const supabaseUrl = requireEnv(env, "SUPABASE_URL").replace(/\/+$/, "");
  const serviceKey = requireEnv(env, "SUPABASE_SERVICE_ROLE_KEY");

  const res = await fetch(`${supabaseUrl}/auth/v1/user`, {
    method: "GET",
    headers: {
      apikey: serviceKey,
      Authorization: `Bearer ${token}`,
    },
  });

  const text = await res.text();
  let user = null;
  try { user = text ? JSON.parse(text) : null; } catch {}

  if (!res.ok || !user?.id) {
    throw httpError(401, "Invalid or expired login session");
  }

  return { token, user };
}

async function fetchMyAccessForShare(env, token) {
  const supabaseUrl = requireEnv(env, "SUPABASE_URL").replace(/\/+$/, "");
  const serviceKey = requireEnv(env, "SUPABASE_SERVICE_ROLE_KEY");

  const commonHeaders = {
    apikey: serviceKey,
    Authorization: `Bearer ${token}`,
    "Content-Type": "application/json",
  };

  let res = await fetch(`${supabaseUrl}/rest/v1/rpc/mw_my_access`, {
    method: "POST",
    headers: {
      ...commonHeaders,
      Accept: "application/vnd.pgrst.object+json",
    },
    body: "{}",
  });

  let text = await res.text();

  if (!res.ok && res.status === 406) {
    res = await fetch(`${supabaseUrl}/rest/v1/rpc/mw_my_access`, {
      method: "POST",
      headers: commonHeaders,
      body: "{}",
    });
    text = await res.text();
  }

  if (!res.ok) throw httpError(403, text || "Failed to check access");

  try {
    const data = text ? JSON.parse(text) : null;
    return Array.isArray(data) ? (data[0] || null) : data;
  } catch {
    return null;
  }
}

function isZipShareSuperAdmin(access) {
  return Boolean(
    access &&
    access.is_maroowell === true &&
    access.is_admin === true &&
    Number(access.max_role_level || access.role_level || 0) >= 90
  );
}

async function requireZipShareSuperAdmin(request, env) {
  const auth = await verifySupabaseUserByJwt(request, env);
  const access = await fetchMyAccessForShare(env, auth.token);

  if (!isZipShareSuperAdmin(access)) {
    throw httpError(403, "Super admin permission is required");
  }

  return { ...auth, access };
}

function base64UrlEncodeBytes(bytes) {
  let binary = "";
  for (const b of bytes) binary += String.fromCharCode(b);

  return btoa(binary)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/g, "");
}

function base64UrlEncodeText(text) {
  return base64UrlEncodeBytes(new TextEncoder().encode(text));
}

function base64UrlDecodeText(value) {
  const raw = String(value || "").replace(/-/g, "+").replace(/_/g, "/");
  const padded = raw + "=".repeat((4 - raw.length % 4) % 4);
  const binary = atob(padded);
  const bytes = new Uint8Array([...binary].map(ch => ch.charCodeAt(0)));
  return new TextDecoder().decode(bytes);
}

async function zipShareHmacHex(env, payloadB64) {
  const secret = requireEnv(env, "ZIP_SHARE_SECRET");
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"]
  );

  const sig = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(payloadB64));
  return [...new Uint8Array(sig)].map(b => b.toString(16).padStart(2, "0")).join("");
}

function constantTimeEqual(a, b) {
  const aa = String(a || "");
  const bb = String(b || "");
  if (aa.length !== bb.length) return false;

  let diff = 0;
  for (let i = 0; i < aa.length; i++) diff |= aa.charCodeAt(i) ^ bb.charCodeAt(i);
  return diff === 0;
}

function safeShareTitle(value, fallback) {
  const text = cleanText(value).replace(/\s+/g, " ");
  return (text || fallback || "우편번호 지도 공유").slice(0, 120);
}

async function handleZipShareCreate(request, env) {
  const auth = await requireZipShareSuperAdmin(request, env);
  const body = await readJsonBody(request);

  const zips = uniqueShareZips(body.zips || body.zipcodes || body.zipcode || body.text);
  if (!zips.length) throw httpError(400, "At least one zipcode is required");

  const ttlRaw = Number(body.ttl_hours || ZIP_SHARE_DEFAULT_TTL_HOURS);
  const ttlHours = Math.min(
    ZIP_SHARE_MAX_TTL_HOURS,
    Math.max(1, Number.isFinite(ttlRaw) ? ttlRaw : ZIP_SHARE_DEFAULT_TTL_HOURS)
  );

  const now = Date.now();
  const expiresAt = new Date(now + ttlHours * 60 * 60 * 1000).toISOString();

  const payload = {
    type: "zipcode_map",
    version: 2,
    title: "우편번호 지도 공유",
    description: safeShareTitle(body.description || body.title, `${zips.length}개 우편번호 배송 구역을 확인하세요`),
    zips,
    merge: body.merge === true,
    created_at: new Date(now).toISOString(),
    expires_at: expiresAt,
    ttl_hours: ttlHours,
    created_by: auth.user?.email || auth.access?.email || "",
    source: cleanText(body.source || "zipcode_search")
  };

  const id = await createUniqueZipShareId(env);
  const kv = getZipShareKv(env);
  const ttlSeconds = Math.ceil(ttlHours * 60 * 60);

  await kv.put(ZIP_SHARE_KV_PREFIX + id, JSON.stringify(payload), {
    expirationTtl: ttlSeconds
  });

  const url = `${publicShareOrigin(env)}/zip/share?s=${encodeURIComponent(id)}`;

  return jsonResp({
    ok: true,
    version: ZIP_SHARE_WORKER_VERSION,
    mode: "kv_shortlink",
    url,
    token: id,
    share_id: id,
    expires_at: expiresAt,
    zips
  });
}

async function decodeLegacySignedShare(request, env, s, sig) {
  if (!s || !sig) throw httpError(400, "Missing share token");

  const expected = await zipShareHmacHex(env, s);
  if (!constantTimeEqual(expected, sig)) throw httpError(403, "Invalid share signature");

  let payload = null;
  try {
    payload = JSON.parse(base64UrlDecodeText(s));
  } catch {
    throw httpError(400, "Invalid share payload");
  }

  return payload;
}

async function loadShortZipSharePayload(env, id) {
  if (!/^[A-Za-z0-9_-]{8,40}$/.test(id)) {
    throw httpError(400, "Invalid share id");
  }

  const kv = getZipShareKv(env);
  const text = await kv.get(ZIP_SHARE_KV_PREFIX + id);

  if (!text) {
    throw httpError(410, "Share link has expired or does not exist");
  }

  try {
    return JSON.parse(text);
  } catch {
    throw httpError(500, "Stored share payload is invalid");
  }
}

async function handleZipShareVerify(request, env, url) {
  const s = cleanText(url.searchParams.get("s"));
  const sig = cleanText(url.searchParams.get("sig"));

  if (!s) throw httpError(400, "Missing share token");

  // v1 legacy: long payload + sig
  // v2 current: short id stored in KV, no sig
  const payload = sig
    ? await decodeLegacySignedShare(request, env, s, sig)
    : await loadShortZipSharePayload(env, s);

  if (payload?.type !== "zipcode_map") throw httpError(400, "Invalid share type");

  const expiresAt = Date.parse(payload.expires_at || payload.expiresAt || "");
  if (!Number.isFinite(expiresAt)) throw httpError(400, "Invalid expiration");
  if (Date.now() > expiresAt) throw httpError(410, "Share link has expired");

  payload.zips = uniqueShareZips(payload.zips);
  if (!payload.zips.length) throw httpError(400, "No zipcode in share payload");

  return jsonResp({
    ok: true,
    version: ZIP_SHARE_WORKER_VERSION,
    mode: sig ? "legacy_signed" : "kv_shortlink",
    payload
  });
}


