}

function classifyDeliveryUnit(unitRow, parentClassification) {
  const text = [unitUseText(unitRow), parentClassification?.purpose || ""]
    .join(" ")
    .replace(/\s+/g, "");

  if (/오피스텔|아파트|공동주택|연립주택|다세대주택|단독주택|다가구주택|다중주택|도시형생활주택|기숙사|주택/.test(text)) {
    return "residential";
  }

  if (/근린생활시설|판매시설|업무시설|사무소|상점|점포|소매점|음식점|의료시설|병원|의원|약국|교육연구시설|학원|교습소|숙박시설|호텔|모텔|위락시설|문화및집회시설|운동시설|노유자시설|자동차관련시설|공장|창고시설|방송통신시설|종교시설|관광휴게시설/.test(text)) {
    return "commercial";
  }

  if (parentClassification?.residential) return "residential";
  if (parentClassification?.commercial) return "commercial";
  return "unclassified";
}

function buildingParcelQueryVariants(parcel) {
  const padded = {
    sigunguCd: parcel.sigunguCd,
    bjdongCd: parcel.bjdongCd,
    platGbCd: parcel.platGbCd,
    bun: parcel.bun,
    ji: parcel.ji,
  };

  const unpadded = {
    ...padded,
    bun: String(Number(parcel.bun)),
    ji: String(Number(parcel.ji || "0")),
  };

  const variants = [
    { name: "padded", params: padded },
    { name: "unpadded", params: unpadded },
  ];

  if (Number(parcel.ji || 0) === 0) {
    variants.push({
      name: "omit_zero_ji",
      params: {
        sigunguCd: parcel.sigunguCd,
        bjdongCd: parcel.bjdongCd,
        platGbCd: parcel.platGbCd,
        bun: parcel.bun,
      },
    });
  }

  const seen = new Set();
  return variants.filter((variant) => {
    const key = JSON.stringify(variant.params);
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

function buildingUnitRowStableKey(row, fallbackIndex = 0) {
