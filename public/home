    const [currentRes,freshRes,scheduleRes]=await Promise.all([
      S.sb.from("meta_realtime_current")
        .select("batch_id,meta_worker_key,driver_pk,camp_code,camp_name,wave,coupang_id,driver_name,scheduled_routes,actual_routes,extra_routes,delivery_assigned,delivery_scanned,delivery_completed,delivery_impossible,delivery_pdd_miss,delivery_total,delivery_complete_rate,return_pending,return_collected,return_uncollected,return_uncollected_raw,return_absent_raw,return_total,return_attempt_rate,return_collection_rate,freshbag_pending,freshbag_collected,freshbag_uncollected,freshbag_total,freshbag_attempt_rate,freshbag_collection_rate,scan_started_at,all_completed_at,last_seen_at,all_done,dawn_miss,fresh_miss,raw_payload")
        .in("batch_id",ids),
      S.sb.from("meta_realtime_fresh_current")
        .select("batch_id,meta_worker_key,driver_pk,coupang_id,driver_name,delivery_assigned,delivery_scanned,delivery_completed,delivery_impossible,delivery_pdd_miss,delivery_total,delivery_complete_rate,fresh_miss")
        .in("batch_id",ids),
      S.sb.from("maroowell_schedule")
        .select("schedule_date,camp,wave,route_label,driver_name,driver_display_name,driver_owner_name,driver_coupang_id,is_active")
        .in("schedule_date",scheduleDates)
        .eq("is_active",true)
    ]);

    if(currentRes.error)throw currentRes.error;
    if(freshRes.error)throw freshRes.error;
    if(scheduleRes.error)throw scheduleRes.error;

    S.scheduleRows=scheduleRes.data||[];
    S.sourceRows=mergeFresh(currentRes.data||[],freshRes.data||[]);
    S.lastQueryAt=Date.now();
    applyWaveFilter();

    const visible=S.camps.reduce((n,c)=>n+c.rows.length,0);
    const errors=S.batches.filter(b=>b.status==="error");
    const polls=S.batches.map(b=>String(b.last_polled_at||"")).filter(Boolean).sort();
    const lastPoll=polls.at(-1)||"";
    const pollText=lastPoll?lastPoll.replace("T"," ").slice(11,19):"-";

    setStatus(
      `${S.wave==="ALL"?"주간·야간 통합":waveLabel(S.wave)} · 기사 <strong>${num(visible)}명</strong> · 1분 자동 새로고침 · `+
      `${errors.length?`오류 ${errors.length}건 · `:""}최근 수집 ${pollText}`,
      errors.length===S.batches.length
    );
  }catch(e){
    console.error(e);
    setStatus(`백엔드 조회 실패: ${esc(e?.message||String(e))}`,true);
  }finally{
    setBusy(false);
  }
}

function restartAuto(){
  clearInterval(S.timer);
  S.timer=setInterval(()=>{if(!S.busy)queryAll()},60000);
}

async function copySection(id,name,trigger){
  const el=$(id);
  if(!el||!window.htmlToImage)return setStatus("이미지 캡처 모듈을 불러오지 못했습니다.",true);

  const buttons=[...el.querySelectorAll(".copyBtn")];
  const original=trigger?.textContent||"이미지 복사";
  const stamp=document.createElement("div");
  const q=S.lastQueryAt?new Date(S.lastQueryAt):null;
  const queryTime=q?q.toLocaleString("ko-KR",{hour12:false,year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit",second:"2-digit"}):"조회 전";
  stamp.className="captureMeta";
  stamp.textContent=`데이터 조회 기준 · ${S.wave==="ALL"?"주간·야간 통합":waveLabel(S.wave)} · 조회시각 ${queryTime}`;
  el.insertBefore(stamp,el.firstChild);
  buttons.forEach(b=>b.style.visibility="hidden");
  el.classList.add("copying");

  let copied=false;
  try{
    const pixel=Math.max(1,Math.min(2,15000/Math.max(1,el.scrollHeight)));
    const blob=await window.htmlToImage.toBlob(el,{backgroundColor:"#f3f6f8",pixelRatio:pixel,cacheBust:true});
    if(!blob)throw new Error("이미지 생성 실패");
    if(!navigator.clipboard?.write||typeof ClipboardItem==="undefined")throw new Error("이미지 클립보드 복사를 지원하지 않습니다.");
    await navigator.clipboard.write([new ClipboardItem({"image/png":blob})]);
    copied=true;
    setStatus(`${esc(name)} 이미지를 클립보드에 복사했습니다.`);
  }catch(e){
    setStatus(`이미지 복사 실패: ${esc(e?.message||String(e))}`,true);
  }finally{
    buttons.forEach(b=>b.style.visibility="");
    el.classList.remove("copying");
    stamp.remove();
  }

  if(copied&&trigger){
    trigger.textContent="복사됨!";
    trigger.classList.add("copied");
    setTimeout(()=>{trigger.textContent=original;trigger.classList.remove("copied")},1400);
  }
}

function bind(){
  $("scheduleDate").value=defaultDate();

  document.querySelectorAll(".waveBtn").forEach(b=>b.addEventListener("click",()=>{
    S.wave=b.dataset.wave;
    document.querySelectorAll(".waveBtn").forEach(x=>x.classList.toggle("active",x===b));
    applyWaveFilter();
  }));
  $("queryBtn")?.addEventListener("click",queryAll);
  $("logoutBtn").addEventListener("click",logout);

  document.querySelectorAll("[data-copy-section]").forEach(b=>b.addEventListener("click",e=>{
    e.stopPropagation();
    copySection(b.dataset.copySection,b.dataset.copyName,b);
  }));

  document.addEventListener("keydown",e=>{
    if(e.key==="Escape"&&S.selected.size){
      S.selected.clear();
      renderCamps();
      setStatus("캠프 선택을 모두 해제했습니다.");
    }
  });
}

async function boot(){
  bind();
  try{
    if(!(await auth()))return;
    document.documentElement.style.visibility="visible";
    await queryAll();
    restartAuto();
  }catch(e){
    document.documentElement.style.visibility="visible";
    $("userPill").className="pill err user";
    $("userPill").textContent="접근 불가";
    setStatus(esc(e?.message||String(e)),true);
    if($("queryBtn"))$("queryBtn").disabled=true;
  }
}

boot();
})();
