<script>
(()=>{"use strict";

const SUPA="https://rgqerimdxkthkcewqbbe.supabase.co";
const KEY=["sb_publishable_","FUFuH5JVyM-JLWWVeasgOw_Sk_LtD9H"].join("");
const $=id=>document.getElementById(id);

const S={
  sb:null,
  wave:"ALL",
  busy:false,
  timer:null,
  isAdmin:false,
  batches:[],
  sourceRows:[],
  scheduleRows:[],
  camps:[],
  selected:new Set(),
  lastQueryAt:0
};

const esc=v=>String(v??"")
  .replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;");
const num=v=>new Intl.NumberFormat("ko-KR").format(Number(v||0));
const pct=v=>`${Number(v||0).toFixed(1)}%`;
const ratio=(a,b)=>Number(b||0)>0?Number(a||0)*100/Number(b):0;
const uniq=a=>[...new Set((a||[]).filter(Boolean))];
const norm=v=>String(v||"").trim().replace(/[^0-9A-Za-z가-힣]/g,"").toUpperCase();
const subRoute=v=>{const n=norm(v),m=n.match(/^(.+?[A-Z])\d{2}$/);return m?.[1]||n};
const nameKey=v=>String(v||"").trim().replace(/\s+/g,"").toLowerCase();
const iso=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
const addIsoDate=(date,days)=>{const d=new Date(date+"T00:00:00Z");d.setUTCDate(d.getUTCDate()+days);return d.toISOString().slice(0,10)};
const kstNow=()=>{const d=new Date(Date.now()+9*3600000);return{date:d.toISOString().slice(0,10),hour:d.getUTCHours()}};
const defaultDate=()=>kstNow().date;
const activeScheduleDateForWave=wave=>{const k=kstNow();return wave==="WAVE1"&&k.hour<12?addIsoDate(k.date,-1):k.date};
const batchIsCurrentShift=b=>String(b?.schedule_date||"")===activeScheduleDateForWave(String(b?.wave||"").toUpperCase());
const waveLabel=w=>w==="WAVE1"?"야간":w==="WAVE2"?"주간":"전체";
const isNight=w=>w==="WAVE1";
const firstRow=data=>Array.isArray(data)?(data[0]||null):(data||null);

function fmtTime(v){
  if(!v)return "-";
  const m=String(v).match(/[T\s](\d{2}):(\d{2})/);
  if(!m)return "-";
  return `${Number(m[1])}시 ${m[2]}분`;
}
function setStatus(t,e=false){
  $("queryStatus").innerHTML=t;
  $("queryStatus").classList.toggle("err",!!e);
}
function setBusy(v){
  S.busy=!!v;
  if($("controlCard"))$("controlCard").classList.toggle("loading",S.busy);
  if($("queryBtn"))$("queryBtn").disabled=S.busy;
}
function cleanCampName(name,code=""){
  let n=String(name||"").trim().replace(/^M_/i,"M");
  if(/익산\s*1/i.test(n))return "M익산1";
  return n||String(code||"").trim();
}
function blankDelivery(){
  return{total:0,misscan:0,remaining:0,completed:0,impossible:0,pddMiss:0,rate:0,hasData:false};
}
function addDelivery(a,b){
  for(const k of["total","misscan","remaining","completed","impossible","pddMiss"])a[k]=(a[k]||0)+(b[k]||0);
  a.hasData=!!(a.hasData||b?.hasData);
  a.rate=ratio(a.completed||0,a.total);
}
function collectionBlank(){
  return{total:0,collected:0,uncollected:0,assigned:0,absent:0,completionRate:0,collectionRate:0};
}
function addCollection(a,b){
  for(const k of["total","collected","uncollected","assigned","absent"])a[k]=(a[k]||0)+(b[k]||0);
  a.completionRate=ratio((a.collected||0)+(a.uncollected||0),a.total);
  a.collectionRate=ratio(a.collected,a.total);
}
function backendDelivery(r,p="delivery"){
  const rawTotal=r[`${p}_total`];
  const total=Number(rawTotal||0);
  const misscan=Number(r[`${p}_assigned`]||0);
  const remaining=Number(r[`${p}_scanned`]||0);
  const completed=Number(r[`${p}_completed`]||0);
  const impossible=Number(r[`${p}_impossible`]||0);
  const pddMiss=Number(r[`${p}_pdd_miss`]||0);
  const rate=ratio(completed,total);
  return{
    total,misscan,remaining,completed,impossible,pddMiss,rate,
    hasData:p==="fresh_delivery" ? rawTotal!=null&&total>0 : total>0
  };
}
function backendCollection(r,p,includeAbsent=false){
  const assigned=Number(r[`${p}_pending`]||0);
  const collected=Number(r[`${p}_collected`]||0);
  const uncollected=Number(r[`${p}_uncollected`]??r[`${p}_uncollected_raw`]??0);
  const absent=includeAbsent?Number(r[`${p}_absent_raw`]||0):0;
  const total=Number(r[`${p}_total`]||0)||(assigned+collected+uncollected+absent);
  return{
    total,assigned,collected,uncollected,absent,
    completionRate:Number(r[`${p}_attempt_rate`]??ratio(collected+uncollected,total)),
    collectionRate:Number(r[`${p}_collection_rate`]??ratio(collected,total))
  };
}
function isStarted(r){
  return !!r.scan_started_at ||
    Number(r.delivery_scanned||0)>0 ||
    Number(r.delivery_completed||0)>0 ||
    Number(r.delivery_impossible||0)>0 ||
    Number(r.delivery_pdd_miss||0)>0;
}

function makeScheduleIndex(){
  const byCampWave=new Map();
  for(const x of S.scheduleRows||[]){
    if(x.is_active===false || norm(x.route_label)==="휴무자")continue;
    const camp=cleanCampName(x.camp);
    const wave=String(x.wave||"").toUpperCase();
    const scheduleDate=String(x.schedule_date||"");
    if(!camp||!wave||!scheduleDate)continue;
    const key=`${scheduleDate}|${camp}|${wave}`;
    if(!byCampWave.has(key))byCampWave.set(key,new Map());
    const display=String(x.driver_display_name||x.driver_name||x.driver_owner_name||x.driver_coupang_id||"").trim();
    const cid=String(x.driver_coupang_id||"").trim().toLowerCase();
    const nk=nameKey(display);
    const pk=cid?`id:${cid}`:`name:${nk}`;
    if(display&&pk!=="name:")byCampWave.get(key).set(pk,{display,cid,nk});
  }
  return byCampWave;
}

function buildCamps(){
  const batchMap=new Map((S.batches||[]).map(b=>[b.id,b]));
  const groups=new Map();

  for(const src of S.sourceRows||[]){
    const b=batchMap.get(src.batch_id)||{};
    const wave=String(src.wave||b.wave||"").toUpperCase();
    if(S.wave!=="ALL"&&wave!==S.wave)continue;
    if(!isStarted(src))continue;

    const name=cleanCampName(src.camp_name||b.camp_name,src.camp_code||b.camp_code);
    const key=`${name}|${wave}`;
    let g=groups.get(key);
    if(!g){
      g={
        key,name,wave,code:src.camp_code||b.camp_code||"",scheduleDate:String(b.schedule_date||""),
        status:b.status||"collecting",lastPolledAt:b.last_polled_at||null,
        rows:[],workers:0,
        totals:{delivery:blankDelivery(),freshDelivery:blankDelivery(),returns:collectionBlank(),fresh:collectionBlank()},
        scheduledCount:0,absentNames:[],campCompletedAt:null
      };
      groups.set(key,g);
    }

    const delivery=backendDelivery(src,"delivery");
    const freshDelivery=backendDelivery(src,"fresh_delivery");
    const returns=backendCollection(src,"return",true);
    const fresh=backendCollection(src,"freshbag",false);
    const baseRoutes=(Array.isArray(src.scheduled_routes)&&src.scheduled_routes.length?src.scheduled_routes:src.actual_routes)||[];
    const routeAlerts=Array.isArray(src.raw_payload?.route_alerts)?src.raw_payload.route_alerts:[];
    const externalAlerts=routeAlerts.filter(x=>String(x?.type||"").toLowerCase()==="uncontracted");
    const ownRouteAlerts=routeAlerts.filter(x=>["borrowed","owner_mismatch"].includes(String(x?.type||"").toLowerCase()));
    const externalRoutes=uniq(externalAlerts.map(x=>norm(x?.route)).filter(Boolean));
    const ownExtraRoutes=uniq(ownRouteAlerts.map(x=>norm(x?.route)).filter(Boolean));
    const routes=uniq([...baseRoutes.map(norm),...ownExtraRoutes,...externalRoutes].filter(Boolean)).sort((a,b)=>a.localeCompare(b,"en",{numeric:true,sensitivity:"base"}));
    const warns=[];
    if(ownExtraRoutes.length)warns.push(`마루웰 라우트 스캔 /  ${ownExtraRoutes.join(", ")}`);
    if(externalRoutes.length)warns.push(`타 라우트 오스캔 /  ${externalRoutes.join(", ")}`);

    addDelivery(g.totals.delivery,delivery);
    addDelivery(g.totals.freshDelivery,freshDelivery);
    addCollection(g.totals.returns,returns);
    addCollection(g.totals.fresh,fresh);

    g.rows.push({
      campKey:key,camp:name,wave,
      driver:String(src.driver_name||src.coupang_id||"담당 확인").trim(),
      driverPk:src.driver_pk==null?null:Number(src.driver_pk),
      coupangId:String(src.coupang_id||"").trim().toLowerCase(),
      routes,ownExtraRoutes,externalRoutes,delivery,freshDelivery,returns,fresh,
      scanStartedAt:src.scan_started_at||null,
      allCompletedAt:src.all_completed_at||null,
      freshMiss:String(src.fresh_miss||"N").toUpperCase()==="Y",
      dawnMiss:String(src.dawn_miss||"N").toUpperCase()==="Y",
      status:externalRoutes.length?"external":(ownExtraRoutes.length?"mismatch":"ok"),
      hasExternalRoute:externalRoutes.length>0,
      warns
    });
    g.workers++;
  }

  const scheduleIndex=makeScheduleIndex();
  for(const g of groups.values()){
    const scheduled=scheduleIndex.get(`${g.scheduleDate}|${g.name}|${g.wave}`)||new Map();
    g.scheduledCount=scheduled.size;

    const presentIds=new Set(g.rows.map(r=>r.coupangId).filter(Boolean));
    const presentNames=new Set(g.rows.map(r=>nameKey(r.driver)).filter(Boolean));
    g.absentNames=[...scheduled.values()]
      .filter(p=>!(p.cid&&presentIds.has(p.cid)) && !presentNames.has(p.nk))
      .map(p=>p.display);

    if(scheduled.size>0&&g.absentNames.length===0){
      const completionTimes=[];
      let allDone=true;
      for(const p of scheduled.values()){
        const row=g.rows.find(r=>(p.cid&&r.coupangId===p.cid)||nameKey(r.driver)===p.nk);
        if(!row?.allCompletedAt){allDone=false;break}
        completionTimes.push(row.allCompletedAt);
      }
      if(allDone&&completionTimes.length===scheduled.size){
        g.campCompletedAt=completionTimes.sort().at(-1)||null;
      }
    }
  }

  return [...groups.values()];
}

function aggregate(camps){
  const a={workers:0,delivery:blankDelivery(),freshDelivery:blankDelivery(),returns:collectionBlank(),fresh:collectionBlank()};
  for(const c of camps){
    a.workers+=c.workers||0;
    addDelivery(a.delivery,c.totals.delivery);
    addDelivery(a.freshDelivery,c.totals.freshDelivery);
    addCollection(a.returns,c.totals.returns);
    addCollection(a.fresh,c.totals.fresh);
  }
  return a;
}

