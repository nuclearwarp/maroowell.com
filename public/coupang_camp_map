<!doctype html>
<html lang="ko">
<head>
  <style>html{visibility:hidden}</style>
  <script src="/config.js"></script>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>쿠팡 캠프 지도</title><link rel="icon" href="/favicon.ico?v=2">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://dapi.kakao.com/v2/maps/sdk.js?appkey=add4ce93b38c0ff9d9b9053728e067b3&autoload=false&libraries=clusterer"></script>
  <style>
    @font-face{font-family:mw;src:url('/assets/fonts/MungyeongGamhong.woff2') format('woff2');font-display:swap}
    :root{--line:#d8e0ee;--text:#0f172a;--muted:#64748b;--blue:#2563eb;--bg:#eef3f8;--font:mw,'Noto Sans KR',system-ui,sans-serif}
    *{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;font-family:var(--font);color:var(--text);background:var(--bg)}body{overflow:hidden}button,input,select{font:inherit}.app{height:100%;display:grid;grid-template-rows:56px 1fr}.top{display:flex;align-items:center;gap:10px;padding:0 14px;background:#fff;border-bottom:1px solid var(--line);z-index:30}.logo{width:32px;height:32px;display:flex;align-items:center;justify-content:center}.logo img{width:30px}.title{display:flex;flex-direction:column}.title b{font-size:18px}.title small{font-size:11px;color:var(--muted);margin-top:2px}.spacer{flex:1}.btn{height:38px;padding:0 13px;border:1px solid #cbd5e1;border-radius:999px;background:#fff;color:var(--text);font-size:12px;font-weight:800;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}.btn:hover{border-color:#93c5fd;background:#f8fbff}.btn.primary{background:var(--blue);border-color:var(--blue);color:#fff}.menuBtn{display:none;width:38px;padding:0;font-size:18px}.work{position:relative;min-height:0;display:grid;grid-template-columns:390px 1fr}.side{background:#fff;border-right:1px solid var(--line);overflow:auto;z-index:20}.inner{padding:14px}.card{padding:13px;border:1px solid var(--line);border-radius:18px;background:#fff;margin-bottom:12px;box-shadow:0 7px 20px rgba(15,23,42,.05)}.head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.head b{font-size:14px}.head span{font-size:11px;color:var(--muted)}.field{display:grid;gap:6px;margin-top:9px}.field label{font-size:11px;font-weight:800;color:#475569}.control{width:100%;height:40px;padding:0 11px;border:1px solid #cbd5e1;border-radius:12px;background:#f8fafc;outline:0}.control:focus{border-color:#60a5fa;background:#fff;box-shadow:0 0 0 3px rgba(37,99,235,.1)}.cols{display:grid;grid-template-columns:1fr 1fr;gap:9px}.actions{display:flex;gap:8px;margin-top:11px}.actions>*{flex:1}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{padding:10px 6px;border:1px solid var(--line);border-radius:14px;background:#f8fafc;text-align:center}.stat strong{display:block;font-size:17px}.stat span{display:block;margin-top:4px;font-size:10px;color:var(--muted)}.chips{display:flex;flex-wrap:wrap;gap:7px}.chip{height:30px;padding:0 10px;border:1px solid var(--line);border-radius:999px;background:#fff;font-size:11px;font-weight:800;cursor:pointer}.chip.active{border-color:#60a5fa;background:#eff6ff;color:#1d4ed8}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px}.list{display:grid;gap:7px;max-height:38vh;overflow:auto}.item{width:100%;padding:10px 11px;border:1px solid var(--line);border-radius:14px;background:#fff;text-align:left;cursor:pointer}.item:hover,.item.active{border-color:#60a5fa;background:#f8fbff}.item strong{display:block;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.item span{display:block;margin-top:5px;font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.empty{padding:20px 10px;text-align:center;color:var(--muted);font-size:12px;border:1px dashed #cbd5e1;border-radius:14px}.detail{display:none}.detail.show{display:block}.detail h3{margin:0;font-size:16px}.detail p{margin:5px 0 0;font-size:11px;color:var(--muted)}.rows{display:grid;gap:7px;margin-top:12px}.row{display:grid;grid-template-columns:64px 1fr;gap:8px;font-size:12px;line-height:1.45}.row b{color:var(--muted)}.mapPane{position:relative;min-width:0;min-height:0}#map{position:absolute;inset:0}.tools{position:absolute;top:12px;right:12px;z-index:10;display:flex;gap:8px}.tools .btn{box-shadow:0 10px 28px rgba(15,23,42,.15)}.toast{position:absolute;left:50%;bottom:18px;transform:translate(-50%,10px);z-index:10;padding:10px 14px;border-radius:999px;background:rgba(15,23,42,.9);color:#fff;font-size:12px;font-weight:800;opacity:0;transition:.18s}.toast.show{opacity:1;transform:translate(-50%,0)}.toast.err{background:rgba(185,28,28,.92)}.loading{position:absolute;inset:0;z-index:25;display:flex;align-items:center;justify-content:center;background:rgba(238,243,248,.82)}.loading.hide{display:none}.loading div{padding:16px 20px;border:1px solid var(--line);border-radius:18px;background:#fff;font-size:13px;font-weight:900;box-shadow:0 14px 38px rgba(15,23,42,.12)}.info{min-width:210px;max-width:280px;padding:11px 12px;border:1px solid rgba(15,23,42,.12);border-radius:14px;background:#fff;box-shadow:0 14px 34px rgba(15,23,42,.2);transform:translateY(-8px)}.info strong{display:block;font-size:13px}.info span{display:block;margin-top:4px;font-size:11px;color:var(--muted)}
    @media(max-width:900px){.app{grid-template-rows:54px 1fr}.top{padding:0 10px}.title b{font-size:16px}.title small,.listLink{display:none}.menuBtn{display:inline-flex}.work{display:block}.side{position:absolute;left:0;top:0;bottom:0;width:min(88vw,390px);transform:translateX(-105%);transition:.2s;box-shadow:0 14px 38px rgba(15,23,42,.18)}.work.open .side{transform:translateX(0)}.mapPane{position:absolute;inset:0}.list{max-height:34vh}}
  </style>
</head>
<body>
<div class="app">
  <header class="top"><a id="mwBoardMenuToggle" class="logo" href="/index.html"><img src="/favicon.ico" alt="Maroowell"></a><div class="title"><b>쿠팡 캠프 지도</b><small>등록 캠프 위치 · 구분/지역별 조회</small></div><div class="spacer"></div><button id="menu" class="btn menuBtn">☰</button><a class="btn listLink" href="/coupang_camp">목록 보기</a><button id="reload" class="btn primary">새로고침</button></header>
  <main id="work" class="work">
    <aside class="side"><div class="inner">
      <section class="card"><div class="head"><b>캠프 필터</b><span>실시간 반영</span></div><div class="field"><label>검색</label><input id="q" class="control" type="search" placeholder="캠프명, 주소, 코드, 설명"></div><div class="cols"><div class="field"><label>구분</label><select id="type" class="control"><option value="">전체</option></select></div><div class="field"><label>지역</label><select id="region" class="control"><option value="">전체</option></select></div></div><div class="actions"><button id="reset" class="btn">필터 초기화</button><button id="fit" class="btn">전체 위치 보기</button></div></section>
      <section class="card"><div class="head"><b>조회 현황</b><span id="time">-</span></div><div class="stats"><div class="stat"><strong id="visible">0</strong><span>표시 캠프</span></div><div class="stat"><strong id="total">0</strong><span>전체 캠프</span></div><div class="stat"><strong id="missing">0</strong><span>좌표 누락</span></div></div></section>
      <section class="card"><div class="head"><b>구분별 보기</b><span>클릭 필터</span></div><div id="chips" class="chips"></div></section>
      <section id="detail" class="card detail"><div class="head"><b>선택 캠프</b><span id="dType"></span></div><h3 id="dTitle"></h3><p id="dSub"></p><div class="rows"><div class="row"><b>주소</b><span id="dAddress"></span></div><div class="row"><b>지역</b><span id="dRegion"></span></div><div class="row"><b>코드</b><span id="dCode"></span></div><div class="row"><b>설명</b><span id="dDesc"></span></div><div class="row"><b>좌표</b><span id="dCoord"></span></div></div><div class="actions"><button id="copy" class="btn">주소 복사</button><button id="openKakao" class="btn primary">카카오맵 열기</button></div></section>
      <section class="card"><div class="head"><b>캠프 목록</b><span id="count">0건</span></div><div id="list" class="list"></div></section>
    </div></aside>
    <section class="mapPane"><div id="map"></div><div class="tools"><button id="mapType" class="btn">스카이뷰</button><button id="current" class="btn">내 위치</button></div><div id="toast" class="toast"></div><div id="loading" class="loading"><div>캠프 지도를 불러오는 중...</div></div></section>
  </main>
</div>
<script>
(()=>{'use strict';
const C=window.MARUWELL_CONFIG||{},API=C.BACKENDS?.coupangCamp||C.COUPANG_CAMP_API||'https://coupangcamp.brain-0f6.workers.dev',COLORS=['#2563eb','#16a34a','#f97316','#7c3aed','#db2777','#0891b2','#ca8a04','#475569','#dc2626','#0f766e'];
const $=s=>document.querySelector(s),D={work:$('#work'),menu:$('#menu'),reload:$('#reload'),q:$('#q'),type:$('#type'),region:$('#region'),reset:$('#reset'),fit:$('#fit'),chips:$('#chips'),list:$('#list'),count:$('#count'),visible:$('#visible'),total:$('#total'),missing:$('#missing'),time:$('#time'),detail:$('#detail'),dType:$('#dType'),dTitle:$('#dTitle'),dSub:$('#dSub'),dAddress:$('#dAddress'),dRegion:$('#dRegion'),dCode:$('#dCode'),dDesc:$('#dDesc'),dCoord:$('#dCoord'),copy:$('#copy'),openKakao:$('#openKakao'),mapType:$('#mapType'),current:$('#current'),toast:$('#toast'),loading:$('#loading')};
const S={map:null,cluster:null,rows:[],filtered:[],markers:[],colors:new Map(),selected:null,overlay:null,road:true};
const txt=v=>String(v??'').trim(),low=v=>txt(v).toLowerCase(),id=r=>r.id||[r.camp,r.mb_camp,r.code,r.latitude,r.longitude].join('|'),name=r=>r.camp&&r.mb_camp&&r.camp!==r.mb_camp?`${r.camp} · ${r.mb_camp}`:r.camp||r.mb_camp||r.code||'이름 없는 캠프';
function color(t){t=t||'미분류';if(!S.colors.has(t))S.colors.set(t,COLORS[S.colors.size%COLORS.length]);return S.colors.get(t)}
function toast(m,e=false){D.toast.textContent=m;D.toast.className=`toast show${e?' err':''}`;clearTimeout(toast.t);toast.t=setTimeout(()=>D.toast.className='toast',2400)}
function markerImage(t){const c=color(t),svg=`<svg xmlns="http://www.w3.org/2000/svg" width="36" height="46" viewBox="0 0 36 46"><path d="M18 1C8.6 1 1 8.6 1 18c0 12.7 17 27 17 27s17-14.3 17-27C35 8.6 27.4 1 18 1z" fill="${c}" stroke="white" stroke-width="2"/><circle cx="18" cy="18" r="7" fill="white"/><circle cx="18" cy="18" r="3.2" fill="${c}"/></svg>`;return new kakao.maps.MarkerImage('data:image/svg+xml;charset=UTF-8,'+encodeURIComponent(svg),new kakao.maps.Size(36,46),{offset:new kakao.maps.Point(18,45)})}
function norm(r,i){const lat=Number(r.latitude),lng=Number(r.longitude),ok=Number.isFinite(lat)&&Number.isFinite(lng)&&lat>=-90&&lat<=90&&lng>=-180&&lng<=180&&!(lat===0&&lng===0);return{id:txt(r.id)||`row_${i}`,camp_type:txt(r.camp_type)||'미분류',camp:txt(r.camp),mb_camp:txt(r.mb_camp),address:txt(r.address),region:txt(r.region||r.area),code:txt(r.code),latitude:lat,longitude:lng,description:txt(r.description),ok}}
function options(){const types=[...new Set(S.rows.map(r=>r.camp_type))].sort((a,b)=>a.localeCompare(b,'ko',{numeric:true})),regions=[...new Set(S.rows.map(r=>r.region).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'ko',{numeric:true}));fill(D.type,types);fill(D.region,regions);chips(types)}
function fill(el,vals){const cur=el.value;el.innerHTML='<option value="">전체</option>';vals.forEach(v=>el.add(new Option(v,v)));if(vals.includes(cur))el.value=cur}
function chips(types){const counts=new Map;S.rows.forEach(r=>counts.set(r.camp_type,(counts.get(r.camp_type)||0)+1));D.chips.replaceChildren(...types.map(t=>{const b=document.createElement('button');b.className='chip'+(D.type.value===t?' active':'');b.dataset.type=t;b.innerHTML=`<span class="dot" style="background:${color(t)}"></span>${t} ${counts.get(t)}`;return b}))}
function apply(fit=true){const q=low(D.q.value),type=D.type.value,region=D.region.value;S.filtered=S.rows.filter(r=>r.ok&&(!type||r.camp_type===type)&&(!region||r.region===region)&&(!q||[r.camp_type,r.camp,r.mb_camp,r.address,r.region,r.code,r.description].map(low).join('\n').includes(q)));renderMarkers(fit);renderList();stats();chips([...new Set(S.rows.map(r=>r.camp_type))].sort((a,b)=>a.localeCompare(b,'ko',{numeric:true})))}
function renderMarkers(fit){S.cluster.clear();S.markers.forEach(m=>m.setMap(null));S.markers=[];if(S.overlay)S.overlay.setMap(null);const bounds=new kakao.maps.LatLngBounds;S.filtered.forEach(r=>{const p=new kakao.maps.LatLng(r.latitude,r.longitude),m=new kakao.maps.Marker({position:p,image:markerImage(r.camp_type),title:name(r)});kakao.maps.event.addListener(m,'click',()=>select(r,true));S.markers.push(m);bounds.extend(p)});S.cluster.addMarkers(S.markers);if(fit&&S.markers.length)S.map.setBounds(bounds)}
function renderList(){D.count.textContent=`${S.filtered.length.toLocaleString()}건`;D.list.replaceChildren();if(!S.filtered.length){D.list.innerHTML='<div class="empty">조건에 맞는 좌표 등록 캠프가 없습니다.</div>';return}S.filtered.slice(0,500).forEach(r=>{const b=document.createElement('button');b.className='item'+(S.selected&&id(S.selected)===id(r)?' active':'');b.dataset.id=id(r);b.innerHTML=`<strong><i class="dot" style="background:${color(r.camp_type)}"></i>${name(r)}</strong><span>${[r.camp_type,r.region,r.address].filter(Boolean).join(' · ')}</span>`;D.list.appendChild(b)})}
function stats(){D.visible.textContent=S.filtered.length.toLocaleString();D.total.textContent=S.rows.length.toLocaleString();D.missing.textContent=S.rows.filter(r=>!r.ok).length.toLocaleString();D.time.textContent=new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'})}
function select(r,focus){S.selected=r;D.detail.classList.add('show');D.dType.textContent=r.camp_type;D.dTitle.textContent=r.camp||r.mb_camp||r.code||'이름 없는 캠프';D.dSub.textContent=r.mb_camp&&r.mb_camp!==r.camp?`MB캠프 ${r.mb_camp}`:'';D.dAddress.textContent=r.address||'-';D.dRegion.textContent=r.region||'-';D.dCode.textContent=r.code||'-';D.dDesc.textContent=r.description||'-';D.dCoord.textContent=`${r.latitude}, ${r.longitude}`;const p=new kakao.maps.LatLng(r.latitude,r.longitude),box=document.createElement('div');box.className='info';box.innerHTML=`<strong>${name(r)}</strong><span>${[r.camp_type,r.region].filter(Boolean).join(' · ')}</span><span>${r.address||'주소 없음'}</span>`;if(S.overlay)S.overlay.setMap(null);S.overlay=new kakao.maps.CustomOverlay({position:p,content:box,yAnchor:1.32,zIndex:20});S.overlay.setMap(S.map);if(focus){S.map.panTo(p);if(S.map.getLevel()>5)S.map.setLevel(5,{anchor:p})}renderList()}
async function load(){D.loading.classList.remove('hide');try{const res=await fetch(API+'/camps',{cache:'no-store'}),data=await res.json();if(!res.ok)throw Error(data.error||data.message||`HTTP ${res.status}`);S.rows=(Array.isArray(data)?data:data.rows||[]).map(norm).sort((a,b)=>name(a).localeCompare(name(b),'ko',{numeric:true}));S.selected=null;D.detail.classList.remove('show');options();apply(true);toast(`캠프 ${S.rows.length.toLocaleString()}건을 불러왔습니다.`)}catch(e){console.error(e);toast(e.message||String(e),true)}finally{D.loading.classList.add('hide')}}
function bind(){let t;D.q.oninput=()=>{clearTimeout(t);t=setTimeout(()=>apply(true),180)};D.type.onchange=D.region.onchange=()=>apply(true);D.chips.onclick=e=>{const b=e.target.closest('[data-type]');if(!b)return;D.type.value=D.type.value===b.dataset.type?'':b.dataset.type;apply(true)};D.list.onclick=e=>{const b=e.target.closest('[data-id]');if(!b)return;const r=S.filtered.find(x=>id(x)===b.dataset.id);if(r)select(r,true)};D.reset.onclick=()=>{D.q.value='';D.type.value='';D.region.value='';apply(true)};D.fit.onclick=()=>apply(true);D.reload.onclick=load;D.menu.onclick=()=>D.work.classList.toggle('open');D.mapType.onclick=()=>{S.road=!S.road;S.map.setMapTypeId(S.road?kakao.maps.MapTypeId.ROADMAP:kakao.maps.MapTypeId.HYBRID);D.mapType.textContent=S.road?'스카이뷰':'일반지도'};D.current.onclick=()=>navigator.geolocation?navigator.geolocation.getCurrentPosition(p=>{const x=new kakao.maps.LatLng(p.coords.latitude,p.coords.longitude);S.map.panTo(x);S.map.setLevel(5,{anchor:x})},()=>toast('현재 위치를 확인할 수 없습니다.',true)):toast('위치 확인을 지원하지 않습니다.',true);D.copy.onclick=async()=>{if(!S.selected?.address)return toast('복사할 주소가 없습니다.',true);try{await navigator.clipboard.writeText(S.selected.address);toast('주소를 복사했습니다.')}catch{toast('주소 복사에 실패했습니다.',true)}};D.openKakao.onclick=()=>{if(!S.selected)return;window.open(`https://map.kakao.com/link/map/${encodeURIComponent(name(S.selected))},${S.selected.latitude},${S.selected.longitude}`,'_blank','noopener,noreferrer')};window.onresize=()=>S.map?.relayout()}
function init(){S.map=new kakao.maps.Map($('#map'),{center:new kakao.maps.LatLng(36.45,127.85),level:13});S.cluster=new kakao.maps.MarkerClusterer({map:S.map,averageCenter:true,minLevel:7});kakao.maps.event.addListener(S.map,'click',()=>S.overlay?.setMap(null));bind();load();document.documentElement.style.visibility='visible'}
if(window.kakao?.maps)kakao.maps.load(init);else{document.documentElement.style.visibility='visible';D.loading.classList.add('hide');toast('카카오 지도 SDK를 불러오지 못했습니다.',true)}
})();
</script>
<script src="/board-menu.js"></script>
</body></html>
