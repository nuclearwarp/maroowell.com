[16] 신선 데이터 조인 방식 변경
기존처럼 meta_worker_key 하나만 쓰지 말고 다음 우선순위로 매칭:
1. batch_id + meta_worker_key
2. batch_id + coupang_id
3. batch_id + driver_name

사용 예시:
const fmKey=new Map(),fmCid=new Map(),fmName=new Map();
for(const f of freshRows||[]){
  if(f.meta_worker_key)fmKey.set(`${f.batch_id}|${String(f.meta_worker_key).toLowerCase()}`,f);
  if(f.coupang_id)fmCid.set(`${f.batch_id}|${String(f.coupang_id).trim().toLowerCase()}`,f);
  if(f.driver_name)fmName.set(`${f.batch_id}|${nameKey(f.driver_name)}`,f);
}

const merged=(rows||[]).map(r=>{
  const f=
    fmKey.get(`${r.batch_id}|${String(r.meta_worker_key||"").toLowerCase()}`) ||
    fmCid.get(`${r.batch_id}|${String(r.coupang_id||"").trim().toLowerCase()}`) ||
    fmName.get(`${r.batch_id}|${nameKey(r.driver_name)}`);

  return f
    ? {
        ...r,
        fresh_delivery_assigned:f.delivery_assigned,
        fresh_delivery_scanned:f.delivery_scanned,
        fresh_delivery_completed:f.delivery_completed,
        fresh_delivery_impossible:f.delivery_impossible,
        fresh_delivery_pdd_miss:f.delivery_pdd_miss,
        fresh_delivery_total:f.delivery_total,
        fresh_delivery_complete_rate:f.delivery_complete_rate,
        fresh_miss:f.fresh_miss
      }
    : {
        ...r,
        fresh_delivery_total:null,
        fresh_delivery_complete_rate:null
      };
});

