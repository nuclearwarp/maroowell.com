function analyze(code,name,main,fresh,sc){const owners=new Map(),own=new Set((sc.routes||[]).map(norm));for(const a of sc.assignments||[]){const r=norm(a.route),d=String(a.driver||"").trim();if(r&&d)owners.set(r,d)}const ownerOf=r=>{if(owners.has(r))return owners.get(r);let best="",who="";for(const[a,d]of owners)if(r.startsWith(a)&&a.length>best.length){best=a;who=d}return who},isOwn=r=>own.has(r)||[...owners].some(([a])=>a.length===4&&r.startsWith(a));const fm=new Map((fresh?.data?.content||[]).map(x=>[workerKey(x),col(x.freshbagSummary||{})])),rows=[],sum={total:0,miss:0,scan:0,done:0,freshTotal:0,freshDone:0,attendance:uniq((sc.assignments||[]).map(x=>String(x.driver||"").trim())).length};for(const x of main?.data?.content||[]){const w=x.workerInfo||{},d=del(x.deliverySummary||{}),f=fm.get(workerKey(x))||col(x.freshbagSummary||{}),routes=uniq((w.workSubRoutes||[]).map(norm).filter(Boolean));sum.total+=d.total;sum.miss+=d.miss;sum.scan+=d.scan;sum.done+=d.done;sum.freshTotal+=f.total;sum.freshDone+=f.done;const counts=new Map();for(const r of routes){const o=ownerOf(r);if(o)counts.set(o,(counts.get(o)||0)+1)}let driver="",bc=-1;for(const[dri,c]of counts)if(c>bc){driver=dri;bc=c}driver=driver||String(w.workerName||w.name||w.workerDisplayName||"담당 확인");let external=false,mismatch=false,warns=[];for(const r of routes){const o=ownerOf(r);if(!isOwn(r)){external=true;warns.push(`${r} → 관리 라우트 아님`)}else if(o&&o!==driver){mismatch=true;warns.push(`${r} → 등록 ${o}`)}}rows.push({camp:name,driver,routes,d,f,status:external?"external":mismatch?"mismatch":"ok",warns})}sum.rate=rat(sum.done,sum.total);sum.freshRate=rat(sum.freshDone,sum.freshTotal);return{name,code,sum,rows}}
