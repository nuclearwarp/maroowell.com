      function escapeTerrainHtml(value) {
        return String(value ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function terrainNumber(value) {
        const n = Number(value);
        return Number.isFinite(n) ? n : null;
      }

      function formatTerrainMeters(value, digits = 1) {
        const n = terrainNumber(value);
        if (n == null) return "-";
        return `${n.toLocaleString("ko-KR", {
          minimumFractionDigits: 0,
          maximumFractionDigits: digits
        })}m`;
      }

      function formatTerrainRange(from, to) {
        const a = terrainNumber(from);
        const b = terrainNumber(to);
        if (a == null || b == null) return "-";
        return `${formatTerrainMeters(a)} ~ ${formatTerrainMeters(b)}`;
      }

      function formatTerrainInteger(value) {
        const n = terrainNumber(value);
        return n == null ? "-" : Math.max(0, Math.trunc(n)).toLocaleString("ko-KR");
      }

      function featureAreaSquareMeters(feature) {
        if (!feature?.geometry) return null;

        const cached = terrainNumber(feature?.properties?.area_sqm);
        if (cached != null && cached >= 0) return cached;

        try {
          const calculated = Number(turf.area(feature));
          if (!Number.isFinite(calculated) || calculated < 0) return null;

          if (!feature.properties || typeof feature.properties !== "object") {
            feature.properties = {};
          }
          feature.properties.area_sqm = calculated;
          return calculated;
        } catch (e) {
          console.warn("[ZIP_AREA] calculation failed", e);
          return null;
        }
      }

      function zipAreaSquareMeters(zip) {
        const saved = terrainNumber(state.areaByZip.get(zip));
        if (saved != null && saved >= 0) return saved;

        const calculated = featureAreaSquareMeters(state.geoByZip.get(zip));
        if (calculated != null && calculated >= 0) {
          state.areaByZip.set(zip, calculated);
        }
        return calculated;
      }

