기존 collectionPanel() 전체를 아래로 교체:

function collectionPanel(cls,label,m,wave){
  if(cls==="return"&&night(wave))return"";
  const detail=cls==="return"
    ? `<div class="detail">회수 ${num(m.collected)} · 회수대기 ${num(m.assigned)}<br>미회수 ${num(m.uncollected)} · 부재 ${num(m.absent)}</div>`
    : `<div class="detail">회수 ${num(m.collected)} · 미회수 ${num(m.uncollected)} · 회수대기 ${num(m.assigned)}</div>`;
  return `<div class="metricPanel ${cls}">
    <div class="k">${label}</div>
    <div class="dual">
      <span>완료율 <b>${pct(m.completionRate)}</b></span>
      <span>회수율 <b>${pct(m.collectionRate)}</b></span>
    </div>
    ${detail}
  </div>`;
}

