{
  "manifest_version": 3,
  "name": "Maroowell META Bridge",
  "version": "0.1.0",
  "description": "maroowell.com 실시간 배송 현황과 Coupang META 페이지를 연결합니다.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://fly.coupang.com/*",
    "https://maroowell.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://fly.coupang.com/*"],
      "js": ["meta-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://fly.coupang.com/*"],
      "js": ["meta-relay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://maroowell.com/home", "https://maroowell.com/home*"],
      "js": ["home-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Maroowell META Bridge"
  }
}
